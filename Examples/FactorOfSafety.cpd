#md on
#include ../Core/DratCore.cpd

#def Organization$ = EXAMPLE ORGANIZATION
#def Client$ = EXAMPLE CLIENT
#def Project$ = EXAMPLE PROJECT
#def Title$ = MINIMUM RECOMMENDED FACTOR OF SAFETY
#def Purpose$ = DETERMINE A RECOMMENDED MINIMUM FACTOR OF SAFETY AND COMPARE IT WITH THE DESIGN VALUE.
#def Scope$ = DEMONSTRATE A STATIC, AUDITABLE FACTOR-SELECTION AND DESIGN-CHECK WORKFLOW.
#def Calculation$ = EXAMPLE-FOS-001
#def Rev$ = 0
#def PreparedBy$ = EXAMPLE AUTHOR
#def PreparedOn$ = 2026-08-08
#def CheckedBy$ = NOT CHECKED
#def CheckedOn$ = --
#def ApprovedBy$ = NOT APPROVED
#def ApprovedOn$ = --

CreateHeader$
CreateTitle$
CreatePurpose$
CreateScope$

#hide
REF_PROJECT_BASIS = 1
REF_FACTOR_SOURCES = 2
CRITERION_FACTOR_SELECTION = 1
ASSUMPTION_DIMENSIONLESS_FACTORS = 1
ASSUMPTION_APPLICABLE_OPTIONS = 2
LIMITATION_WORKFLOW_EXAMPLE = 1
INPUT_MATERIAL_FACTOR = 1
INPUT_STRESS_FACTOR = 2
INPUT_GEOMETRY_FACTOR = 3
INPUT_FAILURE_FACTOR = 4
INPUT_RELIABILITY_FACTOR = 5
INPUT_DESIGN_FOS = 6
INPUT_WARNING_THRESHOLD = 7
CHECK_MINIMUM_FOS = 1
#show

BeginRevisions$
AddRevision$(0; Initial example; EXAMPLE AUTHOR; 2026-08-08)
EndRevisions$

BeginReferences$
AddReference$(REF_PROJECT_BASIS; Project design basis; Applicable engineering requirements; Project revision; Governing criteria; Confirm the project-specific acceptance requirements.)
AddReference$(REF_FACTOR_SOURCES; Engineering input sources; Material data and loading assumptions; Current project revision; Factor selection basis; Document the evidence supporting each selected factor.)
EndReferences$

"Design Basis and Assumptions

BeginDesignCriteria$
AddDesignCriterion$(CRITERION_FACTOR_SELECTION; Factor selection; Each selected factor must match a documented option and the design factor must meet or exceed the recommended minimum.; REF_PROJECT_BASIS; Governing criteria; Confirm the project-specific requirement before issue.)
EndDesignCriteria$

BeginAssumptions$
AddAssumption$(ASSUMPTION_DIMENSIONLESS_FACTORS; Methodology; The selected factors are dimensionless.; The factor method combines categorical multipliers.; REF_FACTOR_SOURCES)
AddAssumption$(ASSUMPTION_APPLICABLE_OPTIONS; Applicability; The documented factor categories and permitted values apply to the design.; Selection must be confirmed by the responsible engineer.; REF_PROJECT_BASIS)
EndAssumptions$

BeginLimitations$
AddLimitation$(LIMITATION_WORKFLOW_EXAMPLE; This example demonstrates a workflow and is not a substitute for a governing code requirement.; A passing result does not establish code compliance.; Confirm every governing project and code requirement before use.; REF_PROJECT_BASIS)
EndLimitations$

ShowReportingSummary$

"Factor Options
'#### Material knowledge:
'1.0 for directly established properties.
'1.1 for reliable published values.
'1.4 for variable or poorly established material properties.
#hide
material_options = [1.0; 1.1; 1.4]
#show
n_material = 1.1

'#### Loading and stress analysis:
'1.1 for well-defined loading and analysis.
'1.3 for expected uncertainty.
'1.7 for poorly defined loading or analysis.
#hide
stress_options = [1.1; 1.3; 1.7]
#show
n_stress = 1.3

'#### Geometry and manufacturing:
'1.0 for controlled dimensions.
'1.2 where dimensions are not closely controlled.
#hide
geometry_options = [1.0; 1.2]
#show
n_geometry = 1.2

'#### Failure analysis:
'1.1 for established simple loading models.
'1.2 for complex loading.
'1.5 where the failure model is not well established.
#hide
failure_options = [1.1; 1.2; 1.5]
#show
n_failure = 1.2

'#### Reliability:
'1.1 below 90 percent.
'1.2 from 90 through 98 percent.
'1.7 above 99 percent.
#hide
reliability_options = [1.1; 1.2; 1.7]
#show
n_reliability = 1.2

'The design factor of safety is a saved worksheet input rather than transient browser state.
FoS_design = 2.5
#hide
warning_threshold = CHK_DEFAULT_WARNING
#show

"Input Validation
#hide
fos_material_set = 9001
fos_stress_set = 9002
fos_geometry_set = 9003
fos_failure_set = 9004
fos_reliability_set = 9005

ValidationAllowedRegistry = ValidationRegistryAdd(ValidationAllowedRegistry; fos_material_set; material_options)
ValidationAllowedRegistry = ValidationRegistryAdd(ValidationAllowedRegistry; fos_stress_set; stress_options)
ValidationAllowedRegistry = ValidationRegistryAdd(ValidationAllowedRegistry; fos_geometry_set; geometry_options)
ValidationAllowedRegistry = ValidationRegistryAdd(ValidationAllowedRegistry; fos_failure_set; failure_options)
ValidationAllowedRegistry = ValidationRegistryAdd(ValidationAllowedRegistry; fos_reliability_set; reliability_options)

material_validation = ValidationAllowedSetResult(n_material; fos_material_set)
stress_validation = ValidationAllowedSetResult(n_stress; fos_stress_set)
geometry_validation = ValidationAllowedSetResult(n_geometry; fos_geometry_set)
failure_validation = ValidationAllowedSetResult(n_failure; fos_failure_set)
reliability_validation = ValidationAllowedSetResult(n_reliability; fos_reliability_set)
design_validation = ValidationPositiveResult(FoS_design)
warning_validation = ValidationRangeResult(warning_threshold; 0; 1)

#show
BeginValidationSummary$
AddValidationResult$(INPUT_MATERIAL_FACTOR; Material factor; material_validation)
AddValidationResult$(INPUT_STRESS_FACTOR; Stress factor; stress_validation)
AddValidationResult$(INPUT_GEOMETRY_FACTOR; Geometry factor; geometry_validation)
AddValidationResult$(INPUT_FAILURE_FACTOR; Failure-analysis factor; failure_validation)
AddValidationResult$(INPUT_RELIABILITY_FACTOR; Reliability factor; reliability_validation)
AddValidationResult$(INPUT_DESIGN_FOS; Design factor of safety; design_validation)
AddValidationResult$(INPUT_WARNING_THRESHOLD; Warning threshold; warning_validation)
EndValidationResults$
ShowValidationIssues$

#hide
input_validation = ValidationResultRegistrySummaryStatus(InputValidationRegistry; InputValidationRegistryErrors)
inputs_valid = ValidationResultRegistryInputsValid(InputValidationRegistry; InputValidationRegistryErrors)
#show

"Calculation
FoS_required = n_material*n_stress*n_geometry*n_failure*n_reliability

"Engineering Checks

BeginCheckRegistry$
AddLowerCheck$(CHECK_MINIMUM_FOS; Minimum factor of safety; FoS_required; FoS_design; warning_threshold; Design FoS ≥ required FoS; inputs_valid)
EndCheckRegistryWithSummary$
ShowCheckIssues$

#hide
overall_check_status = CheckResultRegistrySummaryStatus(EngineeringCheckRegistry; EngineeringCheckRegistryErrors)
calculation_status = CalculationStatusFromRegistries(InputValidationRegistry; InputValidationRegistryErrors; EngineeringCheckRegistry; EngineeringCheckRegistryErrors)
#show

ShowCalculationStatusFromRegistries$

BeginConclusions$
#novar
AddConclusion$(Recommended minimum factor of safety; FoS_required)
AddConclusion$(Design factor of safety; FoS_design)
AddConclusion$(Governing utilization; CheckResultRegistryGoverningUtilization(EngineeringCheckRegistry))
AddCalculationStatusConclusion$(Document calculation status; calculation_status)
AddValidationConclusion$(Input validation status; input_validation)
AddCheckConclusion$(Design check status; overall_check_status)
EndConclusions$
#equ
