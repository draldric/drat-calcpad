'</td></tr>
'<tr><td>R290 or propane</td><td>'r290_density'</td><td>'r290_Cp'</td><td>
ThermoPropsStatus$(r290_status)
'</td></tr>
'<tr><td>R600a or isobutane</td><td>'r600a_density'</td><td>'r600a_Cp'</td><td>
ThermoPropsStatus$(r600a_status)
'</td></tr>
'<tr><td>R717 or ammonia</td><td>'r717_density'</td><td>'r717_Cp'</td><td>
ThermoPropsStatus$(r717_status)
'</td></tr>
'<tr><td>Pure propylene glycol</td><td>'pure_pg_density'</td><td>'pure_pg_Cp'</td><td>
ThermoPropsStatus$(pure_pg_status)
'</td></tr>
'</tbody>
'</table>
#equ

"Aqueous Glycol Mixture Comparison
#hide
p_mix = 101.325kPa
T_mix = 40°C
T_mix_K = (T_mix/°C + 273.15)*K
x_mix = 0.30
meg_mix_status = PropsSIIncompressibleStatus(CP_D; CP_P; p_mix; CP_T; T_mix_K; GLYCOL_ETHYLENE; x_mix)
mpg_mix_status = PropsSIIncompressibleStatus(CP_D; CP_P; p_mix; CP_T; T_mix_K; GLYCOL_PROPYLENE; x_mix)
meg_mix_density = PropsSIIncompressible(CP_D; CP_P; p_mix; CP_T; T_mix_K; GLYCOL_ETHYLENE; x_mix)
mpg_mix_density = PropsSIIncompressible(CP_D; CP_P; p_mix; CP_T; T_mix_K; GLYCOL_PROPYLENE; x_mix)
meg_mix_Cp = PropsSIIncompressible(CP_C; CP_P; p_mix; CP_T; T_mix_K; GLYCOL_ETHYLENE; x_mix)
mpg_mix_Cp = PropsSIIncompressible(CP_C; CP_P; p_mix; CP_T; T_mix_K; GLYCOL_PROPYLENE; x_mix)
meg_mix_viscosity = PropsSIIncompressible(CP_V; CP_P; p_mix; CP_T; T_mix_K; GLYCOL_ETHYLENE; x_mix)
mpg_mix_viscosity = PropsSIIncompressible(CP_V; CP_P; p_mix; CP_T; T_mix_K; GLYCOL_PROPYLENE; x_mix)
meg_mix_conductivity = PropsSIIncompressible(CP_L; CP_P; p_mix; CP_T; T_mix_K; GLYCOL_ETHYLENE; x_mix)
mpg_mix_conductivity = PropsSIIncompressible(CP_L; CP_P; p_mix; CP_T; T_mix_K; GLYCOL_PROPYLENE; x_mix)
meg_freeze = (GlycolFreezeK(GLYCOL_ETHYLENE; x_mix) - 273.15)*°C
mpg_freeze = (GlycolFreezeK(GLYCOL_PROPYLENE; x_mix) - 273.15)*°C
meg_density_scalar = PropsSIIncompressibleScalar(CP_D; CP_P; p_mix/Pa; CP_T; T_mix_K/K; GLYCOL_ETHYLENE; x_mix)
#show

#novar
'<table class="bordered data" style="width:95%">
'<thead><tr><th>State or property</th><th>30 percent MEG</th><th>30 percent MPG</th></tr></thead>
'<tbody>
'<tr><td>Pressure input</td><td>'p_mix'</td><td>'p_mix'</td></tr>
'<tr><td>Temperature input</td><td>'T_mix_K'</td><td>'T_mix_K'</td></tr>
'<tr><td>Mass fraction</td><td>'x_mix'</td><td>'x_mix'</td></tr>
'<tr><td>Status</td><td>
GlycolStatus$(meg_mix_status)
'</td><td>
GlycolStatus$(mpg_mix_status)
'</td></tr>
'<tr><td>Density</td><td>'meg_mix_density'</td><td>'mpg_mix_density'</td></tr>
'<tr><td>Specific heat</td><td>'meg_mix_Cp'</td><td>'mpg_mix_Cp'</td></tr>
'<tr><td>Dynamic viscosity</td><td>'meg_mix_viscosity'</td><td>'mpg_mix_viscosity'</td></tr>
'<tr><td>Thermal conductivity</td><td>'meg_mix_conductivity'</td><td>'mpg_mix_conductivity'</td></tr>
'<tr><td>Correlation freezing limit</td><td>'meg_freeze'</td><td>'mpg_freeze'</td></tr>
'<tr><td>MEG raw SI density example</td><td>'meg_density_scalar'</td><td>Not queried</td></tr>
'</tbody>
'</table>
#equ

"Glycol Temperature Trends

'The chart evaluates both mixture families directly from their equations at 30 percent glycol by mass. Density uses the primary axis and dynamic viscosity uses the secondary axis.

#hide
DemoMEGDensity(T_C) = EgWaterDensityTX(T_C*°C; x_mix)/(kg/m^3)
DemoMPGDensity(T_C) = PgWaterDensityTX(T_C*°C; x_mix)/(kg/m^3)
DemoMEGViscosity(T_C) = EgWaterDynamicViscosityTX(T_C*°C; x_mix)/(mPa*s)
DemoMPGViscosity(T_C) = PgWaterDynamicViscosityTX(T_C*°C; x_mix)/(mPa*s)
#show
sampleData$(T_meg_density; y_meg_density; DemoMEGDensity; 0; 90; 46)
sampleData$(T_mpg_density; y_mpg_density; DemoMPGDensity; 0; 90; 46)
sampleData$(T_meg_viscosity; y_meg_viscosity; DemoMEGViscosity; 0; 90; 46)
sampleData$(T_mpg_viscosity; y_mpg_viscosity; DemoMPGViscosity; 0; 90; 46)

#md off
figure$(glycolPropertyPlot)
figureSize$(glycolPropertyPlot; 900; 500)
plot$(glycolPropertyPlot; T_meg_density; y_meg_density; #337ab7; MEG density)
plot$(glycolPropertyPlot; T_mpg_density; y_mpg_density; #d9534f; MPG density)
plotY2$(glycolPropertyPlot; T_meg_viscosity; y_meg_viscosity; #5cb85c; MEG viscosity)
plotY2$(glycolPropertyPlot; T_mpg_viscosity; y_mpg_viscosity; #8a6d3b; MPG viscosity)
y2Axis$(glycolPropertyPlot; Dynamic viscosity (mPa s))
hoverUnified$(glycolPropertyPlot)
render$(glycolPropertyPlot; 30 Percent Aqueous Glycol Properties; Temperature (deg C); Density (kg per m3))
#md on

"Status and Guard Demonstration
#hide
bad_pair_status = PropsSIStatus(CP_D; CP_P; 100kPa; CP_P; 200kPa; THERMO_NITROGEN)
saturation_status = ThermoPropsStatus(THERMO_OUT_DENSITY; THERMO_IN_PRESSURE; p_sat_500; THERMO_IN_TEMPERATURE; 500K; THERMO_WATER)
region3_status = ThermoPropsStatus(THERMO_OUT_DENSITY; THERMO_IN_PRESSURE; 25MPa; THERMO_IN_TEMPERATURE; 650K; THERMO_WATER)
frozen_glycol_status = PropsSIIncompressibleStatus(CP_D; CP_P; 101.325kPa; CP_T; 243.15K; GLYCOL_PROPYLENE; 0.30)
high_concentration_status = GlycolPROPStatus(GLYCOL_ETHYLENE; THERMO_P_DENSITY; 20°C; 0.70)
#show

#novar
'<table class="bordered data" style="width:95%">
'<thead><tr><th>Guarded request</th><th>Status code</th><th>Rendered interpretation</th></tr></thead>
'<tbody>
'<tr><td>Duplicate pressure inputs</td><td>'bad_pair_status'</td><td>
ThermoPropsStatus$(bad_pair_status)
'</td></tr>
'<tr><td>State on the IF97 saturation boundary</td><td>'saturation_status'</td><td>
ThermoPropsStatus$(saturation_status)
'</td></tr>
'<tr><td>IF97 Region 3 state</td><td>'region3_status'</td><td>
ThermoPropsStatus$(region3_status)
'</td></tr>
'<tr><td>Frozen 30 percent MPG request</td><td>'frozen_glycol_status'</td><td>
GlycolStatus$(frozen_glycol_status)
'</td></tr>
'<tr><td>MEG concentration above 60 percent</td><td>'high_concentration_status'</td><td>
GlycolStatus$(high_concentration_status)
'</td></tr>
'</tbody>
'</table>
#equ

