"Complete Unit-Aware PropsSI State
#hide
p_r134a = 1MPa
T_r134a = 320K
r134a_status = PropsSIStatus(CP_D; CP_P; p_r134a; CP_T; T_r134a; THERMO_R134A)
r134a_pressure = PropsSI(CP_P; CP_P; p_r134a; CP_T; T_r134a; THERMO_R134A)
r134a_temperature = PropsSI(CP_T; CP_P; p_r134a; CP_T; T_r134a; THERMO_R134A)
r134a_specific_volume = PropsSI(CP_VSPEC; CP_P; p_r134a; CP_T; T_r134a; THERMO_R134A)
r134a_density = PropsSI(CP_D; CP_P; p_r134a; CP_T; T_r134a; THERMO_R134A)
r134a_enthalpy = PropsSI(CP_H; CP_P; p_r134a; CP_T; T_r134a; THERMO_R134A)
r134a_internal_energy = PropsSI(CP_U; CP_P; p_r134a; CP_T; T_r134a; THERMO_R134A)
r134a_entropy = PropsSI(CP_S; CP_P; p_r134a; CP_T; T_r134a; THERMO_R134A)
r134a_Cp = PropsSI(CP_C; CP_P; p_r134a; CP_T; T_r134a; THERMO_R134A)
r134a_Cv = PropsSI(CP_CV; CP_P; p_r134a; CP_T; T_r134a; THERMO_R134A)
r134a_sound_speed = PropsSI(CP_A; CP_P; p_r134a; CP_T; T_r134a; THERMO_R134A)
r134a_density_macro = PropsSI$(D; P; p_r134a; T; T_r134a; R134a)
r134a_density_scalar = PropsSIScalar(CP_D; CP_P; p_r134a/Pa; CP_T; T_r134a/K; THERMO_R134A)
#show

#novar
