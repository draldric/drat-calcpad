T_n2 = 300K
p_co2 = 10MPa
T_co2 = 320K

n2_status = ThermoPropsStatus(THERMO_OUT_DENSITY; THERMO_IN_PRESSURE; p_n2; THERMO_IN_TEMPERATURE; T_n2; THERMO_NITROGEN)
n2_density = ThermoProps(THERMO_OUT_DENSITY; THERMO_IN_PRESSURE; p_n2; THERMO_IN_TEMPERATURE; T_n2; THERMO_NITROGEN)
n2_enthalpy = ThermoProps(THERMO_OUT_ENTHALPY; THERMO_IN_PRESSURE; p_n2; THERMO_IN_TEMPERATURE; T_n2; THERMO_NITROGEN)
n2_Cp = ThermoProps(THERMO_OUT_CP; THERMO_IN_PRESSURE; p_n2; THERMO_IN_TEMPERATURE; T_n2; THERMO_NITROGEN)

co2_status = ThermoPropsStatus(THERMO_OUT_DENSITY; THERMO_IN_PRESSURE; p_co2; THERMO_IN_TEMPERATURE; T_co2; THERMO_CARBON_DIOXIDE)
co2_density = ThermoProps(THERMO_OUT_DENSITY; THERMO_IN_PRESSURE; p_co2; THERMO_IN_TEMPERATURE; T_co2; THERMO_CARBON_DIOXIDE)
co2_enthalpy = ThermoProps(THERMO_OUT_ENTHALPY; THERMO_IN_PRESSURE; p_co2; THERMO_IN_TEMPERATURE; T_co2; THERMO_CARBON_DIOXIDE)
co2_Cp = ThermoProps(THERMO_OUT_CP; THERMO_IN_PRESSURE; p_co2; THERMO_IN_TEMPERATURE; T_co2; THERMO_CARBON_DIOXIDE)
co2_density_SI = PropsSI(CP_D; CP_P; p_co2; CP_T; T_co2; THERMO_CARBON_DIOXIDE)
