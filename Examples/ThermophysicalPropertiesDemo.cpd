#md on
#include ../Core/DratCore.cpd
#include ../Libraries/Thermophysical/ThermophysicalProperties.cpd

#def Organization$ = DRAT EXAMPLE ORGANIZATION
#def Client$ = DEMONSTRATION CLIENT
#def Project$ = THERMAL PROPERTY WORKFLOW DEMONSTRATION
#def Title$ = THERMOPHYSICAL CURVES AND EQUATION-BASED FLUID STATES
#def Purpose$ = DEMONSTRATE THE UNIT-AWARE PropsSI WORKFLOW ACROSS WATER STEAM PURE FLUIDS REFRIGERANTS AND AQUEOUS GLYCOL MIXTURES.
#def Scope$ = QUERY EVERY IMPLEMENTED THERMODYNAMIC OUTPUT COMPARE EQUATION-BASED FLUIDS VISUALIZE GLYCOL TRENDS AND DEMONSTRATE STATUS AND SCALAR COMPATIBILITY PATHS. PURE ETHYLENE GLYCOL REFRIGERANT MIXTURES PHASE QUALITY TRANSPORT PROPERTIES FOR PURE FLUIDS AND UNIMPLEMENTED IAPWS REGIONS ARE EXCLUDED.
#def Calculation$ = EXAMPLE-THERMO-001
#def Rev$ = 1
#def PreparedBy$ = EXAMPLE AUTHOR
#def PreparedOn$ = 2026-08-15
#def CheckedBy$ = NOT CHECKED
#def CheckedOn$ = --
#def ApprovedBy$ = NOT APPROVED
#def ApprovedOn$ = --

CreateHeader$
CreateTitle$
CreatePurpose$
CreateScope$
#hide
REF_COOLPROP_SAMPLE = 1
REF_IAPWS_IF97 = 2
REF_N2_EOS = 3
REF_CO2_EOS = 4
REF_GLYCOL_EQUATIONS = 5
REF_REFRIGERANT_EOS = 6
ASSUMPTION_SAMPLE_BASIS = 1
LIMITATION_RANGE = 1
LIMITATION_MODEL = 2
LIMITATION_IF97_SCOPE = 3
LIMITATION_HELMHOLTZ_SCOPE = 4
#show

BeginRevisions$
AddRevision$(0; Initial thermophysical-property library demonstration; EXAMPLE AUTHOR; 2026-08-15)
AddRevision$(1; Expanded unit-aware PropsSI fluid glycol status and plotting showcase; EXAMPLE AUTHOR; 2026-08-24)
EndRevisions$

BeginReferences$
AddReference$(REF_COOLPROP_SAMPLE; CoolProp thermophysical property engine; Water and INCOMP::MEG-50% sampled curves; SMath plugin build 6.4.8214.13502; 10 deg C through 95 deg C; Migration baseline captured from the source tank-heating worksheet.)
AddReference$(REF_IAPWS_IF97; International Association for the Properties of Water and Steam; Revised Release on the IAPWS Industrial Formulation 1997; R7-97 2012; Regions 1 2 and 4 plus the B23 boundary; Official coefficients and computer-program verification tables.)
AddReference$(REF_N2_EOS; Span Lemmon Jacobsen Wagner and Yokozeki; Reference equation of state for nitrogen; 2000; 63.151 K through 1000 K and up to 2200 MPa; Fundamental Helmholtz equation curated from the pinned CoolProp fluid record.)
AddReference$(REF_CO2_EOS; Span and Wagner; New equation of state for carbon dioxide; 1996; Triple point through 1100 K and up to 800 MPa; Fundamental Helmholtz equation curated from the pinned CoolProp fluid record.)
AddReference$(REF_GLYCOL_EQUATIONS; Melinder; Properties of Secondary Working Fluids for Indirect Systems; 2010; Zero through 60 percent glycol by mass; MEG and MPG equations curated from pinned CoolProp incompressible records.)
AddReference$(REF_REFRIGERANT_EOS; CoolProp contributors and cited equation authors; Default equation-of-state records for implemented pure refrigerants; CoolProp revision 5b9c32a; Validity limits differ by fluid; Complete ideal and residual Helmholtz terms are stored in repository-owned generator inputs.)
EndReferences$

"Basis and Limitations

BeginAssumptions$
AddAssumption$(ASSUMPTION_SAMPLE_BASIS; Property basis; The example concentrations are mass fractions and each query is inside its equation and liquid-phase range.; The aqueous glycol functions enforce concentration temperature and freezing limits.; REF_GLYCOL_EQUATIONS)
EndAssumptions$

BeginLimitations$
AddLimitation$(LIMITATION_RANGE; The aqueous equations cover no more than 60 percent glycol by mass.; Pure glycol requests and other out-of-range states return a fatal status and undefined property value.; Add a separately qualified pure-fluid model instead of extrapolating.; REF_GLYCOL_EQUATIONS)
AddLimitation$(LIMITATION_MODEL; The aqueous glycol equations are incompressible correlations without pressure as an input.; Phase-equilibrium and compressibility effects are unsupported.; Confirm that the selected family concentration and liquid state match the engineering application.; REF_GLYCOL_EQUATIONS)
AddLimitation$(LIMITATION_IF97_SCOPE; The IF97 backend implements only stable single-phase Regions 1 and 2.; Saturation states Region 3 Region 5 and metastable steam return explicit error statuses.; Check the state status before using a returned property in design calculations.; REF_IAPWS_IF97)
AddLimitation$(LIMITATION_HELMHOLTZ_SCOPE; The pure-fluid backends provide equation-based thermodynamic properties for pressure-temperature states.; Transport properties refrigerant mixtures and two-phase quality states are unsupported.; Check the state status and use a separate qualified correlation when viscosity or conductivity is required.; REF_REFRIGERANT_EOS)
EndLimitations$

"Dataset Summary

ShowThermoDatasetSummary$
ShowThermoSourceRecord$(THERMO_SRC_COOLPROP_SMATH)
ShowThermoSourceRecord$(THERMO_SRC_IAPWS_IF97)
ShowThermoSourceRecord$(THERMO_SRC_NITROGEN_EOS)
ShowThermoSourceRecord$(THERMO_SRC_CO2_EOS)

"Cataloged Sample Curves and Core Fluids

ShowThermoFluidRecord$(THERMO_WATER)
ShowThermoFluidRecord$(THERMO_EG_50)
ShowThermoFluidRecord$(THERMO_NITROGEN)
ShowThermoFluidRecord$(THERMO_CARBON_DIOXIDE)

"Property Query
#hide
T_query = 60°C
x_pg = 0.30
m_dot = 2kg/s
Delta_T = 15K

rho_eg = Eg50DensityT(T_query)
Cp_eg = Eg50SpecificHeatT(T_query)
mu_eg = Eg50DynamicViscosityT(T_query)
k_eg = Eg50ThermalConductivityT(T_query)
rho_pg = PgWaterDensityTX(T_query; x_pg)
Cp_pg = PgWaterSpecificHeatTX(T_query; x_pg)
pg_status = GlycolPROPStatus(GLYCOL_PROPYLENE; THERMO_P_DENSITY; T_query; x_pg)
P_sat = WaterSaturationPressureT(T_query)
h_fg = WaterLatentHeatT(T_query)

rho_status = Eg50DensityTStatus(T_query)
Cp_status = Eg50SpecificHeatTStatus(T_query)
Q_capacity = m_dot*Cp_eg*Delta_T
#show

#novar
'<table class="bordered data" style="width:95%">
'<thead><tr><th>Quantity</th><th>Value</th><th>Status</th></tr></thead>
'<tbody>
'<tr><td>Query temperature</td><td>'T_query'</td><td>Input</td></tr>
'<tr><td>50 percent aqueous ethylene glycol density</td><td>'rho_eg'</td><td>
DBStatus$(rho_status)
'</td></tr>
'<tr><td>50 percent aqueous ethylene glycol specific heat</td><td>'Cp_eg'</td><td>
DBStatus$(Cp_status)
'</td></tr>
'<tr><td>50 percent aqueous ethylene glycol dynamic viscosity</td><td>'mu_eg'</td><td>Equation based</td></tr>
'<tr><td>50 percent aqueous ethylene glycol thermal conductivity</td><td>'k_eg'</td><td>Equation based</td></tr>
'<tr><td>30 percent propylene glycol density</td><td>'rho_pg'</td><td>
GlycolStatus$(pg_status)
'</td></tr>
'<tr><td>30 percent propylene glycol specific heat</td><td>'Cp_pg'</td><td>Equation based</td></tr>
'<tr><td>Water saturation pressure</td><td>'P_sat'</td><td>Sampled water curve</td></tr>
'<tr><td>Water latent heat</td><td>'h_fg'</td><td>Sampled water curve</td></tr>
'<tr><td>Heat-capacity rate for the example stream</td><td>'Q_capacity'</td><td>Derived from the returned specific heat</td></tr>
'</tbody>
'</table>
#equ

"Glycol Equation Provenance

'GlycolEquationCitation$
'GlycolEquationRevision$

"IAPWS-IF97 Water and Steam States
#hide
p_liquid = 3MPa
T_liquid = 500K
p_steam = 0.1MPa
T_steam = 500K

liquid_region = If97RegionPT(p_liquid; T_liquid)
liquid_status = ThermoPropsStatus(THERMO_OUT_ENTHALPY; THERMO_IN_PRESSURE; p_liquid; THERMO_IN_TEMPERATURE; T_liquid; THERMO_WATER)
liquid_density = ThermoProps(THERMO_OUT_DENSITY; THERMO_IN_PRESSURE; p_liquid; THERMO_IN_TEMPERATURE; T_liquid; THERMO_WATER)
liquid_specific_volume = ThermoProps(THERMO_OUT_SPECIFIC_VOLUME; THERMO_IN_PRESSURE; p_liquid; THERMO_IN_TEMPERATURE; T_liquid; THERMO_WATER)
liquid_enthalpy = ThermoProps(THERMO_OUT_ENTHALPY; THERMO_IN_PRESSURE; p_liquid; THERMO_IN_TEMPERATURE; T_liquid; THERMO_WATER)
liquid_internal_energy = ThermoProps(THERMO_OUT_INTERNAL_ENERGY; THERMO_IN_PRESSURE; p_liquid; THERMO_IN_TEMPERATURE; T_liquid; THERMO_WATER)
liquid_entropy = ThermoProps(THERMO_OUT_ENTROPY; THERMO_IN_PRESSURE; p_liquid; THERMO_IN_TEMPERATURE; T_liquid; THERMO_WATER)
liquid_Cp = ThermoProps(THERMO_OUT_CP; THERMO_IN_PRESSURE; p_liquid; THERMO_IN_TEMPERATURE; T_liquid; THERMO_WATER)
liquid_Cv = ThermoProps(THERMO_OUT_CV; THERMO_IN_PRESSURE; p_liquid; THERMO_IN_TEMPERATURE; T_liquid; THERMO_WATER)
liquid_sound_speed = ThermoProps(THERMO_OUT_SOUND_SPEED; THERMO_IN_PRESSURE; p_liquid; THERMO_IN_TEMPERATURE; T_liquid; THERMO_WATER)

steam_region = If97RegionPT(p_steam; T_steam)
steam_status = ThermoPropsStatus(THERMO_OUT_ENTHALPY; THERMO_IN_TEMPERATURE; T_steam; THERMO_IN_PRESSURE; p_steam; THERMO_WATER)
steam_density = ThermoProps(THERMO_OUT_DENSITY; THERMO_IN_TEMPERATURE; T_steam; THERMO_IN_PRESSURE; p_steam; THERMO_WATER)
steam_specific_volume = ThermoProps(THERMO_OUT_SPECIFIC_VOLUME; THERMO_IN_TEMPERATURE; T_steam; THERMO_IN_PRESSURE; p_steam; THERMO_WATER)
steam_enthalpy = ThermoProps(THERMO_OUT_ENTHALPY; THERMO_IN_TEMPERATURE; T_steam; THERMO_IN_PRESSURE; p_steam; THERMO_WATER)
steam_internal_energy = ThermoProps(THERMO_OUT_INTERNAL_ENERGY; THERMO_IN_TEMPERATURE; T_steam; THERMO_IN_PRESSURE; p_steam; THERMO_WATER)
steam_entropy = ThermoProps(THERMO_OUT_ENTROPY; THERMO_IN_TEMPERATURE; T_steam; THERMO_IN_PRESSURE; p_steam; THERMO_WATER)
steam_Cp = ThermoProps(THERMO_OUT_CP; THERMO_IN_TEMPERATURE; T_steam; THERMO_IN_PRESSURE; p_steam; THERMO_WATER)
steam_Cv = ThermoProps(THERMO_OUT_CV; THERMO_IN_TEMPERATURE; T_steam; THERMO_IN_PRESSURE; p_steam; THERMO_WATER)
steam_sound_speed = ThermoProps(THERMO_OUT_SOUND_SPEED; THERMO_IN_TEMPERATURE; T_steam; THERMO_IN_PRESSURE; p_steam; THERMO_WATER)

p_sat_500 = If97SaturationPressureT(500K)
T_sat_1MPa = If97SaturationTemperatureP(1MPa)
#show

#novar
'<table class="bordered data" style="width:95%">
