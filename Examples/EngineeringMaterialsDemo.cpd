#include ../Core/DratCore.cpd
#include ../Libraries/Materials/EngineeringMaterials.cpd

"Common Engineering Materials Library Demonstration

'Representative screening values only. Verify project-specific design data.

"Dataset Discovery

ShowMatDatasetSummary$

"Supported Property Coverage

ShowMatProperties$

"Glass Materials

ShowMatCategory$(MAT_CAT_GLASS)

"Material Selection and Ranking

#hide
required_steel_properties = [MAT_P_DENSITY; MAT_P_YOUNGS_MODULUS; MAT_P_YIELD_STRENGTH; MAT_P_TENSILE_STRENGTH]
ferrous_candidates = MatCandidateItems(MAT_CAT_FERROUS_METAL; required_steel_properties)
ferrous_yield_ranking = MatRankCandidates(MAT_CAT_FERROUS_METAL; required_steel_properties; MAT_P_YIELD_STRENGTH; MAT_RANK_DESCENDING)
high_yield_ferrous = MatItemsAtLeast(MAT_CAT_FERROUS_METAL; MAT_P_YIELD_STRENGTH; 1000MPa)
comparison_items = first(MatRankedItems(ferrous_yield_ranking); 5)
comparison_properties = [MAT_P_DENSITY; MAT_P_YOUNGS_MODULUS; MAT_P_YIELD_STRENGTH; MAT_P_TENSILE_STRENGTH]
#show

ferrous_candidate_count = len(ferrous_candidates)
high_yield_candidate_count = len(high_yield_ferrous)

#novar
ShowMatRanking$(ferrous_yield_ranking; MAT_P_YIELD_STRENGTH; 10)
#equ

"Side-by-Side Candidate Comparison

#novar
ShowMatComparison$(comparison_items; comparison_properties)
#equ

"Candidate Property Plots

#novar
ShowMatPropertyComparisonPlot$(ferrousYieldComparison; comparison_items; MAT_P_YIELD_STRENGTH)
ShowMatPropertyTradeoffPlot$(ferrousDensityYieldTradeoff; comparison_items; MAT_P_DENSITY; MAT_P_YIELD_STRENGTH)
#equ

"Representative Lookups

rho_A36 = MatRho(STEEL_ASTM_A36)
E_A36 = MatE(A36)
yield_A36 = MatYield(STEEL_ASTM_A36)

rho_6061 = MatRho(AL6061_T6)
E_6061 = MatE(ALUMINUM_6061_T6)
thermal_k_6061 = MatThermalK(ALUMINUM_6061_T6)

E_PEEK = MatE(PEEK)
service_PEEK = MatMaxServiceT(POLYMER_PEEK)

ShowMatPROP$(STAINLESS_316L; MAT_P_THERMAL_CONDUCTIVITY)
ShowMatPROP$(COMPOSITE_CFRP_UD; MAT_P_YOUNGS_MODULUS)
ShowMatPROP$(CONCRETE_NORMAL_40MPA; MAT_P_COMPRESSIVE_STRENGTH)
ShowMatPROP$(ELASTOMER_EPDM; MAT_P_YIELD_STRENGTH)
