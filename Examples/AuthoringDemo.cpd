SectionIntro$(The authoring components present the calculation. The check registry remains responsible for engineering acceptance.)

BeginCheckRegistry$
AddUpperCheck$(CHECK_SELECTED_HEAT_LOSS; Selected heat-loss screening; selected_heat_loss; allowable_heat_loss; CHK_DEFAULT_WARNING; Selected heat loss must not exceed the illustrative criterion.; inputs_valid)
EndCheckRegistryWithSummary$

#hide
overall_check_status = CheckResultRegistrySummaryStatus(EngineeringCheckRegistry; EngineeringCheckRegistryErrors)
#show

H3$(Conclusions)
BeginConclusions$
AddConclusion$(Selected insulation; 50 mm)
AddConclusion$(Selected heat loss; selected_heat_loss)
AddCheckConclusion$(Screening status; overall_check_status)
EndConclusions$

EmptyState$(No additional alternatives were evaluated in this focused demonstration.)