{
  "schema_version": 2,
  "library": {
    "name": "DRAT Thermophysical Properties Library",
    "revision": "0.6.0",
    "date": "2026-08-24",
    "scope": "Equation-based density, specific heat, dynamic viscosity, thermal conductivity, and freezing limits for aqueous ethylene-glycol and propylene-glycol mixtures from zero to 60 percent glycol by mass; IAPWS-IF97 equations for stable single-phase water and steam in Regions 1 and 2; and fundamental Helmholtz equations for pure nitrogen, carbon dioxide, R11, R12, R13, R134a, R32, R1234yf, R290, R600a, R717, and propylene glycol pressure-temperature states. Pure ethylene glycol, pure-fluid transport properties, mixtures including R401A, two-phase quality calculations, IF97 Region 3, IF97 Region 5, and metastable steam are not implemented."
  },
