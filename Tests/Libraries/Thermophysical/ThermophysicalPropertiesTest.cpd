catalog_tests = and(ThermoDatasetStatus ≡ DB_OK; ThermoFluidCount ≡ 14; ThermoPropertyCount ≡ 6; ThermoCurveCount ≡ 7; ThermoPointCount ≡ 126; ThermoHasFluid(THERMO_WATER); ThermoHasFluid(THERMO_EG_50); ThermoHasFluid(THERMO_NITROGEN); ThermoHasFluid(THERMO_CARBON_DIOXIDE); ThermoHasFluid(THERMO_R11); ThermoHasFluid(THERMO_R12); ThermoHasFluid(THERMO_R13); ThermoHasFluid(THERMO_R134A); ThermoHasFluid(THERMO_R32); ThermoHasFluid(THERMO_R1234YF); ThermoHasFluid(THERMO_R290); ThermoHasFluid(THERMO_R600A); ThermoHasFluid(THERMO_R717); ThermoHasFluid(THERMO_PROPYLENE_GLYCOL); ThermoHasProperty(THERMO_P_DENSITY); ThermoHasSource(THERMO_SRC_COOLPROP_SMATH); ThermoHasSource(THERMO_SRC_IAPWS_IF97); ThermoHasSource(THERMO_SRC_NITROGEN_EOS); ThermoHasSource(THERMO_SRC_CO2_EOS); ThermoHasSource(THERMO_SRC_R717_EOS); ThermoHasSource(THERMO_SRC_PROPYLENE_GLYCOL_EOS); If97DatasetOK; If97PropertyCount ≡ 8; If97ImplementedRegionCount ≡ 2; HelmholtzDatasetOK; HelmholtzFluidCount ≡ 12; GlycolDatasetOK; GlycolFamilyCount ≡ 2)
alias_tests = and(THERMO_P_CP ≡ THERMO_P_SPECIFIC_HEAT; THERMO_P_VISCOSITY ≡ THERMO_P_DYNAMIC_VISCOSITY; THERMO_P_CONDUCTIVITY ≡ THERMO_P_THERMAL_CONDUCTIVITY; THERMO_R744 ≡ THERMO_CARBON_DIOXIDE; THERMO_PROPANE ≡ THERMO_R290; THERMO_ISOBUTANE ≡ THERMO_R600A; THERMO_AMMONIA ≡ THERMO_R717)
value_tests = and(abs(water_cp_25/(J/(kg*K)) - 4181.314991) < 0.000001; abs(water_pressure_37_5/kPa - 6.50697707) < 0.000001; abs(water_latent_heat_60/(kJ/kg) - 2357.65452) < 0.000001; abs(eg_density_60/(kg/m^3) - 1040.4899931631571) < 0.000001; abs(eg_cp_60/(J/(kg*K)) - 3503.1484638024453) < 0.000001; abs(eg_viscosity_60/(Pa*s) - 0.0013749186235782736) < 0.000000000001; abs(eg_conductivity_60/(W/(m*K)) - 0.4137864278027444) < 0.000000001; abs(pg30_density_40/(kg/m^3) - 1013.4322561509518) < 0.000001; abs(pg30_cp_40/(J/(kg*K)) - 3910.4194060926284) < 0.000001; abs(pg30_viscosity_40/(Pa*s) - 0.0015731257838686608) < 0.000000000001; abs(pg30_conductivity_40/(W/(m*K)) - 0.460564837945612) < 0.000000001)
status_tests = and(WaterSpecificHeatTStatus(25°C) ≡ DB_OK; WaterSpecificHeatTStatus(5°C) ≡ DB_ERR_BELOW_RANGE; Eg50DensityTStatus(100°C) ≡ DB_OK; Eg50DensityTStatus(101°C) ≡ DB_ERR_ABOVE_RANGE; GlycolPROPStatus(GLYCOL_ETHYLENE; THERMO_P_DENSITY; 20°C; 0.61) ≡ GLYCOL_ERR_CONCENTRATION_HIGH; GlycolPROPStatus(GLYCOL_PROPYLENE; THERMO_P_DENSITY; -20°C; 0.3) ≡ GLYCOL_ERR_FROZEN; ThermoPROPStatus(THERMO_WATER; THERMO_P_DENSITY; 25°C; DB_LINEAR; DB_STRICT) ≡ DB_ERR_MISSING; ThermoPROPStatus(999; THERMO_P_SPECIFIC_HEAT; 25°C; DB_LINEAR; DB_STRICT) ≡ DB_ERR_NAME; ThermoPROPStatus(THERMO_WATER; 999; 25°C; DB_LINEAR; DB_STRICT) ≡ DB_ERR_PROPERTY; ThermoPROPStatus(THERMO_WATER; THERMO_P_SPECIFIC_HEAT; 25°C; 999; DB_STRICT) ≡ DB_ERR_BAD_METHOD; ThermoPROPStatus(THERMO_WATER; THERMO_P_SPECIFIC_HEAT; 25°C; DB_LINEAR; 999) ≡ DB_ERR_BAD_POLICY)
bounds_tests = and(ThermoPROPStatus(THERMO_EG_50; THERMO_P_DENSITY; 110°C; DB_LINEAR; DB_CLAMP) ≡ DB_WARN_CLAMP_HIGH; abs(ThermoPROPClamped(THERMO_EG_50; THERMO_P_DENSITY; 110°C)/(kg/m^3) - 1011.5200842319194) < 0.000001)
metadata_tests = and(ThermoTMin(THERMO_WATER; THERMO_P_SPECIFIC_HEAT) ≡ 10°C; ThermoTMax(THERMO_WATER; THERMO_P_SPECIFIC_HEAT) ≡ 95°C; ThermoSourceID(THERMO_WATER; THERMO_P_SPECIFIC_HEAT) ≡ THERMO_SRC_COOLPROP_SMATH; ThermoDataRevision(THERMO_EG_50; THERMO_P_DENSITY) ≡ 1; ThermoFluidConcentrationMassFraction(THERMO_EG_50) ≡ 0.5; DBIsMissing(ThermoFluidConcentrationMassFraction(THERMO_WATER)))
