#include ../../../Core/DratCore.cpd
#include ../../../Libraries/Thermophysical/ThermophysicalProperties.cpd

'<!-- TEST PURPOSE: Verify generated thermophysical curves plus IAPWS-IF97 Regions 1 and 2 against the official release verification tables. -->

water_cp_25 = WaterSpecificHeatT(25°C)
water_pressure_37_5 = WaterSaturationPressureT(37.5°C)
water_latent_heat_60 = WaterLatentHeatT(60°C)
eg_density_60 = Eg50DensityT(60°C)
eg_cp_60 = Eg50SpecificHeatT(60°C)
eg_viscosity_60 = Eg50DynamicViscosityT(60°C)
eg_conductivity_60 = Eg50ThermalConductivityT(60°C)

catalog_tests = and(ThermoDatasetStatus ≡ DB_OK; ThermoFluidCount ≡ 2; ThermoPropertyCount ≡ 6; ThermoCurveCount ≡ 7; ThermoPointCount ≡ 126; ThermoHasFluid(THERMO_WATER); ThermoHasFluid(THERMO_EG_50); ThermoHasProperty(THERMO_P_DENSITY); ThermoHasSource(THERMO_SRC_COOLPROP_SMATH); ThermoHasSource(THERMO_SRC_IAPWS_IF97); If97DatasetOK; If97PropertyCount ≡ 8; If97ImplementedRegionCount ≡ 2)
alias_tests = and(THERMO_P_CP ≡ THERMO_P_SPECIFIC_HEAT; THERMO_P_VISCOSITY ≡ THERMO_P_DYNAMIC_VISCOSITY; THERMO_P_CONDUCTIVITY ≡ THERMO_P_THERMAL_CONDUCTIVITY)
value_tests = and(abs(water_cp_25/(J/(kg*K)) - 4181.314991) < 0.000001; abs(water_pressure_37_5/kPa - 6.50697707) < 0.000001; abs(water_latent_heat_60/(kJ/kg) - 2357.65452) < 0.000001; abs(eg_density_60/(kg/m^3) - 1040.489993) < 0.000001; abs(eg_cp_60/(J/(kg*K)) - 3503.148464) < 0.000001; abs(eg_viscosity_60/(Pa*s) - 0.001374918624) < 0.000000000001; abs(eg_conductivity_60/(W/(m*K)) - 0.413786428) < 0.000000001)
status_tests = and(WaterSpecificHeatTStatus(25°C) ≡ DB_OK; WaterSpecificHeatTStatus(5°C) ≡ DB_ERR_BELOW_RANGE; Eg50DensityTStatus(100°C) ≡ DB_ERR_ABOVE_RANGE; ThermoPROPStatus(THERMO_WATER; THERMO_P_DENSITY; 25°C; DB_LINEAR; DB_STRICT) ≡ DB_ERR_MISSING; ThermoPROPStatus(999; THERMO_P_SPECIFIC_HEAT; 25°C; DB_LINEAR; DB_STRICT) ≡ DB_ERR_NAME; ThermoPROPStatus(THERMO_WATER; 999; 25°C; DB_LINEAR; DB_STRICT) ≡ DB_ERR_PROPERTY; ThermoPROPStatus(THERMO_WATER; THERMO_P_SPECIFIC_HEAT; 25°C; 999; DB_STRICT) ≡ DB_ERR_BAD_METHOD; ThermoPROPStatus(THERMO_WATER; THERMO_P_SPECIFIC_HEAT; 25°C; DB_LINEAR; 999) ≡ DB_ERR_BAD_POLICY)
bounds_tests = and(ThermoPROPStatus(THERMO_EG_50; THERMO_P_DENSITY; 100°C; DB_LINEAR; DB_CLAMP) ≡ DB_WARN_CLAMP_HIGH; abs(ThermoPROPClamped(THERMO_EG_50; THERMO_P_DENSITY; 100°C)/(kg/m^3) - 1015.298872) < 0.000001)
metadata_tests = and(ThermoTMin(THERMO_WATER; THERMO_P_SPECIFIC_HEAT) ≡ 10°C; ThermoTMax(THERMO_WATER; THERMO_P_SPECIFIC_HEAT) ≡ 95°C; ThermoSourceID(THERMO_WATER; THERMO_P_SPECIFIC_HEAT) ≡ THERMO_SRC_COOLPROP_SMATH; ThermoDataRevision(THERMO_EG_50; THERMO_P_DENSITY) ≡ 1; ThermoFluidConcentrationMassFraction(THERMO_EG_50) ≡ 0.5; DBIsMissing(ThermoFluidConcentrationMassFraction(THERMO_WATER)))
undefined_tests = and(not(ValidationIsFinite(ThermoPROP(THERMO_WATER; THERMO_P_DENSITY; 25°C))); not(ValidationIsFinite(Eg50DensityT(100°C))))

if97_r1_point1_tests = and(abs(If97SpecificVolumePT(3MPa; 300K)/(m^3/kg) - 0.100215168*10^-2) < 10^-11; abs(If97EnthalpyPT(3MPa; 300K)/(kJ/kg) - 0.115331273*10^3) < 10^-5; abs(If97InternalEnergyPT(3MPa; 300K)/(kJ/kg) - 0.112324818*10^3) < 10^-5; abs(If97EntropyPT(3MPa; 300K)/(kJ/(kg*K)) - 0.392294792) < 10^-8; abs(If97CpPT(3MPa; 300K)/(kJ/(kg*K)) - 0.417301218*10^1) < 10^-7; abs(If97SoundSpeedPT(3MPa; 300K)/(m/s) - 0.150773921*10^4) < 10^-4)
if97_r1_point2_tests = and(abs(If97SpecificVolumePT(80MPa; 300K)/(m^3/kg) - 0.971180894*10^-3) < 10^-11; abs(If97EnthalpyPT(80MPa; 300K)/(kJ/kg) - 0.184142828*10^3) < 10^-5; abs(If97CpPT(80MPa; 300K)/(kJ/(kg*K)) - 0.401008987*10^1) < 10^-7; abs(If97SoundSpeedPT(80MPa; 300K)/(m/s) - 0.163469054*10^4) < 10^-4)
if97_r1_point3_tests = and(abs(If97SpecificVolumePT(3MPa; 500K)/(m^3/kg) - 0.120241800*10^-2) < 10^-11; abs(If97EnthalpyPT(3MPa; 500K)/(kJ/kg) - 0.975542239*10^3) < 10^-5; abs(If97EntropyPT(3MPa; 500K)/(kJ/(kg*K)) - 0.258041912*10^1) < 10^-7; abs(If97SoundSpeedPT(3MPa; 500K)/(m/s) - 0.124071337*10^4) < 10^-4)

if97_r2_point1_tests = and(abs(If97SpecificVolumePT(0.0035MPa; 300K)/(m^3/kg) - 0.394913866*10^2) < 10^-6; abs(If97EnthalpyPT(0.0035MPa; 300K)/(kJ/kg) - 0.254991145*10^4) < 10^-4; abs(If97InternalEnergyPT(0.0035MPa; 300K)/(kJ/kg) - 0.241169160*10^4) < 10^-4; abs(If97EntropyPT(0.0035MPa; 300K)/(kJ/(kg*K)) - 0.852238967*10^1) < 10^-7; abs(If97CpPT(0.0035MPa; 300K)/(kJ/(kg*K)) - 0.191300162*10^1) < 10^-7; abs(If97SoundSpeedPT(0.0035MPa; 300K)/(m/s) - 0.427920172*10^3) < 10^-4)
if97_r2_point2_tests = and(abs(If97SpecificVolumePT(0.0035MPa; 700K)/(m^3/kg) - 0.923015898*10^2) < 10^-6; abs(If97EnthalpyPT(0.0035MPa; 700K)/(kJ/kg) - 0.333568375*10^4) < 10^-4; abs(If97EntropyPT(0.0035MPa; 700K)/(kJ/(kg*K)) - 0.101749996*10^2) < 10^-6; abs(If97SoundSpeedPT(0.0035MPa; 700K)/(m/s) - 0.644289068*10^3) < 10^-4)
if97_r2_point3_tests = and(abs(If97SpecificVolumePT(30MPa; 700K)/(m^3/kg) - 0.542946619*10^-2) < 10^-10; abs(If97EnthalpyPT(30MPa; 700K)/(kJ/kg) - 0.263149474*10^4) < 10^-4; abs(If97CpPT(30MPa; 700K)/(kJ/(kg*K)) - 0.103505092*10^2) < 10^-6; abs(If97SoundSpeedPT(30MPa; 700K)/(m/s) - 0.480386523*10^3) < 10^-4)

if97_saturation_tests = and(abs(If97SaturationPressureT(300K)/MPa - 0.353658941*10^-2) < 10^-10; abs(If97SaturationPressureT(500K)/MPa - 0.263889776*10^1) < 10^-7; abs(If97SaturationPressureT(600K)/MPa - 0.123443146*10^2) < 10^-6; abs(If97SaturationTemperatureP(0.1MPa)/K - 0.372755919*10^3) < 10^-5; abs(If97SaturationTemperatureP(1MPa)/K - 0.453035632*10^3) < 10^-5; abs(If97SaturationTemperatureP(10MPa)/K - 0.584149488*10^3) < 10^-5)
if97_boundary_tests = abs(If97Boundary23PressureT(623.15K)/MPa - 0.165291643*10^2) < 10^-6
if97_region_tests = and(If97RegionPT(3MPa; 300K) ≡ IF97_REGION_1; If97RegionPT(0.0035MPa; 300K) ≡ IF97_REGION_2; If97RegionPT(30MPa; 700K) ≡ IF97_REGION_2; If97RegionPTStatus(50MPa; 700K) ≡ IF97_ERR_UNSUPPORTED_REGION; If97RegionPTStatus(If97SaturationPressureT(500K); 500K) ≡ IF97_ERR_TWO_PHASE; If97RegionPTStatus(0MPa; 500K) ≡ IF97_ERR_PRESSURE_LOW; If97RegionPTStatus(101MPa; 500K) ≡ IF97_ERR_PRESSURE_HIGH; If97RegionPTStatus(1MPa; 270K) ≡ IF97_ERR_TEMPERATURE_LOW; If97RegionPTStatus(1MPa; 1100K) ≡ IF97_ERR_TEMPERATURE_HIGH; If97PROPPTStatus(999; 3MPa; 300K) ≡ IF97_ERR_PROPERTY)
if97_derived_tests = and(abs(If97DensityPT(3MPa; 300K)/(kg/m^3) - 1/(If97SpecificVolumePT(3MPa; 300K)/(m^3/kg))) < 10^-8; If97CvPT(3MPa; 300K) > 0kJ/(kg*K); If97CvPT(0.0035MPa; 700K) > 0kJ/(kg*K); not(ValidationIsFinite(If97EnthalpyPT(50MPa; 700K))))
thermo_props_tests = and(abs(ThermoProps(THERMO_OUT_ENTHALPY; THERMO_IN_PRESSURE; 3MPa; THERMO_IN_TEMPERATURE; 300K; THERMO_WATER)/(kJ/kg) - 0.115331273*10^3) < 10^-5; abs(ThermoProps(THERMO_OUT_ENTHALPY; THERMO_IN_TEMPERATURE; 300K; THERMO_IN_PRESSURE; 3MPa; THERMO_WATER)/(kJ/kg) - 0.115331273*10^3) < 10^-5; ThermoPropsStatus(THERMO_OUT_DENSITY; THERMO_IN_PRESSURE; 3MPa; THERMO_IN_TEMPERATURE; 300K; THERMO_WATER) ≡ THERMO_PROPS_OK; ThermoPropsStatus(999; THERMO_IN_PRESSURE; 3MPa; THERMO_IN_TEMPERATURE; 300K; THERMO_WATER) ≡ THERMO_PROPS_ERR_OUTPUT; ThermoPropsStatus(THERMO_OUT_DENSITY; 999; 3MPa; THERMO_IN_TEMPERATURE; 300K; THERMO_WATER) ≡ THERMO_PROPS_ERR_INPUT; ThermoPropsStatus(THERMO_OUT_DENSITY; THERMO_IN_PRESSURE; 3MPa; THERMO_IN_PRESSURE; 4MPa; THERMO_WATER) ≡ THERMO_PROPS_ERR_INPUT_PAIR; ThermoPropsStatus(THERMO_OUT_DENSITY; THERMO_IN_PRESSURE; 3MPa; THERMO_IN_TEMPERATURE; 300K; THERMO_EG_50) ≡ THERMO_PROPS_ERR_FLUID; ThermoPropsStatus(THERMO_OUT_DENSITY; THERMO_IN_PRESSURE; 50MPa; THERMO_IN_TEMPERATURE; 700K; THERMO_WATER) ≡ IF97_ERR_UNSUPPORTED_REGION; not(ValidationIsFinite(ThermoProps(THERMO_OUT_DENSITY; THERMO_IN_PRESSURE; 3MPa; THERMO_IN_TEMPERATURE; 300K; THERMO_EG_50))))

all_tests = and(catalog_tests; alias_tests; value_tests; status_tests; bounds_tests; metadata_tests; undefined_tests; if97_r1_point1_tests; if97_r1_point2_tests; if97_r1_point3_tests; if97_r2_point1_tests; if97_r2_point2_tests; if97_r2_point3_tests; if97_saturation_tests; if97_boundary_tests; if97_region_tests; if97_derived_tests; thermo_props_tests)

ShowThermoDatasetSummary$
ShowThermoFluidRecord$(THERMO_EG_50)
ShowThermoProperty$(THERMO_WATER; THERMO_P_SATURATION_PRESSURE; 60°C)
