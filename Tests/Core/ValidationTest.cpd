"Validation Core Test

#include ../../Core/DratCore.cpd

'<!-- TEST PURPOSE: Verify scalar, vector, matrix, set, registry, and unit-aware input-validation behavior. -->

range_ok = ValidationRangeStatus(5; 0; 10)
range_below = ValidationRangeStatus(-1; 0; 10)
range_above = ValidationRangeStatus(11; 0; 10)
range_bad = ValidationRangeStatus(5; 10; 0)
range_missing = ValidationRangeStatus(DB_MISSING; 0; 10)

positive_ok = ValidationPositiveStatus(1)
positive_zero = ValidationPositiveStatus(0)
nonnegative_zero = ValidationNonnegativeStatus(0)
nonnegative_bad = ValidationNonnegativeStatus(-1)
unit_positive = ValidationPositiveStatus(5m)
unit_nonnegative = ValidationNonnegativeStatus(0m)
unit_range = ValidationRangeStatus(5m; 1m; 10m)

defined_ok = ValidationDefinedStatus(5kN)
defined_bad = ValidationDefinedStatus(DB_MISSING)
negative_ok = ValidationNegativeStatus(-1)
negative_bad = ValidationNegativeStatus(0)
nonpositive_ok = ValidationNonpositiveStatus(0)
nonpositive_bad = ValidationNonpositiveStatus(1)
nonzero_ok = ValidationNonzeroStatus(5mm; 0.1mm)
nonzero_bad = ValidationNonzeroStatus(0.05mm; 0.1mm)
zero_ok = ValidationZeroStatus(0.05mm; 0.1mm)
zero_bad = ValidationZeroStatus(0.2mm; 0.1mm)
minimum_ok = ValidationMinimumStatus(5m; 1m)
minimum_bad = ValidationMinimumStatus(0m; 1m)
maximum_ok = ValidationMaximumStatus(5m; 10m)
maximum_bad = ValidationMaximumStatus(11m; 10m)
open_range_ok = ValidationOpenRangeStatus(5; 1; 10)
open_range_bad = ValidationOpenRangeStatus(1; 1; 10)
outside_range_ok = ValidationOutsideRangeStatus(0; 1; 10)
outside_range_bad = ValidationOutsideRangeStatus(5; 1; 10)
absolute_maximum_ok = ValidationAbsoluteMaximumStatus(-5kN; 10kN)
absolute_maximum_bad = ValidationAbsoluteMaximumStatus(-11kN; 10kN)

integer_ok = ValidationIntegerStatus(3)
integer_near = ValidationIntegerStatus(3 + 1*10^-13)
integer_bad = ValidationIntegerStatus(3.1)

length_ok = ValidationLengthStatus([1; 2; 3]; 2; 4)
length_short = ValidationLengthStatus([1]; 2; 4)
length_long = ValidationLengthStatus([1; 2; 3; 4; 5]; 2; 4)

square_matrix = [1; 2|3; 4]
rectangular_matrix = [1; 2; 3|4; 5; 6]
vector_range_ok = ValidationVectorRangeStatus([1m; 2m; 3m]; 0m; 4m)
vector_range_bad = ValidationVectorRangeStatus([1m; 5m]; 0m; 4m)
vector_positive_ok = ValidationVectorPositiveStatus([1kN; 2kN])
vector_positive_bad = ValidationVectorPositiveStatus([0kN; 2kN])
vector_nonnegative_ok = ValidationVectorNonnegativeStatus([0kN; 2kN])
vector_nonnegative_bad = ValidationVectorNonnegativeStatus([-1kN; 2kN])
vector_defined_ok = ValidationVectorDefinedStatus([0kN; 2kN])
vector_defined_bad = ValidationVectorDefinedStatus([0kN; setunits(DB_MISSING; kN)])
vector_negative_ok = ValidationVectorNegativeStatus([-2kN; -1kN])
vector_negative_bad = ValidationVectorNegativeStatus([-2kN; 0kN])
vector_nonpositive_ok = ValidationVectorNonpositiveStatus([-2kN; 0kN])
vector_nonpositive_bad = ValidationVectorNonpositiveStatus([-2kN; 1kN])
increasing_ok = ValidationIncreasingStatus([1; 2; 3])
increasing_bad = ValidationIncreasingStatus([1; 1; 3])
nondecreasing_ok = ValidationNondecreasingStatus([1; 1; 3])
nondecreasing_bad = ValidationNondecreasingStatus([1; 0; 3])
unique_ok = ValidationUniqueStatus([1; 2; 3])
unique_bad = ValidationUniqueStatus([1; 2; 1])
matching_length_ok = ValidationMatchingLengthStatus([1; 2]; [3; 4])
matching_length_bad = ValidationMatchingLengthStatus([1]; [2; 3])
matrix_rows_ok = ValidationMatrixRowsStatus(square_matrix; 2; 3)
matrix_rows_bad = ValidationMatrixRowsStatus(square_matrix; 3; 4)
matrix_columns_ok = ValidationMatrixColumnsStatus(rectangular_matrix; 3; 3)
matrix_columns_bad = ValidationMatrixColumnsStatus(rectangular_matrix; 1; 2)
square_matrix_ok = ValidationSquareMatrixStatus(square_matrix)
square_matrix_bad = ValidationSquareMatrixStatus(rectangular_matrix)
exact_dimensions_ok = ValidationMatrixDimensionsResults(rectangular_matrix; 2; 3)
exact_dimensions_bad = ValidationMatrixDimensionsResults(rectangular_matrix; 3; 3)

allowed_ok = ValidationAllowedStatus(1.2; [1.0; 1.1; 1.2])
allowed_bad = ValidationAllowedStatus(1.3; [1.0; 1.1; 1.2])

test_set_id = 9001
ValidationAllowedRegistry = ValidationRegistryAdd(ValidationAllowedRegistry; test_set_id; [1.0; 1.1; 1.2])
ValidationAllowedRegistry = ValidationRegistryAdd(ValidationAllowedRegistry; test_set_id; [1.3])
registered_values = ValidationAllowedSetValues(test_set_id)

range_result = ValidationRangeResult(5m; 1m; 10m)
positive_result = ValidationPositiveResult(5kN)
nonnegative_result = ValidationNonnegativeResult(0m)
integer_result = ValidationIntegerResult(3)
length_result = ValidationLengthResult([1; 2; 3]; 2; 4)
allowed_result = ValidationAllowedSetResult(1.2; test_set_id)
allowed_result_bad = ValidationAllowedSetResult(1.5; test_set_id)
missing_set_result = ValidationAllowedSetResult(1.2; 9999)
available_result = ValidationAvailableResult(5MPa)
registered_result = ValidationRegisteredResult(101; 1)
unregistered_result = ValidationRegisteredResult(999; 0)

duplicate_set_id = 9002
ValidationAllowedRegistry = ValidationRegistryAdd(ValidationAllowedRegistry; duplicate_set_id; [2; 2])
duplicate_set_result = ValidationAllowedSetResult(2; duplicate_set_id)

stale_set_id = 9003
ValidationAllowedRegistry = ValidationRegistryAdd(ValidationAllowedRegistry; stale_set_id; [3])
stale_set_result = ValidationAllowedSetResult(3; stale_set_id)
ValidationAllowedRegistry = ValidationRegistryAdd(ValidationAllowedRegistry; stale_set_id; [4])

defined_result = ValidationDefinedResult(5kN)
negative_result = ValidationNegativeResult(-1)
nonpositive_result = ValidationNonpositiveResult(0)
nonzero_result = ValidationNonzeroResult(5mm; 0.1mm)
zero_result = ValidationZeroResult(0.05mm; 0.1mm)
minimum_result = ValidationMinimumResult(5m; 1m)
maximum_result = ValidationMaximumResult(5m; 10m)
open_range_result = ValidationOpenRangeResult(5; 1; 10)
outside_range_result = ValidationOutsideRangeResult(0; 1; 10)
absolute_maximum_result = ValidationAbsoluteMaximumResult(-5kN; 10kN)
matrix_rows_result = ValidationMatrixRowsResult(square_matrix; 2; 3)
matrix_columns_result = ValidationMatrixColumnsResult(rectangular_matrix; 3; 3)
square_matrix_result = ValidationSquareMatrixResult(square_matrix)
vector_range_result = ValidationVectorRangeResult([1m; 2m; 3m]; 0m; 4m)
vector_positive_result = ValidationVectorPositiveResult([1kN; 2kN])
vector_nonnegative_result = ValidationVectorNonnegativeResult([0kN; 2kN])
vector_defined_result = ValidationVectorDefinedResult([0kN; 2kN])
vector_negative_result = ValidationVectorNegativeResult([-2kN; -1kN])
vector_nonpositive_result = ValidationVectorNonpositiveResult([-2kN; 0kN])
increasing_result = ValidationIncreasingResult([1; 2; 3])
nondecreasing_result = ValidationNondecreasingResult([1; 1; 3])
unique_result = ValidationUniqueResult([1; 2; 3])
matching_length_result = ValidationMatchingLengthResult([1; 2]; [3; 4])

extended_results = join_rows(defined_result; negative_result; nonpositive_result; nonzero_result; zero_result; minimum_result; maximum_result; open_range_result; outside_range_result; absolute_maximum_result; matrix_rows_result; matrix_columns_result; square_matrix_result; vector_range_result; vector_positive_result; vector_nonnegative_result; vector_defined_result; vector_negative_result; vector_nonpositive_result; increasing_result; nondecreasing_result; unique_result; matching_length_result)
extended_statuses = ValidationResultsStatuses(extended_results)

validation_results = join_rows(range_result; positive_result; nonnegative_result; integer_result; length_result; allowed_result; available_result; registered_result)
result_statuses = ValidationResultsStatuses(validation_results)

result_shape_value = ValidationResultShapeOK(range_result)
result_status_value = ValidationResultStatus(range_result)
result_value_value = ValidationResultValue(range_result)
result_rule_value = ValidationResultRule(range_result)
result_data_1_value = ValidationResultData1(range_result)
result_data_2_value = ValidationResultData2(range_result)
malformed_shape_value = ValidationResultShapeOK([VAL_OK; 1])
malformed_status_value = ValidationResultStatus([VAL_OK; 1])

registry_range_record = ValidationResultRecord(101; range_result)
registry_warning_record = ValidationResultRecord(102; [VAL_WARN; 9m; VAL_RULE_RANGE; 1m; 10m])
registry_error_record = ValidationResultRecord(103; allowed_result_bad)
result_registry = ValidationResultRegistryEmpty
result_registry = ValidationResultRegistryAdd(result_registry; registry_range_record)
result_registry = ValidationResultRegistryAdd(result_registry; registry_warning_record)
result_registry = ValidationResultRegistryAdd(result_registry; registry_error_record)
result_registry_errors = [VAL_REG_OK]

validation_statuses = [range_ok; range_below; range_above; range_bad; range_missing]

range_tests = and(range_ok ≡ VAL_OK; range_below ≡ VAL_ERR_BELOW_RANGE; range_above ≡ VAL_ERR_ABOVE_RANGE; range_bad ≡ VAL_ERR_BAD_RANGE; range_missing ≡ VAL_ERR_UNDEFINED)
sign_tests = and(positive_ok ≡ VAL_OK; positive_zero ≡ VAL_ERR_NONPOSITIVE; nonnegative_zero ≡ VAL_OK; nonnegative_bad ≡ VAL_ERR_NEGATIVE)
extended_scalar_tests = and(defined_ok ≡ VAL_OK; defined_bad ≡ VAL_ERR_UNDEFINED; negative_ok ≡ VAL_OK; negative_bad ≡ VAL_ERR_NONNEGATIVE; nonpositive_ok ≡ VAL_OK; nonpositive_bad ≡ VAL_ERR_POSITIVE; nonzero_ok ≡ VAL_OK; nonzero_bad ≡ VAL_ERR_ZERO; zero_ok ≡ VAL_OK; zero_bad ≡ VAL_ERR_NONZERO; minimum_ok ≡ VAL_OK; minimum_bad ≡ VAL_ERR_BELOW_RANGE; maximum_ok ≡ VAL_OK; maximum_bad ≡ VAL_ERR_ABOVE_RANGE; open_range_ok ≡ VAL_OK; open_range_bad ≡ VAL_ERR_BELOW_RANGE; outside_range_ok ≡ VAL_OK; outside_range_bad ≡ VAL_ERR_INSIDE_RANGE; absolute_maximum_ok ≡ VAL_OK; absolute_maximum_bad ≡ VAL_ERR_ABOVE_RANGE)
unit_tests = and(unit_positive ≡ VAL_OK; unit_nonnegative ≡ VAL_OK; unit_range ≡ VAL_OK)
integer_tests = and(integer_ok ≡ VAL_OK; integer_near ≡ VAL_OK; integer_bad ≡ VAL_ERR_NOT_INTEGER)
length_tests = and(length_ok ≡ VAL_OK; length_short ≡ VAL_ERR_LENGTH; length_long ≡ VAL_ERR_LENGTH)
vector_tests = and(vector_range_ok ≡ VAL_OK; vector_range_bad ≡ VAL_ERR_ABOVE_RANGE; vector_positive_ok ≡ VAL_OK; vector_positive_bad ≡ VAL_ERR_NONPOSITIVE; vector_nonnegative_ok ≡ VAL_OK; vector_nonnegative_bad ≡ VAL_ERR_NEGATIVE; vector_defined_ok ≡ VAL_OK; vector_defined_bad ≡ VAL_ERR_UNDEFINED; vector_negative_ok ≡ VAL_OK; vector_negative_bad ≡ VAL_ERR_NONNEGATIVE; vector_nonpositive_ok ≡ VAL_OK; vector_nonpositive_bad ≡ VAL_ERR_POSITIVE; increasing_ok ≡ VAL_OK; increasing_bad ≡ VAL_ERR_ORDER; nondecreasing_ok ≡ VAL_OK; nondecreasing_bad ≡ VAL_ERR_ORDER; unique_ok ≡ VAL_OK; unique_bad ≡ VAL_ERR_DUPLICATE; matching_length_ok ≡ VAL_OK; matching_length_bad ≡ VAL_ERR_LENGTH)
matrix_tests = and(matrix_rows_ok ≡ VAL_OK; matrix_rows_bad ≡ VAL_ERR_BELOW_RANGE; matrix_columns_ok ≡ VAL_OK; matrix_columns_bad ≡ VAL_ERR_ABOVE_RANGE; square_matrix_ok ≡ VAL_OK; square_matrix_bad ≡ VAL_ERR_DIMENSIONS; ValidationAllOK(ValidationResultsStatuses(exact_dimensions_ok)); ValidationErrorCount(ValidationResultsStatuses(exact_dimensions_bad)) ≡ 1)
aggregation_tests = and(ValidationWorst(validation_statuses) ≡ VAL_ERR_BAD_RANGE; ValidationCount(validation_statuses; VAL_OK) ≡ 1; not(ValidationAllOK(validation_statuses)); ValidationAllOK([VAL_OK; VAL_OK]))
status_tests = and(ValidationStatusKnown(VAL_ERR_LENGTH); not(ValidationStatusKnown(99)))
allowed_tests = and(allowed_ok ≡ VAL_OK; allowed_bad ≡ VAL_ERR_NOT_ALLOWED; ValidationStatusKnown(VAL_ERR_NOT_ALLOWED))
registry_tests = and(ValidationRegistryAddStatus(test_set_id; [1; 2]) ≡ VAL_OK; ValidationRegistryAddStatus(0; [1; 2]) ≡ VAL_ERR_BAD_SET; ValidationRegistryAddStatus(test_set_id; find_eq([0]; 1; 1)) ≡ VAL_ERR_BAD_SET; ValidationAllowedSetExists(test_set_id); ValidationAllowedSetCount(test_set_id) ≡ 4; len(registered_values) ≡ 4; take(4; registered_values) ≡ 1.3; ValidationValuesUnique(registered_values); not(ValidationValuesUnique([1; 1; 2])); ValidationRegistrySetStatus(ValidationAllowedRegistry; duplicate_set_id) ≡ VAL_ERR_BAD_SET)
result_access_tests = and(result_shape_value; result_status_value ≡ VAL_OK; result_value_value ≡ 5m; result_rule_value ≡ VAL_RULE_RANGE; result_data_1_value ≡ 1m; result_data_2_value ≡ 10m; not(malformed_shape_value); malformed_status_value ≡ VAL_ERR_BAD_RESULT)
result_rule_tests = and(ValidationResultStatus(positive_result) ≡ VAL_OK; ValidationResultStatus(nonnegative_result) ≡ VAL_OK; ValidationResultStatus(integer_result) ≡ VAL_OK; ValidationResultStatus(length_result) ≡ VAL_OK; ValidationResultStatus(allowed_result) ≡ VAL_OK; ValidationResultStatus(allowed_result_bad) ≡ VAL_ERR_NOT_ALLOWED; ValidationResultStatus(missing_set_result) ≡ VAL_ERR_BAD_SET; ValidationResultStatus(available_result) ≡ VAL_OK; ValidationResultStatus(registered_result) ≡ VAL_OK; ValidationResultStatus(unregistered_result) ≡ VAL_ERR_NOT_REGISTERED; ValidationResultStatus(duplicate_set_result) ≡ VAL_ERR_BAD_SET; ValidationResultStatus(stale_set_result) ≡ VAL_ERR_BAD_SET)
result_aggregation_tests = and(len(result_statuses) ≡ 8; ValidationAllOK(result_statuses); len(extended_statuses) ≡ 23; ValidationAllOK(extended_statuses))
result_registry_shape_tests = and(ValidationResultRecordShapeOK(registry_range_record); ValidationResultRecordID(registry_range_record) ≡ 101; ValidationResultRecordStatus(registry_range_record) ≡ VAL_OK; ValidationResultRecordValue(registry_range_record) ≡ 5m; ValidationResultRecordRule(registry_range_record) ≡ VAL_RULE_RANGE; ValidationResultRecordData1(registry_range_record) ≡ 1m; ValidationResultRecordData2(registry_range_record) ≡ 10m; ValidationResultShapeOK(ValidationResultRecordResult(registry_range_record)))
result_registry_status_tests = and(ValidationResultRegistryAddStatus(ValidationResultRegistryEmpty; registry_range_record) ≡ VAL_REG_OK; ValidationResultRegistryAddStatus(result_registry; registry_range_record) ≡ VAL_REG_ERR_DUPLICATE_ID; ValidationResultRegistryAddStatus(ValidationResultRegistryEmpty; ValidationResultRecord(0; range_result)) ≡ VAL_REG_ERR_BAD_ID; ValidationResultRegistryAddStatus(ValidationResultRegistryEmpty; [1; 2]) ≡ VAL_REG_ERR_BAD_RESULT)
result_registry_query_tests = and(ValidationResultRegistryShapeOK(result_registry); ValidationResultRegistryCount(result_registry) ≡ 3; ValidationResultRegistryEntryExists(result_registry; 102); not(ValidationResultRegistryEntryExists(result_registry; 999)); len(ValidationResultRegistryIDs(result_registry)) ≡ 3; take(2; ValidationResultRegistryIDs(result_registry)) ≡ 102; take(2; ValidationResultRegistryStatuses(result_registry)) ≡ VAL_WARN; take(1; ValidationResultRegistryRules(result_registry)) ≡ VAL_RULE_RANGE; ValidationResultRegistryIDAt(result_registry; 3) ≡ 103; ValidationResultRegistryStatusAt(result_registry; 3) ≡ VAL_ERR_NOT_ALLOWED; ValidationResultRegistryValueAt(result_registry; 1) ≡ 5m; ValidationResultRegistryRuleAt(result_registry; 1) ≡ VAL_RULE_RANGE; ValidationResultShapeOK(ValidationResultRegistryResultAt(result_registry; 1)))
result_registry_summary_tests = and(ValidationRegistryErrorsOK(result_registry_errors); ValidationRegistryErrorCount([VAL_REG_OK; VAL_REG_ERR_DUPLICATE_ID]) ≡ 1; ValidationResultRegistryIssueCount(result_registry; result_registry_errors) ≡ 2; ValidationResultRegistrySummaryStatus(result_registry; result_registry_errors) ≡ VAL_ERR_UNKNOWN; not(ValidationResultRegistryInputsValid(result_registry; result_registry_errors)); ValidationResultRegistrySummaryStatus(ValidationResultRegistryEmpty; [VAL_REG_OK]) ≡ VAL_ERR_UNKNOWN; ValidationResultRegistrySummaryStatus(result_registry; [VAL_REG_OK; VAL_REG_ERR_DUPLICATE_ID]) ≡ VAL_ERR_UNKNOWN)
reporting_statuses = [VAL_OK; VAL_WARN; VAL_ERR_LENGTH]
reporting_tests = and(ValidationWarningCount(reporting_statuses) ≡ 1; ValidationErrorCount(reporting_statuses) ≡ 1; ValidationHasErrors(reporting_statuses))
overall_tests = and(ValidationOverallStatus([VAL_OK; VAL_OK]) ≡ VAL_OK; ValidationOverallStatus([VAL_OK; VAL_WARN]) ≡ VAL_WARN; ValidationOverallStatus(reporting_statuses) ≡ VAL_ERR_UNKNOWN)
summary_tests_1 = and(aggregation_tests; status_tests; allowed_tests; reporting_tests; overall_tests)
summary_tests = and(summary_tests_1; unit_tests; extended_scalar_tests; vector_tests; matrix_tests; registry_tests; result_access_tests; result_rule_tests; result_aggregation_tests; result_registry_shape_tests; result_registry_status_tests; result_registry_query_tests; result_registry_summary_tests)

all_tests = and(range_tests; sign_tests; integer_tests; length_tests; summary_tests)

ShowValidation$(Range example; 5; range_ok)

BeginValidationSummary$
AddValidationResult$(201; Range result; range_result)
AddValidationResult$(202; Allowed-set result; allowed_result)
AddValidationResult$(203; Registered result; registered_result)
AddValidationResult$(204; Negative result; negative_result)
AddValidationResult$(205; Nonzero result; nonzero_result)
AddValidationResult$(206; Zero result; zero_result)
AddValidationResult$(207; Square-matrix result; square_matrix_result)
AddValidationResult$(208; Vector-range result; vector_range_result)
AddValidationResult$(209; Matching-length result; matching_length_result)
AddValidationResult$(210; Invalid allowed-set result; allowed_result_bad)
EndValidationResults$
ShowValidationIssues$
