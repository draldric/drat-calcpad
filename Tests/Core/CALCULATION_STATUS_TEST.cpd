"Calculation Status Core Test

#include ../../Core/DratCore.cpd

empty_statuses = find_eq([0]; 1; 1)

calculation_pass = CalculationStatus([VAL_OK; VAL_OK]; [CHK_PASS; CHK_PASS])
calculation_validation_warning = CalculationStatus([VAL_OK; VAL_WARN]; [CHK_PASS])
calculation_check_warning = CalculationStatus([VAL_OK]; [CHK_PASS; CHK_WARN])
calculation_fail = CalculationStatus([VAL_OK]; [CHK_PASS; CHK_FAIL])
calculation_invalid_input = CalculationStatus([VAL_OK; VAL_ERR_UNDEFINED]; [CHK_ERROR])
calculation_missing_validation = CalculationStatus(empty_statuses; [CHK_PASS])
calculation_missing_checks = CalculationStatus([VAL_OK]; empty_statuses)
calculation_check_error = CalculationStatus([VAL_OK]; [CHK_ERROR])
calculation_unknown_check = CalculationStatus([VAL_OK]; [99])
calculation_unknown_validation = CalculationStatus([99]; [CHK_PASS])

warning_validation_statuses = [VAL_OK; VAL_WARN]
warning_check_statuses = [CHK_PASS; CHK_WARN]
fail_check_statuses = [CHK_PASS; CHK_FAIL]

classification_tests = and(calculation_pass ≡ CALC_PASS; calculation_validation_warning ≡ CALC_WARN; calculation_check_warning ≡ CALC_WARN; calculation_fail ≡ CALC_FAIL; calculation_invalid_input ≡ CALC_INCOMPLETE; calculation_missing_validation ≡ CALC_INCOMPLETE; calculation_missing_checks ≡ CALC_INCOMPLETE; calculation_check_error ≡ CALC_ERROR; calculation_unknown_check ≡ CALC_ERROR; calculation_unknown_validation ≡ CALC_ERROR)
known_status_tests = and(CalculationStatusKnown(CALC_PASS); CalculationStatusKnown(CALC_WARN); CalculationStatusKnown(CALC_FAIL); CalculationStatusKnown(CALC_INCOMPLETE); CalculationStatusKnown(CALC_ERROR); not(CalculationStatusKnown(99)))
predicate_tests = and(CalculationIsPass(CALC_PASS); CalculationHasWarning(CALC_WARN); CalculationHasFailure(CALC_FAIL); CalculationIsIncomplete(CALC_INCOMPLETE); CalculationHasError(CALC_ERROR); CalculationCanBeIssued(CALC_PASS); CalculationCanBeIssued(CALC_WARN); not(CalculationCanBeIssued(CALC_FAIL)); not(CalculationCanBeIssued(CALC_INCOMPLETE)); not(CalculationCanBeIssued(CALC_ERROR)))
completion_tests = and(CalculationValidationStatusesOK([VAL_OK; VAL_WARN]); not(CalculationValidationStatusesOK([VAL_OK; 99])); CalculationInputsComplete([VAL_OK; VAL_WARN]); not(CalculationInputsComplete([VAL_OK; VAL_ERR_NEGATIVE])); not(CalculationInputsComplete(empty_statuses)); CalculationChecksComplete([CHK_PASS; CHK_WARN]); not(CalculationChecksComplete([CHK_ERROR])); not(CalculationChecksComplete(empty_statuses)))

all_tests = and(classification_tests; known_status_tests; predicate_tests; completion_tests)

ShowCalculationStatus$(warning_validation_statuses; warning_check_statuses)
ShowCalculationStatus$([VAL_OK]; fail_check_statuses)
ShowCalculationStatus$([VAL_ERR_UNDEFINED]; [CHK_ERROR])
