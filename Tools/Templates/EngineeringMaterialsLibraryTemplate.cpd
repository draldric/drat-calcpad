#def ShowMatPropertyComparisonPlot$(id$; items$; property$)
    #hide
    ζMAT_plot_items = items$
    ζMAT_plot_property = property$
    ζMAT_plot_count = len(ζMAT_plot_items)
    ζMAT_plot_property_ok = MatHasProperty(ζMAT_plot_property)
    ζMAT_plot_safe_property = if(ζMAT_plot_property_ok; ζMAT_plot_property; MAT_P_DENSITY)
    ζMAT_plot_values = vector(max(1; ζMAT_plot_count))
    ζMAT_plot_status = switch(ζMAT_plot_count ≡ 0; DB_ERR_INSUFFICIENT_DATA; not(ζMAT_plot_property_ok); DB_ERR_PROPERTY; DB_OK)
    #if ζMAT_plot_count > 0
        #for ζMAT_plot_index = 1 : ζMAT_plot_count
            ζMAT_plot_item = take(ζMAT_plot_index; ζMAT_plot_items)
            ζMAT_plot_value_status = MatPROPStatus(ζMAT_plot_item; ζMAT_plot_safe_property)
            ζMAT_plot_values.ζMAT_plot_index = if(ζMAT_plot_value_status ≡ DB_OK; MatPROPRaw(ζMAT_plot_item; ζMAT_plot_safe_property); 0)
            ζMAT_plot_status = switch(ζMAT_plot_status ≠ DB_OK; ζMAT_plot_status; ζMAT_plot_value_status ≠ DB_OK; ζMAT_plot_value_status; DB_OK)
        #loop
    #end if
    ζMAT_plot_height = min(700; max(360; 110 + 34*ζMAT_plot_count))
    #show
    #novar
    #if ζMAT_plot_status ≡ DB_OK
        figure$(id$)
        figureSize$(id$; 900; ζMAT_plot_height)
        #val
        '<script>
        '(function(){
        '  var p=window.TSPlots["id$"];
        '  p.layout.title={text:"
        MatPropertyName$(ζMAT_plot_property)
        ' comparison",x:0.5,xanchor:"center"};
        '  p.layout.xaxis.title={text:"
        MatPropertyName$(ζMAT_plot_property)
        ' (
        MatPropertyUnit$(ζMAT_plot_property)
        ')"};
        '  p.layout.yaxis.title={text:"Material"};
        '  p.layout.yaxis.autorange="reversed";
        '  p.layout.showlegend=false;
        '  p.layout.margin.l=220;
        '  p.data.push({
        '    x:'clrunits(ζMAT_plot_values)',
        '    y:[
        #for ζMAT_plot_label_index = 1 : ζMAT_plot_count
            #hide
            ζMAT_plot_label_item = take(ζMAT_plot_label_index; ζMAT_plot_items)
            #show
            '      "
            MatName$(ζMAT_plot_label_item)
            '"
            #if ζMAT_plot_label_index < ζMAT_plot_count
                ',
            #end if
        #loop
        '    ],
        '    customdata:'clrunits(ζMAT_plot_items)',
        '    type:"bar",orientation:"h",marker:{color:"#337ab7"},
        '    hovertemplate:"%{y}<br>Material ID: %{customdata}<br>Value: %{x}<extra></extra>"
        '  });
        '})();
        '</script>
        #equ
        RenderMatPlot$(id$)
        '<div class="material-plot-note">Representative screening values only. Verify project-specific design data.</div>
    #end if
    #if ζMAT_plot_status ≠ DB_OK
        '<div class="ts-plot" style="height:160px;max-width:900px"><div class="ts-plot-status err">
        DBStatus$(ζMAT_plot_status)
        '</div></div>
    #end if
    #equ
    #varsub
#end def

#def ShowMatPropertyTradeoffPlot$(id$; items$; x_property$; y_property$)
    #hide
    ζMAT_tradeoff_items = items$
    ζMAT_tradeoff_x_property = x_property$
    ζMAT_tradeoff_y_property = y_property$
    ζMAT_tradeoff_count = len(ζMAT_tradeoff_items)
    ζMAT_tradeoff_x_ok = MatHasProperty(ζMAT_tradeoff_x_property)
    ζMAT_tradeoff_y_ok = MatHasProperty(ζMAT_tradeoff_y_property)
    ζMAT_tradeoff_safe_x = if(ζMAT_tradeoff_x_ok; ζMAT_tradeoff_x_property; MAT_P_DENSITY)
    ζMAT_tradeoff_safe_y = if(ζMAT_tradeoff_y_ok; ζMAT_tradeoff_y_property; MAT_P_DENSITY)
    ζMAT_tradeoff_x_values = vector(max(1; ζMAT_tradeoff_count))
    ζMAT_tradeoff_y_values = vector(max(1; ζMAT_tradeoff_count))
    ζMAT_tradeoff_status = switch(ζMAT_tradeoff_count ≡ 0; DB_ERR_INSUFFICIENT_DATA; not(ζMAT_tradeoff_x_ok); DB_ERR_PROPERTY; not(ζMAT_tradeoff_y_ok); DB_ERR_PROPERTY; DB_OK)
    #if ζMAT_tradeoff_count > 0
        #for ζMAT_tradeoff_index = 1 : ζMAT_tradeoff_count
            ζMAT_tradeoff_item = take(ζMAT_tradeoff_index; ζMAT_tradeoff_items)
            ζMAT_tradeoff_x_status = MatPROPStatus(ζMAT_tradeoff_item; ζMAT_tradeoff_safe_x)
            ζMAT_tradeoff_y_status = MatPROPStatus(ζMAT_tradeoff_item; ζMAT_tradeoff_safe_y)
            ζMAT_tradeoff_x_values.ζMAT_tradeoff_index = if(ζMAT_tradeoff_x_status ≡ DB_OK; MatPROPRaw(ζMAT_tradeoff_item; ζMAT_tradeoff_safe_x); 0)
            ζMAT_tradeoff_y_values.ζMAT_tradeoff_index = if(ζMAT_tradeoff_y_status ≡ DB_OK; MatPROPRaw(ζMAT_tradeoff_item; ζMAT_tradeoff_safe_y); 0)
            ζMAT_tradeoff_status = switch(ζMAT_tradeoff_status ≠ DB_OK; ζMAT_tradeoff_status; ζMAT_tradeoff_x_status ≠ DB_OK; ζMAT_tradeoff_x_status; ζMAT_tradeoff_y_status ≠ DB_OK; ζMAT_tradeoff_y_status; DB_OK)
        #loop
    #end if
    #show
    #novar
    #if ζMAT_tradeoff_status ≡ DB_OK
        figure$(id$)
        figureSize$(id$; 900; 500)
        #val
        '<script>
        '(function(){
        '  var p=window.TSPlots["id$"];
        '  p.layout.title={text:"Material property trade-off",x:0.5,xanchor:"center"};
        '  p.layout.xaxis.title={text:"
        MatPropertyName$(ζMAT_tradeoff_x_property)
        ' (
        MatPropertyUnit$(ζMAT_tradeoff_x_property)
        ')"};
        '  p.layout.yaxis.title={text:"
        MatPropertyName$(ζMAT_tradeoff_y_property)
        ' (
        MatPropertyUnit$(ζMAT_tradeoff_y_property)
        ')"};
        '  p.layout.showlegend=false;
        '  p.data.push({
        '    x:'clrunits(ζMAT_tradeoff_x_values)',y:'clrunits(ζMAT_tradeoff_y_values)',
        '    text:[
        #for ζMAT_tradeoff_label_index = 1 : ζMAT_tradeoff_count
            #hide
            ζMAT_tradeoff_label_item = take(ζMAT_tradeoff_label_index; ζMAT_tradeoff_items)
            #show
            '      "
            MatName$(ζMAT_tradeoff_label_item)
            '"
            #if ζMAT_tradeoff_label_index < ζMAT_tradeoff_count
                ',
            #end if
        #loop
        '    ],
        '    customdata:'clrunits(ζMAT_tradeoff_items)',
        '    mode:"markers",type:"scatter",marker:{size:10,color:"#337ab7"},
        '    hovertemplate:"%{text}<br>Material ID: %{customdata}<br>x: %{x}<br>y: %{y}<extra></extra>"
        '  });
        '})();
        '</script>
        #equ
        RenderMatPlot$(id$)
        '<div class="material-plot-note">Representative screening values only. Verify project-specific design data.</div>
    #end if
    #if ζMAT_tradeoff_status ≠ DB_OK
        '<div class="ts-plot" style="height:160px;max-width:900px"><div class="ts-plot-status err">
        DBStatus$(ζMAT_tradeoff_status)
        '</div></div>
    #end if
    #equ
    #varsub
#end def

#def ShowMatComparison$(items$; properties$)
    #hide
    ζMAT_comparison_items = items$
    ζMAT_comparison_properties = properties$
    ζMAT_comparison_item_count = len(ζMAT_comparison_items)
    ζMAT_comparison_property_count = len(ζMAT_comparison_properties)
    ζMAT_comparison_request_ok = and(ζMAT_comparison_item_count > 0; MatPropertySetKnown(ζMAT_comparison_properties))
    #show
    #novar
    '<table class="bordered data material-comparison" style="width:95%">
    '<thead>
    '<tr><th>Material ID</th><th>Material</th><th>Category</th>
    #if ζMAT_comparison_request_ok
        #for ζMAT_comparison_property_index = 1 : ζMAT_comparison_property_count
            #hide
            ζMAT_comparison_property = take(ζMAT_comparison_property_index; ζMAT_comparison_properties)
            #show
            '<th>
            MatPropertyName$(ζMAT_comparison_property)
            '<br><span class="note">
            MatPropertyUnit$(ζMAT_comparison_property)
            '</span></th>
        #loop
    #end if
    '</tr>
    '</thead>
    '<tbody>
    #if ζMAT_comparison_request_ok
        #for ζMAT_comparison_item_index = 1 : ζMAT_comparison_item_count
            #hide
            ζMAT_comparison_item = take(ζMAT_comparison_item_index; ζMAT_comparison_items)
            ζMAT_comparison_item_ok = MatHasItem(ζMAT_comparison_item)
            ζMAT_comparison_category = if(ζMAT_comparison_item_ok; MatCategory(ζMAT_comparison_item); -1)
            #show
            '<tr><td style="text-align:right">'ζMAT_comparison_item'</td><td style="text-align:left">
            MatName$(ζMAT_comparison_item)
            '</td><td style="text-align:left">
            MatCategoryName$(ζMAT_comparison_category)
            '</td>
            #for ζMAT_comparison_value_index = 1 : ζMAT_comparison_property_count
                #hide
                ζMAT_comparison_value_property = take(ζMAT_comparison_value_index; ζMAT_comparison_properties)
                ζMAT_comparison_value_status = MatPROPStatus(ζMAT_comparison_item; ζMAT_comparison_value_property)
                ζMAT_comparison_value = MatPROP(ζMAT_comparison_item; ζMAT_comparison_value_property)
                #show
                #if ζMAT_comparison_value_status ≡ DB_OK
                    '<td>'ζMAT_comparison_value'</td>
                #end if
                #if ζMAT_comparison_value_status ≠ DB_OK
                    '<td>
                    DBStatus$(ζMAT_comparison_value_status)
                    '</td>
                #end if
            #loop
            '</tr>
        #loop
    #end if
    #if not(ζMAT_comparison_request_ok)
        '<tr><td colspan="3" class="status-cell"><span class="err">Material comparison requires at least one item and valid property IDs.</span></td></tr>
    #end if
    '</tbody>
    '</table>
    #varsub
#end def

#def ShowMatRanking$(ranking_result$; property$; limit$)
    #hide
    ζMAT_ranking_result = ranking_result$
    ζMAT_ranking_property = property$
    ζMAT_ranking_status = MatRankingResultStatus(ζMAT_ranking_result)
    ζMAT_ranking_count = MatRankingCount(ζMAT_ranking_result)
    ζMAT_ranking_limit = min(ζMAT_ranking_count; max(0; round(limit$)))
    #show
    #novar
    '<table class="bordered data material-ranking" style="width:95%">
    '<thead>
    '<tr><th>Rank</th><th>Material ID</th><th>Material</th><th>Category</th><th>
    MatPropertyName$(ζMAT_ranking_property)
    '<br><span class="note">
    MatPropertyUnit$(ζMAT_ranking_property)
    '</span></th><th>Classification</th></tr>
    '</thead>
    '<tbody>
    #if and(ζMAT_ranking_status ≡ DB_OK; ζMAT_ranking_limit > 0)
        #for ζMAT_ranking_index = 1 : ζMAT_ranking_limit
            #hide
            ζMAT_ranked_item = take(ζMAT_ranking_index; col(ζMAT_ranking_result; 2))
            ζMAT_ranked_category = MatCategory(ζMAT_ranked_item)
            ζMAT_ranked_value = MatPROP(ζMAT_ranked_item; ζMAT_ranking_property)
            ζMAT_ranked_classification = MatClassification(ζMAT_ranked_item; ζMAT_ranking_property)
            #show
            '<tr><td style="text-align:right">'ζMAT_ranking_index'</td><td style="text-align:right">'ζMAT_ranked_item'</td><td style="text-align:left">
            MatName$(ζMAT_ranked_item)
            '</td><td style="text-align:left">
            MatCategoryName$(ζMAT_ranked_category)
            '</td><td>'ζMAT_ranked_value'</td><td style="text-align:left">
            MatClassificationName$(ζMAT_ranked_classification)
            '</td></tr>
        #loop
    #end if
    #if ζMAT_ranking_status ≠ DB_OK
        '<tr><td colspan="6" class="status-cell">
        DBStatus$(ζMAT_ranking_status)
        '</td></tr>
    #end if
    '</tbody>
    '<tfoot><tr><th colspan="5">Displayed candidates</th><td>'ζMAT_ranking_limit' of 'ζMAT_ranking_count'</td></tr></tfoot>
    '</table>
    #varsub
#end def

#def ShowMatRecord$(item$)
	    #hide
	    ζMAT_record_status = MatProvenanceStatus(item$)
	    ζMAT_record_source = if(DBIsFatal(ζMAT_record_status); 0; MatSourceID(item$))
	    ζMAT_record_revision = if(DBIsFatal(ζMAT_record_status); 0; MatDataRevision(item$))
	    ζMAT_record_category = if(DBIsFatal(ζMAT_record_status); 0; MatCategory(item$))
	    ζMAT_record_available = if(DBIsFatal(ζMAT_record_status); 0; MatAvailablePropertyCount(item$))
	    ζMAT_record_completeness_percent = if(DBIsFatal(ζMAT_record_status); 0; 100*MatItemCompleteness(item$))
	    #show
	    #novar
	    '<table class="bordered data material-record" style="width:95%">
	    '<tbody>
	    '<tr><td><strong>Material</strong></td><td>
	    MatName$(item$)
	    '</td></tr>
	    '<tr><td><strong>Material ID</strong></td><td>'item$'</td></tr>
	    '<tr><td><strong>Status</strong></td><td>
	    DBStatus$(ζMAT_record_status)
	    '</td></tr>
	    #if not(DBIsFatal(ζMAT_record_status))
	        '<tr><td><strong>Library</strong></td><td>EngineeringMaterialsLibraryName$</td></tr>
	        '<tr><td><strong>Library revision</strong></td><td>EngineeringMaterialsLibraryRevision$</td></tr>
	        '<tr><td><strong>Category</strong></td><td>
	        MatCategoryName$(ζMAT_record_category)
	        '</td></tr>
	        '<tr><td><strong>Available properties</strong></td><td>'ζMAT_record_available' of 'EngineeringMaterialPropertyCount'</td></tr>
	        '<tr><td><strong>Record completeness</strong></td><td>'ζMAT_record_completeness_percent'%</td></tr>
	        '<tr><td><strong>Default classification</strong></td><td>
	        MatClassificationName$(EngineeringMaterialDefaultClassification)
	        '</td></tr>
	        '<tr><td><strong>Dataset revision</strong></td><td>'ζMAT_record_revision'</td></tr>
	        '<tr><td><strong>Source registry</strong></td><td>
	        MatSource$(ζMAT_record_source)
	        '</td></tr>
	        #varsub
	    #end if
	    '</tbody>
	    '</table>
#end def

#def ShowMatPROP$(item$; property$)
	    #hide
	    ζMAT_status = MatPropertyRecordStatus(item$; property$)
	    ζMAT_value = MatPROP(item$; property$)
	    ζMAT_source = if(DBIsFatal(ζMAT_status); 0; MatSourceID(item$))
	    ζMAT_revision = if(DBIsFatal(ζMAT_status); 0; MatDataRevision(item$))
	    ζMAT_classification = if(DBIsFatal(ζMAT_status); MAT_CLASS_UNKNOWN; MatClassification(item$; property$))
	    #show
	    #novar
	    '<table class="bordered data material-property" style="width:95%">
	    '<tbody>
	    '<tr><td><strong>Material</strong></td><td>
	    MatName$(item$)
	    '</td></tr>
	    '<tr><td><strong>Property</strong></td><td>
	    MatPropertyName$(property$)
	    '</td></tr>
	    '<tr><td><strong>Property ID</strong></td><td>'property$'</td></tr>
	    '<tr><td><strong>Status</strong></td><td>
	    DBStatus$(ζMAT_status)
	    '</td></tr>
	    #if not(DBIsFatal(ζMAT_status))
		        '<tr><td><strong>Value</strong></td><td>'ζMAT_value'</td></tr>
		        '<tr><td><strong>Value classification</strong></td><td>
		        MatClassificationName$(ζMAT_classification)
		        '</td></tr>
		        '<tr><td><strong>Dataset revision</strong></td><td>'ζMAT_revision'</td></tr>
		        '<tr><td><strong>Source registry</strong></td><td>
		        MatSource$(ζMAT_source)
		        '</td></tr>
		    #varsub
	    #end if
	    '</tbody>
	    '</table>
#end def
#show
#else
'<div style="margin:1em;padding:0.75em;border:2px solid #b00020;color:#b00020;background:#fff0f2;"><strong>DRAT library load error:</strong> EngineeringMaterials requires Plotting API 3.2 or newer. Load a compatible DratCore.cpd before this library.</div>
#end if
#else
'<div style="margin:1em;padding:0.75em;border:2px solid #b00020;color:#b00020;background:#fff0f2;"><strong>DRAT library load error:</strong> EngineeringMaterials requires DataWrapper API 0.3.2 or newer. Load a compatible DratCore.cpd before this library.</div>
#end if
#else
'<div style="margin:1em;padding:0.75em;border:2px solid #b00020;color:#b00020;background:#fff0f2;"><strong>DRAT library load error:</strong> EngineeringMaterials requires DRAT core API 1.x. Load DratCore.cpd before this library.</div>
#end if
