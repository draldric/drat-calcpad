#md on
#include ../Core/DratCore.cpd

'<!-- Replace the document-control values before issuing the worksheet. -->
#def Organization$ = ORGANIZATION NAME
#def Client$ = CLIENT NAME
#def Project$ = PROJECT NAME
#def Title$ = ENGINEERING CALCULATION TITLE
#def Purpose$ = STATE THE PURPOSE AND REQUIRED DECISION.
#def Scope$ = DEFINE WHAT THE CALCULATION INCLUDES AND EXCLUDES.
#def Calculation$ = CALCULATION NUMBER
#def Rev$ = 0
#def PreparedBy$ = PREPARER NAME
#def PreparedOn$ = YYYY-MM-DD
#def CheckedBy$ = NOT CHECKED
#def CheckedOn$ = --
#def ApprovedBy$ = NOT APPROVED
#def ApprovedOn$ = --

CreateHeader$
CreateTitle$
CreatePurpose$
CreateScope$

#hide
REF_GOVERNING_STANDARD = 1
REF_INPUT_SOURCE = 2
CRITERION_PRIMARY = 1
ASSUMPTION_PRIMARY = 1
LIMITATION_PRIMARY = 1
#show

BeginRevisions$
AddRevision$(0; Initial calculation; PREPARER NAME; YYYY-MM-DD)
EndRevisions$

BeginReferences$
AddReference$(REF_GOVERNING_STANDARD; GOVERNING STANDARD; STANDARD TITLE; EDITION / REVISION; APPLICABLE CLAUSE; Describe how the reference governs the calculation.)
AddReference$(REF_INPUT_SOURCE; DRAWING / SPECIFICATION / DATASET; INPUT SOURCE TITLE; REVISION / DATE; APPLICABLE LOCATION; Identify the origin of calculation inputs.)
EndReferences$

"Design Basis and Assumptions

BeginDesignCriteria$
AddDesignCriterion$(CRITERION_PRIMARY; PRIMARY DESIGN CRITERION; STATE THE REQUIRED LIMIT OR ACCEPTANCE CONDITION.; REF_GOVERNING_STANDARD; APPLICABLE CLAUSE; Explain how the criterion is applied.)
EndDesignCriteria$

BeginAssumptions$
AddAssumption$(ASSUMPTION_PRIMARY; ANALYSIS / GEOMETRY / LOADING / MATERIAL; STATE THE ENGINEERING ASSUMPTION.; State the evidence or engineering basis.; REF_INPUT_SOURCE)
EndAssumptions$

BeginLimitations$
AddLimitation$(LIMITATION_PRIMARY; STATE THE BOUND, EXCLUSION, OR CONDITION OF USE.; Explain the consequence if the limitation is exceeded.; State the review, verification, or additional analysis required.; RPT_NO_REFERENCE)
EndLimitations$

ShowReportingSummary$

"Inputs

'#### Saved Inputs

'Replace these demonstration inputs with calculation-specific values.
demand = 80
capacity = 100
warning_threshold = CHK_DEFAULT_WARNING

'#### Input Validation
#hide
demand_validation = ValidationNonnegativeResult(demand)
capacity_validation = ValidationPositiveResult(capacity)
warning_validation = ValidationRangeResult(warning_threshold; 0; 1)
input_results = join_rows(demand_validation; capacity_validation; warning_validation)
input_statuses = ValidationResultsStatuses(input_results)
input_validation = ValidationOverallStatus(input_statuses)
inputs_valid = not(ValidationHasErrors(input_statuses))
#show

#novar
BeginValidationSummary$
AddValidationResult$(Demand; demand_validation)
AddValidationResult$(Capacity; capacity_validation)
AddValidationResult$(Warning threshold; warning_validation)
EndValidationResults$(input_results)
#equ

"Methodology

'Describe the governing method, equations, models, and acceptance criteria.
'For this demonstration, utilization is the magnitude of demand divided by positive capacity.

"Calculations

#hide
utilization = CheckUpperUtilization(demand; capacity)
raw_check_status = CheckUpperStatus(demand; capacity; warning_threshold)
check_status = CheckGatedStatus(inputs_valid; raw_check_status)
check_statuses = [check_status]
check_utilizations = [utilization]
overall_check_status = CheckSummaryStatus(check_statuses; check_utilizations)
calculation_status = CalculationStatus(input_statuses; check_statuses)
#show

"Results

#novar
AddConclusion$(Governing utilization; utilization)
#equ

"Engineering Checks

#novar
BeginCheckSummary$
AddCheckRow$(Upper-limit demonstration; demand; capacity; utilization; warning_threshold; Demand ≤ capacity; check_status)
EndCheckSummaryWithResult$(check_statuses; check_utilizations; Upper-limit demonstration)
#equ

ShowCalculationStatus$(input_statuses; check_statuses)

BeginConclusions$
#novar
AddCalculationStatusConclusion$(Document calculation status; calculation_status)
AddValidationConclusion$(Overall input validation; input_validation)
AddCheckConclusion$(Overall check status; overall_check_status)
EndConclusions$
#equ
