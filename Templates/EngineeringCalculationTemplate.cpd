#md on
#include ../Core/DratCore.cpd

'<!-- Replace the document-control values before issuing the worksheet. -->
#def Organization$ = ORGANIZATION NAME
#def Client$ = CLIENT NAME
#def Project$ = PROJECT NAME
#def Title$ = ENGINEERING CALCULATION TITLE
#def Purpose$ = STATE THE PURPOSE AND REQUIRED DECISION.
#def Scope$ = DEFINE WHAT THE CALCULATION INCLUDES AND EXCLUDES.
#def Calculation$ = CALCULATION NUMBER
#def Rev$ = 0
#def PreparedBy$ = PREPARER NAME
#def PreparedOn$ = YYYY-MM-DD
#def CheckedBy$ = NOT CHECKED
#def CheckedOn$ = --
#def ApprovedBy$ = NOT APPROVED
#def ApprovedOn$ = --

CreateHeader$
CreateTitle$
CreatePurpose$
CreateScope$

BeginRevisions$
AddRevision$(0; Initial calculation; PREPARER NAME; YYYY-MM-DD)
EndRevisions$

BeginReferences$
AddReference$(List the governing code, standard, drawing, or source.)
EndReferences$

"Design Basis and Assumptions

BeginListSection$(Design Criteria)
AddListItem$(State the governing requirements and acceptance criteria.)
EndListSection$

BeginListSection$(Input Sources)
AddListItem$(Identify drawings, specifications, measurements, databases, or other input sources.)
EndListSection$

BeginListSection$(Assumptions)
AddListItem$(State each engineering assumption and its justification.)
EndListSection$

BeginListSection$(Applicability and Limitations)
AddListItem$(Document important bounds, exclusions, and conditions of use.)
EndListSection$

"Inputs

'#### Saved Inputs

'Replace these demonstration inputs with calculation-specific values.
demand = 80
capacity = 100
warning_threshold = CHK_DEFAULT_WARNING

'#### Input Validation
#hide
demand_validation = ValidationNonnegativeStatus(demand)
capacity_validation = ValidationPositiveStatus(capacity)
warning_validation = ValidationRangeStatus(warning_threshold; 0; 1)
input_statuses = [demand_validation; capacity_validation; warning_validation]
input_validation = ValidationOverallStatus(input_statuses)
#show

#novar
BeginValidationSummary$
AddValidationRow$(Demand; demand; Nonnegative; demand_validation)
AddValidationRow$(Capacity; capacity; Positive; capacity_validation)
AddValidationRow$(Warning threshold; warning_threshold; 0 to 1; warning_validation)
EndValidationSummary$(input_statuses)
#equ

"Methodology

'Describe the governing method, equations, models, and acceptance criteria.
'For this demonstration, utilization is the magnitude of demand divided by positive capacity.

"Calculations

#hide
utilization = CheckUpperUtilization(demand; capacity)
check_status = CheckUpperStatus(demand; capacity; warning_threshold)
#show

"Results

#novar
AddConclusion$(Governing utilization; utilization)
#equ

"Engineering Checks

#novar
BeginCheckSummary$
AddCheckRow$(Upper-limit demonstration; demand; capacity; utilization; warning_threshold; Demand ≤ capacity; check_status)
EndCheckSummary$
#equ

BeginConclusions$
#novar
AddValidationConclusion$(Overall input validation; input_validation)
AddCheckConclusion$(Overall check status; check_status)
EndConclusions$
#equ