#end def

#def area$(id$; x_vals$; y_vals$; color$; name$)
	    #val
	    '<script>
	    'window.TSPlots["id$"].data.push({
	    '  x:'clrunits(x_vals$)',y:'clrunits(y_vals$)',
	    '  fill:"tozeroy",type:"scatter",mode:"lines",
	    '  line:{width:1,color:"color$"},fillcolor:"color$",name:"name$"
	    '});
	    '</script>
	    #equ
#end def

#def hline$(id$; y_value$; color$; label$)
	    #val
	    '<script>
	    'var p=window.TSPlots["id$"],y='clrunits(y_value$)';
	    'p.layout.shapes.push({type:"line",xref:"paper",x0:0,x1:1,yref:"y",y0:y,y1:y,line:{color:"color$",width:1.5,dash:"dash"}});
	    'p.layout.annotations.push({xref:"paper",x:1,yref:"y",y:y,text:"label$",showarrow:false,xanchor:"right",yanchor:"bottom",font:{color:"color$"}});
	    '</script>
	    #equ
#end def

#def vline$(id$; x_value$; color$; label$)
	    #val
	    '<script>
	    'var p=window.TSPlots["id$"],x='clrunits(x_value$)';
	    'p.layout.shapes.push({type:"line",xref:"x",x0:x,x1:x,yref:"paper",y0:0,y1:1,line:{color:"color$",width:1.5,dash:"dash"}});
	    'p.layout.annotations.push({xref:"x",x:x,yref:"paper",y:1,text:"label$",showarrow:false,xanchor:"left",yanchor:"top",font:{color:"color$"}});
	    '</script>
	    #equ
#end def

#def yBand$(id$; y_min$; y_max$; color$; label$)
	    #val
	    '<script>
	    'var p=window.TSPlots["id$"],y0='clrunits(y_min$)',y1='clrunits(y_max$)';
	    'p.layout.shapes.push({type:"rect",xref:"paper",x0:0,x1:1,yref:"y",y0:y0,y1:y1,line:{width:0},fillcolor:"color$",layer:"below"});
	    'p.layout.annotations.push({xref:"paper",x:0.01,yref:"y",y:y1,text:"label$",showarrow:false,xanchor:"left",yanchor:"top"});
	    '</script>
	    #equ
#end def

#def xBand$(id$; x_min$; x_max$; color$; label$)
	    #val
	    '<script>
	    'var p=window.TSPlots["id$"],x0='clrunits(x_min$)',x1='clrunits(x_max$)';
	    'p.layout.shapes.push({type:"rect",xref:"x",x0:x0,x1:x1,yref:"paper",y0:0,y1:1,line:{width:0},fillcolor:"color$",layer:"below"});
	    'p.layout.annotations.push({xref:"x",x:x0,yref:"paper",y:1,text:"label$",showarrow:false,xanchor:"left",yanchor:"top"});
	    '</script>
	    #equ
#end def

#def annotate$(id$; x_value$; y_value$; label$)
	    #val
	    '<script>
	    'window.TSPlots["id$"].layout.annotations.push({x:'clrunits(x_value$)',y:'clrunits(y_value$)',text:"label$",showarrow:true,arrowhead:2,ax:25,ay:-30});
	    '</script>
	    #equ
#end def

#def render$(id$; title$; xlabel$; ylabel$)
	    #val
	    '<div id="id$" class="ts-plot"></div>
	    '<script>
	    '(function(){
	    '  var p=window.TSPlots&&window.TSPlots["id$"];
	    '  var el=document.getElementById("id$");
	    '  if(!el){return;}
	    '  if(!p){el.innerHTML="<div class=\"ts-plot-status err\">Figure was not initialized.</div>";return;}
	    '  p.layout.title={text:"title$",x:0.5,xanchor:"center"};
	    '  p.layout.xaxis.title={text:"xlabel$"};
	    '  p.layout.yaxis.title={text:"ylabel$"};
	    '  p.layout.height=p.height;
	    '  el.style.maxWidth=p.maxWidth+"px";
	    '  el.style.height=p.height+"px";
	    '  if(typeof Plotly==="undefined"){
	    '    el.innerHTML="<div class=\"ts-plot-status err\">Plotly.js did not load. Try the offline wrapper.</div>";
	    '    return;
	    '  }
	    '  if(!p.data.length){el.innerHTML="<div class=\"ts-plot-status err\">No traces were added.</div>";return;}
	    '  try{
	    '    var result=Plotly.newPlot(el,p.data,p.layout,p.config);
	    '    if(result&&typeof result.catch==="function"){
	    '      result.catch(function(error){el.innerHTML="<div class=\"ts-plot-status err\">Plot failed: "+error.message+"</div>";});
	    '    }
	    '  }catch(error){
	    '    el.innerHTML="<div class=\"ts-plot-status err\">Plot failed: "+error.message+"</div>";
	    '  }
	    '})();
	    '</script>
	    #equ
#end def

#def sampleData$(x_vals$; y_vals$; function$; x_start$; x_end$; points$)
	    #hide
	    ζn = max(2; round(points$))
	    ζx_data = vector(ζn)
	    ζy_data = vector(ζn)
	    #for ζi = 1 : ζn
		        ζx = x_start$ + (ζi - 1)*(x_end$ - x_start$)/(ζn - 1)
		        ζx_data.ζi = ζx
		        ζy_data.ζi = function$(ζx)
	    #loop
	    x_vals$ = ζx_data
	    y_vals$ = ζy_data
	    #show
#end def

#def sampleParametric$(x_vals$; y_vals$; x_function$; y_function$; t_start$; t_end$; points$)
	    #hide
	    ζn = max(2; round(points$))
	    ζx_data = vector(ζn)
	    ζy_data = vector(ζn)
	    #for ζi = 1 : ζn
		        ζt = t_start$ + (ζi - 1)*(t_end$ - t_start$)/(ζn - 1)
		        ζx_data.ζi = x_function$(ζt)
		        ζy_data.ζi = y_function$(ζt)
	    #loop
	    x_vals$ = ζx_data
	    y_vals$ = ζy_data
	    #show
#end def

#show
