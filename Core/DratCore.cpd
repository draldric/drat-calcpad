    ReportRegistryErrors = ReportErrorRegistryAdd(ReportRegistryErrors; RPT_ENTRY_ASSUMPTION; id$; ζRPT_assumption_status)
    ζRPT_assumption_sequence = ReportErrorRegistryAttemptCount(ReportRegistryErrors)
