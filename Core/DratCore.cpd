'<!-- Generic numeric property-wrapper core. Version 0.3.2. -->

#def DBWrapperName$ = Apple
#def DBWrapperVersion$ = 0.3.2

DB_OK = 0
DB_ERR_NAME = 10
DB_ERR_PROPERTY = 11
DB_ERR_MISSING = 12
DB_ERR_BELOW_RANGE = 13
DB_ERR_ABOVE_RANGE = 14
DB_ERR_BAD_COLUMN = 15
DB_ERR_BAD_METHOD = 16
DB_ERR_INSUFFICIENT_DATA = 17
DB_ERR_BAD_POLICY = 18
DB_ERR_BAD_RANGE = 19
DB_WARN_CLAMP_LOW = 20
DB_WARN_CLAMP_HIGH = 21
DB_WARN_EXTRAP_LOW = 22
DB_WARN_EXTRAP_HIGH = 23

DB_NEAREST = 0
DB_LINEAR = 1

DB_STRICT = 0
DB_CLAMP = 1
DB_EXTRAPOLATE = 2

DB_MISSING = -9.87654321*10^307
DB_PROPERTY_FACTOR = 1000

DBKey(item; property) = item*DB_PROPERTY_FACTOR + property
DBHasID(ids; id) = count(ids; id; 1) > 0
DBIsMissing(value) = clrunits(value) ≡ DB_MISSING
DBIsFatal(status) = and(status ≥ DB_ERR_NAME; status < DB_WARN_CLAMP_LOW)
DBIsWarning(status) = status ≥ DB_WARN_CLAMP_LOW
DBMethodOK(method) = or(method ≡ DB_NEAREST; method ≡ DB_LINEAR)
DBPolicyOK(bounds_policy) = or(bounds_policy ≡ DB_STRICT; bounds_policy ≡ DB_CLAMP; bounds_policy ≡ DB_EXTRAPOLATE)

DBTableStatus(table; item; property_column) = _
$block{
    safe_column = min(max(round(property_column); 1); n_cols(table)); 
    column_exists = and(property_column ≥ 2; property_column ≤ n_cols(table)); 
    values = vlookup(table; item; 1; safe_column); 
    item_exists = len(values) > 0; 
    raw = if(item_exists; take(1; values); DB_MISSING); 
    status = switch(not(column_exists); DB_ERR_BAD_COLUMN; not(item_exists); DB_ERR_NAME; DBIsMissing(raw); DB_ERR_MISSING; DB_OK); 
    status; 
}

DBTableRaw(table; item; property_column) = _
$block{
    status = DBTableStatus(table; item; property_column); 
    safe_column = min(max(round(property_column); 1); n_cols(table)); 
    values = vlookup(table; item; 1; safe_column); 
    raw = if(status ≡ DB_OK; take(1; values); 0/0); 
    raw; 
}

DBCurveExists(curve_table; curve_key) = len(vlookup(curve_table; curve_key; 1; 2)) > 0

DBRangeStatus(x; x_min; x_max; bounds_policy) = switch(not(DBPolicyOK(bounds_policy)); DB_ERR_BAD_POLICY; x_min > x_max; DB_ERR_BAD_RANGE; and(x < x_min; bounds_policy ≡ DB_STRICT); DB_ERR_BELOW_RANGE; and(x > x_max; bounds_policy ≡ DB_STRICT); DB_ERR_ABOVE_RANGE; and(x < x_min; bounds_policy ≡ DB_CLAMP); DB_WARN_CLAMP_LOW; and(x > x_max; bounds_policy ≡ DB_CLAMP); DB_WARN_CLAMP_HIGH; and(x < x_min; bounds_policy ≡ DB_EXTRAPOLATE); DB_WARN_EXTRAP_LOW; and(x > x_max; bounds_policy ≡ DB_EXTRAPOLATE); DB_WARN_EXTRAP_HIGH; DB_OK)

DBLinear(X; Y; x) = _
$block{
    n = len(X); 
    x_first = take(1; X); 
    x_last = take(n; X); 
    x_search = min(max(x; x_first); x_last); 
    lower_count = len(find_le(X; x_search; 1)); 
    i_1 = min(max(lower_count; 1); n - 1); 
    i_2 = i_1 + 1; 
    x_1 = take(i_1; X); 
    x_2 = take(i_2; X); 
    y_1 = take(i_1; Y); 
    y_2 = take(i_2; Y); 
    y = if(x_2 ≡ x_1; 0/0; y_1 + (x - x_1)*(y_2 - y_1)/(x_2 - x_1)); 
    y; 
}

DBNearest(X; Y; x) = _
$block{
    n = len(X); 
    x_first = take(1; X); 
    x_last = take(n; X); 
    x_search = min(max(x; x_first); x_last); 
    lower_count = len(find_le(X; x_search; 1)); 
    i_1 = min(max(lower_count; 1); n - 1); 
    i_2 = i_1 + 1; 
    x_1 = take(i_1; X); 
    x_2 = take(i_2; X); 
    i_near = if(abs(x_search - x_1) ≤ abs(x_2 - x_search); i_1; i_2); 
    y = take(i_near; Y); 
    y; 
}

DBCurveStatus(curve_table; curve_key; x; valid_min; valid_max; method; bounds_policy) = _
$block{
    X = vlookup(curve_table; curve_key; 1; 2); 
    Y = vlookup(curve_table; curve_key; 1; 3); 
    n_X = len(X); 
    n_Y = len(Y); 
    exists = n_X > 0; 
    enough_data = and(n_X ≥ 2; n_Y ≡ n_X); 
    missing_data = count(Y; DB_MISSING; 1) > 0; 
    status = switch(not(exists); DB_ERR_MISSING; not(enough_data); DB_ERR_INSUFFICIENT_DATA; missing_data; DB_ERR_MISSING; not(DBMethodOK(method)); DB_ERR_BAD_METHOD; DBRangeStatus(x; valid_min; valid_max; bounds_policy)); 
    status; 
}

DBCurveRaw(curve_table; curve_key; x; valid_min; valid_max; method; bounds_policy) = _
$block{
    status = DBCurveStatus(curve_table; curve_key; x; valid_min; valid_max; method; bounds_policy); 
    X = vlookup(curve_table; curve_key; 1; 2); 
    Y = vlookup(curve_table; curve_key; 1; 3); 
    x_eval = if(bounds_policy ≡ DB_CLAMP; min(max(x; valid_min); valid_max); x); 
    raw = switch(DBIsFatal(status); 0/0; method ≡ DB_NEAREST; DBNearest(X; Y; x_eval); method ≡ DB_LINEAR; DBLinear(X; Y; x_eval); 0/0); 
    raw; 
}

DBStatusKnown(status) = or(status ≡ DB_OK; status ≡ DB_ERR_NAME; status ≡ DB_ERR_PROPERTY; status ≡ DB_ERR_MISSING; status ≡ DB_ERR_BELOW_RANGE; status ≡ DB_ERR_ABOVE_RANGE; status ≡ DB_ERR_BAD_COLUMN; status ≡ DB_ERR_BAD_METHOD; status ≡ DB_ERR_INSUFFICIENT_DATA; status ≡ DB_ERR_BAD_POLICY; status ≡ DB_ERR_BAD_RANGE; status ≡ DB_WARN_CLAMP_LOW; status ≡ DB_WARN_CLAMP_HIGH; status ≡ DB_WARN_EXTRAP_LOW; status ≡ DB_WARN_EXTRAP_HIGH)

#def DBStatus$(status$)
	    #if status$ ≡ DB_OK
		        '<span class="ok">OK</span>
	    #end if
	    #if status$ ≡ DB_ERR_NAME
		        '<span class="err">Unknown item name or ID</span>
	    #end if
	    #if status$ ≡ DB_ERR_PROPERTY
		        '<span class="err">Unknown property name or ID</span>
	    #end if
	    #if status$ ≡ DB_ERR_MISSING
		        '<span class="err">Property value is missing</span>
	    #end if
	    #if status$ ≡ DB_ERR_BELOW_RANGE
		        '<span class="err">Query is below the valid range</span>
	    #end if
	    #if status$ ≡ DB_ERR_ABOVE_RANGE
		        '<span class="err">Query is above the valid range</span>
	    #end if
	    #if status$ ≡ DB_ERR_BAD_COLUMN
		        '<span class="err">Invalid property column</span>
	    #end if
	    #if status$ ≡ DB_ERR_BAD_METHOD
		        '<span class="err">Unsupported interpolation method</span>
	    #end if
	    #if status$ ≡ DB_ERR_INSUFFICIENT_DATA
		        '<span class="err">Curve requires at least two data points</span>
	    #end if
	    #if status$ ≡ DB_ERR_BAD_POLICY
		        '<span class="err">Unsupported range policy</span>
	    #end if
	    #if status$ ≡ DB_ERR_BAD_RANGE
		        '<span class="err">Invalid property range</span>
	    #end if
	    #if status$ ≡ DB_WARN_CLAMP_LOW
		        '<span class="note">Below range; clamped to minimum</span>
	    #end if
	    #if status$ ≡ DB_WARN_CLAMP_HIGH
		        '<span class="note">Above range; clamped to maximum</span>
	    #end if
	    #if status$ ≡ DB_WARN_EXTRAP_LOW
		        '<span class="note">Below range; extrapolated</span>
	    #end if
	    #if status$ ≡ DB_WARN_EXTRAP_HIGH
		        '<span class="note">Above range; extrapolated</span>
	    #end if
	    #if not(DBStatusKnown(status$))
		        '<span class="err">Unknown data-wrapper status</span>
	    #end if
#end def
#show
#hide
'<!-- Engineering check helpers. Version 1.2.0. -->

CHK_PASS = 0
CHK_WARN = 10
CHK_FAIL = 20
CHK_ERROR = 30

CHK_DEFAULT_WARNING = 0.9
CHK_FINITE_LIMIT = 1*10^300

CheckStatusKnown(status) = or(status ≡ CHK_PASS; status ≡ CHK_WARN; status ≡ CHK_FAIL; status ≡ CHK_ERROR)
CheckIsPass(status) = status ≡ CHK_PASS
CheckIsWarning(status) = status ≡ CHK_WARN
CheckIsFailure(status) = status ≥ CHK_FAIL
CheckWarningThresholdOK(warning_threshold) = and(warning_threshold ≥ 0; warning_threshold ≤ 1)
CheckUtilizationOK(utilization) = and(utilization ≡ utilization; utilization ≥ 0; abs(clrunits(utilization)) < CHK_FINITE_LIMIT)

CheckStatus(utilization; warning_threshold) = switch(not(CheckWarningThresholdOK(warning_threshold)); CHK_ERROR; not(CheckUtilizationOK(utilization)); CHK_ERROR; utilization > 1; CHK_FAIL; utilization ≥ warning_threshold; CHK_WARN; CHK_PASS)

CheckUpperUtilization(demand; capacity) = if(clrunits(capacity) > 0; abs(demand)/capacity; 0/0)
CheckUpperStatus(demand; capacity; warning_threshold) = if(clrunits(capacity) > 0; CheckStatus(CheckUpperUtilization(demand; capacity); warning_threshold); CHK_ERROR)

CheckLowerUtilization(provided; required) = if(clrunits(provided) > 0; abs(required)/provided; 0/0)
CheckLowerStatus(provided; required; warning_threshold) = if(clrunits(provided) > 0; CheckStatus(CheckLowerUtilization(provided; required); warning_threshold); CHK_ERROR)

CheckCount(statuses; status) = count(statuses; status; 1)
CheckPassCount(statuses) = CheckCount(statuses; CHK_PASS)
CheckWarningCount(statuses) = CheckCount(statuses; CHK_WARN)
CheckFailureCount(statuses) = CheckCount(statuses; CHK_FAIL)
CheckKnownCount(statuses) = CheckPassCount(statuses) + CheckWarningCount(statuses) + CheckFailureCount(statuses) + CheckCount(statuses; CHK_ERROR)
CheckUnknownCount(statuses) = len(statuses) - CheckKnownCount(statuses)
CheckErrorCount(statuses) = CheckCount(statuses; CHK_ERROR) + CheckUnknownCount(statuses)

CheckStatusesOK(statuses) = and(len(statuses) > 0; CheckUnknownCount(statuses) ≡ 0)
CheckUtilizationsOK(utilizations) = and(len(utilizations) > 0; len(find_ge(clrunits(utilizations); 0; 1)) ≡ len(utilizations); len(find_lt(abs(clrunits(utilizations)); CHK_FINITE_LIMIT; 1)) ≡ len(utilizations))
CheckSummaryDataOK(statuses; utilizations) = and(CheckStatusesOK(statuses); CheckUtilizationsOK(utilizations); len(statuses) ≡ len(utilizations))

CheckOverallStatus(statuses) = switch(not(CheckStatusesOK(statuses)); CHK_ERROR; CheckErrorCount(statuses) > 0; CHK_ERROR; CheckFailureCount(statuses) > 0; CHK_FAIL; CheckWarningCount(statuses) > 0; CHK_WARN; CHK_PASS)
CheckSummaryStatus(statuses; utilizations) = if(CheckSummaryDataOK(statuses; utilizations); CheckOverallStatus(statuses); CHK_ERROR)
CheckGatedStatus(inputs_valid; status) = switch(not(inputs_valid); CHK_ERROR; not(CheckStatusKnown(status)); CHK_ERROR; status)

CheckGoverningUtilization(utilizations) = _
$block{
    safe_utilizations = join(clrunits(utilizations); -1);
    governing_utilization = max(safe_utilizations);
    result = if(CheckUtilizationsOK(utilizations); governing_utilization; 0/0);
    result;
}

CheckGoverningIndex(utilizations) = _
$block{
    safe_utilizations = join(clrunits(utilizations); -1);
    governing_utilization = max(safe_utilizations);
    governing_indexes = find_eq(safe_utilizations; governing_utilization; 1);
    governing_index = take(1; governing_indexes);
    result = if(CheckUtilizationsOK(utilizations); governing_index; 0);
    result;
}

CheckWorst(statuses) = CheckOverallStatus(statuses)
CheckNoFailures(statuses) = CheckOverallStatus(statuses) < CHK_FAIL
CheckAllPass(statuses) = CheckOverallStatus(statuses) ≡ CHK_PASS

#def CheckStatus$(status$)
    #if status$ ≡ CHK_PASS
        '<span class="ok">PASS</span>
    #end if
    #if status$ ≡ CHK_WARN
        '<span class="note">WARNING</span>
    #end if
    #if status$ ≡ CHK_FAIL
        '<span class="err">FAIL</span>
    #end if
    #if status$ ≡ CHK_ERROR
        '<span class="err">CHECK ERROR</span>
    #end if
    #if not(CheckStatusKnown(status$))
        '<span class="err">UNKNOWN CHECK STATUS</span>
    #end if
#end def

#def ShowCheck$(label$; utilization$; status$)
    '<table class="bordered data" style="width:95%">
    '<tbody>
    '<tr><td><strong>Check</strong></td><td>label$</td></tr>
    '<tr><td><strong>Utilization</strong></td><td>'utilization$'</td></tr>
    '<tr><td><strong>Status</strong></td><td>
    CheckStatus$(status$)
    '</td></tr>
    '</tbody>
    '</table>
#end def

#def BeginCheckSummary$
    '<table class="bordered data reporting-summary check-summary">
    '<thead>
    '<tr><th>Demand / Required</th><th>Capacity / Provided</th><th>Utilization</th><th>Warning</th><th>Acceptance Criterion</th><th>Status</th></tr>
    '</thead>
    '<tbody>
#end def

#def AddCheckRow$(label$; demand$; capacity$; utilization$; warning_threshold$; criterion$; status$)
    '<tr class="check-title"><th colspan="6">label$</th></tr>
    '<tr><td class="check-demand">'demand$'</td><td>'capacity$'</td><td>'utilization$'</td><td>'warning_threshold$'</td><td>criterion$</td><td class="status-cell">
    CheckStatus$(status$)
    '</td></tr>
#end def

#def EndCheckSummary$
    '</tbody>
    '</table>
#end def

#def EndCheckSummaryWithResult$(statuses$; utilizations$; governing_label$)
    '</tbody>
    '<tfoot>
    '<tr class="check-counts"><th>Check counts</th><td><strong>Pass:</strong> 'CheckPassCount(statuses$)'</td><td><strong>Warning:</strong> 'CheckWarningCount(statuses$)'</td><td><strong>Fail:</strong> 'CheckFailureCount(statuses$)'</td><td><strong>Error:</strong> 'CheckErrorCount(statuses$)'</td><td class="status-cell"><strong>Overall:</strong>
    CheckStatus$(CheckSummaryStatus(statuses$; utilizations$))
    '</td></tr>
    #if CheckSummaryDataOK(statuses$; utilizations$)
        '<tr class="check-governing"><th>Governing check</th><td colspan="3">governing_label$ (row 'CheckGoverningIndex(utilizations$)')</td><th>Utilization</th><td>'CheckGoverningUtilization(utilizations$)'</td></tr>
    #end if
    #if not(CheckSummaryDataOK(statuses$; utilizations$))
        '<tr class="check-governing"><th>Governing check</th><td colspan="3">Not available</td><th>Utilization</th><td>Not available</td></tr>
    #end if
    '</tfoot>
    '</table>
#end def
#show
#hide
'<!-- General table and metadata lookup helpers. Version 1.0.0. -->

DBColumnOK(table; column) = and(column ≡ round(column); column ≥ 1; column ≤ n_cols(table))

DBLookupExists(table; key; key_column) = _
$block{
    safe_key_column = min(max(round(key_column); 1); n_cols(table));
    matches = vlookup(table; key; safe_key_column; safe_key_column);
    exists = and(DBColumnOK(table; key_column); len(matches) > 0);
    exists;
}

DBLookupStatus(table; key; key_column; value_column) = _
$block{
    safe_key_column = min(max(round(key_column); 1); n_cols(table));
    safe_value_column = min(max(round(value_column); 1); n_cols(table));
    columns_ok = and(DBColumnOK(table; key_column); DBColumnOK(table; value_column));
    values = vlookup(table; key; safe_key_column; safe_value_column);
    row_exists = len(values) > 0;
    raw = if(row_exists; take(1; values); DB_MISSING);
    status = switch(not(columns_ok); DB_ERR_BAD_COLUMN; not(row_exists); DB_ERR_NAME; DBIsMissing(raw); DB_ERR_MISSING; DB_OK);
    status;
}

DBLookupRaw(table; key; key_column; value_column) = _
$block{
    status = DBLookupStatus(table; key; key_column; value_column);
    safe_key_column = min(max(round(key_column); 1); n_cols(table));
    safe_value_column = min(max(round(value_column); 1); n_cols(table));
    values = vlookup(table; key; safe_key_column; safe_value_column);
    raw = if(status ≡ DB_OK; take(1; values); 0/0);
    raw;
}

DBLookupOr(table; key; key_column; value_column; fallback) = if(DBLookupStatus(table; key; key_column; value_column) ≡ DB_OK; DBLookupRaw(table; key; key_column; value_column); fallback)
DBMetadataSource(metadata; item) = DBLookupRaw(metadata; item; 1; 2)
DBMetadataRevision(metadata; item) = DBLookupRaw(metadata; item; 1; 3)
DBRegistryStatus(ids; id) = if(DBHasID(ids; id); DB_OK; DB_ERR_NAME)
DBRegistryCount(ids) = len(ids)
#show
#hide
'<!-- Input validation helpers. Version 1.2.0. -->

VAL_OK = 0
VAL_WARN = 10
VAL_ERR_UNDEFINED = 20
VAL_ERR_BELOW_RANGE = 21
VAL_ERR_ABOVE_RANGE = 22
VAL_ERR_BAD_RANGE = 23
VAL_ERR_NONPOSITIVE = 24
VAL_ERR_NEGATIVE = 25
VAL_ERR_NOT_INTEGER = 26
VAL_ERR_LENGTH = 27
VAL_ERR_NOT_ALLOWED = 28
VAL_ERR_UNKNOWN = 29

VAL_FINITE_LIMIT = 1*10^300
VAL_INTEGER_TOLERANCE = 1*10^-9

ValidationStatusKnown(status) = or(status ≡ VAL_OK; status ≡ VAL_WARN; status ≡ VAL_ERR_UNDEFINED; status ≡ VAL_ERR_BELOW_RANGE; status ≡ VAL_ERR_ABOVE_RANGE; status ≡ VAL_ERR_BAD_RANGE; status ≡ VAL_ERR_NONPOSITIVE; status ≡ VAL_ERR_NEGATIVE; status ≡ VAL_ERR_NOT_INTEGER; status ≡ VAL_ERR_LENGTH; status ≡ VAL_ERR_NOT_ALLOWED; status ≡ VAL_ERR_UNKNOWN)
ValidationIsError(status) = status ≥ VAL_ERR_UNDEFINED
ValidationIsFinite(value) = and(value ≡ value; abs(clrunits(value)) < VAL_FINITE_LIMIT)
ValidationIsInteger(value) = and(ValidationIsFinite(value); abs(clrunits(value) - round(clrunits(value))) ≤ VAL_INTEGER_TOLERANCE)

ValidationRangeStatus(value; minimum; maximum) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; minimum > maximum; VAL_ERR_BAD_RANGE; value < minimum; VAL_ERR_BELOW_RANGE; value > maximum; VAL_ERR_ABOVE_RANGE; VAL_OK)
ValidationPositiveStatus(value) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; clrunits(value) ≤ 0; VAL_ERR_NONPOSITIVE; VAL_OK)
ValidationNonnegativeStatus(value) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; clrunits(value) < 0; VAL_ERR_NEGATIVE; VAL_OK)
ValidationIntegerStatus(value) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; not(ValidationIsInteger(value)); VAL_ERR_NOT_INTEGER; VAL_OK)
ValidationLengthStatus(values; minimum_length; maximum_length) = switch(minimum_length < 0; VAL_ERR_BAD_RANGE; maximum_length < minimum_length; VAL_ERR_BAD_RANGE; len(values) < minimum_length; VAL_ERR_LENGTH; len(values) > maximum_length; VAL_ERR_LENGTH; VAL_OK)
ValidationAllowedStatus(value; allowed_values) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; count(allowed_values; value; 1) ≡ 0; VAL_ERR_NOT_ALLOWED; VAL_OK)

ValidationWorst(statuses) = max(statuses)
ValidationCount(statuses; status) = count(statuses; status; 1)
ValidationWarningCount(statuses) = ValidationCount(statuses; VAL_WARN)
ValidationErrorCount(statuses) = len(statuses) - ValidationCount(statuses; VAL_OK) - ValidationWarningCount(statuses)
ValidationHasErrors(statuses) = ValidationErrorCount(statuses) > 0
ValidationOverallStatus(statuses) = switch(ValidationHasErrors(statuses); VAL_ERR_UNKNOWN; ValidationWarningCount(statuses) > 0; VAL_WARN; VAL_OK)
ValidationAllOK(statuses) = ValidationWorst(statuses) ≡ VAL_OK

#def ValidationStatus$(status$)
    #if status$ ≡ VAL_OK
        '<span class="ok">VALID</span>
    #end if
    #if status$ ≡ VAL_WARN
        '<span class="note">VALIDATION WARNING</span>
    #end if
    #if status$ ≡ VAL_ERR_UNDEFINED
        '<span class="err">Value is undefined or non-finite</span>
    #end if
    #if status$ ≡ VAL_ERR_BELOW_RANGE
        '<span class="err">Value is below the permitted range</span>
    #end if
    #if status$ ≡ VAL_ERR_ABOVE_RANGE
        '<span class="err">Value is above the permitted range</span>
    #end if
    #if status$ ≡ VAL_ERR_BAD_RANGE
        '<span class="err">Validation range is invalid</span>
    #end if
    #if status$ ≡ VAL_ERR_NONPOSITIVE
        '<span class="err">Value must be positive</span>
    #end if
    #if status$ ≡ VAL_ERR_NEGATIVE
        '<span class="err">Value must be nonnegative</span>
    #end if
    #if status$ ≡ VAL_ERR_NOT_INTEGER
        '<span class="err">Value must be an integer</span>
    #end if
    #if status$ ≡ VAL_ERR_LENGTH
        '<span class="err">Vector or matrix length is invalid</span>
    #end if
    #if status$ ≡ VAL_ERR_NOT_ALLOWED
        '<span class="err">Value is not one of the permitted options</span>
    #end if
    #if or(status$ ≡ VAL_ERR_UNKNOWN; not(ValidationStatusKnown(status$)))
        '<span class="err">Unknown validation status</span>
    #end if
#end def

#def ShowValidation$(label$; value$; status$)
    '<table class="bordered data" style="width:95%">
    '<tbody>
    '<tr><td><strong>Input</strong></td><td>label$</td></tr>
    '<tr><td><strong>Value</strong></td><td>'value$'</td></tr>
    '<tr><td><strong>Status</strong></td><td>
    ValidationStatus$(status$)
    '</td></tr>
    '</tbody>
    '</table>
#end def

#def ValidationSummaryStatus$(statuses$)
    #if ValidationHasErrors(statuses$)
        '<span class="err">INVALID</span>
    #end if
    #if and(not(ValidationHasErrors(statuses$)); ValidationWarningCount(statuses$) > 0)
        '<span class="note">VALIDATION WARNING</span>
    #end if
    #if and(not(ValidationHasErrors(statuses$)); ValidationWarningCount(statuses$) ≡ 0)
        '<span class="ok">VALID</span>
    #end if
#end def

#def BeginValidationSummary$
    '<table class="bordered data reporting-summary validation-summary">
    '<thead>
    '<tr><th>Input</th><th>Value</th><th>Permitted</th><th>Status</th></tr>
    '</thead>
    '<tbody>
#end def

#def AddValidationRow$(label$; value$; permitted$; status$)
    '<tr><td>label$</td><td>'value$'</td><td>permitted$</td><td class="status-cell">
    ValidationStatus$(status$)
    '</td></tr>
#end def

#def EndValidationSummary$(statuses$)
    '</tbody>
    '<tfoot>
    '<tr><th colspan="2">Overall validation</th><td><strong>Errors:</strong> 'ValidationErrorCount(statuses$)'</td><td class="status-cell">
    ValidationSummaryStatus$(statuses$)
    '</td></tr>
    '</tfoot>
    '</table>
#end def
#show
#hide
