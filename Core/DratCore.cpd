    ValidationStatus$(status$)
    '</p>
#end def
#def AddCheckConclusion$(label$; status$)
    '<p><strong>label$:</strong>
    CheckStatus$(status$)
    '</p>
#end def
#def EndConclusions$
    '</div>
#end def
#show
#hide
'<!-- Generic numeric property-wrapper core. Version 0.3.3. -->

#def DBWrapperName$ = DRAT Data Wrapper
#def DBWrapperVersion$ = 0.3.3

DB_OK = 0
DB_ERR_NAME = 10
DB_ERR_PROPERTY = 11
DB_ERR_MISSING = 12
DB_ERR_BELOW_RANGE = 13
DB_ERR_ABOVE_RANGE = 14
DB_ERR_BAD_COLUMN = 15
DB_ERR_BAD_METHOD = 16
DB_ERR_INSUFFICIENT_DATA = 17
DB_ERR_BAD_POLICY = 18
DB_ERR_BAD_RANGE = 19
DB_WARN_CLAMP_LOW = 20
DB_WARN_CLAMP_HIGH = 21
DB_WARN_EXTRAP_LOW = 22
DB_WARN_EXTRAP_HIGH = 23

DB_NEAREST = 0
DB_LINEAR = 1

DB_STRICT = 0
DB_CLAMP = 1
DB_EXTRAPOLATE = 2

'<!-- DB_MISSING is a reserved finite scalar so mixed-unit numeric tables can carry explicit missing data without relying on undefined values. -->
DB_MISSING = -9.87654321*10^307
'<!-- Property IDs must remain below this factor so DBKey produces a unique item-property key. -->
DB_PROPERTY_FACTOR = 1000

DBKey(item; property) = item*DB_PROPERTY_FACTOR + property
DBHasID(ids; id) = count(ids; id; 1) > 0
DBIsMissing(value) = clrunits(value) ≡ DB_MISSING
DBIsFatal(status) = and(status ≥ DB_ERR_NAME; status < DB_WARN_CLAMP_LOW)
DBIsWarning(status) = status ≥ DB_WARN_CLAMP_LOW
DBMethodOK(method) = or(method ≡ DB_NEAREST; method ≡ DB_LINEAR)
DBPolicyOK(bounds_policy) = or(bounds_policy ≡ DB_STRICT; bounds_policy ≡ DB_CLAMP; bounds_policy ≡ DB_EXTRAPOLATE)

'<!-- Clamp the lookup column before vlookup because CalcPad may evaluate function arguments even when a later status rejects the request. -->
DBTableStatus(table; item; property_column) = _
$block{
    safe_column = min(max(round(property_column); 1); n_cols(table)); 
    column_exists = and(property_column ≥ 2; property_column ≤ n_cols(table)); 
    values = vlookup(table; item; 1; safe_column); 
    item_exists = len(values) > 0; 
    raw = if(item_exists; take(1; values); DB_MISSING); 
    status = switch(not(column_exists); DB_ERR_BAD_COLUMN; not(item_exists); DB_ERR_NAME; DBIsMissing(raw); DB_ERR_MISSING; DB_OK); 
    status; 
}

DBTableRaw(table; item; property_column) = _
$block{
    status = DBTableStatus(table; item; property_column); 
    safe_column = min(max(round(property_column); 1); n_cols(table)); 
    values = vlookup(table; item; 1; safe_column); 
    raw = if(status ≡ DB_OK; take(1; values); 0/0); 
    raw; 
}

DBCurveExists(curve_table; curve_key) = len(vlookup(curve_table; curve_key; 1; 2)) > 0

DBRangeStatus(x; x_min; x_max; bounds_policy) = switch(not(DBPolicyOK(bounds_policy)); DB_ERR_BAD_POLICY; x_min > x_max; DB_ERR_BAD_RANGE; and(x < x_min; bounds_policy ≡ DB_STRICT); DB_ERR_BELOW_RANGE; and(x > x_max; bounds_policy ≡ DB_STRICT); DB_ERR_ABOVE_RANGE; and(x < x_min; bounds_policy ≡ DB_CLAMP); DB_WARN_CLAMP_LOW; and(x > x_max; bounds_policy ≡ DB_CLAMP); DB_WARN_CLAMP_HIGH; and(x < x_min; bounds_policy ≡ DB_EXTRAPOLATE); DB_WARN_EXTRAP_LOW; and(x > x_max; bounds_policy ≡ DB_EXTRAPOLATE); DB_WARN_EXTRAP_HIGH; DB_OK)

DBLinear(X; Y; x) = _
$block{
    n = len(X); 
    x_first = take(1; X); 
    x_last = take(n; X); 
    x_search = min(max(x; x_first); x_last); 
    lower_count = len(find_le(X; x_search; 1)); 
    i_1 = min(max(lower_count; 1); n - 1); 
    i_2 = i_1 + 1; 
    x_1 = take(i_1; X); 
    x_2 = take(i_2; X); 
    y_1 = take(i_1; Y); 
    y_2 = take(i_2; Y); 
    y = if(x_2 ≡ x_1; 0/0; y_1 + (x - x_1)*(y_2 - y_1)/(x_2 - x_1)); 
    y; 
}

DBNearest(X; Y; x) = _
$block{
    n = len(X); 
    x_first = take(1; X); 
    x_last = take(n; X); 
    x_search = min(max(x; x_first); x_last); 
    lower_count = len(find_le(X; x_search; 1)); 
    i_1 = min(max(lower_count; 1); n - 1); 
    i_2 = i_1 + 1; 
    x_1 = take(i_1; X); 
    x_2 = take(i_2; X); 
    i_near = if(abs(x_search - x_1) ≤ abs(x_2 - x_search); i_1; i_2); 
    y = take(i_near; Y); 
    y; 
}

DBCurveStatus(curve_table; curve_key; x; valid_min; valid_max; method; bounds_policy) = _
$block{
    X = vlookup(curve_table; curve_key; 1; 2); 
    Y = vlookup(curve_table; curve_key; 1; 3); 
    n_X = len(X); 
    n_Y = len(Y); 
    exists = n_X > 0; 
    enough_data = and(n_X ≥ 2; n_Y ≡ n_X); 
    missing_data = count(Y; DB_MISSING; 1) > 0; 
    status = switch(not(exists); DB_ERR_MISSING; not(enough_data); DB_ERR_INSUFFICIENT_DATA; missing_data; DB_ERR_MISSING; not(DBMethodOK(method)); DB_ERR_BAD_METHOD; DBRangeStatus(x; valid_min; valid_max; bounds_policy)); 
    status; 
}

DBCurveRaw(curve_table; curve_key; x; valid_min; valid_max; method; bounds_policy) = _
$block{
    status = DBCurveStatus(curve_table; curve_key; x; valid_min; valid_max; method; bounds_policy); 
    X = vlookup(curve_table; curve_key; 1; 2); 
    Y = vlookup(curve_table; curve_key; 1; 3); 
    x_eval = if(bounds_policy ≡ DB_CLAMP; min(max(x; valid_min); valid_max); x); 
    raw = switch(DBIsFatal(status); 0/0; method ≡ DB_NEAREST; DBNearest(X; Y; x_eval); method ≡ DB_LINEAR; DBLinear(X; Y; x_eval); 0/0); 
    raw; 
}

DBStatusKnown(status) = or(status ≡ DB_OK; status ≡ DB_ERR_NAME; status ≡ DB_ERR_PROPERTY; status ≡ DB_ERR_MISSING; status ≡ DB_ERR_BELOW_RANGE; status ≡ DB_ERR_ABOVE_RANGE; status ≡ DB_ERR_BAD_COLUMN; status ≡ DB_ERR_BAD_METHOD; status ≡ DB_ERR_INSUFFICIENT_DATA; status ≡ DB_ERR_BAD_POLICY; status ≡ DB_ERR_BAD_RANGE; status ≡ DB_WARN_CLAMP_LOW; status ≡ DB_WARN_CLAMP_HIGH; status ≡ DB_WARN_EXTRAP_LOW; status ≡ DB_WARN_EXTRAP_HIGH)

#def DBStatus$(status$)
	    #if status$ ≡ DB_OK
		        '<span class="ok">OK</span>
	    #end if
	    #if status$ ≡ DB_ERR_NAME
		        '<span class="err">Unknown item name or ID</span>
	    #end if
	    #if status$ ≡ DB_ERR_PROPERTY
		        '<span class="err">Unknown property name or ID</span>
	    #end if
	    #if status$ ≡ DB_ERR_MISSING
		        '<span class="err">Property value is missing</span>
	    #end if
	    #if status$ ≡ DB_ERR_BELOW_RANGE
		        '<span class="err">Query is below the valid range</span>
	    #end if
	    #if status$ ≡ DB_ERR_ABOVE_RANGE
		        '<span class="err">Query is above the valid range</span>
	    #end if
	    #if status$ ≡ DB_ERR_BAD_COLUMN
		        '<span class="err">Invalid property column</span>
	    #end if
	    #if status$ ≡ DB_ERR_BAD_METHOD
		        '<span class="err">Unsupported interpolation method</span>
	    #end if
	    #if status$ ≡ DB_ERR_INSUFFICIENT_DATA
		        '<span class="err">Curve requires at least two data points</span>
	    #end if
	    #if status$ ≡ DB_ERR_BAD_POLICY
		        '<span class="err">Unsupported range policy</span>
	    #end if
	    #if status$ ≡ DB_ERR_BAD_RANGE
		        '<span class="err">Invalid property range</span>
	    #end if
	    #if status$ ≡ DB_WARN_CLAMP_LOW
		        '<span class="note">Below range; clamped to minimum</span>
	    #end if
	    #if status$ ≡ DB_WARN_CLAMP_HIGH
		        '<span class="note">Above range; clamped to maximum</span>
	    #end if
	    #if status$ ≡ DB_WARN_EXTRAP_LOW
		        '<span class="note">Below range; extrapolated</span>
	    #end if
	    #if status$ ≡ DB_WARN_EXTRAP_HIGH
		        '<span class="note">Above range; extrapolated</span>
	    #end if
	    #if not(DBStatusKnown(status$))
		        '<span class="err">Unknown data-wrapper status</span>
	    #end if
#end def
#show
#hide
'<!-- Engineering check helpers. Version 2.0.0. -->

CHK_PASS = 0
CHK_WARN = 10
CHK_FAIL = 20
CHK_ERROR = 30

CHK_DEFAULT_WARNING = 0.9
'<!-- This guard rejects NaN and overflow-like results while remaining far beyond practical engineering utilizations. -->
CHK_FINITE_LIMIT = 1*10^300

CheckStatusKnown(status) = or(status ≡ CHK_PASS; status ≡ CHK_WARN; status ≡ CHK_FAIL; status ≡ CHK_ERROR)
CheckIsPass(status) = status ≡ CHK_PASS
CheckIsWarning(status) = status ≡ CHK_WARN
CheckIsFailure(status) = status ≥ CHK_FAIL
CheckWarningThresholdOK(warning_threshold) = and(warning_threshold ≥ 0; warning_threshold ≤ 1)
CheckUtilizationOK(utilization) = and(utilization ≡ utilization; utilization ≥ 0; abs(clrunits(utilization)) < CHK_FINITE_LIMIT)

CheckStatus(utilization; warning_threshold) = switch(not(CheckWarningThresholdOK(warning_threshold)); CHK_ERROR; not(CheckUtilizationOK(utilization)); CHK_ERROR; utilization > 1; CHK_FAIL; utilization ≥ warning_threshold; CHK_WARN; CHK_PASS)

CheckUpperUtilization(demand; capacity) = if(clrunits(capacity) > 0; abs(demand)/capacity; 0/0)
CheckUpperStatus(demand; capacity; warning_threshold) = if(clrunits(capacity) > 0; CheckStatus(CheckUpperUtilization(demand; capacity); warning_threshold); CHK_ERROR)

CheckLowerUtilization(provided; required) = if(clrunits(provided) > 0; abs(required)/provided; 0/0)
CheckLowerStatus(provided; required; warning_threshold) = if(clrunits(provided) > 0; CheckStatus(CheckLowerUtilization(provided; required); warning_threshold); CHK_ERROR)

CheckCount(statuses; status) = count(statuses; status; 1)
CheckPassCount(statuses) = CheckCount(statuses; CHK_PASS)
CheckWarningCount(statuses) = CheckCount(statuses; CHK_WARN)
CheckFailureCount(statuses) = CheckCount(statuses; CHK_FAIL)
CheckKnownCount(statuses) = CheckPassCount(statuses) + CheckWarningCount(statuses) + CheckFailureCount(statuses) + CheckCount(statuses; CHK_ERROR)
CheckUnknownCount(statuses) = len(statuses) - CheckKnownCount(statuses)
CheckErrorCount(statuses) = CheckCount(statuses; CHK_ERROR) + CheckUnknownCount(statuses)

CheckStatusesOK(statuses) = and(len(statuses) > 0; CheckUnknownCount(statuses) ≡ 0)
CheckUtilizationsOK(utilizations) = and(len(utilizations) > 0; len(find_ge(clrunits(utilizations); 0; 1)) ≡ len(utilizations); len(find_lt(abs(clrunits(utilizations)); CHK_FINITE_LIMIT; 1)) ≡ len(utilizations))
CheckSummaryDataOK(statuses; utilizations) = and(CheckStatusesOK(statuses); CheckUtilizationsOK(utilizations); len(statuses) ≡ len(utilizations))

CheckOverallStatus(statuses) = switch(not(CheckStatusesOK(statuses)); CHK_ERROR; CheckErrorCount(statuses) > 0; CHK_ERROR; CheckFailureCount(statuses) > 0; CHK_FAIL; CheckWarningCount(statuses) > 0; CHK_WARN; CHK_PASS)
CheckSummaryStatus(statuses; utilizations) = if(CheckSummaryDataOK(statuses; utilizations); CheckOverallStatus(statuses); CHK_ERROR)
CheckGatedStatus(inputs_valid; status) = switch(not(inputs_valid); CHK_ERROR; not(CheckStatusKnown(status)); CHK_ERROR; status)

CheckGoverningUtilization(utilizations) = _
$block{
    safe_utilizations = join(clrunits(utilizations); -1);
    governing_utilization = max(safe_utilizations);
    result = if(CheckUtilizationsOK(utilizations); governing_utilization; 0/0);
    result;
}

CheckGoverningIndex(utilizations) = _
$block{
    safe_utilizations = join(clrunits(utilizations); -1);
    governing_utilization = max(safe_utilizations);
    governing_indexes = find_eq(safe_utilizations; governing_utilization; 1);
    governing_index = take(1; governing_indexes);
    result = if(CheckUtilizationsOK(utilizations); governing_index; 0);
    result;
}

CheckWorst(statuses) = CheckOverallStatus(statuses)
CheckNoFailures(statuses) = CheckOverallStatus(statuses) < CHK_FAIL
CheckAllPass(statuses) = CheckOverallStatus(statuses) ≡ CHK_PASS

#def CheckStatus$(status$)
    #if status$ ≡ CHK_PASS
        '<span class="ok">PASS</span>
    #end if
    #if status$ ≡ CHK_WARN
        '<span class="note">WARNING</span>
    #end if
    #if status$ ≡ CHK_FAIL
        '<span class="err">FAIL</span>
    #end if
    #if status$ ≡ CHK_ERROR
        '<span class="err">CHECK ERROR</span>
    #end if
    #if not(CheckStatusKnown(status$))
        '<span class="err">UNKNOWN CHECK STATUS</span>
    #end if
#end def

#def ShowCheck$(label$; utilization$; status$)
    '<table class="bordered data" style="width:95%">
    '<tbody>
    '<tr><td><strong>Check</strong></td><td>label$</td></tr>
    '<tr><td><strong>Utilization</strong></td><td>'utilization$'</td></tr>
    '<tr><td><strong>Status</strong></td><td>
    CheckStatus$(status$)
    '</td></tr>
    '</tbody>
    '</table>
#end def

#show
#hide
'<!-- General table and metadata lookup helpers. Version 1.0.0. -->

DBColumnOK(table; column) = and(column ≡ round(column); column ≥ 1; column ≤ n_cols(table))

'<!-- Clamp before vlookup so an invalid requested column returns a status instead of causing an eager-evaluation error. -->
DBLookupExists(table; key; key_column) = _
$block{
    safe_key_column = min(max(round(key_column); 1); n_cols(table));
    matches = vlookup(table; key; safe_key_column; safe_key_column);
    exists = and(DBColumnOK(table; key_column); len(matches) > 0);
    exists;
}

DBLookupStatus(table; key; key_column; value_column) = _
$block{
    safe_key_column = min(max(round(key_column); 1); n_cols(table));
    safe_value_column = min(max(round(value_column); 1); n_cols(table));
    columns_ok = and(DBColumnOK(table; key_column); DBColumnOK(table; value_column));
    values = vlookup(table; key; safe_key_column; safe_value_column);
    row_exists = len(values) > 0;
    raw = if(row_exists; take(1; values); DB_MISSING);
    status = switch(not(columns_ok); DB_ERR_BAD_COLUMN; not(row_exists); DB_ERR_NAME; DBIsMissing(raw); DB_ERR_MISSING; DB_OK);
    status;
}

DBLookupRaw(table; key; key_column; value_column) = _
$block{
    status = DBLookupStatus(table; key; key_column; value_column);
    safe_key_column = min(max(round(key_column); 1); n_cols(table));
    safe_value_column = min(max(round(value_column); 1); n_cols(table));
    values = vlookup(table; key; safe_key_column; safe_value_column);
    raw = if(status ≡ DB_OK; take(1; values); 0/0);
    raw;
}

DBLookupOr(table; key; key_column; value_column; fallback) = if(DBLookupStatus(table; key; key_column; value_column) ≡ DB_OK; DBLookupRaw(table; key; key_column; value_column); fallback)
DBMetadataSource(metadata; item) = DBLookupRaw(metadata; item; 1; 2)
DBMetadataRevision(metadata; item) = DBLookupRaw(metadata; item; 1; 3)
DBRegistryStatus(ids; id) = if(DBHasID(ids; id); DB_OK; DB_ERR_NAME)
DBRegistryCount(ids) = len(ids)
#show
#hide
'<!-- Input validation helpers. Version 2.0.0. -->

VAL_OK = 0
VAL_WARN = 10
VAL_ERR_UNDEFINED = 20
VAL_ERR_BELOW_RANGE = 21
VAL_ERR_ABOVE_RANGE = 22
VAL_ERR_BAD_RANGE = 23
VAL_ERR_NONPOSITIVE = 24
VAL_ERR_NEGATIVE = 25
VAL_ERR_NOT_INTEGER = 26
VAL_ERR_LENGTH = 27
VAL_ERR_NOT_ALLOWED = 28
VAL_ERR_UNKNOWN = 29
VAL_ERR_BAD_RESULT = 30
VAL_ERR_BAD_SET = 31
VAL_ERR_NOT_REGISTERED = 32
VAL_ERR_NONNEGATIVE = 33
VAL_ERR_POSITIVE = 34
VAL_ERR_ZERO = 35
VAL_ERR_DIMENSIONS = 36
VAL_ERR_ORDER = 37
VAL_ERR_DUPLICATE = 38
VAL_ERR_INSIDE_RANGE = 39
VAL_ERR_NONZERO = 40

VAL_RULE_RANGE = 1
VAL_RULE_POSITIVE = 2
VAL_RULE_NONNEGATIVE = 3
VAL_RULE_INTEGER = 4
VAL_RULE_LENGTH = 5
VAL_RULE_ALLOWED = 6
VAL_RULE_AVAILABLE = 7
VAL_RULE_REGISTERED = 8
VAL_RULE_DEFINED = 9
VAL_RULE_NEGATIVE = 10
VAL_RULE_NONPOSITIVE = 11
VAL_RULE_NONZERO = 12
VAL_RULE_MINIMUM = 13
VAL_RULE_MAXIMUM = 14
VAL_RULE_OPEN_RANGE = 15
VAL_RULE_OUTSIDE_RANGE = 16
VAL_RULE_ABSOLUTE_MAXIMUM = 17
VAL_RULE_MATRIX_ROWS = 18
VAL_RULE_MATRIX_COLUMNS = 19
VAL_RULE_SQUARE_MATRIX = 20
VAL_RULE_VECTOR_RANGE = 21
VAL_RULE_VECTOR_POSITIVE = 22
VAL_RULE_VECTOR_NONNEGATIVE = 23
VAL_RULE_INCREASING = 24
VAL_RULE_NONDECREASING = 25
VAL_RULE_UNIQUE = 26
VAL_RULE_MATCHING_LENGTH = 27
VAL_RULE_ZERO = 28
VAL_RULE_VECTOR_DEFINED = 29
VAL_RULE_VECTOR_NEGATIVE = 30
VAL_RULE_VECTOR_NONPOSITIVE = 31

'<!-- Validation results use [status; value; rule; data_1; data_2]; each rule defines whether the final fields are bounds, dimensions, a set ID, or VAL_EMPTY. -->
VAL_RESULT_STATUS = 1
VAL_RESULT_VALUE = 2
VAL_RESULT_RULE = 3
VAL_RESULT_DATA_1 = 4
VAL_RESULT_DATA_2 = 5
VAL_RESULT_LENGTH = 5

VAL_REG_OK = 0
VAL_REG_ERR_BAD_REGISTRY = 10
VAL_REG_ERR_BAD_RESULT = 20
VAL_REG_ERR_BAD_ID = 30
VAL_REG_ERR_DUPLICATE_ID = 40

'<!-- Registry rows prepend a stable input ID to the five-field validation result. The first sentinel row preserves a predictable six-column matrix when empty. -->
VAL_REG_ID = 1
VAL_REG_STATUS = 2
VAL_REG_VALUE = 3
VAL_REG_RULE = 4
VAL_REG_DATA_1 = 5
VAL_REG_DATA_2 = 6
VAL_REG_COLUMNS = 6
VAL_REG_EMPTY = 0

VAL_EMPTY = DB_MISSING

'<!-- Finite and integer guards are unit-neutral after clrunits; the tolerance absorbs ordinary floating-point roundoff only. -->
VAL_FINITE_LIMIT = 1*10^300
VAL_INTEGER_TOLERANCE = 1*10^-9

ValidationStatusKnown(status) = or(status ≡ VAL_OK; status ≡ VAL_WARN; status ≡ VAL_ERR_UNDEFINED; status ≡ VAL_ERR_BELOW_RANGE; status ≡ VAL_ERR_ABOVE_RANGE; status ≡ VAL_ERR_BAD_RANGE; status ≡ VAL_ERR_NONPOSITIVE; status ≡ VAL_ERR_NEGATIVE; status ≡ VAL_ERR_NOT_INTEGER; status ≡ VAL_ERR_LENGTH; status ≡ VAL_ERR_NOT_ALLOWED; status ≡ VAL_ERR_UNKNOWN; status ≡ VAL_ERR_BAD_RESULT; status ≡ VAL_ERR_BAD_SET; status ≡ VAL_ERR_NOT_REGISTERED; status ≡ VAL_ERR_NONNEGATIVE; status ≡ VAL_ERR_POSITIVE; status ≡ VAL_ERR_ZERO; status ≡ VAL_ERR_DIMENSIONS; status ≡ VAL_ERR_ORDER; status ≡ VAL_ERR_DUPLICATE; status ≡ VAL_ERR_INSIDE_RANGE; status ≡ VAL_ERR_NONZERO)
ValidationIsError(status) = status ≥ VAL_ERR_UNDEFINED
ValidationIsFinite(value) = and(value ≡ value; abs(clrunits(value)) < VAL_FINITE_LIMIT)
ValidationIsInteger(value) = and(ValidationIsFinite(value); abs(clrunits(value) - round(clrunits(value))) ≤ VAL_INTEGER_TOLERANCE)
ValidationRuleKnown(rule_code) = or(rule_code ≡ VAL_RULE_RANGE; rule_code ≡ VAL_RULE_POSITIVE; rule_code ≡ VAL_RULE_NONNEGATIVE; rule_code ≡ VAL_RULE_INTEGER; rule_code ≡ VAL_RULE_LENGTH; rule_code ≡ VAL_RULE_ALLOWED; rule_code ≡ VAL_RULE_AVAILABLE; rule_code ≡ VAL_RULE_REGISTERED; rule_code ≡ VAL_RULE_DEFINED; rule_code ≡ VAL_RULE_NEGATIVE; rule_code ≡ VAL_RULE_NONPOSITIVE; rule_code ≡ VAL_RULE_NONZERO; rule_code ≡ VAL_RULE_MINIMUM; rule_code ≡ VAL_RULE_MAXIMUM; rule_code ≡ VAL_RULE_OPEN_RANGE; rule_code ≡ VAL_RULE_OUTSIDE_RANGE; rule_code ≡ VAL_RULE_ABSOLUTE_MAXIMUM; rule_code ≡ VAL_RULE_MATRIX_ROWS; rule_code ≡ VAL_RULE_MATRIX_COLUMNS; rule_code ≡ VAL_RULE_SQUARE_MATRIX; rule_code ≡ VAL_RULE_VECTOR_RANGE; rule_code ≡ VAL_RULE_VECTOR_POSITIVE; rule_code ≡ VAL_RULE_VECTOR_NONNEGATIVE; rule_code ≡ VAL_RULE_INCREASING; rule_code ≡ VAL_RULE_NONDECREASING; rule_code ≡ VAL_RULE_UNIQUE; rule_code ≡ VAL_RULE_MATCHING_LENGTH; rule_code ≡ VAL_RULE_ZERO; rule_code ≡ VAL_RULE_VECTOR_DEFINED; rule_code ≡ VAL_RULE_VECTOR_NEGATIVE; rule_code ≡ VAL_RULE_VECTOR_NONPOSITIVE)

ValidationRangeStatus(value; minimum; maximum) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; minimum > maximum; VAL_ERR_BAD_RANGE; value < minimum; VAL_ERR_BELOW_RANGE; value > maximum; VAL_ERR_ABOVE_RANGE; VAL_OK)
ValidationPositiveStatus(value) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; clrunits(value) ≤ 0; VAL_ERR_NONPOSITIVE; VAL_OK)
ValidationNonnegativeStatus(value) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; clrunits(value) < 0; VAL_ERR_NEGATIVE; VAL_OK)
ValidationIntegerStatus(value) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; not(ValidationIsInteger(value)); VAL_ERR_NOT_INTEGER; VAL_OK)
ValidationLengthStatus(values; minimum_length; maximum_length) = switch(minimum_length < 0; VAL_ERR_BAD_RANGE; maximum_length < minimum_length; VAL_ERR_BAD_RANGE; len(values) < minimum_length; VAL_ERR_LENGTH; len(values) > maximum_length; VAL_ERR_LENGTH; VAL_OK)
ValidationAllowedStatus(value; allowed_values) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; count(allowed_values; value; 1) ≡ 0; VAL_ERR_NOT_ALLOWED; VAL_OK)
ValidationDefinedStatus(value) = if(ValidationIsFinite(value); VAL_OK; VAL_ERR_UNDEFINED)
ValidationNegativeStatus(value) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; clrunits(value) ≥ 0; VAL_ERR_NONNEGATIVE; VAL_OK)
ValidationNonpositiveStatus(value) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; clrunits(value) > 0; VAL_ERR_POSITIVE; VAL_OK)
ValidationNonzeroStatus(value; tolerance) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; not(ValidationIsFinite(tolerance)); VAL_ERR_BAD_RANGE; clrunits(tolerance) < 0; VAL_ERR_BAD_RANGE; abs(value) ≤ tolerance; VAL_ERR_ZERO; VAL_OK)
ValidationZeroStatus(value; tolerance) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; not(ValidationIsFinite(tolerance)); VAL_ERR_BAD_RANGE; clrunits(tolerance) < 0; VAL_ERR_BAD_RANGE; abs(value) > tolerance; VAL_ERR_NONZERO; VAL_OK)
ValidationMinimumStatus(value; minimum) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; value < minimum; VAL_ERR_BELOW_RANGE; VAL_OK)
ValidationMaximumStatus(value; maximum) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; value > maximum; VAL_ERR_ABOVE_RANGE; VAL_OK)
ValidationOpenRangeStatus(value; minimum; maximum) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; minimum ≥ maximum; VAL_ERR_BAD_RANGE; value ≤ minimum; VAL_ERR_BELOW_RANGE; value ≥ maximum; VAL_ERR_ABOVE_RANGE; VAL_OK)
ValidationOutsideRangeStatus(value; minimum; maximum) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; minimum > maximum; VAL_ERR_BAD_RANGE; and(value ≥ minimum; value ≤ maximum); VAL_ERR_INSIDE_RANGE; VAL_OK)
ValidationAbsoluteMaximumStatus(value; maximum) = switch(not(ValidationIsFinite(value)); VAL_ERR_UNDEFINED; not(ValidationIsFinite(maximum)); VAL_ERR_BAD_RANGE; clrunits(maximum) < 0; VAL_ERR_BAD_RANGE; abs(value) > maximum; VAL_ERR_ABOVE_RANGE; VAL_OK)

ValidationRegistryAddStatus(set_id; values) = switch(not(ValidationIsInteger(set_id)); VAL_ERR_BAD_SET; set_id ≤ 0; VAL_ERR_BAD_SET; len(values) ≡ 0; VAL_ERR_BAD_SET; VAL_OK)

ValidationRegistryAdd(registry; set_id; values) = _
$block{
    value_count = len(values);
    safe_count = max(value_count; 1);
    safe_values = if(value_count > 0; values; [VAL_EMPTY]);
    keys = fill(resize([0]; safe_count); set_id);
    new_rows = join_cols(keys; safe_values);
    updated_registry = if(ValidationRegistryAddStatus(set_id; values) ≡ VAL_OK; stack(registry; new_rows); registry);
    updated_registry;
}

ValidationRegistryValues(registry; set_id) = vlookup(registry; set_id; 1; 2)
ValidationRegistrySetExists(registry; set_id) = len(ValidationRegistryValues(registry; set_id)) > 0
ValidationRegistrySetCount(registry; set_id) = len(ValidationRegistryValues(registry; set_id))
ValidationValuesUnique(values) = if(len(values) ≤ 1; 1; count(first(sort(values); len(values) - 1) - last(sort(values); len(values) - 1); 0; 1) ≡ 0)
ValidationRegistrySetStatus(registry; set_id) = switch(not(ValidationRegistrySetExists(registry; set_id)); VAL_ERR_BAD_SET; not(ValidationValuesUnique(ValidationRegistryValues(registry; set_id))); VAL_ERR_BAD_SET; VAL_OK)

ValidationVectorRangeStatus(values; minimum; maximum) = _
$block{
    value_count = len(values);
    safe_values = if(value_count > 0; values; [0/0]);
    lowest_value = min(safe_values);
    highest_value = max(safe_values);
    status = switch(value_count ≡ 0; VAL_ERR_LENGTH; not(and(ValidationIsFinite(lowest_value); ValidationIsFinite(highest_value))); VAL_ERR_UNDEFINED; minimum > maximum; VAL_ERR_BAD_RANGE; lowest_value < minimum; VAL_ERR_BELOW_RANGE; highest_value > maximum; VAL_ERR_ABOVE_RANGE; VAL_OK);
    status;
}

ValidationVectorPositiveStatus(values) = _
$block{
    value_count = len(values);
    safe_values = if(value_count > 0; values; [0/0]);
    lowest_value = min(safe_values);
    status = switch(value_count ≡ 0; VAL_ERR_LENGTH; not(ValidationIsFinite(lowest_value)); VAL_ERR_UNDEFINED; clrunits(lowest_value) ≤ 0; VAL_ERR_NONPOSITIVE; VAL_OK);
    status;
}

ValidationVectorNonnegativeStatus(values) = _
$block{
    value_count = len(values);
    safe_values = if(value_count > 0; values; [0/0]);
    lowest_value = min(safe_values);
    status = switch(value_count ≡ 0; VAL_ERR_LENGTH; not(ValidationIsFinite(lowest_value)); VAL_ERR_UNDEFINED; clrunits(lowest_value) < 0; VAL_ERR_NEGATIVE; VAL_OK);
    status;
}

ValidationVectorDefinedStatus(values) = _
$block{
    value_count = len(values);
    safe_values = if(value_count > 0; values; [0/0]);
    lowest_value = min(safe_values);
    highest_value = max(safe_values);
    status = switch(value_count ≡ 0; VAL_ERR_LENGTH; not(and(ValidationIsFinite(lowest_value); ValidationIsFinite(highest_value))); VAL_ERR_UNDEFINED; VAL_OK);
    status;
}

ValidationVectorNegativeStatus(values) = _
$block{
    value_count = len(values);
    safe_values = if(value_count > 0; values; [0/0]);
    highest_value = max(safe_values);
    status = switch(value_count ≡ 0; VAL_ERR_LENGTH; not(ValidationIsFinite(highest_value)); VAL_ERR_UNDEFINED; clrunits(highest_value) ≥ 0; VAL_ERR_NONNEGATIVE; VAL_OK);
    status;
}

ValidationVectorNonpositiveStatus(values) = _
$block{
    value_count = len(values);
    safe_values = if(value_count > 0; values; [0/0]);
    highest_value = max(safe_values);
    status = switch(value_count ≡ 0; VAL_ERR_LENGTH; not(ValidationIsFinite(highest_value)); VAL_ERR_UNDEFINED; clrunits(highest_value) > 0; VAL_ERR_POSITIVE; VAL_OK);
    status;
}

ValidationIncreasingStatus(values) = _
$block{
    value_count = len(values);
    safe_values = if(value_count > 1; values; [0; 1]);
    differences = last(safe_values; len(safe_values) - 1) - first(safe_values; len(safe_values) - 1);
    smallest_difference = min(differences);
    status = switch(value_count ≡ 0; VAL_ERR_LENGTH; value_count ≡ 1; VAL_OK; not(ValidationIsFinite(smallest_difference)); VAL_ERR_UNDEFINED; clrunits(smallest_difference) ≤ 0; VAL_ERR_ORDER; VAL_OK);
    status;
}

ValidationNondecreasingStatus(values) = _
$block{
    value_count = len(values);
    safe_values = if(value_count > 1; values; [0; 1]);
    differences = last(safe_values; len(safe_values) - 1) - first(safe_values; len(safe_values) - 1);
    smallest_difference = min(differences);
    status = switch(value_count ≡ 0; VAL_ERR_LENGTH; value_count ≡ 1; VAL_OK; not(ValidationIsFinite(smallest_difference)); VAL_ERR_UNDEFINED; clrunits(smallest_difference) < 0; VAL_ERR_ORDER; VAL_OK);
    status;
}

ValidationUniqueStatus(values) = switch(len(values) ≡ 0; VAL_ERR_LENGTH; not(ValidationValuesUnique(values)); VAL_ERR_DUPLICATE; VAL_OK)
ValidationMatchingLengthStatus(first_values; second_values) = if(len(first_values) ≡ len(second_values); VAL_OK; VAL_ERR_LENGTH)
ValidationMatrixRowsStatus(matrix; minimum_rows; maximum_rows) = ValidationRangeStatus(n_rows(matrix); minimum_rows; maximum_rows)
ValidationMatrixColumnsStatus(matrix; minimum_columns; maximum_columns) = ValidationRangeStatus(n_cols(matrix); minimum_columns; maximum_columns)
ValidationSquareMatrixStatus(matrix) = if(n_rows(matrix) ≡ n_cols(matrix); VAL_OK; VAL_ERR_DIMENSIONS)

ValidationAllowedRegistry = join_rows([VAL_EMPTY; VAL_EMPTY])

ValidationAllowedSetValues(set_id) = ValidationRegistryValues(ValidationAllowedRegistry; set_id)
ValidationAllowedSetExists(set_id) = ValidationRegistrySetExists(ValidationAllowedRegistry; set_id)
ValidationAllowedSetCount(set_id) = ValidationRegistrySetCount(ValidationAllowedRegistry; set_id)
ValidationAllowedSetStatus(value; set_id) = switch(ValidationRegistrySetStatus(ValidationAllowedRegistry; set_id) ≠ VAL_OK; VAL_ERR_BAD_SET; ValidationAllowedStatus(value; ValidationAllowedSetValues(set_id)))

ValidationRangeResult(value; minimum; maximum) = [ValidationRangeStatus(value; minimum; maximum); value; VAL_RULE_RANGE; minimum; maximum]
ValidationPositiveResult(value) = [ValidationPositiveStatus(value); value; VAL_RULE_POSITIVE; VAL_EMPTY; VAL_EMPTY]
ValidationNonnegativeResult(value) = [ValidationNonnegativeStatus(value); value; VAL_RULE_NONNEGATIVE; VAL_EMPTY; VAL_EMPTY]
ValidationIntegerResult(value) = [ValidationIntegerStatus(value); value; VAL_RULE_INTEGER; VAL_EMPTY; VAL_EMPTY]
ValidationLengthResult(values; minimum_length; maximum_length) = [ValidationLengthStatus(values; minimum_length; maximum_length); len(values); VAL_RULE_LENGTH; minimum_length; maximum_length]
ValidationAllowedSetResult(value; set_id) = [ValidationAllowedSetStatus(value; set_id); value; VAL_RULE_ALLOWED; set_id; ValidationAllowedSetCount(set_id)]
ValidationAvailableResult(value) = [if(ValidationIsFinite(value); VAL_OK; VAL_ERR_UNDEFINED); value; VAL_RULE_AVAILABLE; VAL_EMPTY; VAL_EMPTY]
ValidationRegisteredResult(value; registered) = [if(registered; VAL_OK; VAL_ERR_NOT_REGISTERED); value; VAL_RULE_REGISTERED; VAL_EMPTY; VAL_EMPTY]
ValidationDefinedResult(value) = [ValidationDefinedStatus(value); value; VAL_RULE_DEFINED; VAL_EMPTY; VAL_EMPTY]
ValidationNegativeResult(value) = [ValidationNegativeStatus(value); value; VAL_RULE_NEGATIVE; VAL_EMPTY; VAL_EMPTY]
ValidationNonpositiveResult(value) = [ValidationNonpositiveStatus(value); value; VAL_RULE_NONPOSITIVE; VAL_EMPTY; VAL_EMPTY]
ValidationNonzeroResult(value; tolerance) = [ValidationNonzeroStatus(value; tolerance); value; VAL_RULE_NONZERO; tolerance; VAL_EMPTY]
ValidationZeroResult(value; tolerance) = [ValidationZeroStatus(value; tolerance); value; VAL_RULE_ZERO; tolerance; VAL_EMPTY]
ValidationMinimumResult(value; minimum) = [ValidationMinimumStatus(value; minimum); value; VAL_RULE_MINIMUM; minimum; VAL_EMPTY]
ValidationMaximumResult(value; maximum) = [ValidationMaximumStatus(value; maximum); value; VAL_RULE_MAXIMUM; maximum; VAL_EMPTY]
ValidationOpenRangeResult(value; minimum; maximum) = [ValidationOpenRangeStatus(value; minimum; maximum); value; VAL_RULE_OPEN_RANGE; minimum; maximum]
ValidationOutsideRangeResult(value; minimum; maximum) = [ValidationOutsideRangeStatus(value; minimum; maximum); value; VAL_RULE_OUTSIDE_RANGE; minimum; maximum]
ValidationAbsoluteMaximumResult(value; maximum) = [ValidationAbsoluteMaximumStatus(value; maximum); value; VAL_RULE_ABSOLUTE_MAXIMUM; maximum; VAL_EMPTY]
ValidationMatrixRowsResult(matrix; minimum_rows; maximum_rows) = [ValidationMatrixRowsStatus(matrix; minimum_rows; maximum_rows); n_rows(matrix); VAL_RULE_MATRIX_ROWS; minimum_rows; maximum_rows]
ValidationMatrixColumnsResult(matrix; minimum_columns; maximum_columns) = [ValidationMatrixColumnsStatus(matrix; minimum_columns; maximum_columns); n_cols(matrix); VAL_RULE_MATRIX_COLUMNS; minimum_columns; maximum_columns]
ValidationSquareMatrixResult(matrix) = [ValidationSquareMatrixStatus(matrix); n_rows(matrix); VAL_RULE_SQUARE_MATRIX; n_rows(matrix); n_cols(matrix)]
ValidationMatrixDimensionsResults(matrix; required_rows; required_columns) = join_rows(ValidationMatrixRowsResult(matrix; required_rows; required_rows); ValidationMatrixColumnsResult(matrix; required_columns; required_columns))
ValidationVectorRangeResult(values; minimum; maximum) = [ValidationVectorRangeStatus(values; minimum; maximum); len(values); VAL_RULE_VECTOR_RANGE; minimum; maximum]
ValidationVectorPositiveResult(values) = [ValidationVectorPositiveStatus(values); len(values); VAL_RULE_VECTOR_POSITIVE; VAL_EMPTY; VAL_EMPTY]
ValidationVectorNonnegativeResult(values) = [ValidationVectorNonnegativeStatus(values); len(values); VAL_RULE_VECTOR_NONNEGATIVE; VAL_EMPTY; VAL_EMPTY]
ValidationVectorDefinedResult(values) = [ValidationVectorDefinedStatus(values); len(values); VAL_RULE_VECTOR_DEFINED; VAL_EMPTY; VAL_EMPTY]
ValidationVectorNegativeResult(values) = [ValidationVectorNegativeStatus(values); len(values); VAL_RULE_VECTOR_NEGATIVE; VAL_EMPTY; VAL_EMPTY]
ValidationVectorNonpositiveResult(values) = [ValidationVectorNonpositiveStatus(values); len(values); VAL_RULE_VECTOR_NONPOSITIVE; VAL_EMPTY; VAL_EMPTY]
ValidationIncreasingResult(values) = [ValidationIncreasingStatus(values); len(values); VAL_RULE_INCREASING; VAL_EMPTY; VAL_EMPTY]
ValidationNondecreasingResult(values) = [ValidationNondecreasingStatus(values); len(values); VAL_RULE_NONDECREASING; VAL_EMPTY; VAL_EMPTY]
ValidationUniqueResult(values) = [ValidationUniqueStatus(values); len(values); VAL_RULE_UNIQUE; VAL_EMPTY; VAL_EMPTY]
ValidationMatchingLengthResult(first_values; second_values) = [ValidationMatchingLengthStatus(first_values; second_values); len(first_values); VAL_RULE_MATCHING_LENGTH; len(second_values); VAL_EMPTY]

ValidationResultShapeOK(result) = len(result) ≡ VAL_RESULT_LENGTH
ValidationResultSafe(result) = first(join(result; [VAL_ERR_BAD_RESULT; VAL_EMPTY; 0; VAL_EMPTY; VAL_EMPTY]); VAL_RESULT_LENGTH)
ValidationResultStoredStatus(result) = take(VAL_RESULT_STATUS; ValidationResultSafe(result))
ValidationResultValue(result) = take(VAL_RESULT_VALUE; ValidationResultSafe(result))
ValidationResultRule(result) = take(VAL_RESULT_RULE; ValidationResultSafe(result))
ValidationResultData1(result) = take(VAL_RESULT_DATA_1; ValidationResultSafe(result))
ValidationResultData2(result) = take(VAL_RESULT_DATA_2; ValidationResultSafe(result))
ValidationResultAllowedSetCurrent(result) = and(ValidationAllowedSetExists(ValidationResultData1(result)); ValidationAllowedSetCount(ValidationResultData1(result)) ≡ ValidationResultData2(result))
ValidationResultRegistryOK(result) = if(ValidationResultRule(result) ≡ VAL_RULE_ALLOWED; ValidationResultAllowedSetCurrent(result); 1)
ValidationResultStatus(result) = switch(not(ValidationResultShapeOK(result)); VAL_ERR_BAD_RESULT; not(ValidationStatusKnown(ValidationResultStoredStatus(result))); VAL_ERR_BAD_RESULT; not(ValidationRuleKnown(ValidationResultRule(result))); VAL_ERR_BAD_RESULT; not(ValidationResultRegistryOK(result)); VAL_ERR_BAD_SET; ValidationResultStoredStatus(result))
ValidationResultsStatuses(results) = col(results; VAL_RESULT_STATUS)

ValidationResultRecord(id; result) = join_rows([id; ValidationResultStatus(result); ValidationResultValue(result); ValidationResultRule(result); ValidationResultData1(result); ValidationResultData2(result)])
ValidationResultRecordShapeOK(record) = and(n_rows(record) ≡ 1; n_cols(record) ≡ VAL_REG_COLUMNS)
ValidationResultRecordID(record) = take(VAL_REG_ID; record)
ValidationResultRecordStatus(record) = take(VAL_REG_STATUS; record)
ValidationResultRecordValue(record) = take(VAL_REG_VALUE; record)
ValidationResultRecordRule(record) = take(VAL_REG_RULE; record)
ValidationResultRecordData1(record) = take(VAL_REG_DATA_1; record)
ValidationResultRecordData2(record) = take(VAL_REG_DATA_2; record)
ValidationResultRecordResult(record) = [ValidationResultRecordStatus(record); ValidationResultRecordValue(record); ValidationResultRecordRule(record); ValidationResultRecordData1(record); ValidationResultRecordData2(record)]
ValidationResultRecordIDOK(id) = and(ValidationIsInteger(id); id > VAL_REG_EMPTY)

ValidationResultRegistryEmpty = join_rows([VAL_REG_EMPTY; VAL_ERR_BAD_RESULT; 0; 0; VAL_EMPTY; VAL_EMPTY])
ValidationResultRegistryShapeOK(registry) = and(n_cols(registry) ≡ VAL_REG_COLUMNS; n_rows(registry) ≥ 1; take(1; col(registry; VAL_REG_ID)) ≡ VAL_REG_EMPTY)
ValidationResultRegistryCount(registry) = if(ValidationResultRegistryShapeOK(registry); n_rows(registry) - 1; 0)
ValidationResultRegistryEntryExists(registry; id) = if(ValidationResultRegistryShapeOK(registry); count(col(registry; VAL_REG_ID); id; 1) > 0; 0)

ValidationResultRegistryAddStatus(registry; record) = switch(
    not(ValidationResultRegistryShapeOK(registry)); VAL_REG_ERR_BAD_REGISTRY;
    not(ValidationResultRecordShapeOK(record)); VAL_REG_ERR_BAD_RESULT;
    not(ValidationResultRecordIDOK(ValidationResultRecordID(record))); VAL_REG_ERR_BAD_ID;
    ValidationResultRegistryEntryExists(registry; ValidationResultRecordID(record)); VAL_REG_ERR_DUPLICATE_ID;
    not(ValidationStatusKnown(ValidationResultRecordStatus(record))); VAL_REG_ERR_BAD_RESULT;
    not(ValidationRuleKnown(ValidationResultRecordRule(record))); VAL_REG_ERR_BAD_RESULT;
    VAL_REG_OK)

ValidationResultRegistryAdd(registry; record) = if(ValidationResultRegistryAddStatus(registry; record) ≡ VAL_REG_OK; stack(registry; record); registry)

ValidationResultRegistryValues(registry; column) = _
$block{
    value_count = ValidationResultRegistryCount(registry);
    safe_column = min(max(round(column); 1); n_cols(registry));
    safe_values = last(col(registry; safe_column); max(value_count; 1));
    values = if(value_count > 0; safe_values; find_eq([0]; 1; 1));
    values;
}

ValidationResultRegistryIDs(registry) = ValidationResultRegistryValues(registry; VAL_REG_ID)
ValidationResultRegistryStatuses(registry) = ValidationResultRegistryValues(registry; VAL_REG_STATUS)
ValidationResultRegistryValuesStored(registry) = ValidationResultRegistryValues(registry; VAL_REG_VALUE)
ValidationResultRegistryRules(registry) = ValidationResultRegistryValues(registry; VAL_REG_RULE)
ValidationResultRegistryIDAt(registry; index) = take(index; ValidationResultRegistryIDs(registry))
ValidationResultRegistryStatusAt(registry; index) = take(index; ValidationResultRegistryStatuses(registry))
ValidationResultRegistryValueAt(registry; index) = take(index; ValidationResultRegistryValuesStored(registry))
ValidationResultRegistryRuleAt(registry; index) = take(index; ValidationResultRegistryValues(registry; VAL_REG_RULE))
ValidationResultRegistryData1At(registry; index) = take(index; ValidationResultRegistryValues(registry; VAL_REG_DATA_1))
ValidationResultRegistryData2At(registry; index) = take(index; ValidationResultRegistryValues(registry; VAL_REG_DATA_2))
ValidationResultRegistryResultAt(registry; index) = [ValidationResultRegistryStatusAt(registry; index); ValidationResultRegistryValueAt(registry; index); ValidationResultRegistryRuleAt(registry; index); ValidationResultRegistryData1At(registry; index); ValidationResultRegistryData2At(registry; index)]

ValidationRegistryErrorCount(errors) = len(errors) - count(errors; VAL_REG_OK; 1)
ValidationRegistryErrorsOK(errors) = ValidationRegistryErrorCount(errors) ≡ 0
ValidationResultRegistryEffectiveStatuses(registry; errors) = if(ValidationRegistryErrorsOK(errors); ValidationResultRegistryStatuses(registry); join(ValidationResultRegistryStatuses(registry); VAL_ERR_BAD_RESULT))

InputValidationRegistry = ValidationResultRegistryEmpty
InputValidationRegistryErrors = [VAL_REG_OK]

ValidationWorst(statuses) = max(statuses)
ValidationCount(statuses; status) = count(statuses; status; 1)
ValidationWarningCount(statuses) = ValidationCount(statuses; VAL_WARN)
ValidationErrorCount(statuses) = len(statuses) - ValidationCount(statuses; VAL_OK) - ValidationWarningCount(statuses)
ValidationHasErrors(statuses) = ValidationErrorCount(statuses) > 0
ValidationOverallStatus(statuses) = switch(ValidationHasErrors(statuses); VAL_ERR_UNKNOWN; ValidationWarningCount(statuses) > 0; VAL_WARN; VAL_OK)
ValidationAllOK(statuses) = ValidationWorst(statuses) ≡ VAL_OK
ValidationResultRegistryIssueCount(registry; errors) = len(ValidationResultRegistryEffectiveStatuses(registry; errors)) - ValidationCount(ValidationResultRegistryEffectiveStatuses(registry; errors); VAL_OK)
ValidationResultRegistrySummaryStatus(registry; errors) = switch(not(ValidationResultRegistryShapeOK(registry)); VAL_ERR_UNKNOWN; not(ValidationRegistryErrorsOK(errors)); VAL_ERR_UNKNOWN; ValidationResultRegistryCount(registry) ≡ 0; VAL_ERR_UNKNOWN; ValidationOverallStatus(ValidationResultRegistryStatuses(registry)))
ValidationResultRegistryInputsValid(registry; errors) = and(ValidationResultRegistryCount(registry) > 0; ValidationRegistryErrorsOK(errors); not(ValidationHasErrors(ValidationResultRegistryStatuses(registry))))

#def ValidationStatus$(status$)
    #if status$ ≡ VAL_OK
        '<span class="ok">VALID</span>
    #end if
    #if status$ ≡ VAL_WARN
        '<span class="note">VALIDATION WARNING</span>
    #end if
    #if status$ ≡ VAL_ERR_UNDEFINED
        '<span class="err">Value is undefined or non-finite</span>
    #end if
    #if status$ ≡ VAL_ERR_BELOW_RANGE
        '<span class="err">Value is below the permitted range</span>
    #end if
    #if status$ ≡ VAL_ERR_ABOVE_RANGE
        '<span class="err">Value is above the permitted range</span>
    #end if
    #if status$ ≡ VAL_ERR_BAD_RANGE
        '<span class="err">Validation range is invalid</span>
    #end if
    #if status$ ≡ VAL_ERR_NONPOSITIVE
        '<span class="err">Value must be positive</span>
    #end if
    #if status$ ≡ VAL_ERR_NEGATIVE
        '<span class="err">Value must be nonnegative</span>
    #end if
    #if status$ ≡ VAL_ERR_NOT_INTEGER
        '<span class="err">Value must be an integer</span>
    #end if
    #if status$ ≡ VAL_ERR_LENGTH
        '<span class="err">Vector or matrix length is invalid</span>
    #end if
    #if status$ ≡ VAL_ERR_NOT_ALLOWED
        '<span class="err">Value is not one of the permitted options</span>
    #end if
    #if status$ ≡ VAL_ERR_BAD_RESULT
        '<span class="err">Validation result is malformed or incompatible</span>
    #end if
    #if status$ ≡ VAL_ERR_BAD_SET
        '<span class="err">Permitted-value set is missing or has changed</span>
    #end if
    #if status$ ≡ VAL_ERR_NOT_REGISTERED
        '<span class="err">Value is not registered</span>
    #end if
    #if status$ ≡ VAL_ERR_NONNEGATIVE
        '<span class="err">Value must be negative</span>
    #end if
    #if status$ ≡ VAL_ERR_POSITIVE
        '<span class="err">Value must be nonpositive</span>
    #end if
    #if status$ ≡ VAL_ERR_ZERO
        '<span class="err">Value must be nonzero outside the specified tolerance</span>
    #end if
    #if status$ ≡ VAL_ERR_DIMENSIONS
        '<span class="err">Matrix dimensions are invalid</span>
    #end if
    #if status$ ≡ VAL_ERR_ORDER
        '<span class="err">Vector ordering is invalid</span>
    #end if
    #if status$ ≡ VAL_ERR_DUPLICATE
        '<span class="err">Vector contains duplicate values</span>
    #end if
    #if status$ ≡ VAL_ERR_INSIDE_RANGE
        '<span class="err">Value lies inside the excluded range</span>
    #end if
    #if status$ ≡ VAL_ERR_NONZERO
        '<span class="err">Value must be zero within the specified tolerance</span>
    #end if
    #if or(status$ ≡ VAL_ERR_UNKNOWN; not(ValidationStatusKnown(status$)))
        '<span class="err">Unknown validation status</span>
    #end if
#end def

#def ShowValidation$(label$; value$; status$)
    '<table class="bordered data" style="width:95%">
    '<tbody>
    '<tr><td><strong>Input</strong></td><td>label$</td></tr>
    '<tr><td><strong>Value</strong></td><td>'value$'</td></tr>
    '<tr><td><strong>Status</strong></td><td>
    ValidationStatus$(status$)
    '</td></tr>
    '</tbody>
    '</table>
#end def

#def ValidationSummaryStatus$(statuses$)
    #if ValidationHasErrors(statuses$)
        '<span class="err">INVALID</span>
    #end if
    #if and(not(ValidationHasErrors(statuses$)); ValidationWarningCount(statuses$) > 0)
        '<span class="note">VALIDATION WARNING</span>
    #end if
    #if and(not(ValidationHasErrors(statuses$)); ValidationWarningCount(statuses$) ≡ 0)
        '<span class="ok">VALID</span>
    #end if
#end def

#def ValidationRegistryStatus$(status$)
    #if status$ ≡ VAL_REG_OK
        '<span class="ok">VALID</span>
    #end if
    #if status$ ≡ VAL_REG_ERR_BAD_REGISTRY
        '<span class="err">INVALID VALIDATION REGISTRY</span>
    #end if
    #if status$ ≡ VAL_REG_ERR_BAD_RESULT
        '<span class="err">INVALID VALIDATION RESULT</span>
    #end if
    #if status$ ≡ VAL_REG_ERR_BAD_ID
        '<span class="err">INVALID INPUT ID</span>
    #end if
    #if status$ ≡ VAL_REG_ERR_DUPLICATE_ID
        '<span class="err">DUPLICATE INPUT ID</span>
    #end if
    #if not(or(status$ ≡ VAL_REG_OK; status$ ≡ VAL_REG_ERR_BAD_REGISTRY; status$ ≡ VAL_REG_ERR_BAD_RESULT; status$ ≡ VAL_REG_ERR_BAD_ID; status$ ≡ VAL_REG_ERR_DUPLICATE_ID))
        '<span class="err">UNKNOWN VALIDATION REGISTRY STATUS</span>
    #end if
#end def

#def ValidationRegistryID$(id$)
    #val
    '<span>'id$'</span>
    #equ
#end def

#def ValidationRegistryLink$(id$)
    '<a class="validation-registry-link" href="#" onclick="event.preventDefault();var n=this.textContent.replace(&quot;Input&quot;,&quot;&quot;).trim();var rows=document.querySelectorAll(&quot;.validation-registry-entry&quot;);for(var i=0;i&lt;rows.length;i++){var cell=rows[i].querySelector(&quot;.validation-registry-id&quot;);if(cell&amp;&amp;cell.textContent.trim()===n){rows[i].scrollIntoView({block:&quot;center&quot;});rows[i].focus();break;}}">Input
    ValidationRegistryID$(id$)
    '</a>
#end def

#def BeginValidationSummary$
    #novar
    '<table class="bordered data reporting-summary validation-summary validation-registry">
    '<thead>
    '<tr><th>Input</th><th>Value</th><th>Permitted</th><th>Status</th></tr>
    '</thead>
    '<tbody>
#end def

#def ValidationPermitted$(result$)
    #hide
    ζVAL_rule = ValidationResultRule(result$)
    ζVAL_data_1 = ValidationResultData1(result$)
    ζVAL_data_2 = ValidationResultData2(result$)
    #show
    #if ζVAL_rule ≡ VAL_RULE_RANGE
        '<span class="validation-permitted">'ζVAL_data_1' to 'ζVAL_data_2'</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_POSITIVE
        '<span class="validation-permitted">Positive</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_NONNEGATIVE
        '<span class="validation-permitted">Nonnegative</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_INTEGER
        '<span class="validation-permitted">Integer</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_LENGTH
        '<span class="validation-permitted">'ζVAL_data_1' to 'ζVAL_data_2' entries</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_ALLOWED
        #hide
        ζVAL_allowed_values = ValidationAllowedSetValues(ζVAL_data_1)
        #show
        '<span class="validation-permitted">'ζVAL_allowed_values'</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_AVAILABLE
        '<span class="validation-permitted">Available</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_REGISTERED
        '<span class="validation-permitted">Registered</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_DEFINED
        '<span class="validation-permitted">Defined and finite</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_NEGATIVE
        '<span class="validation-permitted">Negative</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_NONPOSITIVE
        '<span class="validation-permitted">Nonpositive</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_NONZERO
        '<span class="validation-permitted">Absolute value greater than 'ζVAL_data_1'</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_MINIMUM
        '<span class="validation-permitted">At least 'ζVAL_data_1'</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_MAXIMUM
        '<span class="validation-permitted">At most 'ζVAL_data_1'</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_OPEN_RANGE
        '<span class="validation-permitted">Greater than 'ζVAL_data_1' and less than 'ζVAL_data_2'</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_OUTSIDE_RANGE
        '<span class="validation-permitted">Less than 'ζVAL_data_1' or greater than 'ζVAL_data_2'</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_ABSOLUTE_MAXIMUM
        '<span class="validation-permitted">Absolute value at most 'ζVAL_data_1'</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_MATRIX_ROWS
        '<span class="validation-permitted">'ζVAL_data_1' to 'ζVAL_data_2' rows</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_MATRIX_COLUMNS
        '<span class="validation-permitted">'ζVAL_data_1' to 'ζVAL_data_2' columns</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_SQUARE_MATRIX
        '<span class="validation-permitted">Equal row and column counts</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_VECTOR_RANGE
        '<span class="validation-permitted">Every entry from 'ζVAL_data_1' to 'ζVAL_data_2'</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_VECTOR_POSITIVE
        '<span class="validation-permitted">Every entry positive</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_VECTOR_NONNEGATIVE
        '<span class="validation-permitted">Every entry nonnegative</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_INCREASING
        '<span class="validation-permitted">Strictly increasing entries</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_NONDECREASING
        '<span class="validation-permitted">Nondecreasing entries</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_UNIQUE
        '<span class="validation-permitted">Unique entries</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_MATCHING_LENGTH
        '<span class="validation-permitted">Matching vector lengths</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_ZERO
        '<span class="validation-permitted">Absolute value at most 'ζVAL_data_1'</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_VECTOR_DEFINED
        '<span class="validation-permitted">Every entry defined and finite</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_VECTOR_NEGATIVE
        '<span class="validation-permitted">Every entry negative</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_VECTOR_NONPOSITIVE
        '<span class="validation-permitted">Every entry nonpositive</span>
    #end if
    #if not(ValidationRuleKnown(ζVAL_rule))
        '<span class="err">Unknown validation rule</span>
    #end if
#end def

#def ValidationResultValue$(result$)
    #hide
    ζVAL_value_rule = ValidationResultRule(result$)
    ζVAL_display_value = ValidationResultValue(result$)
    ζVAL_value_data_1 = ValidationResultData1(result$)
    ζVAL_value_data_2 = ValidationResultData2(result$)
    ζVAL_vector_rule = or(and(ζVAL_value_rule ≥ VAL_RULE_VECTOR_RANGE; ζVAL_value_rule ≤ VAL_RULE_UNIQUE); and(ζVAL_value_rule ≥ VAL_RULE_VECTOR_DEFINED; ζVAL_value_rule ≤ VAL_RULE_VECTOR_NONPOSITIVE))
    #show
    #if ζVAL_value_rule ≡ VAL_RULE_SQUARE_MATRIX
        '<span class="validation-value">'ζVAL_value_data_1' × 'ζVAL_value_data_2'</span>
    #end if
    #if ζVAL_value_rule ≡ VAL_RULE_MATCHING_LENGTH
        '<span class="validation-value">'ζVAL_display_value' and 'ζVAL_value_data_1' entries</span>
    #end if
    #if or(ζVAL_value_rule ≡ VAL_RULE_LENGTH; ζVAL_vector_rule)
        '<span class="validation-value">'ζVAL_display_value' entries</span>
    #end if
    #if and(ζVAL_value_rule ≠ VAL_RULE_SQUARE_MATRIX; ζVAL_value_rule ≠ VAL_RULE_MATCHING_LENGTH; ζVAL_value_rule ≠ VAL_RULE_LENGTH; not(ζVAL_vector_rule))
        '<span class="validation-value">'ζVAL_display_value'</span>
    #end if
#end def

#def AddValidationResult$(id$; label$; result$)
    #hide
    ζVAL_result = result$
    ζVAL_record = ValidationResultRecord(id$; ζVAL_result)
    ζVAL_registration_status = ValidationResultRegistryAddStatus(InputValidationRegistry; ζVAL_record)
    InputValidationRegistry = if(ζVAL_registration_status ≡ VAL_REG_OK; ValidationResultRegistryAdd(InputValidationRegistry; ζVAL_record); InputValidationRegistry)
    InputValidationRegistryErrors = join(InputValidationRegistryErrors; ζVAL_registration_status)
    #show
    '<tr class="validation-registry-entry" tabindex="-1"><td>Input <span class="validation-registry-id">
    ValidationRegistryID$(id$)
    '</span> &mdash; label$</td><td>
    ValidationResultValue$(ζVAL_result)
    '</td><td>
    ValidationPermitted$(ζVAL_result)
    '</td><td class="status-cell">
    ValidationStatus$(ValidationResultRecordStatus(ζVAL_record))
    '</td></tr>
    #if ζVAL_registration_status ≠ VAL_REG_OK
        '<tr class="validation-registry-error"><td colspan="4"><strong>Validation registry error:</strong>
        ValidationRegistryStatus$(ζVAL_registration_status)
        '</td></tr>
    #end if
#end def

#def EndValidationSummary$
    '</tbody>
    '<tfoot>
    #val
    '<tr><th colspan="2">Overall validation</th><td><strong>Warnings:</strong> 'ValidationWarningCount(ValidationResultRegistryEffectiveStatuses(InputValidationRegistry; InputValidationRegistryErrors))' &nbsp; <strong>Errors:</strong> 'ValidationErrorCount(ValidationResultRegistryEffectiveStatuses(InputValidationRegistry; InputValidationRegistryErrors))'</td><td class="status-cell">
    #equ
    ValidationSummaryStatus$([ValidationResultRegistrySummaryStatus(InputValidationRegistry; InputValidationRegistryErrors)])
    '</td></tr>
    '</tfoot>
    '</table>
    #equ
    #varsub
#end def

#def EndValidationResults$
    EndValidationSummary$
#end def

#def ShowValidationIssues$
    #hide
    ζVAL_issue_count = ValidationResultRegistryIssueCount(InputValidationRegistry; InputValidationRegistryErrors)
    ζVAL_registry_count = ValidationResultRegistryCount(InputValidationRegistry)
    #show
    '<section class="validation-issues">
    '<h4>Input Items Requiring Review</h4>
    #if ζVAL_issue_count ≡ 0
        '<p class="ok">No validation warnings or errors were registered.</p>
    #else
        '<table class="bordered reporting-summary validation-issue-summary">
        '<thead><tr><th>Input</th><th>Value</th><th>Status</th></tr></thead>
        '<tbody>
        #if ζVAL_registry_count > 0
            #for ζVAL_issue_index = 1 : ζVAL_registry_count
                #hide
                ζVAL_issue_status = ValidationResultRegistryStatusAt(InputValidationRegistry; ζVAL_issue_index)
                #show
                #if ζVAL_issue_status ≠ VAL_OK
                    '<tr><td>
                    ValidationRegistryLink$(ValidationResultRegistryIDAt(InputValidationRegistry; ζVAL_issue_index))
                    '</td>
                    '<td>
                    ValidationResultValue$(ValidationResultRegistryResultAt(InputValidationRegistry; ζVAL_issue_index))
                    '</td>
                    '<td class="status-cell">
                    ValidationStatus$(ζVAL_issue_status)
                    '</td></tr>
                #end if
            #loop
        #end if
        #if not(ValidationRegistryErrorsOK(InputValidationRegistryErrors))
            '<tr><td>Registry</td><td>Not available</td><td class="status-cell"><span class="err">REGISTRATION ERROR</span></td></tr>
        #end if
        '</tbody>
        '</table>
    #end if
    '</section>
#end def
#show
#hide
'<!-- Structured engineering check-result registry. Version 1.0.0. -->

CHECK_REG_OK = 0
CHECK_REG_ERR_BAD_REGISTRY = 10
CHECK_REG_ERR_BAD_RESULT = 20
CHECK_REG_ERR_BAD_ID = 30
CHECK_REG_ERR_DUPLICATE_ID = 40
CHECK_REG_ERR_BAD_METHOD = 50

CHECK_METHOD_UPPER = 1
CHECK_METHOD_LOWER = 2
CHECK_METHOD_CUSTOM = 3

'<!-- Every result row is [id; method; demand; capacity; utilization; warning threshold; status]. Demand and capacity may retain different engineering units across rows. -->
CHECK_RESULT_ID = 1
CHECK_RESULT_METHOD = 2
CHECK_RESULT_DEMAND = 3
CHECK_RESULT_CAPACITY = 4
CHECK_RESULT_UTILIZATION = 5
CHECK_RESULT_WARNING = 6
CHECK_RESULT_STATUS = 7
CHECK_RESULT_COLUMNS = 7

'<!-- The sentinel first row fixes the registry shape; public counts and value accessors intentionally exclude it. -->
CHECK_REG_EMPTY = 0
CheckResultRegistryEmpty = join_rows([CHECK_REG_EMPTY; CHECK_METHOD_CUSTOM; 0; 0; 0; 0; CHK_ERROR])

CheckMethodKnown(method) = or(method ≡ CHECK_METHOD_UPPER; method ≡ CHECK_METHOD_LOWER; method ≡ CHECK_METHOD_CUSTOM)
CheckResultColumn(result; column) = take(1; col(result; min(max(round(column); 1); n_cols(result))))
CheckResultShapeOK(result) = and(n_rows(result) ≡ 1; n_cols(result) ≡ CHECK_RESULT_COLUMNS)
CheckResultID(result) = CheckResultColumn(result; CHECK_RESULT_ID)
CheckResultMethod(result) = CheckResultColumn(result; CHECK_RESULT_METHOD)
CheckResultDemand(result) = CheckResultColumn(result; CHECK_RESULT_DEMAND)
CheckResultCapacity(result) = CheckResultColumn(result; CHECK_RESULT_CAPACITY)
CheckResultUtilization(result) = CheckResultColumn(result; CHECK_RESULT_UTILIZATION)
CheckResultWarning(result) = CheckResultColumn(result; CHECK_RESULT_WARNING)
CheckResultStatus(result) = CheckResultColumn(result; CHECK_RESULT_STATUS)
CheckResultIDOK(id) = and(ValidationIsInteger(id); id > CHECK_REG_EMPTY)

CheckCustomResult(id; demand; capacity; utilization; warning_threshold; status) = _
$block{
    safe_status = switch(not(CheckWarningThresholdOK(warning_threshold)); CHK_ERROR; not(CheckUtilizationOK(utilization)); CHK_ERROR; not(CheckStatusKnown(status)); CHK_ERROR; status);
    join_rows([id; CHECK_METHOD_CUSTOM; demand; capacity; utilization; warning_threshold; safe_status]);
}

CheckUpperResult(id; demand; capacity; warning_threshold; inputs_valid) = _
$block{
    utilization = CheckUpperUtilization(demand; capacity);
    status = CheckGatedStatus(inputs_valid; CheckUpperStatus(demand; capacity; warning_threshold));
    join_rows([id; CHECK_METHOD_UPPER; demand; capacity; utilization; warning_threshold; status]);
}

CheckLowerResult(id; required; provided; warning_threshold; inputs_valid) = _
$block{
    utilization = CheckLowerUtilization(provided; required);
    status = CheckGatedStatus(inputs_valid; CheckLowerStatus(provided; required; warning_threshold));
    join_rows([id; CHECK_METHOD_LOWER; required; provided; utilization; warning_threshold; status]);
}

CheckResultRegistryShapeOK(registry) = and(n_cols(registry) ≡ CHECK_RESULT_COLUMNS; n_rows(registry) ≥ 1; take(1; col(registry; CHECK_RESULT_ID)) ≡ CHECK_REG_EMPTY)
CheckResultRegistryCount(registry) = if(CheckResultRegistryShapeOK(registry); n_rows(registry) - 1; 0)
CheckResultRegistryEntryExists(registry; id) = if(CheckResultRegistryShapeOK(registry); count(col(registry; CHECK_RESULT_ID); id; 1) > 0; 0)

CheckResultRegistryAddStatus(registry; result) = switch(
    not(CheckResultRegistryShapeOK(registry)); CHECK_REG_ERR_BAD_REGISTRY;
    not(CheckResultShapeOK(result)); CHECK_REG_ERR_BAD_RESULT;
    not(CheckResultIDOK(CheckResultID(result))); CHECK_REG_ERR_BAD_ID;
    CheckResultRegistryEntryExists(registry; CheckResultID(result)); CHECK_REG_ERR_DUPLICATE_ID;
    not(CheckMethodKnown(CheckResultMethod(result))); CHECK_REG_ERR_BAD_METHOD;
    not(CheckStatusKnown(CheckResultStatus(result))); CHECK_REG_ERR_BAD_RESULT;
    CHECK_REG_OK)

CheckResultRegistryAdd(registry; result) = if(CheckResultRegistryAddStatus(registry; result) ≡ CHECK_REG_OK; stack(registry; result); registry)

'<!-- The synthetic fallback prevents zero-length vector operations; it is discarded whenever the registry has no real rows. -->
CheckResultRegistryValues(registry; column) = _
$block{
    value_count = CheckResultRegistryCount(registry);
    safe_column = min(max(round(column); 1); n_cols(registry));
    safe_values = last(col(registry; safe_column); max(value_count; 1));
    values = if(value_count > 0; safe_values; find_eq([0]; 1; 1));
    values;
}

CheckResultRegistryIDs(registry) = CheckResultRegistryValues(registry; CHECK_RESULT_ID)
CheckResultRegistryMethods(registry) = CheckResultRegistryValues(registry; CHECK_RESULT_METHOD)
CheckResultRegistryDemands(registry) = CheckResultRegistryValues(registry; CHECK_RESULT_DEMAND)
CheckResultRegistryCapacities(registry) = CheckResultRegistryValues(registry; CHECK_RESULT_CAPACITY)
CheckResultRegistryUtilizations(registry) = CheckResultRegistryValues(registry; CHECK_RESULT_UTILIZATION)
CheckResultRegistryWarnings(registry) = CheckResultRegistryValues(registry; CHECK_RESULT_WARNING)
CheckResultRegistryStatuses(registry) = CheckResultRegistryValues(registry; CHECK_RESULT_STATUS)

CheckResultRegistryIDAt(registry; index) = take(index; CheckResultRegistryIDs(registry))
CheckResultRegistryUtilizationAt(registry; index) = take(index; CheckResultRegistryUtilizations(registry))
CheckResultRegistryStatusAt(registry; index) = take(index; CheckResultRegistryStatuses(registry))

CheckRegistryErrorCount(errors) = len(errors) - count(errors; CHECK_REG_OK; 1)
CheckRegistryErrorsOK(errors) = CheckRegistryErrorCount(errors) ≡ 0
CheckResultRegistryEffectiveStatuses(registry; errors) = if(CheckRegistryErrorsOK(errors); CheckResultRegistryStatuses(registry); join(CheckResultRegistryStatuses(registry); CHK_ERROR))
CheckResultRegistryIssueCount(registry; errors) = len(CheckResultRegistryEffectiveStatuses(registry; errors)) - CheckPassCount(CheckResultRegistryEffectiveStatuses(registry; errors))
CheckResultRegistrySummaryStatus(registry; errors) = switch(not(CheckResultRegistryShapeOK(registry)); CHK_ERROR; not(CheckRegistryErrorsOK(errors)); CHK_ERROR; CheckSummaryStatus(CheckResultRegistryStatuses(registry); CheckResultRegistryUtilizations(registry)))
CheckResultRegistryGoverningIndex(registry) = CheckGoverningIndex(CheckResultRegistryUtilizations(registry))
CheckResultRegistryGoverningUtilization(registry) = CheckGoverningUtilization(CheckResultRegistryUtilizations(registry))
CheckResultRegistryGoverningID(registry) = _
$block{
    governing_index = CheckResultRegistryGoverningIndex(registry);
    safe_index = max(governing_index; 1);
    safe_ids = join(CheckResultRegistryIDs(registry); CHECK_REG_EMPTY);
    governing_id = if(governing_index > 0; take(safe_index; safe_ids); CHECK_REG_EMPTY);
    governing_id;
}

EngineeringCheckRegistry = CheckResultRegistryEmpty
EngineeringCheckRegistryErrors = [CHECK_REG_OK]

#def CheckRegistryStatus$(status$)
    #if status$ ≡ CHECK_REG_OK
        '<span class="ok">VALID</span>
    #end if
    #if status$ ≡ CHECK_REG_ERR_BAD_REGISTRY
        '<span class="err">INVALID CHECK REGISTRY</span>
    #end if
    #if status$ ≡ CHECK_REG_ERR_BAD_RESULT
        '<span class="err">INVALID CHECK RESULT</span>
    #end if
    #if status$ ≡ CHECK_REG_ERR_BAD_ID
        '<span class="err">INVALID CHECK ID</span>
    #end if
    #if status$ ≡ CHECK_REG_ERR_DUPLICATE_ID
        '<span class="err">DUPLICATE CHECK ID</span>
    #end if
    #if status$ ≡ CHECK_REG_ERR_BAD_METHOD
        '<span class="err">INVALID CHECK METHOD</span>
    #end if
    #if not(or(status$ ≡ CHECK_REG_OK; status$ ≡ CHECK_REG_ERR_BAD_REGISTRY; status$ ≡ CHECK_REG_ERR_BAD_RESULT; status$ ≡ CHECK_REG_ERR_BAD_ID; status$ ≡ CHECK_REG_ERR_DUPLICATE_ID; status$ ≡ CHECK_REG_ERR_BAD_METHOD))
        '<span class="err">UNKNOWN CHECK REGISTRY STATUS</span>
    #end if
#end def

#def CheckRegistryID$(id$)
    #val
    '<span>'id$'</span>
    #equ
#end def

#def CheckRegistryLink$(id$)
    '<a class="check-registry-link" href="#" onclick="event.preventDefault();var n=this.textContent.replace(&quot;Check&quot;,&quot;&quot;).trim();var rows=document.querySelectorAll(&quot;.check-registry-entry&quot;);for(var i=0;i&lt;rows.length;i++){var cell=rows[i].querySelector(&quot;.check-registry-id&quot;);if(cell&amp;&amp;cell.textContent.trim()===n){rows[i].scrollIntoView({block:&quot;center&quot;});rows[i].focus();break;}}">Check
    CheckRegistryID$(id$)
    '</a>
#end def

#def BeginCheckRegistry$
    '<table class="bordered data reporting-summary check-summary check-registry">
    '<thead><tr><th>Demand / Required</th><th>Capacity / Provided</th><th>Utilization</th><th>Warning</th><th>Acceptance Criterion</th><th>Status</th></tr></thead>
    '<tbody>
#end def

#def AddCheckResult$(id$; label$; criterion$; result$)
    #hide
    ζCHECK_expected_id = id$
    ζCHECK_result_id = CheckResultID(result$)
    ζCHECK_base_registration_status = CheckResultRegistryAddStatus(EngineeringCheckRegistry; result$)
    ζCHECK_registration_status = if(ζCHECK_expected_id ≡ ζCHECK_result_id; ζCHECK_base_registration_status; CHECK_REG_ERR_BAD_RESULT)
    EngineeringCheckRegistry = if(ζCHECK_registration_status ≡ CHECK_REG_OK; CheckResultRegistryAdd(EngineeringCheckRegistry; result$); EngineeringCheckRegistry)
    EngineeringCheckRegistryErrors = join(EngineeringCheckRegistryErrors; ζCHECK_registration_status)
    #show
    '<tr class="check-title check-registry-entry" tabindex="-1"><th colspan="6">Check <span class="check-registry-id">
    CheckRegistryID$(ζCHECK_result_id)
    '</span> &mdash; label$</th></tr>
    #val
    '<tr><td class="check-demand">'CheckResultDemand(result$)'</td><td>'CheckResultCapacity(result$)'</td><td>'CheckResultUtilization(result$)'</td><td>'CheckResultWarning(result$)'</td><td>criterion$</td><td class="status-cell">
    #equ
    CheckStatus$(CheckResultStatus(result$))
    '</td></tr>
    #if ζCHECK_registration_status ≠ CHECK_REG_OK
        '<tr class="check-registry-error"><td colspan="6"><strong>Check registry error:</strong>
        CheckRegistryStatus$(ζCHECK_registration_status)
        '</td></tr>
    #end if
#end def

#def AddUpperCheck$(id$; label$; demand$; capacity$; warning_threshold$; criterion$; inputs_valid$)
    #hide
    ζCHECK_pending_result = CheckUpperResult(id$; demand$; capacity$; warning_threshold$; inputs_valid$)
    #show
    AddCheckResult$(id$; label$; criterion$; ζCHECK_pending_result)
#end def

#def AddLowerCheck$(id$; label$; required$; provided$; warning_threshold$; criterion$; inputs_valid$)
    #hide
    ζCHECK_pending_result = CheckLowerResult(id$; required$; provided$; warning_threshold$; inputs_valid$)
    #show
    AddCheckResult$(id$; label$; criterion$; ζCHECK_pending_result)
#end def

#def AddCustomCheck$(id$; label$; demand$; capacity$; utilization$; warning_threshold$; criterion$; status$)
    #hide
    ζCHECK_pending_result = CheckCustomResult(id$; demand$; capacity$; utilization$; warning_threshold$; status$)
    #show
    AddCheckResult$(id$; label$; criterion$; ζCHECK_pending_result)
#end def

#def EndCheckRegistry$
    '</tbody>
    '</table>
#end def

#def EndCheckRegistryWithSummary$
    '</tbody>
    '<tfoot>
    #val
    '<tr class="check-counts"><th>Check counts</th><td><strong>Pass:</strong> 'CheckPassCount(CheckResultRegistryEffectiveStatuses(EngineeringCheckRegistry; EngineeringCheckRegistryErrors))'</td><td><strong>Warning:</strong> 'CheckWarningCount(CheckResultRegistryEffectiveStatuses(EngineeringCheckRegistry; EngineeringCheckRegistryErrors))'</td><td><strong>Fail:</strong> 'CheckFailureCount(CheckResultRegistryEffectiveStatuses(EngineeringCheckRegistry; EngineeringCheckRegistryErrors))'</td><td><strong>Error:</strong> 'CheckErrorCount(CheckResultRegistryEffectiveStatuses(EngineeringCheckRegistry; EngineeringCheckRegistryErrors))'</td><td class="status-cell"><strong>Overall:</strong>
    #equ
    CheckStatus$(CheckResultRegistrySummaryStatus(EngineeringCheckRegistry; EngineeringCheckRegistryErrors))
    '</td></tr>
    #if and(CheckRegistryErrorsOK(EngineeringCheckRegistryErrors); CheckSummaryDataOK(CheckResultRegistryStatuses(EngineeringCheckRegistry); CheckResultRegistryUtilizations(EngineeringCheckRegistry)))
        '<tr class="check-governing"><th>Governing check</th><td colspan="3">
        CheckRegistryLink$(CheckResultRegistryGoverningID(EngineeringCheckRegistry))
        '</td><th>Utilization</th>
        #val
        '<td>'CheckResultRegistryGoverningUtilization(EngineeringCheckRegistry)'</td></tr>
        #equ
    #else
        '<tr class="check-governing"><th>Governing check</th><td colspan="3">Not available</td><th>Utilization</th><td>Not available</td></tr>
    #end if
    '</tfoot>
    '</table>
#end def

#def ShowCheckIssues$
    #hide
    ζCHECK_issue_count = CheckResultRegistryIssueCount(EngineeringCheckRegistry; EngineeringCheckRegistryErrors)
    ζCHECK_registry_count = CheckResultRegistryCount(EngineeringCheckRegistry)
    #show
    '<section class="check-issues">
    '<h4>Items Requiring Review</h4>
    #if ζCHECK_issue_count ≡ 0
        '<p class="ok">No warning, failure, or error checks were registered.</p>
    #else
        '<table class="bordered reporting-summary check-issue-summary">
        '<thead><tr><th>Check</th><th>Utilization</th><th>Status</th></tr></thead>
        '<tbody>
        #if ζCHECK_registry_count > 0
            #for ζCHECK_issue_index = 1 : ζCHECK_registry_count
                #hide
                ζCHECK_issue_status = CheckResultRegistryStatusAt(EngineeringCheckRegistry; ζCHECK_issue_index)
                #show
                #if ζCHECK_issue_status ≠ CHK_PASS
                    '<tr><td>
                    CheckRegistryLink$(CheckResultRegistryIDAt(EngineeringCheckRegistry; ζCHECK_issue_index))
                    '</td>
                    #val
                    '<td>'CheckResultRegistryUtilizationAt(EngineeringCheckRegistry; ζCHECK_issue_index)'</td>
                    #equ
                    '<td class="status-cell">
                    CheckStatus$(ζCHECK_issue_status)
                    '</td></tr>
                #end if
            #loop
        #end if
        #if not(CheckRegistryErrorsOK(EngineeringCheckRegistryErrors))
            '<tr><td>Registry</td><td>Not available</td><td class="status-cell"><span class="err">REGISTRATION ERROR</span></td></tr>
        #end if
        '</tbody>
        '</table>
    #end if
    '</section>
#end def
#show
#hide
'<!-- Document-level calculation status helpers. Version 2.0.0. -->

CALC_PASS = 0
CALC_WARN = 10
CALC_FAIL = 20
CALC_INCOMPLETE = 30
CALC_ERROR = 40

CalculationStatusKnown(status) = or(status ≡ CALC_PASS; status ≡ CALC_WARN; status ≡ CALC_FAIL; status ≡ CALC_INCOMPLETE; status ≡ CALC_ERROR)
CalculationValidationKnownCount(statuses) = ValidationCount(statuses; VAL_OK) + ValidationCount(statuses; VAL_WARN) + ValidationCount(statuses; VAL_ERR_UNDEFINED) + ValidationCount(statuses; VAL_ERR_BELOW_RANGE) + ValidationCount(statuses; VAL_ERR_ABOVE_RANGE) + ValidationCount(statuses; VAL_ERR_BAD_RANGE) + ValidationCount(statuses; VAL_ERR_NONPOSITIVE) + ValidationCount(statuses; VAL_ERR_NEGATIVE) + ValidationCount(statuses; VAL_ERR_NOT_INTEGER) + ValidationCount(statuses; VAL_ERR_LENGTH) + ValidationCount(statuses; VAL_ERR_NOT_ALLOWED) + ValidationCount(statuses; VAL_ERR_UNKNOWN) + ValidationCount(statuses; VAL_ERR_BAD_RESULT) + ValidationCount(statuses; VAL_ERR_BAD_SET) + ValidationCount(statuses; VAL_ERR_NOT_REGISTERED) + ValidationCount(statuses; VAL_ERR_NONNEGATIVE) + ValidationCount(statuses; VAL_ERR_POSITIVE) + ValidationCount(statuses; VAL_ERR_ZERO) + ValidationCount(statuses; VAL_ERR_DIMENSIONS) + ValidationCount(statuses; VAL_ERR_ORDER) + ValidationCount(statuses; VAL_ERR_DUPLICATE) + ValidationCount(statuses; VAL_ERR_INSIDE_RANGE) + ValidationCount(statuses; VAL_ERR_NONZERO)
CalculationValidationStatusesOK(statuses) = and(len(statuses) > 0; CalculationValidationKnownCount(statuses) ≡ len(statuses))
CalculationInputsComplete(validation_statuses) = and(CalculationValidationStatusesOK(validation_statuses); not(ValidationHasErrors(validation_statuses)))
CalculationChecksComplete(check_statuses) = and(len(check_statuses) > 0; CheckStatusesOK(check_statuses); CheckErrorCount(check_statuses) ≡ 0)

CalculationStatus(validation_statuses; check_statuses) = switch(len(validation_statuses) ≡ 0; CALC_INCOMPLETE; not(CalculationValidationStatusesOK(validation_statuses)); CALC_ERROR; ValidationHasErrors(validation_statuses); CALC_INCOMPLETE; len(check_statuses) ≡ 0; CALC_INCOMPLETE; not(CheckStatusesOK(check_statuses)); CALC_ERROR; CheckErrorCount(check_statuses) > 0; CALC_ERROR; CheckFailureCount(check_statuses) > 0; CALC_FAIL; or(ValidationWarningCount(validation_statuses) > 0; CheckWarningCount(check_statuses) > 0); CALC_WARN; CALC_PASS)
CalculationStatusFromRegistries(validation_registry; validation_registry_errors; check_registry; check_registry_errors) = switch(not(ValidationResultRegistryShapeOK(validation_registry)); CALC_ERROR; not(ValidationRegistryErrorsOK(validation_registry_errors)); CALC_ERROR; not(CheckResultRegistryShapeOK(check_registry)); CALC_ERROR; not(CheckRegistryErrorsOK(check_registry_errors)); CALC_ERROR; CalculationStatus(ValidationResultRegistryStatuses(validation_registry); CheckResultRegistryStatuses(check_registry)))

CalculationIsPass(status) = status ≡ CALC_PASS
CalculationHasWarning(status) = status ≡ CALC_WARN
CalculationHasFailure(status) = status ≡ CALC_FAIL
CalculationIsIncomplete(status) = status ≡ CALC_INCOMPLETE
CalculationHasError(status) = status ≡ CALC_ERROR
CalculationCanBeIssued(status) = or(status ≡ CALC_PASS; status ≡ CALC_WARN)

#def CalculationStatus$(status$)
    #if status$ ≡ CALC_PASS
        '<span class="calculation-status-label calculation-status-pass">PASS</span>
    #end if
    #if status$ ≡ CALC_WARN
        '<span class="calculation-status-label calculation-status-warning">WARNING</span>
    #end if
    #if status$ ≡ CALC_FAIL
        '<span class="calculation-status-label calculation-status-fail">FAIL</span>
    #end if
    #if status$ ≡ CALC_INCOMPLETE
        '<span class="calculation-status-label calculation-status-incomplete">INCOMPLETE</span>
    #end if
    #if status$ ≡ CALC_ERROR
        '<span class="calculation-status-label calculation-status-error">CALCULATION ERROR</span>
    #end if
    #if not(CalculationStatusKnown(status$))
        '<span class="calculation-status-label calculation-status-error">UNKNOWN STATUS</span>
    #end if
#end def

#def CalculationStatusMessage$(status$)
    #if status$ ≡ CALC_PASS
        'All validated inputs and engineering checks pass.
    #end if
    #if status$ ≡ CALC_WARN
        'The calculation is valid, but one or more warnings require review.
    #end if
    #if status$ ≡ CALC_FAIL
        'One or more engineering checks fail the acceptance criteria.
    #end if
    #if status$ ≡ CALC_INCOMPLETE
        'Required inputs are missing or invalid. Engineering conclusions are not available.
    #end if
    #if status$ ≡ CALC_ERROR
        'The engineering checks could not be evaluated reliably. Review the calculation and status data.
    #end if
    #if not(CalculationStatusKnown(status$))
        'The document-level calculation status is unknown.
    #end if
#end def

#def ShowCalculationStatus$(validation_statuses$; check_statuses$)
    #hide
    ζCALC_status = CalculationStatus(validation_statuses$; check_statuses$)
    #show
    '<section class="calculation-status-banner">
    '<div class="calculation-status-heading"><strong>Calculation Status</strong>
    CalculationStatus$(ζCALC_status)
    '</div>
    '<p class="calculation-status-message">
    CalculationStatusMessage$(ζCALC_status)
    '</p>
    '<table class="bordered data calculation-status-counts">
    '<thead><tr><th>Input validation</th><th>Engineering checks</th></tr></thead>
    '<tbody><tr><td><strong>Warnings:</strong> 'ValidationWarningCount(validation_statuses$)' &nbsp; <strong>Errors:</strong> 'ValidationErrorCount(validation_statuses$)'</td><td><strong>Pass:</strong> 'CheckPassCount(check_statuses$)' &nbsp; <strong>Warning:</strong> 'CheckWarningCount(check_statuses$)' &nbsp; <strong>Fail:</strong> 'CheckFailureCount(check_statuses$)' &nbsp; <strong>Error:</strong> 'CheckErrorCount(check_statuses$)'</td></tr></tbody>
    '</table>
    '</section>
#end def

#def ShowCalculationStatusFromRegistries$
    #hide
    ζCALC_registry_validation_statuses = ValidationResultRegistryEffectiveStatuses(InputValidationRegistry; InputValidationRegistryErrors)
    ζCALC_registry_check_statuses = CheckResultRegistryEffectiveStatuses(EngineeringCheckRegistry; EngineeringCheckRegistryErrors)
    ζCALC_registry_status = CalculationStatusFromRegistries(InputValidationRegistry; InputValidationRegistryErrors; EngineeringCheckRegistry; EngineeringCheckRegistryErrors)
    #show
    '<section class="calculation-status-banner">
    '<div class="calculation-status-heading"><strong>Calculation Status</strong>
    CalculationStatus$(ζCALC_registry_status)
    '</div>
    '<p class="calculation-status-message">
    CalculationStatusMessage$(ζCALC_registry_status)
    '</p>
    '<table class="bordered data calculation-status-counts">
    '<thead><tr><th>Input validation</th><th>Engineering checks</th></tr></thead>
    #val
    '<tbody><tr><td><strong>Warnings:</strong> 'ValidationWarningCount(ζCALC_registry_validation_statuses)' &nbsp; <strong>Errors:</strong> 'ValidationErrorCount(ζCALC_registry_validation_statuses)'</td><td><strong>Pass:</strong> 'CheckPassCount(ζCALC_registry_check_statuses)' &nbsp; <strong>Warning:</strong> 'CheckWarningCount(ζCALC_registry_check_statuses)' &nbsp; <strong>Fail:</strong> 'CheckFailureCount(ζCALC_registry_check_statuses)' &nbsp; <strong>Error:</strong> 'CheckErrorCount(ζCALC_registry_check_statuses)'</td></tr></tbody>
    #equ
    '</table>
    '</section>
#end def

#def AddCalculationStatusConclusion$(label$; status$)
    '<p><strong>label$:</strong>
    CalculationStatus$(status$)
    '</p>
#end def
#show
#hide
'<!-- Structured engineering-report registries. Version 2.0.0. -->

RPT_OK = 0
RPT_ERR_BAD_REGISTRY = 10
RPT_ERR_BAD_ID = 20
RPT_ERR_DUPLICATE_ID = 30
RPT_ERR_UNKNOWN_REFERENCE = 40

RPT_EMPTY = 0
RPT_NO_REFERENCE = 0

RPT_ENTRY_REFERENCE = 1
RPT_ENTRY_CRITERION = 2
RPT_ENTRY_ASSUMPTION = 3
RPT_ENTRY_LIMITATION = 4

'<!-- CalcPad registries are numeric: report text stays in the rendered macro call while these attempt rows preserve type, stable ID, status, and source sequence. -->
RPT_ATTEMPT_TYPE = 1
RPT_ATTEMPT_ID = 2
RPT_ATTEMPT_STATUS = 3
RPT_ATTEMPT_SEQUENCE = 4
RPT_ATTEMPT_COLUMNS = 4

ReportRegistryEmpty = [RPT_EMPTY]
'<!-- Linked rows store [entry ID; reference ID]. A zero reference is allowed only where the calling macro declares the source optional. -->
ReportLinkedRegistryEmpty = join_rows([RPT_EMPTY; RPT_NO_REFERENCE])

ReportRegistryShapeOK(registry) = and(n_cols(registry) ≡ 1; n_rows(registry) ≥ 1; take(1; col(registry; 1)) ≡ RPT_EMPTY)
ReportLinkedRegistryShapeOK(registry) = and(n_cols(registry) ≡ 2; n_rows(registry) ≥ 1; take(1; col(registry; 1)) ≡ RPT_EMPTY; take(1; col(registry; min(n_cols(registry); 2))) ≡ RPT_NO_REFERENCE)
ReportIDOK(id) = and(ValidationIsInteger(id); id > 0)
ReportReferenceIDOK(reference_id) = and(ValidationIsInteger(reference_id); reference_id ≥ RPT_NO_REFERENCE)
ReportRegistryEntryExists(registry; id) = if(ReportRegistryShapeOK(registry); count(col(registry; 1); id; 1) > 0; 0)
ReportRegistryCount(registry) = if(ReportRegistryShapeOK(registry); n_rows(registry) - 1; 0)
ReportLinkedRegistryCount(registry) = if(ReportLinkedRegistryShapeOK(registry); n_rows(registry) - 1; 0)
ReportReferenceKnown(references; reference_id) = or(reference_id ≡ RPT_NO_REFERENCE; ReportRegistryEntryExists(references; reference_id))

ReportRegistryAddStatus(registry; id) = switch(
    not(ReportRegistryShapeOK(registry)); RPT_ERR_BAD_REGISTRY;
    not(ReportIDOK(id)); RPT_ERR_BAD_ID;
    ReportRegistryEntryExists(registry; id); RPT_ERR_DUPLICATE_ID;
    RPT_OK)

ReportRegistryAdd(registry; id) = if(ReportRegistryAddStatus(registry; id) ≡ RPT_OK; join(registry; id); registry)

ReportLinkedRegistryAddStatus(registry; id; reference_id; references; reference_required) = switch(
    not(ReportLinkedRegistryShapeOK(registry)); RPT_ERR_BAD_REGISTRY;
    not(ReportRegistryShapeOK(references)); RPT_ERR_BAD_REGISTRY;
    not(ReportIDOK(id)); RPT_ERR_BAD_ID;
    ReportRegistryEntryExists(col(registry; 1); id); RPT_ERR_DUPLICATE_ID;
    not(ReportReferenceIDOK(reference_id)); RPT_ERR_UNKNOWN_REFERENCE;
    and(reference_required; reference_id ≡ RPT_NO_REFERENCE); RPT_ERR_UNKNOWN_REFERENCE;
    not(ReportReferenceKnown(references; reference_id)); RPT_ERR_UNKNOWN_REFERENCE;
    RPT_OK)

ReportLinkedRegistryAdd(registry; id; reference_id; references; reference_required) = if(ReportLinkedRegistryAddStatus(registry; id; reference_id; references; reference_required) ≡ RPT_OK; stack(registry; join_rows([id; reference_id])); registry)
ReportLinkedRegistryReference(registry; id) = if(ReportLinkedRegistryShapeOK(registry); DBLookupOr(registry; id; 1; 2; RPT_NO_REFERENCE); RPT_NO_REFERENCE)

ReportEntryTypeKnown(entry_type) = or(entry_type ≡ RPT_ENTRY_REFERENCE; entry_type ≡ RPT_ENTRY_CRITERION; entry_type ≡ RPT_ENTRY_ASSUMPTION; entry_type ≡ RPT_ENTRY_LIMITATION)
ReportErrorRegistryEmpty = join_rows([0; 0; RPT_OK; 0])
'<!-- Attempt records include successful and failed calls so error links can return to the exact rendered source row rather than only the entry ID. -->
ReportErrorRegistryShapeOK(errors) = and(n_cols(errors) ≡ RPT_ATTEMPT_COLUMNS; n_rows(errors) ≥ 1; take(1; col(errors; RPT_ATTEMPT_SEQUENCE)) ≡ 0)
ReportErrorRegistryAttemptCount(errors) = if(ReportErrorRegistryShapeOK(errors); n_rows(errors) - 1; 0)
ReportErrorRecord(entry_type; id; status; sequence) = join_rows([entry_type; id; status; sequence])
ReportErrorRegistryAdd(errors; entry_type; id; status) = stack(errors; ReportErrorRecord(entry_type; id; status; ReportErrorRegistryAttemptCount(errors) + 1))
ReportErrorRegistryCount(errors) = if(ReportErrorRegistryShapeOK(errors); n_rows(errors) - count(col(errors; RPT_ATTEMPT_STATUS); RPT_OK; 1); 1)
ReportErrorRegistryStatus(errors) = if(ReportErrorRegistryCount(errors) ≡ 0; RPT_OK; max(col(errors; RPT_ATTEMPT_STATUS)))
ReportErrorRegistryTypeAt(errors; index) = take(index; last(col(errors; RPT_ATTEMPT_TYPE); max(ReportErrorRegistryAttemptCount(errors); 1)))
ReportErrorRegistryIDAt(errors; index) = take(index; last(col(errors; RPT_ATTEMPT_ID); max(ReportErrorRegistryAttemptCount(errors); 1)))
ReportErrorRegistryStatusAt(errors; index) = take(index; last(col(errors; RPT_ATTEMPT_STATUS); max(ReportErrorRegistryAttemptCount(errors); 1)))
ReportErrorRegistrySequenceAt(errors; index) = take(index; last(col(errors; RPT_ATTEMPT_SEQUENCE); max(ReportErrorRegistryAttemptCount(errors); 1)))
ReportRegistriesCount(references; criteria; assumptions; limitations) = ReportRegistryCount(references) + ReportLinkedRegistryCount(criteria) + ReportLinkedRegistryCount(assumptions) + ReportLinkedRegistryCount(limitations)
ReportRegistriesStatus(references; criteria; assumptions; limitations; errors) = switch(
    not(ReportRegistryShapeOK(references)); RPT_ERR_BAD_REGISTRY;
    not(ReportLinkedRegistryShapeOK(criteria)); RPT_ERR_BAD_REGISTRY;
    not(ReportLinkedRegistryShapeOK(assumptions)); RPT_ERR_BAD_REGISTRY;
    not(ReportLinkedRegistryShapeOK(limitations)); RPT_ERR_BAD_REGISTRY;
    ReportErrorRegistryStatus(errors) ≠ RPT_OK; ReportErrorRegistryStatus(errors);
    RPT_OK)

ReportReferences = ReportRegistryEmpty
ReportDesignCriteria = ReportLinkedRegistryEmpty
ReportAssumptions = ReportLinkedRegistryEmpty
ReportLimitations = ReportLinkedRegistryEmpty
ReportRegistryErrors = ReportErrorRegistryEmpty

#def ReportStatus$(status$)
    #if status$ ≡ RPT_OK
        '<span class="ok">VALID</span>
    #end if
    #if status$ ≡ RPT_ERR_BAD_REGISTRY
        '<span class="err">INVALID REGISTRY</span>
    #end if
    #if status$ ≡ RPT_ERR_BAD_ID
        '<span class="err">INVALID ID</span>
    #end if
    #if status$ ≡ RPT_ERR_DUPLICATE_ID
        '<span class="err">DUPLICATE ID</span>
    #end if
    #if status$ ≡ RPT_ERR_UNKNOWN_REFERENCE
        '<span class="err">UNKNOWN REFERENCE</span>
    #end if
    #if not(or(status$ ≡ RPT_OK; status$ ≡ RPT_ERR_BAD_REGISTRY; status$ ≡ RPT_ERR_BAD_ID; status$ ≡ RPT_ERR_DUPLICATE_ID; status$ ≡ RPT_ERR_UNKNOWN_REFERENCE))
        '<span class="err">UNKNOWN REPORTING STATUS</span>
