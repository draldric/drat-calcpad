#end def

#def AddReference$(id$; document$; title$; edition$; clause$; notes$)
    #hide
    ζRPT_reference_status = ReportRegistryAddStatus(ReportReferences; id$)
    ReportReferences = ReportRegistryAdd(ReportReferences; id$)
    ReportRegistryErrors = ReportErrorRegistryAdd(ReportRegistryErrors; RPT_ENTRY_REFERENCE; id$; ζRPT_reference_status)
    ζRPT_reference_sequence = ReportErrorRegistryAttemptCount(ReportRegistryErrors)
    #show
    #val
    '<tr id="report-entry-1-'ζRPT_reference_sequence'">
    #equ
    '<td class="registry-id">
    #if ζRPT_reference_status ≡ RPT_OK
        '<span id="report-reference-id$"></span>
    #end if
    ReportID$(id$)
    '</td><td>document$</td><td>title$</td><td>edition$</td><td>clause$</td><td>notes$</td></tr>
    #if ζRPT_reference_status ≠ RPT_OK
        '<tr class="registry-error"><td></td><td colspan="5"><strong>Reference registry error:</strong>
        ReportStatus$(ζRPT_reference_status)
        '</td></tr>
    #end if
#end def

#def EndReferences$
