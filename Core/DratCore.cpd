	    'window.TSPlots=window.TSPlots||{};
	    'window.TSPlots["id$"]={
	    '  data:[],
	    '  layout:{
	    '    template:"plotly_white",
	    '    autosize:true,
	    '    font:{family:"Courier New, monospace",size:12},
	    '    margin:{l:70,r:35,b:85,t:65},
	    '    hovermode:"closest",
	    '    showlegend:true,
	    '    legend:{orientation:"h",x:0,y:-0.20},
	    '    xaxis:{automargin:true,zeroline:false},
	    '    yaxis:{automargin:true,zeroline:false},
	    '    shapes:[],
	    '    annotations:[]
	    '  },
	    '  config:{responsive:true,displaylogo:false,scrollZoom:false},
	    '  maxWidth:900,
	    '  height:450
	    '};
	    '</script>
	    #equ
#end def

