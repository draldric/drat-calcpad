#hide
'<!-- Shared worksheet stylesheet. Version 1.8.0. -->
#show
'<style>*{font-family:courier new;font-size:10pt;}</style>
'<style>body{counter-reset:h3counter;}</style>
'<style>h1,h2,h3,h4,h5,h6{text-transform:uppercase;font-family:courier new;}</style>
'<style>h1{font-size:16pt;}</style>
'<style>h2{font-size:12pt;}</style>
'<style>h3{font-size:16pt;counter-reset:h4counter;counter-increment:h3counter;border-bottom:1.5px solid #999;padding-bottom:5px;margin-bottom:15px;}</style>
'<style>h4{font-size:14pt;counter-reset:h5counter;counter-increment:h4counter;}</style>
'<style>h5{font-size:12pt;counter-reset:h6counter;counter-increment:h5counter;}</style>
'<style>h6{font-size:10pt;counter-increment:h6counter;}</style>
'<style>h3::before{content:counter(h3counter) ". ";}</style>
'<style>h4::before{content:counter(h3counter) "." counter(h4counter) ". ";}</style>
'<style>h5::before{content:counter(h3counter) "." counter(h4counter) "." counter(h5counter) ". ";}</style>
'<style>h6::before{content:counter(h3counter) "." counter(h4counter) "." counter(h5counter) "." counter(h6counter) ". ";}</style>
'<style>p{text-transform:none;margin-left:2em;font-family:courier new;text-align:justify;}</style>
'<style>span{font-family:courier new;}</style>
'<style>.ref{font-family:courier new;background-color:#daf5ff;color:#000000;}</style>
'<style>.note{font-family:courier new;background-color:#ffffaa;}</style>
'<style>table,ol,ul,.plot{margin-left:2em;}</style>
'<style>.content-box{columns:3;column-gap:20px;}</style>
'<style>.row{display:flex;}</style>
'<style>.column{flex:50%;}</style>
'<style>.document-header{display:flex;gap:2em;align-items:stretch;border-bottom:2px solid #444;padding-bottom:1em;margin-bottom:1em;}</style>
'<style>.document-identity{flex:1;display:flex;flex-direction:column;justify-content:center;font-size:12pt;}</style>
'<style>.document-identity strong{font-size:16pt;text-transform:uppercase;}</style>
'<style>.document-control{flex:2;margin-left:0;}</style>
'<style>.document-summary{border-bottom:1px solid #999;padding-bottom:0.5em;margin-bottom:1em;}</style>
'<style>.document-summary h2{margin-bottom:0.25em;}</style>
'<style>.conclusions{border:2px solid #444;background:#f5f5f5;padding:1em;margin:1em 2em;}</style>
'<style>.calculation-status-banner{border:2px solid #444;border-left-width:8px;background:#f5f5f5;padding:0.75em 1em;margin:1.5em 2em;break-inside:avoid;page-break-inside:avoid;}</style>
'<style>.calculation-status-heading{display:flex;justify-content:space-between;align-items:center;gap:1em;font-size:12pt;text-transform:uppercase;}</style>
'<style>.calculation-status-label{display:inline-block;padding:0.2em 0.6em;border:2px solid currentColor;font-weight:bold;white-space:nowrap;}</style>
'<style>.calculation-status-pass{color:#176b2c;background:#e8f5e9;}</style>
'<style>.calculation-status-warning{color:#795500;background:#fff4c2;}</style>
'<style>.calculation-status-fail,.calculation-status-error{color:#9b1c1c;background:#fdeaea;}</style>
'<style>.calculation-status-incomplete{color:#555;background:#eeeeee;}</style>
'<style>.calculation-status-message{margin:0.75em 0 0.5em 0;text-align:left;}</style>
'<style>.calculation-status-counts{width:100%;margin:0;table-layout:auto;}</style>
'<style>.calculation-status-counts th,.calculation-status-counts td{text-align:center;}</style>
'<style>.reporting-summary{width:95%;table-layout:auto;}</style>
'<style>.reporting-summary th,.reporting-summary td{vertical-align:top;}</style>
'<style>.reporting-summary .status-cell{white-space:nowrap;text-align:center;}</style>
'<style>.reporting-registry{width:95%;table-layout:auto;}</style>
'<style>.reporting-registry th,.reporting-registry td{text-align:left;vertical-align:top;}</style>
'<style>.reporting-registry .registry-id,.reporting-registry-summary td{text-align:center;white-space:nowrap;}</style>
'<style>.reporting-registry .registry-reference-link{font-weight:bold;}</style>
'<style>.reporting-registry .registry-error td{background:#fff2f2;color:#b30000;}</style>
'<style>.reporting-registry tfoot th,.reporting-registry tfoot td{background:#f5f5f5;font-weight:bold;}</style>
'<style>.check-summary .check-title th{text-align:left;background:#e8e8e8;border-top:2px solid #666;}</style>
'<style>table.data.check-summary td.check-demand{text-align:right;}</style>
'<style>.check-summary .check-counts td{text-align:center;}</style>
'<style>.check-summary .check-governing td:first-of-type{text-align:left;}</style>
'<style>.check-registry .check-registry-id{display:inline-block;min-width:5.5em;margin-right:0.75em;padding:0.1em 0.4em;border:1px solid #777;background:#fff;text-align:center;white-space:nowrap;}</style>
'<style>.check-registry .check-registry-entry:focus{outline:3px solid #337ab7;outline-offset:2px;}</style>
'<style>.check-registry .check-registry-error td{background:#fff2f2;color:#b30000;text-align:left;}</style>
'<style>.check-registry-link{font-weight:bold;white-space:nowrap;}</style>
'<style>.check-issue-summary td:first-child{text-align:left;}</style>
'<style>.check-issue-summary td:nth-child(2){text-align:right;}</style>
'<style>.validation-registry .validation-registry-id{display:inline-block;min-width:5.5em;margin-right:0.75em;padding:0.1em 0.4em;border:1px solid #777;background:#fff;text-align:center;white-space:nowrap;}</style>
'<style>.validation-registry .validation-registry-entry:focus{outline:3px solid #337ab7;outline-offset:2px;}</style>
'<style>.validation-registry .validation-registry-error td{background:#fff2f2;color:#b30000;text-align:left;}</style>
'<style>.validation-registry-link{font-weight:bold;white-space:nowrap;}</style>
'<style>.validation-issue-summary td:first-child{text-align:left;}</style>
'<style>.validation-issue-summary td:nth-child(2){text-align:right;}</style>
'<style>.report-entry-link{font-weight:bold;white-space:nowrap;}</style>
'<style>.document-review-summary{border:2px solid #444;background:#f5f5f5;padding:0.75em 1em;margin:1.5em 2em;break-inside:avoid;page-break-inside:avoid;}</style>
'<style>.document-review-heading{display:flex;justify-content:space-between;align-items:center;gap:1em;font-size:12pt;text-transform:uppercase;}</style>
'<style>.review-status-label{display:inline-block;padding:0.2em 0.6em;border:2px solid currentColor;font-weight:bold;white-space:nowrap;}</style>
'<style>.review-status-ready{color:#176b2c;background:#e8f5e9;}</style>
'<style>.review-status-attention{color:#795500;background:#fff4c2;}</style>
'<style>.review-status-blocked,.review-status-error{color:#9b1c1c;background:#fdeaea;}</style>
'<style>.document-review-counts,.document-review-issues{width:100%;margin:0.75em 0 0 0;}</style>
'<style>.document-review-counts th,.document-review-counts td{text-align:center;}</style>
'<style>.document-review-issues td:first-child,.document-review-issues td:nth-child(2){text-align:left;}</style>
'<style>table.data.revision-history td:first-child{text-align:right;}</style>
'<style>@media print{h3{break-before:page;page-break-before:always;}h3,h4,h5,h6{break-after:avoid-page;page-break-after:avoid;}.document-header,.document-summary,.conclusions,.reporting-summary,.calculation-status-banner,.document-review-summary{break-inside:avoid;page-break-inside:avoid;}.reporting-summary{font-size:9pt;}}</style>
