'<style>*{font-family:courier new;font-size:10pt;}</style>
'<style>body{counter-reset:h3counter;}</style>
'<style>h1,h2,h3,h4,h5,h6{text-transform:uppercase;font-family:courier new;}</style>
'<style>h1{font-size:16pt;}</style>
'<style>h2{font-size:12pt;}</style>
'<style>h3{font-size:16pt;counter-reset:h4counter;counter-increment:h3counter;border-bottom:1.5px solid #999;padding-bottom:5px;margin-bottom:15px;}</style>
'<style>h4{font-size:14pt;counter-reset:h5counter;counter-increment:h4counter;}</style>
'<style>h5{font-size:12pt;counter-reset:h6counter;counter-increment:h5counter;}</style>
'<style>h6{font-size:10pt;counter-increment:h6counter;}</style>
'<style>h3::before{content:counter(h3counter) ". ";}</style>
'<style>h4::before{content:counter(h3counter) "." counter(h4counter) ". ";}</style>
'<style>h5::before{content:counter(h3counter) "." counter(h4counter) "." counter(h5counter) ". ";}</style>
'<style>h6::before{content:counter(h3counter) "." counter(h4counter) "." counter(h5counter) "." counter(h6counter) ". ";}</style>
'<style>p{text-transform:none;margin-left:2em;font-family:courier new;text-align:justify;}</style>
'<style>span{font-family:courier new;}</style>
'<style>.ref{font-family:courier new;background-color:#daf5ff;color:#000000;}</style>
'<style>.note{font-family:courier new;background-color:#ffffaa;}</style>
'<style>table,ol,ul,.plot{margin-left:2em;}</style>
'<style>.content-box{columns:3;column-gap:20px;}</style>
'<style>.row{display:flex;}</style>
'<style>.column{flex:50%;}</style>
'<style>.document-header{display:flex;gap:2em;align-items:stretch;border-bottom:2px solid #444;padding-bottom:1em;margin-bottom:1em;}</style>
'<style>.document-identity{flex:1;display:flex;flex-direction:column;justify-content:center;font-size:12pt;}</style>
'<style>.document-identity strong{font-size:16pt;text-transform:uppercase;}</style>
'<style>.document-control{flex:2;margin-left:0;}</style>
'<style>.document-summary{border-bottom:1px solid #999;padding-bottom:0.5em;margin-bottom:1em;}</style>
'<style>.document-summary h2{margin-bottom:0.25em;}</style>
'<style>.conclusions{border:2px solid #444;background:#f5f5f5;padding:1em;margin:1em 2em;}</style>
'<style>.reporting-summary{width:95%;table-layout:auto;}</style>
'<style>.reporting-summary th,.reporting-summary td{vertical-align:top;}</style>
'<style>.reporting-summary .status-cell{white-space:nowrap;text-align:center;}</style>
'<style>.check-summary .check-title th{text-align:left;background:#e8e8e8;border-top:2px solid #666;}</style>
'<style>table.data.check-summary td.check-demand{text-align:right;}</style>
'<style>.check-summary .check-counts td{text-align:center;}</style>
'<style>.check-summary .check-governing td:first-of-type{text-align:left;}</style>
'<style>table.data.revision-history td:first-child{text-align:right;}</style>
'<style>@media print{h3{break-before:page;page-break-before:always;}h3,h4,h5,h6{break-after:avoid-page;page-break-after:avoid;}.document-header,.document-summary,.conclusions,.reporting-summary{break-inside:avoid;page-break-inside:avoid;}.reporting-summary{font-size:9pt;}}</style>
