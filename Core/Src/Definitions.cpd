#hide
'<!-- Worksheet formatting definitions. Version 1.2.1. -->

'<!-----------------------------|PDF FORMATTING|------------------------------!>
#def pagebreak$ = '<p style="page-break-before: always;"></p>
#def tab$ = '&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;'

'<!--------------------------------|MESSAGES|---------------------------------!>
#def err$(msg$) = '<span class="err">msg$</span>
#def ok$(msg$) = '<span class="ok">msg$</span>
#def desc$(msg$) = '<span class="note">msg$</span>
#def ref$(msg$) = '<span class="ref">msg$</span>

'<!----------------------------|MATHCAD UTILITIES|----------------------------!>
#def cmt$(c$) = '<!--'c$'-->'
#def shide$ = '<!--'
#def ehide$ = '-->'

'<!------------------------------------||-------------------------------------!>
#def if$(cond$; true$; false$)
    #if cond$
        '<p>'true$'</p>
    #else
        '<p>'false$'</p>
    #end if
#end def

'<!--------------------------|WORKSHEET FORMATTING|---------------------------!>
#def CreateHeader$
    '<div class="document-header">
    '<div class="document-identity">
    '<strong>Organization$</strong>
    '<span>Engineering Calculation Worksheet</span>
    '</div>
    '<table class="bordered data document-control">
    '<tbody>
    '<tr><td><strong>Calculation</strong></td><td>Calculation$</td><td><strong>Revision</strong></td><td>Rev$</td></tr>
    '<tr><td><strong>Client</strong></td><td colspan="3">Client$</td></tr>
    '<tr><td><strong>Project</strong></td><td colspan="3">Project$</td></tr>
    '<tr><td><strong>Prepared by</strong></td><td>PreparedBy$</td><td><strong>Date</strong></td><td>PreparedOn$</td></tr>
    '<tr><td><strong>Checked by</strong></td><td>CheckedBy$</td><td><strong>Date</strong></td><td>CheckedOn$</td></tr>
    '<tr><td><strong>Approved by</strong></td><td>ApprovedBy$</td><td><strong>Date</strong></td><td>ApprovedOn$</td></tr>
    '</tbody>
    '</table>
    '</div>
#end def
#def CreateTitle$
    '<section class="document-summary">
    '<h2>Title</h2>
    '<p>Title$</p>
    '</section>
#end def
#def CreatePurpose$
    '<section class="document-summary">
    '<h2>Purpose</h2>
    '<p>Purpose$</p>
    '</section>
#end def
#def CreateScope$
    '<section class="document-summary">
    '<h2>Scope</h2>
    '<p>Scope$</p>
    '</section>
#end def
#def BeginReferences$
    '<hr/>
    '## References
    '<ol>
#end def
#def AddReference$(R$)
    '<li>R$</li>
#end def
#def EndReferences$
    '</ol>
#end def
#def BeginRevisions$
    '## Revision History
    '<table class="bordered data revision-history" style="width:95%">
    '<thead>
    '<tr><th>Revision</th><th>Description</th><th>Author</th><th>Date</th></tr>
    '</thead>
    '<tbody>
#end def
#def AddRevision$(R$; D$; A$; Da$)
    '<tr><td>R$</td><td>D$</td><td>A$</td><td>Da$</td></tr>
#end def
#def EndRevisions$
    '</tbody>
    '</table>
#end def
#def BeginInitialConditions$
    '### Design Basis and Assumptions
    '<ul>
#end def
#def AddInitialCondition$(IC$)
    '<li>IC$</li>
#end def
#def EndInitialConditions$
    '</ul>
#end def
#def BeginListSection$(heading$)
    '#### heading$
    '<ul>
#end def
#def AddListItem$(item$)
    '<li>item$</li>
#end def
#def EndListSection$
    '</ul>
#end def
#def BeginVariables$
    '### List of Variables
    #noc
    '<table class="bordered" style="width:95%">
    '<thead>
    '<tr><th>Symbol</th><th>Description</th><th>Units</th></tr>
    '</thead>
    '<tbody>
#end def
#def AddVariable$(var$; desc$; units$)
    '<tr><td>var$</td><td>desc$</td><td>units$</td></tr>
#end def
#def EndVariables$
    '</tbody>
    '</table>
    #equ
#end def

#def BeginConclusions$
    '### Conclusions
    '<div class="conclusions">
#end def
#def AddConclusion$(label$; value$)
    '<p><strong>label$:</strong> 'value$'</p>
#end def
#def AddValidationConclusion$(label$; status$)
    '<p><strong>label$:</strong>
    ValidationStatus$(status$)
    '</p>
#end def
#def AddCheckConclusion$(label$; status$)
    '<p><strong>label$:</strong>
    CheckStatus$(status$)
    '</p>
#end def
#def EndConclusions$
    '</div>
#end def
#show
