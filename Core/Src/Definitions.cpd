#hide
'<!-----------------------------|PDF FORMATTING|------------------------------!>
#def pagebreak$ = '<p style="page-break-before: always;"></p>
#def tab$ = '&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp'

'<!--------------------------------|MESSAGES|---------------------------------!>
#def err$(msg$) = '<span class="err">msg$</span>
#def ok$(msg$) = '<span class="ok">msg$</span>
#def desc$(msg$) = '<span class="note">msg$</span>
#def ref$(msg$) = '<span class="ref">msg$</span>

'<!----------------------------|MATHCAD UTILITIES|----------------------------!>
#def cmt$(c$) = '<!--'c$'--!>'
#def shide$ = '<!--'
#def ehide$ = '--!>'

'<!------------------------------------||-------------------------------------!>
#def if$(cond$; true$; false$)
	#if cond$
		'<p>'true$'</p>
	#else
		'<p>'false$'</p>
	#end if
#end def

'<!--------------------------|WORKSHEET FORMATTING|---------------------------!>
#def CreateHeader$
	'<div class="row"> 
	'<div class="column"> 
	'<img style="height:auto; width:100%" src="logoPath$" alt="">
	'# Engineering Calculation Worksheet
	'</div> 
	'<div class="column">
	'<table class="bordered data" width="100%">
	'<tbody>
	'<tr><td><strong>Calculation</strong></td><td>Calculation$</td><td>Rev Rev$</td></tr>
	'<tr><td><strong>Author</strong></td><td>Author$</td><td>Date$</td></tr>
	'<tr><td><strong>Checked</strong></td><td>CheckedBy$</td><td>CheckedOn$</td></tr> 
	'<tr><td><strong>Approved</strong></td><td>ApprovedBy$</td><td>ApprovedOn$</td></tr>
	'</tbody>
	'</table>
	'</div> 
	'</div > 
#end def
#def CreateTitle$
	'<hr/>
	'## Title
	'Title$
#end def
#def CreatePurpose$
	'<hr/>
	'## Purpose
	'Purpose$
#end def
#def BeginReferences$
	'<hr/> 
	'## References
	'<ol>
#end def
#def AddReference$(R$)
	'<li>R$</li>
#end def
#def EndReferences$
	'</ol>
#end def
#def BeginRevisions$
	'<hr/> 
	'## Revision History
	'<table class="bordered" style="width:95%">
	'<thead>
	'<tr><th>Revision</th><th>Description</th><th>Author</th><th>Date</th></tr>
	'</thead>
	'<tbody>
#end def
#def AddRevision$(R$; D$; A$; Da$)
	'<tr><td>R$</td><td>D$</td><td>A$</td><td>Da$</td></tr>
#end def
#def EndRevisions$
	'</tbody>
	'</table>
#end def
#def BeginInitialConditions$
	pagebreak$
	'## Initial Conditions and Assumptions
	'<ul>
#end def
#def AddInitialCondition$(IC$)
	'<li>IC$</li>
#end def
#def EndInitialConditions$
	'</ul>
#end def
#def BeginVariables$
	'<hr/>
	'## List of Variables
	#noc
	'<table class="bordered" style="width:95%">
	'<thead>
	'<tr><th>Symbol</th><th>Description</th><th>Units</th></tr>
	'</thead>
	'<tbody>
#end def
#def AddVariable$(var$; desc$; units$)
	'<tr><td>var$</td><td>desc$</td><td>units$</td></tr>
#end def
#def EndVariables$
	'</tbody>
	'</table>
	#equ
#end def
#show