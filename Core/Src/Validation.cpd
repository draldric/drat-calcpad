    #end if
    #if ζVAL_rule ≡ VAL_RULE_MATRIX_COLUMNS
        '<span class="validation-permitted">'ζVAL_data_1' to 'ζVAL_data_2' columns</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_SQUARE_MATRIX
        '<span class="validation-permitted">Equal row and column counts</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_VECTOR_RANGE
        '<span class="validation-permitted">Every entry from 'ζVAL_data_1' to 'ζVAL_data_2'</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_VECTOR_POSITIVE
        '<span class="validation-permitted">Every entry positive</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_VECTOR_NONNEGATIVE
        '<span class="validation-permitted">Every entry nonnegative</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_INCREASING
        '<span class="validation-permitted">Strictly increasing entries</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_NONDECREASING
        '<span class="validation-permitted">Nondecreasing entries</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_UNIQUE
        '<span class="validation-permitted">Unique entries</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_MATCHING_LENGTH
        '<span class="validation-permitted">Matching vector lengths</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_ZERO
        '<span class="validation-permitted">Absolute value at most 'ζVAL_data_1'</span>
    #end if
    #if ζVAL_rule ≡ VAL_RULE_VECTOR_DEFINED
        '<span class="validation-permitted">Every entry defined and finite</span>
