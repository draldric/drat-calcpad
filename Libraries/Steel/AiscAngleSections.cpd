#def ShowAiscAngleProperties$(item$)
    #hide
    ζAISC_angle_item = item$
    ζAISC_angle_item_ok = AiscAngleHasItem(ζAISC_angle_item)
    #show
    #novar
    '<table class="bordered data angle-property" style="width:95%"><thead><tr><th>Property</th><th>Value</th></tr></thead><tbody>
    #if ζAISC_angle_item_ok
        #for ζAISC_angle_property = 1 : AiscAnglePropertyCount
            #hide
            ζAISC_angle_value = AiscAngleProperty(ζAISC_angle_item; ζAISC_angle_property)
            #show
            '<tr><td style="text-align:left">
            AiscAnglePropertyName$(ζAISC_angle_property)
            '</td><td>'ζAISC_angle_value'</td></tr>
        #loop
    #end if
    #if not(ζAISC_angle_item_ok)
        '<tr><td colspan="2" class="status-cell">
        DBStatus$(DB_ERR_NAME)
        '</td></tr>
    #end if
    '</tbody></table>
#end def
#show
#else
'<div style="margin:1em;padding:0.75em;border:2px solid #b00020;color:#b00020;background:#fff0f2;"><strong>DRAT library load error:</strong> AiscAngleSections requires DataWrapper API 0.3.2 or newer. Load a compatible DratCore.cpd before this library.</div>
#end if
