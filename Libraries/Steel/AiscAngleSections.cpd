#def AiscAnglePropertyName$(property$)
    #if property$ ≡ 1
        'Nominal weight
    #end if
    #if property$ ≡ 2
        'Area
    #end if
    #if property$ ≡ 3
        'Long-leg length
    #end if
    #if property$ ≡ 4
        'Short-leg length
    #end if
    #if property$ ≡ 5
        'Angle thickness
    #end if
    #if property$ ≡ 6
        'Centroid x-coordinate
    #end if
    #if property$ ≡ 7
        'Centroid y-coordinate
    #end if
    #if property$ ≡ 8
        'x-axis inertia
    #end if
    #if property$ ≡ 9
        'x-axis plastic modulus
    #end if
    #if property$ ≡ 10
        'x-axis elastic modulus
    #end if
    #if property$ ≡ 11
        'x-axis radius of gyration
    #end if
    #if property$ ≡ 12
        'y-axis inertia
    #end if
    #if property$ ≡ 13
        'y-axis plastic modulus
    #end if
    #if property$ ≡ 14
        'y-axis elastic modulus
    #end if
    #if property$ ≡ 15
        'y-axis radius of gyration
    #end if
    #if property$ ≡ 16
        'principal z-axis inertia
    #end if
    #if property$ ≡ 17
        'principal z-axis radius of gyration
    #end if
    #if property$ ≡ 18
        'principal z-axis elastic modulus
    #end if
    #if property$ ≡ 19
        'Torsional constant
    #end if
    #if property$ ≡ 20
        'Warping constant
    #end if
#end def
#def ShowAiscAngleDatasetSummary$
    #novar
