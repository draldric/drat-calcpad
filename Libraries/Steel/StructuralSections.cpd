#def AiscWPropertyName$(property$)
    #if property$ ≡ 1
        'Nominal weight
    #end if
    #if property$ ≡ 2
        'Area
    #end if
    #if property$ ≡ 3
        'Depth
    #end if
    #if property$ ≡ 4
        'Flange width
    #end if
    #if property$ ≡ 5
        'Web thickness
    #end if
    #if property$ ≡ 6
        'Flange thickness
    #end if
    #if property$ ≡ 7
        'Strong-axis inertia
    #end if
    #if property$ ≡ 8
        'Strong-axis plastic modulus
    #end if
    #if property$ ≡ 9
        'Strong-axis elastic modulus
    #end if
    #if property$ ≡ 10
        'Strong-axis radius of gyration
    #end if
    #if property$ ≡ 11
        'Weak-axis inertia
    #end if
    #if property$ ≡ 12
        'Weak-axis plastic modulus
    #end if
    #if property$ ≡ 13
        'Weak-axis elastic modulus
    #end if
    #if property$ ≡ 14
        'Weak-axis radius of gyration
    #end if
    #if property$ ≡ 15
        'Torsional constant
    #end if
    #if property$ ≡ 16
        'Warping constant
    #end if
#end def
#def AiscWPropertyUnit$(property$)
    #if property$ ≡ 1
        'lb/ft
    #end if
    #if property$ ≡ 2
        'in^2
    #end if
    #if property$ ≡ 3
        'in
    #end if
    #if property$ ≡ 4
        'in
    #end if
    #if property$ ≡ 5
        'in
    #end if
    #if property$ ≡ 6
        'in
    #end if
    #if property$ ≡ 7
        'in^4
    #end if
    #if property$ ≡ 8
        'in^3
    #end if
    #if property$ ≡ 9
        'in^3
    #end if
    #if property$ ≡ 10
        'in
    #end if
    #if property$ ≡ 11
        'in^4
    #end if
    #if property$ ≡ 12
        'in^3
    #end if
    #if property$ ≡ 13
        'in^3
    #end if
    #if property$ ≡ 14
        'in
    #end if
    #if property$ ≡ 15
        'in^4
    #end if
    #if property$ ≡ 16
        'in^6
    #end if
#end def
#def ShowAiscWDatasetSummary$
    #novar
    '<table class="bordered data section-summary" style="width:95%"><tbody>
    '<tr><td><strong>Library</strong></td><td>StructuralSectionsLibraryName$</td></tr>
    '<tr><td><strong>Library revision</strong></td><td>StructuralSectionsLibraryRevision$</td></tr>
    '<tr><td><strong>Source</strong></td><td>StructuralSectionsLibrarySource$</td></tr>
    '<tr><td><strong>Scope</strong></td><td>StructuralSectionsLibraryScope$</td></tr>
    '<tr><td><strong>Section count</strong></td><td>'AiscWItemCount'</td></tr>
    '<tr><td><strong>Property count</strong></td><td>'AiscWPropertyCount'</td></tr>
    '<tr><td><strong>Dataset status</strong></td><td>
    DBStatus$(AiscWDatasetStatus)
    '</td></tr></tbody></table>
#end def
#def ShowAiscWRecord$(item$)
    #hide
    ζAISC_record_status = if(AiscWHasItem(item$); AiscWDatasetStatus; DB_ERR_NAME)
    #show
    #novar
    '<table class="bordered data section-record" style="width:95%"><tbody>
    '<tr><td><strong>Section</strong></td><td>
    AiscWName$(item$)
    '</td></tr>
    '<tr><td><strong>Section ID</strong></td><td>'item$'</td></tr>
    '<tr><td><strong>Status</strong></td><td>
    DBStatus$(ζAISC_record_status)
    '</td></tr>
    '<tr><td><strong>Source</strong></td><td>StructuralSectionsLibrarySource$</td></tr>
    '<tr><td><strong>Data basis</strong></td><td>Tabulated geometric properties only; verify the governing AISC edition before design use.</td></tr>
    '</tbody></table>
#end def
#def ShowAiscWProperties$(item$)
    #hide
    ζAISC_property_item = item$
    ζAISC_property_item_ok = AiscWHasItem(ζAISC_property_item)
    #show
    #novar
    '<table class="bordered data section-property" style="width:95%"><thead><tr><th>Property</th><th>Value</th></tr></thead><tbody>
    #if ζAISC_property_item_ok
        #for ζAISC_property = 1 : AiscWPropertyCount
            #hide
            ζAISC_property_value = AiscWProperty(ζAISC_property_item; ζAISC_property)
            #show
            '<tr><td style="text-align:left">
            AiscWPropertyName$(ζAISC_property)
            '</td><td>'ζAISC_property_value'</td></tr>
        #loop
    #end if
    #if not(ζAISC_property_item_ok)
        '<tr><td colspan="2" class="status-cell">
        DBStatus$(DB_ERR_NAME)
        '</td></tr>
    #end if
    '</tbody></table>
#end def
#show
#else
'<div style="margin:1em;padding:0.75em;border:2px solid #b00020;color:#b00020;background:#fff0f2;"><strong>DRAT library load error:</strong> StructuralSections requires DataWrapper API 0.3.2 or newer. Load a compatible DratCore.cpd before this library.</div>
#end if
#else
'<div style="margin:1em;padding:0.75em;border:2px solid #b00020;color:#b00020;background:#fff0f2;"><strong>DRAT library load error:</strong> StructuralSections requires DRAT core API 1.x. Load DratCore.cpd before this library.</div>
#end if
