3072; 7.1; 2.11; 3; 1.94; 0.312; 0.351; 0.653; 0.574; 2.72; 2.24; 1.81; 1.14; 0.666; 0.998; 0.518; 0.562; 0.0928; 0.915]
AiscChannelHasItem(item) = DBHasID(AiscChannelItemIDs; item)
AiscChannelHasProperty(property) = DBHasID(AiscChannelPropertyIDs; property)
AiscChannelPropertyStatus(item; property) = switch(not(AiscChannelHasItem(item)); DB_ERR_NAME; not(AiscChannelHasProperty(property)); DB_ERR_PROPERTY; DBTableStatus(AiscChannelData; item; property + 1))
AiscChannelPropertyRaw(item; property) = if(DBIsFatal(AiscChannelPropertyStatus(item; property)); 0/0; DBTableRaw(AiscChannelData; item; property + 1))
AiscChannelApplyUnits(property; value) = switch(property ≡ AISC_CHANNEL_P_WEIGHT; setunits(value; lb/ft); property ≡ AISC_CHANNEL_P_AREA; setunits(value; in^2); or(property ≡ AISC_CHANNEL_P_D; property ≡ AISC_CHANNEL_P_BF; property ≡ AISC_CHANNEL_P_TW; property ≡ AISC_CHANNEL_P_TF; property ≡ AISC_CHANNEL_P_X; property ≡ AISC_CHANNEL_P_EO; property ≡ AISC_CHANNEL_P_RX; property ≡ AISC_CHANNEL_P_RY); setunits(value; in); or(property ≡ AISC_CHANNEL_P_IX; property ≡ AISC_CHANNEL_P_IY; property ≡ AISC_CHANNEL_P_J); setunits(value; in^4); or(property ≡ AISC_CHANNEL_P_ZX; property ≡ AISC_CHANNEL_P_SX; property ≡ AISC_CHANNEL_P_ZY; property ≡ AISC_CHANNEL_P_SY); setunits(value; in^3); property ≡ AISC_CHANNEL_P_CW; setunits(value; in^6); 0/0)
AiscChannelProperty(item; property) = AiscChannelApplyUnits(property; AiscChannelPropertyRaw(item; property))
AiscChannelWeight(item) = AiscChannelProperty(item; AISC_CHANNEL_P_WEIGHT)
AiscChannelArea(item) = AiscChannelProperty(item; AISC_CHANNEL_P_AREA)
AiscChannelIx(item) = AiscChannelProperty(item; AISC_CHANNEL_P_IX)
AiscChannelSx(item) = AiscChannelProperty(item; AISC_CHANNEL_P_SX)
AiscChannelIy(item) = AiscChannelProperty(item; AISC_CHANNEL_P_IY)
AiscChannelSy(item) = AiscChannelProperty(item; AISC_CHANNEL_P_SY)
AiscChannelItemsAtLeast(property; minimum) = _
$block{
    property_ok = AiscChannelHasProperty(property);
    safe_property = if(property_ok; property; AISC_CHANNEL_P_WEIGHT);
    values = AiscChannelApplyUnits(safe_property; col(AiscChannelData; safe_property + 1));
    if(property_ok; lookup_ge(values; AiscChannelItemIDs; minimum); find_eq([0]; 1; 1));
}
AiscChannelDataOK = and(AiscChannelItemCount ≡ 72; n_rows(AiscChannelData) ≡ 72; n_cols(AiscChannelData) ≡ AiscChannelPropertyCount + 1; norm_1(sort(col(AiscChannelData; 1)) - sort(AiscChannelItemIDs)) ≡ 0)
AiscChannelDatasetStatus = if(AiscChannelDataOK; DB_OK; DB_ERR_MISSING)
