    '<tr><td><strong>Library</strong></td><td>AiscChannelLibraryName$</td></tr>
    '<tr><td><strong>Library revision</strong></td><td>AiscChannelLibraryRevision$</td></tr>
    '<tr><td><strong>Source</strong></td><td>AiscChannelLibrarySource$</td></tr>
    '<tr><td><strong>Scope</strong></td><td>AiscChannelLibraryScope$</td></tr>
    '<tr><td><strong>Section count</strong></td><td>'AiscChannelItemCount'</td></tr>
    '<tr><td><strong>Property count</strong></td><td>'AiscChannelPropertyCount'</td></tr>
    '<tr><td><strong>Dataset status</strong></td><td>
    DBStatus$(AiscChannelDatasetStatus)
    '</td></tr></tbody></table>
#end def
#def ShowAiscChannelRecord$(item$)
    #hide
    ζAISC_channel_record_status = if(AiscChannelHasItem(item$); AiscChannelDatasetStatus; DB_ERR_NAME)
    #show
    #novar
    '<table class="bordered data channel-record" style="width:95%"><tbody>
    '<tr><td><strong>Section</strong></td><td>
    AiscChannelName$(item$)
    '</td></tr>
    '<tr><td><strong>Section ID</strong></td><td>'item$'</td></tr>
    '<tr><td><strong>Status</strong></td><td>
    DBStatus$(ζAISC_channel_record_status)
    '</td></tr>
    '<tr><td><strong>Source</strong></td><td>AiscChannelLibrarySource$</td></tr>
    '<tr><td><strong>Data basis</strong></td><td>Tabulated geometric properties only; verify the governing AISC edition before design use.</td></tr>
    '</tbody></table>
#end def
#def ShowAiscChannelProperties$(item$)
    #hide
    ζAISC_channel_item = item$
    ζAISC_channel_ok = AiscChannelHasItem(ζAISC_channel_item)
    #show
    #novar
    '<table class="bordered data channel-property" style="width:95%"><thead><tr><th>Property</th><th>Value</th></tr></thead><tbody>
    #if ζAISC_channel_ok
        #for ζAISC_channel_property = 1 : AiscChannelPropertyCount
            #hide
            ζAISC_channel_value = AiscChannelProperty(ζAISC_channel_item; ζAISC_channel_property)
            #show
            '<tr><td style="text-align:left">
            AiscChannelPropertyName$(ζAISC_channel_property)
            '</td><td>'ζAISC_channel_value'</td></tr>
        #loop
    #end if
    #if not(ζAISC_channel_ok)
        '<tr><td colspan="2" class="status-cell">
        DBStatus$(DB_ERR_NAME)
        '</td></tr>
    #end if
    '</tbody></table>
#end def
#show
#else
'<div class="err">DRAT library load error: AiscChannelSections requires DataWrapper API 0.3.2 or newer.</div>
#end if
#else
'<div class="err">DRAT library load error: AiscChannelSections requires DRAT core API 1.x.</div>
#end if
