MatClassificationKnown(classification) = DBHasID(EngineeringMaterialClassificationIDs; classification)
MatProvenanceLevelKnown(level) = DBHasID(EngineeringMaterialProvenanceLevelIDs; level)
MatCitationKnown(citation_id) = DBHasID(EngineeringMaterialCitationIDs; citation_id)
MatValuesUnique(values) = if(len(values) ≤ 1; 1; count(first(sort(values); len(values) - 1) - last(sort(values); len(values) - 1); 0; 1) ≡ 0)
MatIntegerValues(values) = norm_1(values - round(values)) ≤ 10^-12
MatCategoryFilterKnown(category) = or(category ≡ MAT_CAT_ALL; MatHasCategory(category))
MatPropertySetKnown(properties) = _
$block{
    has_properties = len(properties) > 0;
    safe_properties = if(has_properties; properties; [0]);
    known = and(has_properties; min(safe_properties) ≥ 1; max(safe_properties) ≤ EngineeringMaterialPropertyCount; MatIntegerValues(safe_properties));
    known;
}

MatCategoryStatus(item) = switch(not(MatHasItem(item)); DB_ERR_NAME; DBTableStatus(EngineeringMaterialCatalog; item; 2) ≠ DB_OK; DB_ERR_MISSING; not(MatHasCategory(DBTableRaw(EngineeringMaterialCatalog; item; 2))); DB_ERR_MISSING; DB_OK)
MatCategory(item) = if(MatCategoryStatus(item) ≡ DB_OK; DBTableRaw(EngineeringMaterialCatalog; item; 2); 0/0)
MatItemsByCategory(category) = if(category ≡ MAT_CAT_ALL; EngineeringMaterialItemIDs; vlookup(EngineeringMaterialCatalog; category; 2; 1))
MatCategoryCount(category) = len(MatItemsByCategory(category))
MatSourceID(item) = DBTableRaw(EngineeringMaterialMetadata; item; 2)
MatDataRevision(item) = DBTableRaw(EngineeringMaterialMetadata; item; 3)

MatAvailablePropertyIDs(item) = _
$block{
    item_indexes = find_eq(col(EngineeringMaterialData; 1); item; 1);
    item_exists = len(item_indexes) > 0;
    safe_row = row(EngineeringMaterialData; if(item_exists; take(1; item_indexes); 1));
    property_values = last(safe_row; EngineeringMaterialPropertyCount);
    empty_values = find_eq([0]; 1; 1);
    available_properties = if(item_exists; lookup_ne(property_values; EngineeringMaterialPropertyIDs; DB_MISSING); empty_values);
    available_properties;
}

MatAvailablePropertyCount(item) = len(MatAvailablePropertyIDs(item))
MatItemCompleteness(item) = if(MatHasItem(item); MatAvailablePropertyCount(item)/EngineeringMaterialPropertyCount; 0/0)

MatItemsWithProperty(property) = _
$block{
    property_exists = MatHasProperty(property);
    safe_property = min(max(round(property); 1); EngineeringMaterialPropertyCount);
    property_values = col(EngineeringMaterialData; safe_property + 1);
    empty_values = find_eq([0]; 1; 1);
    available_items = if(property_exists; lookup_ne(property_values; EngineeringMaterialItemIDs; DB_MISSING); empty_values);
    available_items;
}

MatPropertyAvailableCount(property) = len(MatItemsWithProperty(property))
MatPropertyCompleteness(property) = if(MatHasProperty(property); MatPropertyAvailableCount(property)/EngineeringMaterialItemCount; 0/0)

MatCandidateMask(category; required_properties) = _
$block{
    category_ok = MatCategoryFilterKnown(category);
    properties_ok = MatPropertySetKnown(required_properties);
    safe_properties = if(properties_ok; required_properties; [MAT_P_DENSITY]);
    property_data = extract_cols(EngineeringMaterialData; safe_properties + 1);
    availability_matrix = property_data ≠ DB_MISSING;
    availability_counts = availability_matrix*fill(resize([0]; len(safe_properties)); 1);
    all_categories = fill(resize([0]; EngineeringMaterialItemCount); 1);
    category_mask = if(category ≡ MAT_CAT_ALL; all_categories; EngineeringMaterialCategoryByItem ≡ category);
    invalid_mask = fill(resize([0]; EngineeringMaterialItemCount); 0);
    candidate_mask = if(and(category_ok; properties_ok); category_mask*(availability_counts ≡ len(safe_properties)); invalid_mask);
    candidate_mask;
}

MatCandidateItems(category; required_properties) = lookup_eq(MatCandidateMask(category; required_properties); EngineeringMaterialItemIDs; 1)
MatCandidateCount(category; required_properties) = len(MatCandidateItems(category; required_properties))
MatCandidateStatus(category; required_properties) = switch(not(MatCategoryFilterKnown(category)); DB_ERR_NAME; not(MatPropertySetKnown(required_properties)); DB_ERR_PROPERTY; MatCandidateCount(category; required_properties) ≡ 0; DB_ERR_MISSING; DB_OK)

MatPROPStatus(item; property) = _
$block{
    item_ok = MatHasItem(item);
    property_ok = MatHasProperty(property);
    status = switch(not(item_ok); DB_ERR_NAME; not(property_ok); DB_ERR_PROPERTY; DBTableStatus(EngineeringMaterialData; item; property + 1));
    status;
}

MatPROPRaw(item; property) = _
$block{
    status = MatPROPStatus(item; property);
    raw = if(DBIsFatal(status); 0/0; DBTableRaw(EngineeringMaterialData; item; property + 1));
    raw;
}

MatApplyUnits(property; value) = switch(property ≡ MAT_P_DENSITY; setunits(value; kg/m^3); property ≡ MAT_P_YOUNGS_MODULUS; setunits(value; GPa); property ≡ MAT_P_SHEAR_MODULUS; setunits(value; GPa); property ≡ MAT_P_POISSON_RATIO; value; property ≡ MAT_P_YIELD_STRENGTH; setunits(value; MPa); property ≡ MAT_P_TENSILE_STRENGTH; setunits(value; MPa); property ≡ MAT_P_COMPRESSIVE_STRENGTH; setunits(value; MPa); property ≡ MAT_P_FLEXURAL_STRENGTH; setunits(value; MPa); property ≡ MAT_P_ELONGATION; value; property ≡ MAT_P_FRACTURE_TOUGHNESS; setunits(value; MPa*m^0.5); property ≡ MAT_P_THERMAL_CONDUCTIVITY; setunits(value; W/(m*K)); property ≡ MAT_P_SPECIFIC_HEAT; setunits(value; J/(kg*K)); property ≡ MAT_P_CTE; setunits(value*10^-6; 1/K); property ≡ MAT_P_ELECTRICAL_RESISTIVITY; setunits(value; Ω*m); property ≡ MAT_P_TRANSITION_TEMPERATURE; setunits(value; °C); property ≡ MAT_P_MAX_SERVICE_TEMPERATURE; setunits(value; °C); property ≡ MAT_P_HARDNESS_VICKERS; value; property ≡ MAT_P_BULK_MODULUS; setunits(value; GPa); 0/0)

MatPROP(item; property) = _
$block{
    status = MatPROPStatus(item; property);
    raw = if(DBIsFatal(status); 0/0; MatPROPRaw(item; property));
    value = if(DBIsFatal(status); 0/0; MatApplyUnits(property; raw));
    value;
}

MatRankingDirectionKnown(direction) = or(direction ≡ MAT_RANK_ASCENDING; direction ≡ MAT_RANK_DESCENDING)
MatRankingStatus(category; required_properties; ranking_property; direction) = _
$block{
    ranking_property_ok = MatHasProperty(ranking_property);
    safe_ranking_property = if(ranking_property_ok; ranking_property; MAT_P_DENSITY);
    selection_properties = join(required_properties; [safe_ranking_property]);
    candidate_status = MatCandidateStatus(category; selection_properties);
    status = switch(not(MatCategoryFilterKnown(category)); DB_ERR_NAME; not(MatPropertySetKnown(required_properties)); DB_ERR_PROPERTY; not(ranking_property_ok); DB_ERR_PROPERTY; not(MatRankingDirectionKnown(direction)); DB_ERR_BAD_METHOD; candidate_status ≠ DB_OK; candidate_status; DB_OK);
    status;
}

MatRankCandidates(category; required_properties; ranking_property; direction) = _
$block{
    ranking_property_ok = MatHasProperty(ranking_property);
    safe_ranking_property = if(ranking_property_ok; ranking_property; MAT_P_DENSITY);
    selection_properties = join(required_properties; [safe_ranking_property]);
    candidate_mask = MatCandidateMask(category; selection_properties);
    candidate_indexes = find_eq(candidate_mask; 1; 1);
    candidate_count = len(candidate_indexes);
    safe_indexes = if(candidate_count > 0; candidate_indexes; [1]);
    unsorted_data = extract_rows(extract_cols(EngineeringMaterialData; [1; safe_ranking_property + 1]); safe_indexes);
    ranked_data = switch(direction ≡ MAT_RANK_ASCENDING; sort_rows(unsorted_data; 2); direction ≡ MAT_RANK_DESCENDING; rsort_rows(unsorted_data; 2); unsorted_data);
    ok_statuses = fill(resize([0]; n_rows(ranked_data)); DB_OK);
    valid_result = augment(ok_statuses; ranked_data);
    status = MatRankingStatus(category; required_properties; ranking_property; direction);
    result = if(status ≡ DB_OK; valid_result; [status; 0; DB_MISSING]);
    result;
}

MatRankByProperty(category; property; direction) = MatRankCandidates(category; [property]; property; direction)
MatRankingResultStatus(ranking_result) = take(1; col(ranking_result; 1))
MatRankingCount(ranking_result) = if(MatRankingResultStatus(ranking_result) ≡ DB_OK; n_rows(ranking_result); 0)
MatRankedItems(ranking_result) = if(MatRankingResultStatus(ranking_result) ≡ DB_OK; col(ranking_result; 2); find_eq([0]; 1; 1))
MatRankedRawValues(ranking_result) = if(MatRankingResultStatus(ranking_result) ≡ DB_OK; col(ranking_result; 3); find_eq([0]; 1; 1))

MatItemsAtLeast(category; property; minimum) = _
$block{
    ranking_result = MatRankByProperty(category; property; MAT_RANK_ASCENDING);
    status = MatRankingResultStatus(ranking_result);
    safe_property = if(MatHasProperty(property); property; MAT_P_DENSITY);
    ranked_items = MatRankedItems(ranking_result);
    ranked_values = MatApplyUnits(safe_property; MatRankedRawValues(ranking_result));
    empty_items = find_eq([0]; 1; 1);
    selected_items = if(status ≡ DB_OK; lookup_ge(ranked_values; ranked_items; minimum); empty_items);
    selected_items;
}

MatItemsAtMost(category; property; maximum) = _
$block{
    ranking_result = MatRankByProperty(category; property; MAT_RANK_ASCENDING);
    status = MatRankingResultStatus(ranking_result);
    safe_property = if(MatHasProperty(property); property; MAT_P_DENSITY);
    ranked_items = MatRankedItems(ranking_result);
    ranked_values = MatApplyUnits(safe_property; MatRankedRawValues(ranking_result));
    empty_items = find_eq([0]; 1; 1);
    selected_items = if(status ≡ DB_OK; lookup_le(ranked_values; ranked_items; maximum); empty_items);
    selected_items;
}

MatItemsBetween(category; property; minimum; maximum) = _
$block{
    ranking_result = MatRankByProperty(category; property; MAT_RANK_ASCENDING);
    status = MatRankingResultStatus(ranking_result);
    safe_property = if(MatHasProperty(property); property; MAT_P_DENSITY);
    ranked_items = MatRankedItems(ranking_result);
    ranked_values = MatApplyUnits(safe_property; MatRankedRawValues(ranking_result));
    range_mask = (ranked_values ≥ minimum)*(ranked_values ≤ maximum);
    empty_items = find_eq([0]; 1; 1);
    selected_items = if(and(status ≡ DB_OK; minimum ≤ maximum); lookup_eq(range_mask; ranked_items; 1); empty_items);
    selected_items;
}

MatPropertyAvailable(item; property) = MatPROPStatus(item; property) ≡ DB_OK
MatClassification(item; property) = if(MatPropertyAvailable(item; property); EngineeringMaterialDefaultClassification; MAT_CLASS_UNKNOWN)
MatClassificationStatus(item; property) = switch(MatPROPStatus(item; property) ≠ DB_OK; MatPROPStatus(item; property); not(MatClassificationKnown(MatClassification(item; property))); DB_ERR_MISSING; DB_OK)

MatProvenanceStatus(item) = _
$block{
    source_status = DBTableStatus(EngineeringMaterialMetadata; item; 2);
    revision_status = DBTableStatus(EngineeringMaterialMetadata; item; 3);
    source_id = if(source_status ≡ DB_OK; MatSourceID(item); 0);
    revision = if(revision_status ≡ DB_OK; MatDataRevision(item); 0);
    status = switch(not(MatHasItem(item)); DB_ERR_NAME; source_status ≠ DB_OK; source_status; revision_status ≠ DB_OK; revision_status; not(MatSourceKnown(source_id)); DB_ERR_MISSING; abs(revision - round(revision)) > 10^-12; DB_ERR_MISSING; revision < 1; DB_ERR_MISSING; DB_OK);
    status;
}

MatCitationSourceID(citation_id) = DBTableRaw(EngineeringMaterialCitations; citation_id; 2)
MatCitationQualificationLevel(citation_id) = DBTableRaw(EngineeringMaterialCitations; citation_id; 3)
MatPropertyCitationID(item; property) = DBTableRaw(EngineeringMaterialPropertyProvenance; DBKey(item; property); 2)
MatPropertyProvenanceLevel(item; property) = DBTableRaw(EngineeringMaterialPropertyProvenance; DBKey(item; property); 3)

MatCitationStatus(citation_id) = _
$block{
    source_status = DBTableStatus(EngineeringMaterialCitations; citation_id; 2);
    level_status = DBTableStatus(EngineeringMaterialCitations; citation_id; 3);
    source_id = if(source_status ≡ DB_OK; MatCitationSourceID(citation_id); 0);
    level = if(level_status ≡ DB_OK; MatCitationQualificationLevel(citation_id); 0);
    status = switch(not(MatCitationKnown(citation_id)); DB_ERR_NAME; source_status ≠ DB_OK; source_status; level_status ≠ DB_OK; level_status; not(MatSourceKnown(source_id)); DB_ERR_MISSING; not(MatProvenanceLevelKnown(level)); DB_ERR_MISSING; DB_OK);
    status;
}

MatPropertyProvenanceStatus(item; property) = _
$block{
    property_status = MatPROPStatus(item; property);
    citation_status = DBTableStatus(EngineeringMaterialPropertyProvenance; DBKey(item; property); 2);
    level_status = DBTableStatus(EngineeringMaterialPropertyProvenance; DBKey(item; property); 3);
    citation_id = if(citation_status ≡ DB_OK; MatPropertyCitationID(item; property); 0);
    level = if(level_status ≡ DB_OK; MatPropertyProvenanceLevel(item; property); 0);
    registry_status = if(MatCitationKnown(citation_id); MatCitationStatus(citation_id); DB_ERR_MISSING);
    citation_level = if(registry_status ≡ DB_OK; MatCitationQualificationLevel(citation_id); 0);
    status = switch(property_status ≠ DB_OK; property_status; citation_status ≠ DB_OK; citation_status; level_status ≠ DB_OK; level_status; registry_status ≠ DB_OK; registry_status; not(MatProvenanceLevelKnown(level)); DB_ERR_MISSING; citation_level < level; DB_ERR_MISSING; DB_OK);
    status;
}

MatPropertyReleaseProvenanceStatus(item; property) = switch(MatPropertyProvenanceStatus(item; property) ≠ DB_OK; MatPropertyProvenanceStatus(item; property); MatPropertyProvenanceLevel(item; property) < EngineeringMaterialMinimumReleaseProvenanceLevel; DB_ERR_MISSING; DB_OK)
MatPropertyRecordStatus(item; property) = switch(MatPROPStatus(item; property) ≠ DB_OK; MatPROPStatus(item; property); MatCategoryStatus(item) ≠ DB_OK; MatCategoryStatus(item); MatPropertyProvenanceStatus(item; property) ≠ DB_OK; MatPropertyProvenanceStatus(item; property); MatClassificationStatus(item; property))

EngineeringMaterialPropertyAvailableCounts = [MatPropertyAvailableCount(1); MatPropertyAvailableCount(2); MatPropertyAvailableCount(3); MatPropertyAvailableCount(4); MatPropertyAvailableCount(5); MatPropertyAvailableCount(6); MatPropertyAvailableCount(7); MatPropertyAvailableCount(8); MatPropertyAvailableCount(9); MatPropertyAvailableCount(10); MatPropertyAvailableCount(11); MatPropertyAvailableCount(12); MatPropertyAvailableCount(13); MatPropertyAvailableCount(14); MatPropertyAvailableCount(15); MatPropertyAvailableCount(16); MatPropertyAvailableCount(17); MatPropertyAvailableCount(18)]
EngineeringMaterialAvailableValueCount = sum(EngineeringMaterialPropertyAvailableCounts)
EngineeringMaterialPossibleValueCount = EngineeringMaterialItemCount*EngineeringMaterialPropertyCount
EngineeringMaterialDatasetCompleteness = EngineeringMaterialAvailableValueCount/EngineeringMaterialPossibleValueCount

EngineeringMaterialCatalogOK = and(len(EngineeringMaterialCategoryByItem) ≡ EngineeringMaterialItemCount; n_rows(EngineeringMaterialCatalog) ≡ EngineeringMaterialItemCount; n_rows(EngineeringMaterialData) ≡ EngineeringMaterialItemCount; n_cols(EngineeringMaterialData) ≡ EngineeringMaterialPropertyCount + 1; n_rows(EngineeringMaterialMetadata) ≡ EngineeringMaterialItemCount; n_cols(EngineeringMaterialMetadata) ≡ 3; MatValuesUnique(EngineeringMaterialItemIDs); norm_1(sort(col(EngineeringMaterialData; 1)) - sort(EngineeringMaterialItemIDs)) ≡ 0; norm_1(sort(col(EngineeringMaterialMetadata; 1)) - sort(EngineeringMaterialItemIDs)) ≡ 0)
EngineeringMaterialCategoriesOK = and(min(EngineeringMaterialCategoryByItem) ≥ take(1; EngineeringMaterialCategoryIDs); max(EngineeringMaterialCategoryByItem) ≤ take(len(EngineeringMaterialCategoryIDs); EngineeringMaterialCategoryIDs); MatIntegerValues(EngineeringMaterialCategoryByItem))
EngineeringMaterialSourcesOK = and(min(col(EngineeringMaterialMetadata; 2)) ≥ MAT_SRC_1; max(col(EngineeringMaterialMetadata; 2)) ≤ MAT_SRC_11; MatIntegerValues(col(EngineeringMaterialMetadata; 2)))
EngineeringMaterialRevisionsOK = and(min(col(EngineeringMaterialMetadata; 3)) ≥ 1; MatIntegerValues(col(EngineeringMaterialMetadata; 3)))
EngineeringMaterialClassificationsOK = and(MatClassificationKnown(EngineeringMaterialDefaultClassification); EngineeringMaterialDefaultClassification ≡ MAT_CLASS_SCREENING)
EngineeringMaterialCompletenessOK = and(min(EngineeringMaterialPropertyAvailableCounts) > 0; EngineeringMaterialAvailableValueCount ≤ EngineeringMaterialPossibleValueCount)
EngineeringMaterialCitationsOK = and(n_rows(EngineeringMaterialCitations) ≡ len(EngineeringMaterialCitationIDs); n_cols(EngineeringMaterialCitations) ≡ 3; MatValuesUnique(EngineeringMaterialCitationIDs); MatValuesUnique(col(EngineeringMaterialCitations; 1)); min(col(EngineeringMaterialCitations; 2)) ≥ MAT_SRC_1; max(col(EngineeringMaterialCitations; 2)) ≤ MAT_SRC_11; min(col(EngineeringMaterialCitations; 3)) ≥ MAT_PROV_SOURCE_ONLY; max(col(EngineeringMaterialCitations; 3)) ≤ MAT_PROV_PROPERTY_RECORD; MatIntegerValues(col(EngineeringMaterialCitations; 1)); MatIntegerValues(col(EngineeringMaterialCitations; 2)); MatIntegerValues(col(EngineeringMaterialCitations; 3)))
EngineeringMaterialProvenanceOK = and(n_rows(EngineeringMaterialPropertyProvenance) ≡ EngineeringMaterialAvailableValueCount; n_cols(EngineeringMaterialPropertyProvenance) ≡ 3; MatValuesUnique(col(EngineeringMaterialPropertyProvenance; 1)); min(col(EngineeringMaterialPropertyProvenance; 2)) ≥ take(1; EngineeringMaterialCitationIDs); max(col(EngineeringMaterialPropertyProvenance; 2)) ≤ take(len(EngineeringMaterialCitationIDs); EngineeringMaterialCitationIDs); min(col(EngineeringMaterialPropertyProvenance; 3)) ≥ MAT_PROV_SOURCE_ONLY; max(col(EngineeringMaterialPropertyProvenance; 3)) ≤ MAT_PROV_PROPERTY_RECORD; MatIntegerValues(col(EngineeringMaterialPropertyProvenance; 1)); MatIntegerValues(col(EngineeringMaterialPropertyProvenance; 2)); MatIntegerValues(col(EngineeringMaterialPropertyProvenance; 3)))
EngineeringMaterialReleaseProvenanceOK = and(EngineeringMaterialProvenanceOK; min(col(EngineeringMaterialPropertyProvenance; 3)) ≥ EngineeringMaterialMinimumReleaseProvenanceLevel)
EngineeringMaterialDatasetStatus = if(and(EngineeringMaterialCatalogOK; EngineeringMaterialCategoriesOK; EngineeringMaterialSourcesOK; EngineeringMaterialRevisionsOK; EngineeringMaterialClassificationsOK; EngineeringMaterialCompletenessOK; EngineeringMaterialCitationsOK; EngineeringMaterialProvenanceOK); DB_OK; DB_ERR_MISSING)
EngineeringMaterialReleaseProvenanceStatus = if(EngineeringMaterialReleaseProvenanceOK; DB_OK; DB_ERR_MISSING)

MatRho(item) = MatPROP(item; MAT_P_DENSITY)
MatE(item) = MatPROP(item; MAT_P_YOUNGS_MODULUS)
MatG(item) = MatPROP(item; MAT_P_SHEAR_MODULUS)
MatNu(item) = MatPROP(item; MAT_P_POISSON_RATIO)
MatYield(item) = MatPROP(item; MAT_P_YIELD_STRENGTH)
MatUTS(item) = MatPROP(item; MAT_P_TENSILE_STRENGTH)
MatCompressive(item) = MatPROP(item; MAT_P_COMPRESSIVE_STRENGTH)
MatFlexural(item) = MatPROP(item; MAT_P_FLEXURAL_STRENGTH)
MatElongation(item) = MatPROP(item; MAT_P_ELONGATION)
MatKIC(item) = MatPROP(item; MAT_P_FRACTURE_TOUGHNESS)
MatThermalK(item) = MatPROP(item; MAT_P_THERMAL_CONDUCTIVITY)
MatCp(item) = MatPROP(item; MAT_P_SPECIFIC_HEAT)
MatCTE(item) = MatPROP(item; MAT_P_CTE)
MatResistivity(item) = MatPROP(item; MAT_P_ELECTRICAL_RESISTIVITY)
MatTransitionT(item) = MatPROP(item; MAT_P_TRANSITION_TEMPERATURE)
MatMaxServiceT(item) = MatPROP(item; MAT_P_MAX_SERVICE_TEMPERATURE)
MatHV(item) = MatPROP(item; MAT_P_HARDNESS_VICKERS)
MatBulk(item) = MatPROP(item; MAT_P_BULK_MODULUS)

#def MatCategoryName$(category$)
    #if category$ ≡ MAT_CAT_ALL
        'All material categories
    #end if
    #if category$ ≡ MAT_CAT_FERROUS_METAL
        'Ferrous metals
    #end if
    #if category$ ≡ MAT_CAT_NONFERROUS_METAL
        'Nonferrous metals
    #end if
    #if category$ ≡ MAT_CAT_POLYMER
        'Polymers
    #end if
    #if category$ ≡ MAT_CAT_ELASTOMER
        'Elastomers
    #end if
    #if category$ ≡ MAT_CAT_GLASS
        'Glass
    #end if
    #if category$ ≡ MAT_CAT_CERAMIC_RELATED
        'Ceramics and related materials
    #end if
    #if category$ ≡ MAT_CAT_COMPOSITE
        'Composites
    #end if
    #if category$ ≡ MAT_CAT_WOOD
        'Wood and engineered wood
    #end if
    #if category$ ≡ MAT_CAT_CONSTRUCTION
        'Construction materials
    #end if
    #if and(category$ ≠ MAT_CAT_ALL; not(MatHasCategory(category$)))
        '<span class="err">Unknown material category ID</span>
    #end if
#end def

#def MatRankingDirectionName$(direction$)
    #if direction$ ≡ MAT_RANK_ASCENDING
        'Ascending
    #end if
    #if direction$ ≡ MAT_RANK_DESCENDING
        'Descending
    #end if
    #if not(MatRankingDirectionKnown(direction$))
        '<span class="err">Unknown ranking direction</span>
    #end if
#end def

#def MatClassificationName$(classification$)
    #if classification$ ≡ MAT_CLASS_TYPICAL
        'Typical value
    #end if
    #if classification$ ≡ MAT_CLASS_SCREENING
        'Screening value
    #end if
    #if classification$ ≡ MAT_CLASS_SPECIFIED_MINIMUM
        'Specified minimum
    #end if
    #if classification$ ≡ MAT_CLASS_DESIGN_ALLOWABLE
        'Design allowable
    #end if
    #if not(MatClassificationKnown(classification$))
        '<span class="err">Unknown value classification</span>
    #end if
#end def

