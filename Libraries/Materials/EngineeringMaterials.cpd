#def MatPropertyName$(property$)
	    #if property$ ≡ MAT_P_DENSITY
		        'Density
	    #end if
	    #if property$ ≡ MAT_P_YOUNGS_MODULUS
		        'Young''s modulus
	    #end if
	    #if property$ ≡ MAT_P_SHEAR_MODULUS
		        'Shear modulus
	    #end if
	    #if property$ ≡ MAT_P_POISSON_RATIO
		        'Poisson ratio
	    #end if
	    #if property$ ≡ MAT_P_YIELD_STRENGTH
		        'Tensile yield strength
	    #end if
	    #if property$ ≡ MAT_P_TENSILE_STRENGTH
		        'Ultimate tensile strength
	    #end if
	    #if property$ ≡ MAT_P_COMPRESSIVE_STRENGTH
		        'Compressive strength
	    #end if
	    #if property$ ≡ MAT_P_FLEXURAL_STRENGTH
		        'Flexural strength
	    #end if
	    #if property$ ≡ MAT_P_ELONGATION
		        'Elongation at break
	    #end if
	    #if property$ ≡ MAT_P_FRACTURE_TOUGHNESS
		        'Fracture toughness
	    #end if
	    #if property$ ≡ MAT_P_THERMAL_CONDUCTIVITY
		        'Thermal conductivity
	    #end if
	    #if property$ ≡ MAT_P_SPECIFIC_HEAT
		        'Specific heat
	    #end if
	    #if property$ ≡ MAT_P_CTE
		        'Coefficient of thermal expansion
	    #end if
	    #if property$ ≡ MAT_P_ELECTRICAL_RESISTIVITY
		        'Electrical resistivity
	    #end if
	    #if property$ ≡ MAT_P_TRANSITION_TEMPERATURE
		        'Primary transition temperature
	    #end if
	    #if property$ ≡ MAT_P_MAX_SERVICE_TEMPERATURE
		        'Indicative maximum service temperature
	    #end if
	    #if property$ ≡ MAT_P_HARDNESS_VICKERS
		        'Vickers hardness
	    #end if
	    #if property$ ≡ MAT_P_BULK_MODULUS
		        'Bulk modulus
	    #end if
	    #if not(MatHasProperty(property$))
		        '<span class="err">Unknown material property ID</span>
	    #end if
#end def

#def MatPropertyUnit$(property$)
	    #if property$ ≡ MAT_P_DENSITY
		        'kg/m^3
	    #end if
	    #if property$ ≡ MAT_P_YOUNGS_MODULUS
		        'GPa
	    #end if
	    #if property$ ≡ MAT_P_SHEAR_MODULUS
		        'GPa
	    #end if
	    #if property$ ≡ MAT_P_POISSON_RATIO
		        '1
	    #end if
	    #if property$ ≡ MAT_P_YIELD_STRENGTH
		        'MPa
	    #end if
	    #if property$ ≡ MAT_P_TENSILE_STRENGTH
		        'MPa
	    #end if
	    #if property$ ≡ MAT_P_COMPRESSIVE_STRENGTH
		        'MPa
	    #end if
	    #if property$ ≡ MAT_P_FLEXURAL_STRENGTH
		        'MPa
	    #end if
	    #if property$ ≡ MAT_P_ELONGATION
		        'fraction
	    #end if
	    #if property$ ≡ MAT_P_FRACTURE_TOUGHNESS
		        'MPa*m^0.5
	    #end if
	    #if property$ ≡ MAT_P_THERMAL_CONDUCTIVITY
		        'W/(m*K)
	    #end if
	    #if property$ ≡ MAT_P_SPECIFIC_HEAT
		        'J/(kg*K)
	    #end if
	    #if property$ ≡ MAT_P_CTE
		        'um/(m*K)
	    #end if
	    #if property$ ≡ MAT_P_ELECTRICAL_RESISTIVITY
		        'ohm*m
	    #end if
	    #if property$ ≡ MAT_P_TRANSITION_TEMPERATURE
		        'degC
	    #end if
	    #if property$ ≡ MAT_P_MAX_SERVICE_TEMPERATURE
		        'degC
	    #end if
	    #if property$ ≡ MAT_P_HARDNESS_VICKERS
		        'HV
	    #end if
	    #if property$ ≡ MAT_P_BULK_MODULUS
		        'GPa
	    #end if
	    #if not(MatHasProperty(property$))
		        '<span class="err">Unknown material property ID</span>
	    #end if
#end def

#def MatSource$(source_id$)
	    #if source_id$ ≡ MAT_SRC_1
		        'MatWeb public materials database — https://www.matweb.com/search/MaterialGroupSearch.aspx
	    #end if
	    #if source_id$ ≡ MAT_SRC_2
		        'Outokumpu stainless steel grades — https://www.outokumpu.com/en/products/stainless-steel/grades
	    #end if
	    #if source_id$ ≡ MAT_SRC_3
		        'Copper Development Association alloy database — https://www.copper.org/resources/properties/db/
	    #end if
	    #if source_id$ ≡ MAT_SRC_4
		        'Special Metals product literature — https://www.specialmetals.com/documents/
	    #end if
	    #if source_id$ ≡ MAT_SRC_5
		        'CAMPUS plastics database — https://www.campusplastics.com/
	    #end if
	    #if source_id$ ≡ MAT_SRC_6
		        'NIST Structural Ceramics Database — https://srdata.nist.gov/CeramicDataPortal/scd
	    #end if
	    #if source_id$ ≡ MAT_SRC_7
		        'USDA Wood Handbook: Wood as an Engineering Material — https://research.fs.usda.gov/fpl/wood-handbook
	    #end if
	    #if source_id$ ≡ MAT_SRC_8
		        'FHWA PCC pavement materials reference — https://www.fhwa.dot.gov/publications/research/infrastructure/pavements/pccp/04127/appa.cfm
	    #end if
	    #if source_id$ ≡ MAT_SRC_9
		        'Hexcel product data sheets — https://www.hexcel.com/Resources/DataSheets/
	    #end if
	    #if source_id$ ≡ MAT_SRC_10
		        'The Aluminum Association alloy overview — https://www.aluminum.org/industry-standards/aluminum-alloys-101
	    #end if
	    #if source_id$ ≡ MAT_SRC_11
		        'NIST TPSX Materials Properties Database — https://tpsx.arc.nasa.gov/
	    #end if
	    #if not(MatSourceKnown(source_id$))
		        '<span class="err">Unknown material source ID</span>
	    #end if
#end def

#def MatCitation$(citation_id$)
	    #if citation_id$ ≡ 1
		        'MatWeb public materials database — edition unresolved; locator unresolved; https://www.matweb.com/search/MaterialGroupSearch.aspx
	    #end if
	    #if citation_id$ ≡ 2
		        'Outokumpu stainless steel grades — edition unresolved; locator unresolved; https://www.outokumpu.com/en/products/stainless-steel/grades
	    #end if
	    #if citation_id$ ≡ 3
		        'Copper Development Association alloy database — edition unresolved; locator unresolved; https://www.copper.org/resources/properties/db/
	    #end if
	    #if citation_id$ ≡ 4
		        'Special Metals product literature — edition unresolved; locator unresolved; https://www.specialmetals.com/documents/
	    #end if
	    #if citation_id$ ≡ 5
		        'CAMPUS plastics database — edition unresolved; locator unresolved; https://www.campusplastics.com/
	    #end if
	    #if citation_id$ ≡ 6
		        'NIST Structural Ceramics Database — edition unresolved; locator unresolved; https://srdata.nist.gov/CeramicDataPortal/scd
	    #end if
	    #if citation_id$ ≡ 7
		        'USDA Wood Handbook: Wood as an Engineering Material — edition unresolved; locator unresolved; https://research.fs.usda.gov/fpl/wood-handbook
	    #end if
	    #if citation_id$ ≡ 8
		        'FHWA PCC pavement materials reference — edition unresolved; locator unresolved; https://www.fhwa.dot.gov/publications/research/infrastructure/pavements/pccp/04127/appa.cfm
	    #end if
	    #if citation_id$ ≡ 9
		        'Hexcel product data sheets — edition unresolved; locator unresolved; https://www.hexcel.com/Resources/DataSheets/
	    #end if
	    #if citation_id$ ≡ 10
		        'The Aluminum Association alloy overview — edition unresolved; locator unresolved; https://www.aluminum.org/industry-standards/aluminum-alloys-101
	    #end if
	    #if citation_id$ ≡ 11
		        'NIST TPSX Materials Properties Database — edition unresolved; locator unresolved; https://tpsx.arc.nasa.gov/
	    #end if
	    #if not(MatCitationKnown(citation_id$))
		        '<span class="err">Unknown material citation ID</span>
	    #end if
#end def

#def MatProvenanceLevelName$(level$)
    #if level$ ≡ MAT_PROV_SOURCE_ONLY
        'Source-only
    #end if
    #if level$ ≡ MAT_PROV_GROUPED
        'Grouped citation
    #end if
    #if level$ ≡ MAT_PROV_PROPERTY_RECORD
        'Property-record citation
    #end if
    #if not(MatProvenanceLevelKnown(level$))
        '<span class="err">Unknown material provenance level</span>
    #end if
#end def

#def ShowMatDatasetSummary$
    #hide
    ζMAT_dataset_completeness_percent = 100*EngineeringMaterialDatasetCompleteness
    #show
    #novar
    '<table class="bordered data material-dataset-summary" style="width:95%">
    '<tbody>
    '<tr><td><strong>Library</strong></td><td>EngineeringMaterialsLibraryName$</td></tr>
    '<tr><td><strong>Library revision</strong></td><td>EngineeringMaterialsLibraryRevision$</td></tr>
    '<tr><td><strong>Scope</strong></td><td>EngineeringMaterialsLibraryScope$</td></tr>
    '<tr><td><strong>Materials</strong></td><td>'EngineeringMaterialItemCount'</td></tr>
    '<tr><td><strong>Categories</strong></td><td>'len(EngineeringMaterialCategoryIDs)'</td></tr>
    '<tr><td><strong>Supported properties</strong></td><td>'EngineeringMaterialPropertyCount'</td></tr>
    '<tr><td><strong>Available values</strong></td><td>'EngineeringMaterialAvailableValueCount' of 'EngineeringMaterialPossibleValueCount'</td></tr>
    '<tr><td><strong>Dataset completeness</strong></td><td>'ζMAT_dataset_completeness_percent'%</td></tr>
    '<tr><td><strong>Default classification</strong></td><td>
    MatClassificationName$(EngineeringMaterialDefaultClassification)
    '</td></tr>
    '<tr><td><strong>Dataset status</strong></td><td>
    DBStatus$(EngineeringMaterialDatasetStatus)
    '</td></tr>
    '</tbody>
    '</table>
    #varsub
#end def

#def ShowMatCatalog$
    #novar
    '<table class="bordered data material-catalog" style="width:95%">
    '<thead>
    '<tr><th>Material ID</th><th>Material</th><th>Category</th><th>Available Properties</th></tr>
    '</thead>
    '<tbody>
    #for ζMAT_catalog_index = 1 : EngineeringMaterialItemCount
        #hide
        ζMAT_catalog_item = take(ζMAT_catalog_index; EngineeringMaterialItemIDs)
        ζMAT_catalog_category = MatCategory(ζMAT_catalog_item)
        ζMAT_catalog_available = MatAvailablePropertyCount(ζMAT_catalog_item)
        #show
        '<tr><td style="text-align:right">'ζMAT_catalog_item'</td><td style="text-align:left">
        MatName$(ζMAT_catalog_item)
        '</td><td style="text-align:left">
        MatCategoryName$(ζMAT_catalog_category)
        '</td><td>'ζMAT_catalog_available' of 'EngineeringMaterialPropertyCount'</td></tr>
    #loop
    '</tbody>
    '</table>
    #varsub
#end def

#def ShowMatCategory$(category$)
    #hide
    ζMAT_category = category$
    ζMAT_category_items = MatItemsByCategory(ζMAT_category)
    ζMAT_category_count = len(ζMAT_category_items)
    #show
    #novar
    '<table class="bordered data material-category" style="width:95%">
    '<thead>
    '<tr><th>Material ID</th><th>Material</th><th>Available Properties</th></tr>
    '</thead>
    '<tbody>
    #if MatHasCategory(ζMAT_category)
        #for ζMAT_category_index = 1 : ζMAT_category_count
            #hide
            ζMAT_category_item = take(ζMAT_category_index; ζMAT_category_items)
            ζMAT_category_available = MatAvailablePropertyCount(ζMAT_category_item)
            #show
            '<tr><td style="text-align:right">'ζMAT_category_item'</td><td style="text-align:left">
            MatName$(ζMAT_category_item)
            '</td><td>'ζMAT_category_available' of 'EngineeringMaterialPropertyCount'</td></tr>
        #loop
    #end if
    #if not(MatHasCategory(ζMAT_category))
        '<tr><td colspan="3" class="status-cell">
        MatCategoryName$(ζMAT_category)
        '</td></tr>
    #end if
    '</tbody>
    '<tfoot><tr><th colspan="2">
    MatCategoryName$(ζMAT_category)
    '</th><td>'ζMAT_category_count' materials</td></tr></tfoot>
    '</table>
    #varsub
#end def

#def ShowMatProperties$
    #novar
    '<table class="bordered data material-properties" style="width:95%">
    '<thead>
    '<tr><th>Property ID</th><th>Property</th><th>Units</th><th>Available Materials</th><th>Completeness</th><th>Classification</th></tr>
    '</thead>
    '<tbody>
    #for ζMAT_property_index = 1 : EngineeringMaterialPropertyCount
        #hide
        ζMAT_property = take(ζMAT_property_index; EngineeringMaterialPropertyIDs)
        ζMAT_property_available = MatPropertyAvailableCount(ζMAT_property)
        ζMAT_property_completeness_percent = 100*MatPropertyCompleteness(ζMAT_property)
        #show
        '<tr><td style="text-align:right">'ζMAT_property'</td><td style="text-align:left">
        MatPropertyName$(ζMAT_property)
        '</td><td style="text-align:right">
        MatPropertyUnit$(ζMAT_property)
        '</td><td>'ζMAT_property_available' of 'EngineeringMaterialItemCount'</td><td>'ζMAT_property_completeness_percent'%</td><td style="text-align:left">
        MatClassificationName$(EngineeringMaterialDefaultClassification)
        '</td></tr>
    #loop
    '</tbody>
    '</table>
    #varsub
#end def

