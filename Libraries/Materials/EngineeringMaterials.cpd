EngineeringMaterialMetadata = [1001; 1; 1|1002; 1; 1|1003; 1; 1|1004; 1; 1|1005; 1; 1|1006; 1; 1|1007; 1; 1|1008; 1; 1|1009; 1; 1|1010; 1; 1|1011; 1; 1|1012; 1; 1|1013; 1; 1|1014; 1; 1|1101; 2; 1|1102; 2; 1|1103; 2; 1|1104; 2; 1|1105; 2; 1|1106; 2; 1|1107; 2; 1|1108; 2; 1|1109; 2; 1|1110; 2; 1|1201; 1; 1|1202; 1; 1|1203; 1; 1|2001; 10; 1|2002; 10; 1|2003; 10; 1|2004; 10; 1|2005; 10; 1|2006; 10; 1|2007; 10; 1|2008; 10; 1|2009; 10; 1|2101; 3; 1|2102; 3; 1|2103; 3; 1|2104; 3; 1|2105; 3; 1|2106; 3; 1|2201; 1; 1|2202; 1; 1|2301; 1; 1|2302; 1; 1|2401; 4; 1|2402; 4; 1|2403; 4; 1|2404; 4; 1|2405; 4; 1|2501; 1; 1|2502; 1; 1|2503; 1; 1|3001; 5; 1|3002; 5; 1|3003; 5; 1|3004; 5; 1|3005; 5; 1|3006; 5; 1|3007; 5; 1|3008; 5; 1|3009; 5; 1|3010; 5; 1|3011; 5; 1|3012; 5; 1|3013; 5; 1|3014; 5; 1|3015; 5; 1|3016; 5; 1|3017; 5; 1|3018; 5; 1|3019; 5; 1|3020; 5; 1|3021; 5; 1|3022; 5; 1|3023; 5; 1|3024; 5; 1|3025; 5; 1|3101; 5; 1|3102; 5; 1|3103; 5; 1|3104; 5; 1|3105; 5; 1|3106; 5; 1|3107; 5; 1|4001; 6; 1|4002; 6; 1|4003; 6; 1|4101; 6; 1|4102; 6; 1|4103; 6; 1|4104; 6; 1|4105; 6; 1|4106; 6; 1|4107; 6; 1|4108; 6; 1|4109; 6; 1|4110; 11; 1|4111; 6; 1|4112; 6; 1|4113; 6; 1|5001; 9; 1|5002; 9; 1|5003; 9; 1|5004; 9; 1|5005; 9; 1|5101; 7; 1|5102; 7; 1|5103; 7; 1|5104; 7; 1|5105; 7; 1|5106; 7; 1|5107; 7; 1|5108; 7; 1|5109; 7; 1|6001; 8; 1|6002; 8; 1|6003; 8; 1|6004; 8; 1|6005; 8; 1|6006; 8; 1|6007; 8; 1|6008; 8; 1|6009; 8; 1|6010; 8; 1]

MatHasItem(item) = DBHasID(EngineeringMaterialItemIDs; item)
MatHasProperty(property) = DBHasID(EngineeringMaterialPropertyIDs; property)
MatSourceID(item) = DBTableRaw(EngineeringMaterialMetadata; item; 2)
MatDataRevision(item) = DBTableRaw(EngineeringMaterialMetadata; item; 3)

MatPROPStatus(item; property) = _
$block{
    item_ok = MatHasItem(item); 
    property_ok = MatHasProperty(property); 
    status = switch(not(item_ok); DB_ERR_NAME; not(property_ok); DB_ERR_PROPERTY; DBTableStatus(EngineeringMaterialData; item; property + 1)); 
    status; 
}

MatPROPRaw(item; property) = _
$block{
    status = MatPROPStatus(item; property); 
    raw = if(DBIsFatal(status); 0/0; DBTableRaw(EngineeringMaterialData; item; property + 1)); 
    raw; 
}

MatApplyUnits(property; value) = switch(property ≡ MAT_P_DENSITY; setunits(value; kg/m^3); property ≡ MAT_P_YOUNGS_MODULUS; setunits(value; GPa); property ≡ MAT_P_SHEAR_MODULUS; setunits(value; GPa); property ≡ MAT_P_POISSON_RATIO; value; property ≡ MAT_P_YIELD_STRENGTH; setunits(value; MPa); property ≡ MAT_P_TENSILE_STRENGTH; setunits(value; MPa); property ≡ MAT_P_COMPRESSIVE_STRENGTH; setunits(value; MPa); property ≡ MAT_P_FLEXURAL_STRENGTH; setunits(value; MPa); property ≡ MAT_P_ELONGATION; value; property ≡ MAT_P_FRACTURE_TOUGHNESS; setunits(value; MPa*m^0.5); property ≡ MAT_P_THERMAL_CONDUCTIVITY; setunits(value; W/(m*K)); property ≡ MAT_P_SPECIFIC_HEAT; setunits(value; J/(kg*K)); property ≡ MAT_P_CTE; setunits(value*10^-6; 1/K); property ≡ MAT_P_ELECTRICAL_RESISTIVITY; setunits(value; Ω*m); property ≡ MAT_P_TRANSITION_TEMPERATURE; setunits(value; °C); property ≡ MAT_P_MAX_SERVICE_TEMPERATURE; setunits(value; °C); property ≡ MAT_P_HARDNESS_VICKERS; value; property ≡ MAT_P_BULK_MODULUS; setunits(value; GPa); 0/0)

MatPROP(item; property) = _
$block{
    status = MatPROPStatus(item; property); 
    raw = if(DBIsFatal(status); 0/0; MatPROPRaw(item; property)); 
    value = if(DBIsFatal(status); 0/0; MatApplyUnits(property; raw)); 
    value; 
}

MatRho(item) = MatPROP(item; MAT_P_DENSITY)
MatE(item) = MatPROP(item; MAT_P_YOUNGS_MODULUS)
MatG(item) = MatPROP(item; MAT_P_SHEAR_MODULUS)
MatNu(item) = MatPROP(item; MAT_P_POISSON_RATIO)
MatYield(item) = MatPROP(item; MAT_P_YIELD_STRENGTH)
MatUTS(item) = MatPROP(item; MAT_P_TENSILE_STRENGTH)
MatCompressive(item) = MatPROP(item; MAT_P_COMPRESSIVE_STRENGTH)
MatFlexural(item) = MatPROP(item; MAT_P_FLEXURAL_STRENGTH)
MatElongation(item) = MatPROP(item; MAT_P_ELONGATION)
MatKIC(item) = MatPROP(item; MAT_P_FRACTURE_TOUGHNESS)
MatThermalK(item) = MatPROP(item; MAT_P_THERMAL_CONDUCTIVITY)
MatCp(item) = MatPROP(item; MAT_P_SPECIFIC_HEAT)
MatCTE(item) = MatPROP(item; MAT_P_CTE)
MatResistivity(item) = MatPROP(item; MAT_P_ELECTRICAL_RESISTIVITY)
MatTransitionT(item) = MatPROP(item; MAT_P_TRANSITION_TEMPERATURE)
MatMaxServiceT(item) = MatPROP(item; MAT_P_MAX_SERVICE_TEMPERATURE)
MatHV(item) = MatPROP(item; MAT_P_HARDNESS_VICKERS)
MatBulk(item) = MatPROP(item; MAT_P_BULK_MODULUS)

