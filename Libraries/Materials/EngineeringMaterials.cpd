		        'Gray cast iron Class 30
	    #end if
	    #if item$ ≡ CAST_IRON_DUCTILE_65_45_12
		        'Ductile cast iron 65-45-12
	    #end if
	    #if item$ ≡ CAST_IRON_COMPACTED_GRAPHITE
		        'Compacted graphite iron
	    #end if
	    #if item$ ≡ ALUMINUM_1100_H14
		        'Aluminum 1100-H14
	    #end if
	    #if item$ ≡ ALUMINUM_2024_T3
		        'Aluminum 2024-T3
	    #end if
	    #if item$ ≡ ALUMINUM_3003_H14
		        'Aluminum 3003-H14
	    #end if
