#def MatPropertyName$(property$)
	    #if property$ ≡ MAT_P_DENSITY
		        'Density
	    #end if
	    #if property$ ≡ MAT_P_YOUNGS_MODULUS
		        'Young''s modulus
	    #end if
	    #if property$ ≡ MAT_P_SHEAR_MODULUS
		        'Shear modulus
	    #end if
	    #if property$ ≡ MAT_P_POISSON_RATIO
		        'Poisson ratio
	    #end if
	    #if property$ ≡ MAT_P_YIELD_STRENGTH
		        'Tensile yield strength
	    #end if
	    #if property$ ≡ MAT_P_TENSILE_STRENGTH
		        'Ultimate tensile strength
	    #end if
	    #if property$ ≡ MAT_P_COMPRESSIVE_STRENGTH
		        'Compressive strength
	    #end if
	    #if property$ ≡ MAT_P_FLEXURAL_STRENGTH
		        'Flexural strength
	    #end if
	    #if property$ ≡ MAT_P_ELONGATION
		        'Elongation at break
	    #end if
	    #if property$ ≡ MAT_P_FRACTURE_TOUGHNESS
		        'Fracture toughness
	    #end if
	    #if property$ ≡ MAT_P_THERMAL_CONDUCTIVITY
		        'Thermal conductivity
	    #end if
	    #if property$ ≡ MAT_P_SPECIFIC_HEAT
		        'Specific heat
	    #end if
	    #if property$ ≡ MAT_P_CTE
		        'Coefficient of thermal expansion
	    #end if
	    #if property$ ≡ MAT_P_ELECTRICAL_RESISTIVITY
		        'Electrical resistivity
	    #end if
	    #if property$ ≡ MAT_P_TRANSITION_TEMPERATURE
		        'Primary transition temperature
	    #end if
	    #if property$ ≡ MAT_P_MAX_SERVICE_TEMPERATURE
		        'Indicative maximum service temperature
	    #end if
	    #if property$ ≡ MAT_P_HARDNESS_VICKERS
		        'Vickers hardness
	    #end if
	    #if property$ ≡ MAT_P_BULK_MODULUS
		        'Bulk modulus
	    #end if
	    #if not(MatHasProperty(property$))
		        '<span class="err">Unknown material property ID</span>
	    #end if
#end def

#def MatPropertyUnit$(property$)
	    #if property$ ≡ MAT_P_DENSITY
		        'kg/m^3
	    #end if
	    #if property$ ≡ MAT_P_YOUNGS_MODULUS
		        'GPa
	    #end if
	    #if property$ ≡ MAT_P_SHEAR_MODULUS
		        'GPa
	    #end if
	    #if property$ ≡ MAT_P_POISSON_RATIO
		        '1
	    #end if
	    #if property$ ≡ MAT_P_YIELD_STRENGTH
		        'MPa
	    #end if
	    #if property$ ≡ MAT_P_TENSILE_STRENGTH
		        'MPa
	    #end if
	    #if property$ ≡ MAT_P_COMPRESSIVE_STRENGTH
		        'MPa
	    #end if
	    #if property$ ≡ MAT_P_FLEXURAL_STRENGTH
		        'MPa
	    #end if
	    #if property$ ≡ MAT_P_ELONGATION
		        'fraction
	    #end if
	    #if property$ ≡ MAT_P_FRACTURE_TOUGHNESS
		        'MPa*m^0.5
	    #end if
	    #if property$ ≡ MAT_P_THERMAL_CONDUCTIVITY
		        'W/(m*K)
	    #end if
	    #if property$ ≡ MAT_P_SPECIFIC_HEAT
		        'J/(kg*K)
	    #end if
	    #if property$ ≡ MAT_P_CTE
		        'um/(m*K)
	    #end if
	    #if property$ ≡ MAT_P_ELECTRICAL_RESISTIVITY
		        'ohm*m
	    #end if
	    #if property$ ≡ MAT_P_TRANSITION_TEMPERATURE
		        'degC
	    #end if
	    #if property$ ≡ MAT_P_MAX_SERVICE_TEMPERATURE
		        'degC
	    #end if
	    #if property$ ≡ MAT_P_HARDNESS_VICKERS
		        'HV
	    #end if
	    #if property$ ≡ MAT_P_BULK_MODULUS
		        'GPa
	    #end if
	    #if not(MatHasProperty(property$))
		        '<span class="err">Unknown material property ID</span>
	    #end if
#end def

MatSourceKnown(source_id) = and(source_id ≥ 1; source_id ≤ 11)

#def MatSource$(source_id$)
	    #if source_id$ ≡ MAT_SRC_1
		        'MatWeb public materials database — https://www.matweb.com/search/MaterialGroupSearch.aspx
	    #end if
	    #if source_id$ ≡ MAT_SRC_2
		        'Outokumpu stainless steel grades — https://www.outokumpu.com/en/products/stainless-steel/grades
	    #end if
	    #if source_id$ ≡ MAT_SRC_3
		        'Copper Development Association alloy database — https://www.copper.org/resources/properties/db/
	    #end if
	    #if source_id$ ≡ MAT_SRC_4
		        'Special Metals product literature — https://www.specialmetals.com/documents/
	    #end if
	    #if source_id$ ≡ MAT_SRC_5
		        'CAMPUS plastics database — https://www.campusplastics.com/
	    #end if
	    #if source_id$ ≡ MAT_SRC_6
		        'NIST Structural Ceramics Database — https://srdata.nist.gov/CeramicDataPortal/scd
	    #end if
	    #if source_id$ ≡ MAT_SRC_7
		        'USDA Wood Handbook: Wood as an Engineering Material — https://research.fs.usda.gov/fpl/wood-handbook
	    #end if
	    #if source_id$ ≡ MAT_SRC_8
		        'FHWA PCC pavement materials reference — https://www.fhwa.dot.gov/publications/research/infrastructure/pavements/pccp/04127/appa.cfm
	    #end if
	    #if source_id$ ≡ MAT_SRC_9
		        'Hexcel product data sheets — https://www.hexcel.com/Resources/DataSheets/
	    #end if
	    #if source_id$ ≡ MAT_SRC_10
		        'The Aluminum Association alloy overview — https://www.aluminum.org/industry-standards/aluminum-alloys-101
	    #end if
	    #if source_id$ ≡ MAT_SRC_11
		        'NIST TPSX Materials Properties Database — https://tpsx.arc.nasa.gov/
	    #end if
	    #if not(MatSourceKnown(source_id$))
		        '<span class="err">Unknown material source ID</span>
	    #end if
#end def

#def ShowMatRecord$(item$)
	    #hide
	    ζMAT_record_status = if(MatHasItem(item$); DB_OK; DB_ERR_NAME)
	    ζMAT_record_source = if(DBIsFatal(ζMAT_record_status); 0; MatSourceID(item$))
	    ζMAT_record_revision = if(DBIsFatal(ζMAT_record_status); 0; MatDataRevision(item$))
	    #show
	    #novar
	    '<table class="bordered data material-record" style="width:95%">
	    '<tbody>
	    '<tr><td><strong>Material</strong></td><td>
	    MatName$(item$)
	    '</td></tr>
	    '<tr><td><strong>Material ID</strong></td><td>'item$'</td></tr>
	    '<tr><td><strong>Status</strong></td><td>
	    DBStatus$(ζMAT_record_status)
	    '</td></tr>
	    #if not(DBIsFatal(ζMAT_record_status))
	        '<tr><td><strong>Library</strong></td><td>EngineeringMaterialsLibraryName$</td></tr>
	        '<tr><td><strong>Library revision</strong></td><td>EngineeringMaterialsLibraryRevision$</td></tr>
	        '<tr><td><strong>Dataset revision</strong></td><td>'ζMAT_record_revision'</td></tr>
	        '<tr><td><strong>Source registry</strong></td><td>
	        MatSource$(ζMAT_record_source)
	        '</td></tr>
	        #varsub
	    #end if
	    '</tbody>
	    '</table>
#end def

#def ShowMatPROP$(item$; property$)
	    #hide
	    ζMAT_status = MatPROPStatus(item$; property$)
	    ζMAT_value = MatPROP(item$; property$)
	    ζMAT_source = if(DBIsFatal(ζMAT_status); 0; MatSourceID(item$))
	    #show
	    #novar
	    '<table class="bordered data material-property" style="width:95%">
	    '<tbody>
	    '<tr><td><strong>Material</strong></td><td>
	    MatName$(item$)
	    '</td></tr>
	    '<tr><td><strong>Property</strong></td><td>
	    MatPropertyName$(property$)
	    '</td></tr>
	    '<tr><td><strong>Status</strong></td><td>
	    DBStatus$(ζMAT_status)
	    '</td></tr>
	    #if not(DBIsFatal(ζMAT_status))
		        '<tr><td><strong>Value</strong></td><td>'ζMAT_value'</td></tr>
		        '<tr><td><strong>Source registry</strong></td><td>
		        MatSource$(ζMAT_source)
		        '</td></tr>
		    #varsub
	    #end if
	    '</tbody>
	    '</table>
#end def
#show
#else
'<div style="margin:1em;padding:0.75em;border:2px solid #b00020;color:#b00020;background:#fff0f2;"><strong>DRAT library load error:</strong> EngineeringMaterials requires DataWrapper API 0.3.2 or newer. Load a compatible DratCore.cpd before this library.</div>
#end if
#else
'<div style="margin:1em;padding:0.75em;border:2px solid #b00020;color:#b00020;background:#fff0f2;"><strong>DRAT library load error:</strong> EngineeringMaterials requires DRAT core API 1.x. Load DratCore.cpd before this library.</div>
#end if
