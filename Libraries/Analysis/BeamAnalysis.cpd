#def ShowBeamMomentPlot$(id$; model$)
    #md off
    #hide
    ζBEAM_moment_plot_samples = BeamSamplePositions(model$)
    ζBEAM_moment_plot_response = BeamMomentSeries(model$)
    ζBEAM_moment_plot_x = BeamNumericSeries(ζBEAM_moment_plot_samples)
    ζBEAM_moment_plot_y = BeamNumericSeries(ζBEAM_moment_plot_response)
    #show
    figure$(id$)
    plot$(id$; ζBEAM_moment_plot_x; ζBEAM_moment_plot_y; #337ab7; Bending moment)
    #for ζBEAM_moment_jump_index = 1 : len(BeamModelMomentValues(model$))
        #hide
        ζBEAM_moment_jump_x = clrunits(BeamLengthElement(BeamModelMomentPositions(model$); ζBEAM_moment_jump_index))
        ζBEAM_moment_jump_left = clrunits(BeamMomentLeftLimit(model$; BeamLengthElement(BeamModelMomentPositions(model$); ζBEAM_moment_jump_index)))
        ζBEAM_moment_jump_right = clrunits(BeamMoment(model$; BeamLengthElement(BeamModelMomentPositions(model$); ζBEAM_moment_jump_index)))
        #show
        #if BeamMomentElement(BeamModelMomentValues(model$); ζBEAM_moment_jump_index) ≠ 0N*m
            #val
            '<script>window.TSPlots["id$"].data.push({x:['ζBEAM_moment_jump_x','ζBEAM_moment_jump_x'],y:['ζBEAM_moment_jump_left','ζBEAM_moment_jump_right'],mode:"lines",type:"scatter",line:{color:"#337ab7",width:2},name:"Applied-moment jump",showlegend:false});</script>
            #equ
        #end if
    #loop
    hline$(id$; 0; #777777; Zero)
    hoverUnified$(id$)
    render$(id$; Bending-moment diagram; Position along beam; Moment)
    #md on
#end def

