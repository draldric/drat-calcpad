#def ShowBeamFBD$(id$; model$)
    #md off
    #hide
    ζBEAM_fbd_span = BeamModelSpan(model$)
    ζBEAM_fbd_point_loads = BeamModelPointLoads(model$)
    ζBEAM_fbd_point_positions = BeamModelPointPositions(model$)
    ζBEAM_fbd_udl_starts = BeamModelUDLStarts(model$)
    ζBEAM_fbd_udl_ends = BeamModelUDLEnds(model$)
    ζBEAM_fbd_udl_values = BeamModelUDLValues(model$)
    ζBEAM_fbd_axial_loads = BeamModelAxialLoads(model$)
    ζBEAM_fbd_axial_positions = BeamModelAxialPositions(model$)
    ζBEAM_fbd_axial_starts = BeamModelAxialStarts(model$)
    ζBEAM_fbd_axial_ends = BeamModelAxialEnds(model$)
    ζBEAM_fbd_axial_values = BeamModelAxialValues(model$)
    ζBEAM_fbd_moment_positions = BeamModelMomentPositions(model$)
    ζBEAM_fbd_moment_values = BeamModelMomentValues(model$)
    #show
    ShowBeamSchematic$(id$; ζBEAM_fbd_span; ζBEAM_fbd_point_loads; ζBEAM_fbd_point_positions; ζBEAM_fbd_udl_starts; ζBEAM_fbd_udl_ends; ζBEAM_fbd_udl_values; ζBEAM_fbd_axial_loads; ζBEAM_fbd_axial_positions; ζBEAM_fbd_axial_starts; ζBEAM_fbd_axial_ends; ζBEAM_fbd_axial_values; ζBEAM_fbd_moment_positions; ζBEAM_fbd_moment_values)
    #md on
#end def

