    ζBEAM_report_udl_starts = BeamModelUDLStarts(model$)
    ζBEAM_report_udl_ends = BeamModelUDLEnds(model$)
    ζBEAM_report_udl_values = BeamModelUDLValues(model$)
    ζBEAM_report_modulus = BeamModelModulus(model$)
    ζBEAM_report_inertia = BeamModelInertia(model$)
    #show
