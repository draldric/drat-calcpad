#def ShowBeamLoadResponse$(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$; x$)
    #hide
    ζBEAM_load_response_status = BeamLoadSetStatus(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$)
    ζBEAM_load_shear = BeamShearAtLoads(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$; x$)
    ζBEAM_load_moment = BeamMomentAtLoads(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$; x$)
    ζBEAM_load_deflection = BeamDeflectionAtLoads(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$; x$)
    #show
