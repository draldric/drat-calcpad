    '<tr><td>Position</td><td>'x$'</td></tr>
    '<tr><td>Shear</td><td>'ζBEAM_shear'</td></tr>
    '<tr><td>Moment</td><td>'ζBEAM_moment'</td></tr>
    '<tr><td>Deflection</td><td>'ζBEAM_deflection'</td></tr>
    '<tr><td>Status</td><td>
    DBStatus$(ζBEAM_response_status)
    '</td></tr>
    '</tbody>
    '</table>
#end def

#def ShowBeamLoadSummary$(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$)
    #hide
    ζBEAM_load_status = BeamAnalyzeStatus(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$)
