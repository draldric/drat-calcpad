    ζBEAM_report_status = BeamModelStatus(model$)
    ζBEAM_report_sample_count = len(BeamSamplePositions(model$))
    ζBEAM_report_peak_shear = BeamPeakShear(model$)
    ζBEAM_report_peak_moment = BeamPeakMoment(model$)
    ζBEAM_report_peak_rotation = BeamPeakRotation(model$)
    ζBEAM_report_peak_deflection = BeamPeakDeflection(model$)
    #show
    #novar
