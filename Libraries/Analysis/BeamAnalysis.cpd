    ζBEAM_load_moment = BeamMomentAtLoads(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$; x$)
    ζBEAM_load_rotation = BeamRotationAtLoads(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$; x$)
