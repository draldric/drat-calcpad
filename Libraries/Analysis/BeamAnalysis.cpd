#def ShowBeamDiagrams$(id$; model$)
    ShowBeamFBD$(id$_loading; model$)
    ShowBeamShearPlot$(id$_shear; model$)
    ShowBeamMomentPlot$(id$_moment; model$)
    ShowBeamAxialPlot$(id$_axial; model$)
    ShowBeamDeflectionPlot$(id$_deflection; model$)
#end def

#else
'<div class="library-load-error"><strong>DRAT library load error:</strong> Beam diagram helpers require Plotting API 3.2.x.</div>
#end if
#show
