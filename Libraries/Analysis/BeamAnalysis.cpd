#def ShowBeamReactions$(model$)
    #hide
    ζBEAM_report_status = BeamModelStatus(model$)
    ζBEAM_report_support = BeamModelSupport(model$)
    ζBEAM_report_left_reaction = BeamLeftReaction(model$)
    ζBEAM_report_right_reaction = if(ζBEAM_report_support ≡ BEAM_SIMPLE_SUPPORTED; BeamRightReaction(model$); 0N)
    ζBEAM_report_fixed_moment = if(ζBEAM_report_support ≡ BEAM_CANTILEVER; BeamFixedEndMoment(model$); 0N*m)
    #show
    #novar
    '<table class="bordered data beam-load-reactions">
    '<thead><tr><th>Reaction</th><th>Value</th></tr></thead>
    '<tbody>
    '<tr><td>Left/support reaction</td><td>'ζBEAM_report_left_reaction'</td></tr>
    '<tr><td>Right/free-end vertical reaction</td><td>'ζBEAM_report_right_reaction'</td></tr>
    '<tr><td>Fixed-end reaction moment</td><td>'ζBEAM_report_fixed_moment'</td></tr>
    '<tr><td>Status</td><td>
    DBStatus$(ζBEAM_report_status)
    '</td></tr>
    '</tbody>
    '</table>
    #equ
#end def

