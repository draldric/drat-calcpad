    '<tr><td>Position</td><td>'x$'</td></tr>
    '<tr><td>Shear</td><td>'ζBEAM_load_shear'</td></tr>
    '<tr><td>Moment</td><td>'ζBEAM_load_moment'</td></tr>
    '<tr><td>Deflection</td><td>'ζBEAM_load_deflection'</td></tr>
    '<tr><td>Status</td><td>
    DBStatus$(ζBEAM_load_response_status)
    '</td></tr>
    '</tbody>
    '</table>
#end def

#def ShowBeamLoadReactions$(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$)
    #hide
    ζBEAM_reaction_status = BeamLoadSetStatus(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$)
    ζBEAM_reaction_left = BeamReactionLeftLoads(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$)
    ζBEAM_reaction_right = BeamReactionRightLoads(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$)
    ζBEAM_reaction_moment = if(support$ ≡ BEAM_CANTILEVER; BeamReactionMomentLoads(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$); 0N*m)
    #show
    #novar
    '<table class="bordered data beam-load-reactions">
    '<thead><tr><th>Reaction</th><th>Value</th></tr></thead>
    '<tbody>
    '<tr><td>Left/support reaction</td><td>'ζBEAM_reaction_left'</td></tr>
    '<tr><td>Right/free-end vertical reaction</td><td>'ζBEAM_reaction_right'</td></tr>
    '<tr><td>Fixed-end reaction moment</td><td>'ζBEAM_reaction_moment'</td></tr>
    '<tr><td>Status</td><td>
    DBStatus$(ζBEAM_reaction_status)
    '</td></tr>
    '</tbody>
    '</table>
#end def

#def ShowBeamLoadExtrema$(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$; sample_positions$)
    #hide
    ζBEAM_extrema_status = BeamLoadSetStatus(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$)
    ζBEAM_extrema_count = len(sample_positions$)
    ζBEAM_extrema_shear = BeamMaxShearAtSamples(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$; sample_positions$)
    ζBEAM_extrema_moment = BeamMaxMomentAtSamples(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$; sample_positions$)
    ζBEAM_extrema_deflection = BeamMaxDeflectionAtSamples(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$; sample_positions$)
    #show
    #novar
    '<table class="bordered data beam-load-extrema">
    '<thead><tr><th>Sampled extrema</th><th>Value</th></tr></thead>
    '<tbody>
    '<tr><td>Sample positions</td><td>'ζBEAM_extrema_count'</td></tr>
    '<tr><td>Maximum sampled shear</td><td>'ζBEAM_extrema_shear'</td></tr>
    '<tr><td>Maximum sampled moment</td><td>'ζBEAM_extrema_moment'</td></tr>
    '<tr><td>Maximum sampled deflection</td><td>'ζBEAM_extrema_deflection'</td></tr>
    '<tr><td>Status</td><td>
    DBStatus$(ζBEAM_extrema_status)
    '</td></tr>
    '</tbody>
    '</table>
#end def

#def ShowBeamModel$(model$)
    #hide
    ζBEAM_model_status = BeamModelStatus(model$)
    ζBEAM_model_support = BeamModelSupport(model$)
    ζBEAM_model_span = BeamModelSpan(model$)
    ζBEAM_model_modulus = BeamModelModulus(model$)
    ζBEAM_model_inertia = BeamModelInertia(model$)
    ζBEAM_model_sample_count = BeamModelSampleCount(model$)
    ζBEAM_model_point_loads = BeamModelPointLoads(model$)
    ζBEAM_model_udl_values = BeamModelUDLValues(model$)
    ζBEAM_model_axial_loads = BeamModelAxialLoads(model$)
    ζBEAM_model_axial_values = BeamModelAxialValues(model$)
    ζBEAM_model_moment_values = BeamModelMomentValues(model$)
    ζBEAM_model_point_count = len(ζBEAM_model_point_loads) - count(ζBEAM_model_point_loads; 0N; 1)
    ζBEAM_model_udl_count = len(ζBEAM_model_udl_values) - count(ζBEAM_model_udl_values; 0N/m; 1)
    ζBEAM_model_axial_point_count = len(ζBEAM_model_axial_loads) - count(ζBEAM_model_axial_loads; 0N; 1)
    ζBEAM_model_axial_udl_count = len(ζBEAM_model_axial_values) - count(ζBEAM_model_axial_values; 0N/m; 1)
    ζBEAM_model_moment_count = len(ζBEAM_model_moment_values) - count(ζBEAM_model_moment_values; 0N*m; 1)
    #show
    #novar
    '<table class="bordered data beam-load-summary">
    '<thead><tr><th>Beam model</th><th>Value</th></tr></thead>
    '<tbody>
    '<tr><td>Support</td><td>
    BeamSupport$(ζBEAM_model_support)
    '</td></tr>
    '<tr><td>Span</td><td>'ζBEAM_model_span'</td></tr>
    '<tr><td>Elastic modulus</td><td>'ζBEAM_model_modulus'</td></tr>
    '<tr><td>Second moment of area</td><td>'ζBEAM_model_inertia'</td></tr>
    '<tr><td>Transverse point loads</td><td>'ζBEAM_model_point_count'</td></tr>
    '<tr><td>Distributed-load segments</td><td>'ζBEAM_model_udl_count'</td></tr>
    '<tr><td>Axial point loads</td><td>'ζBEAM_model_axial_point_count'</td></tr>
    '<tr><td>Axial distributed-load segments</td><td>'ζBEAM_model_axial_udl_count'</td></tr>
    '<tr><td>Diagram-only applied moments</td><td>'ζBEAM_model_moment_count'</td></tr>
    '<tr><td>Diagram samples</td><td>'ζBEAM_model_sample_count'</td></tr>
    '<tr><td>Status</td><td>
    DBStatus$(ζBEAM_model_status)
    '</td></tr>
    '</tbody>
    '</table>
    #equ
#end def

