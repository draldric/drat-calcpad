    ShowBeamLoadExtrema$(ζBEAM_report_support; ζBEAM_report_span; ζBEAM_report_point_loads; ζBEAM_report_point_positions; ζBEAM_report_udl_starts; ζBEAM_report_udl_ends; ζBEAM_report_udl_values; ζBEAM_report_modulus; ζBEAM_report_inertia; ζBEAM_report_samples)
#end def

#def ShowBeamScreening$(model$; section_modulus$; shear_area$; allowable_stress$; allowable_deflection$)
    #hide
    ζBEAM_screening_max_shear = BeamPeakShear(model$)
    ζBEAM_screening_max_moment = BeamPeakMoment(model$)
    ζBEAM_screening_max_deflection = BeamPeakDeflection(model$)
    ζBEAM_screening_bending_stress = BeamBendingStress(ζBEAM_screening_max_moment; section_modulus$)
    ζBEAM_screening_bending_utilization = BeamBendingUtilization(ζBEAM_screening_max_moment; section_modulus$; allowable_stress$)
    ζBEAM_screening_bending_status = BeamBendingStatus(ζBEAM_screening_max_moment; section_modulus$; allowable_stress$; CHK_DEFAULT_WARNING)
    ζBEAM_screening_shear_stress = BeamShearStress(ζBEAM_screening_max_shear; shear_area$)
    ζBEAM_screening_shear_utilization = BeamShearUtilization(ζBEAM_screening_max_shear; shear_area$; allowable_stress$)
    ζBEAM_screening_shear_status = BeamShearStatus(ζBEAM_screening_max_shear; shear_area$; allowable_stress$; CHK_DEFAULT_WARNING)
    ζBEAM_screening_deflection_utilization = BeamDeflectionUtilization(ζBEAM_screening_max_deflection; allowable_deflection$)
    ζBEAM_screening_deflection_status = BeamDeflectionStatus(ζBEAM_screening_max_deflection; allowable_deflection$; CHK_DEFAULT_WARNING)
    ζBEAM_screening_overall_status = CheckOverallStatus([ζBEAM_screening_bending_status; ζBEAM_screening_shear_status; ζBEAM_screening_deflection_status])
    #show
    #novar
    '<table class="bordered data beam-response">
    '<thead><tr><th>Screening check</th><th>Value</th></tr></thead>
    '<tbody>
    '<tr><td>Maximum sampled moment</td><td>'ζBEAM_screening_max_moment'</td></tr>
    '<tr><td>Bending stress</td><td>'ζBEAM_screening_bending_stress'</td></tr>
    '<tr><td>Bending utilization</td><td>'ζBEAM_screening_bending_utilization'</td></tr>
    '<tr><td>Bending status</td><td>
    CheckStatus$(ζBEAM_screening_bending_status)
    '</td></tr>
    '<tr><td>Maximum sampled shear</td><td>'ζBEAM_screening_max_shear'</td></tr>
    '<tr><td>Shear stress</td><td>'ζBEAM_screening_shear_stress'</td></tr>
    '<tr><td>Shear utilization</td><td>'ζBEAM_screening_shear_utilization'</td></tr>
    '<tr><td>Shear status</td><td>
    CheckStatus$(ζBEAM_screening_shear_status)
    '</td></tr>
    '<tr><td>Maximum sampled deflection</td><td>'ζBEAM_screening_max_deflection'</td></tr>
    '<tr><td>Allowable deflection</td><td>'allowable_deflection$'</td></tr>
    '<tr><td>Deflection utilization</td><td>'ζBEAM_screening_deflection_utilization'</td></tr>
    '<tr><td>Deflection status</td><td>
    CheckStatus$(ζBEAM_screening_deflection_status)
    '</td></tr>
    '<tr><td>Overall screening status</td><td>
    CheckStatus$(ζBEAM_screening_overall_status)
    '</td></tr>
    '</tbody>
    '</table>
    #equ
#end def
#if and(DRAT_PLOTTING_API ≥ 30200; DRAT_PLOTTING_API < 40000)

#def ShowBeamSchematic$(id$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; axial_loads$; axial_positions$; axial_starts$; axial_ends$; axial_values$; moment_positions$; moment_values$)
    #hide
    ζBEAM_diagram_point_max = max(abs(point_loads$))
    ζBEAM_diagram_udl_max = max(abs(udl_values$))
    ζBEAM_diagram_axial_max = max(abs(axial_loads$))
    ζBEAM_diagram_axial_segment_max = max(abs(axial_values$))
    ζBEAM_diagram_moment_max = max(abs(moment_values$))
    ζBEAM_diagram_span_numeric = clrunits(span$)
    ζBEAM_diagram_x_margin = max(0.2; 0.05*ζBEAM_diagram_span_numeric)
    ζBEAM_diagram_x_min = -ζBEAM_diagram_x_margin
    ζBEAM_diagram_x_max = ζBEAM_diagram_span_numeric + ζBEAM_diagram_x_margin
    ζBEAM_diagram_support_positions = [0m; span$]
    ζBEAM_diagram_support_ordinates = [-0.06; -0.06]
    ζBEAM_diagram_axis_positions = [0m; span$]
    ζBEAM_diagram_axis_ordinates = [0; 0]
    ζBEAM_diagram_support_positions_numeric = BeamNumericSeries(ζBEAM_diagram_support_positions)
    ζBEAM_diagram_axis_positions_numeric = BeamNumericSeries(ζBEAM_diagram_axis_positions)
    #show
    figure$(id$)
    figureSize$(id$; 900; 360)
    #val
    '<script>var p=window.TSPlots["id$"];p.layout.xaxis.range=['ζBEAM_diagram_x_min','ζBEAM_diagram_x_max'];p.layout.xaxis.showgrid=false;p.layout.xaxis.ticks="outside";p.layout.xaxis.fixedrange=true;p.layout.yaxis.range=[-0.42,0.52];p.layout.yaxis.visible=false;p.layout.yaxis.fixedrange=true;p.layout.margin={l:35,r:35,b:65,t:55};p.config.displayModeBar=false;</script>
    #equ
    plot$(id$; ζBEAM_diagram_axis_positions_numeric; ζBEAM_diagram_axis_ordinates; #333333; Beam axis)
    #val
    '<script>var t=window.TSPlots["id$"].data[window.TSPlots["id$"].data.length-1];t.line.width=4;t.hoverinfo="skip";</script>
    #equ
    #val
    '<script>
    'window.TSPlots["id$"].data.push({
    '  x:'clrunits(ζBEAM_diagram_support_positions_numeric)',
    '  y:'clrunits(ζBEAM_diagram_support_ordinates)',
    '  mode:"markers",type:"scatter",
    '  marker:{size:18,symbol:"triangle-up",color:"#f7f7f7",line:{color:"#333333",width:2}},
    '  name:"Supports",hoverinfo:"skip"
    '});
    '</script>
    #equ
    #for ζBEAM_diagram_support_index = 1 : len(ζBEAM_diagram_support_positions_numeric)
        #hide
        ζBEAM_diagram_support_x = take(ζBEAM_diagram_support_index; ζBEAM_diagram_support_positions_numeric)
        #show
        #val
        '<script>
        'window.TSPlots["id$"].layout.shapes.push({type:"line",xref:"x",x0:'ζBEAM_diagram_support_x',x1:'ζBEAM_diagram_support_x',yref:"y",y0:-0.04,y1:0,line:{color:"#333333",width:2}});
        'window.TSPlots["id$"].layout.shapes.push({type:"line",xref:"x",x0:'ζBEAM_diagram_support_x'-0.20,x1:'ζBEAM_diagram_support_x'+0.20,yref:"y",y0:-0.13,y1:-0.13,line:{color:"#333333",width:2}});
        '</script>
        #equ
    #loop
    #for ζBEAM_diagram_point_index = 1 : len(point_positions$)
        #hide
        ζBEAM_diagram_point_x = clrunits(BeamLengthElement(point_positions$; ζBEAM_diagram_point_index))
        ζBEAM_diagram_point_scale = if(ζBEAM_diagram_point_max > 0N; abs(BeamForceElement(point_loads$; ζBEAM_diagram_point_index))/ζBEAM_diagram_point_max; 0)
        ζBEAM_diagram_point_arrow_height = 0.30*ζBEAM_diagram_point_scale
        ζBEAM_diagram_point_tail_y = if(BeamForceElement(point_loads$; ζBEAM_diagram_point_index) > 0N; ζBEAM_diagram_point_arrow_height; -ζBEAM_diagram_point_arrow_height)
        #show
        #if BeamForceElement(point_loads$; ζBEAM_diagram_point_index) ≠ 0N
            #val
            '<script>window.TSPlots["id$"].layout.annotations.push({xref:"x",yref:"y",axref:"x",ayref:"y",x:'ζBEAM_diagram_point_x',y:0,ax:'ζBEAM_diagram_point_x',ay:'ζBEAM_diagram_point_tail_y',text:"P",showarrow:true,arrowhead:3,arrowsize:1.1,arrowwidth:2.5,arrowcolor:"#d9534f",font:{color:"#d9534f",size:12},xanchor:"center"});</script>
            #equ
        #end if
    #loop
    #for ζBEAM_diagram_udl_index = 1 : len(udl_starts$)
        #hide
        ζBEAM_diagram_udl_start_x = BeamLengthElement(udl_starts$; ζBEAM_diagram_udl_index)
        ζBEAM_diagram_udl_mid_x = (ζBEAM_diagram_udl_start_x + BeamLengthElement(udl_ends$; ζBEAM_diagram_udl_index))/2
        ζBEAM_diagram_udl_end_x = BeamLengthElement(udl_ends$; ζBEAM_diagram_udl_index)
        ζBEAM_diagram_udl_start_numeric = clrunits(ζBEAM_diagram_udl_start_x)
        ζBEAM_diagram_udl_mid_numeric = clrunits(ζBEAM_diagram_udl_mid_x)
        ζBEAM_diagram_udl_end_numeric = clrunits(ζBEAM_diagram_udl_end_x)
        ζBEAM_diagram_udl_arrow_1_x = ζBEAM_diagram_udl_start_numeric + (ζBEAM_diagram_udl_end_numeric - ζBEAM_diagram_udl_start_numeric)/6
        ζBEAM_diagram_udl_arrow_2_x = ζBEAM_diagram_udl_mid_numeric
        ζBEAM_diagram_udl_arrow_3_x = ζBEAM_diagram_udl_end_numeric - (ζBEAM_diagram_udl_end_numeric - ζBEAM_diagram_udl_start_numeric)/6
        ζBEAM_diagram_udl_scale = if(ζBEAM_diagram_udl_max > 0N/m; abs(BeamDistributedElement(udl_values$; ζBEAM_diagram_udl_index))/ζBEAM_diagram_udl_max; 0)
        ζBEAM_diagram_udl_height = 0.30*ζBEAM_diagram_udl_scale
        ζBEAM_diagram_udl_tail_y = if(BeamDistributedElement(udl_values$; ζBEAM_diagram_udl_index) > 0N/m; ζBEAM_diagram_udl_height; -ζBEAM_diagram_udl_height)
        ζBEAM_diagram_udl_shade_y0 = min(0; ζBEAM_diagram_udl_tail_y)
        ζBEAM_diagram_udl_shade_y1 = max(0; ζBEAM_diagram_udl_tail_y)
        ζBEAM_diagram_udl_label_x = ζBEAM_diagram_udl_end_numeric - 0.04*(ζBEAM_diagram_udl_end_numeric - ζBEAM_diagram_udl_start_numeric)
        ζBEAM_diagram_udl_label_y = 0.50*ζBEAM_diagram_udl_tail_y
        #show
        #if BeamDistributedElement(udl_values$; ζBEAM_diagram_udl_index) ≠ 0N/m
            #val
            '<script>
            'var p=window.TSPlots["id$"];
            'p.layout.shapes.push({type:"rect",xref:"x",x0:'ζBEAM_diagram_udl_start_numeric',x1:'ζBEAM_diagram_udl_end_numeric',yref:"y",y0:'ζBEAM_diagram_udl_shade_y0',y1:'ζBEAM_diagram_udl_shade_y1',fillcolor:"rgba(51,122,183,0.18)",line:{color:"#337ab7",width:1},layer:"below"});
            'p.layout.annotations.push({xref:"x",yref:"y",axref:"x",ayref:"y",x:'ζBEAM_diagram_udl_arrow_1_x',y:0,ax:'ζBEAM_diagram_udl_arrow_1_x',ay:'ζBEAM_diagram_udl_tail_y',text:" ",showarrow:true,arrowhead:3,arrowsize:1.05,arrowwidth:2,arrowcolor:"#337ab7"});
            'p.layout.annotations.push({xref:"x",yref:"y",axref:"x",ayref:"y",x:'ζBEAM_diagram_udl_arrow_2_x',y:0,ax:'ζBEAM_diagram_udl_arrow_2_x',ay:'ζBEAM_diagram_udl_tail_y',text:" ",showarrow:true,arrowhead:3,arrowsize:1.05,arrowwidth:2,arrowcolor:"#337ab7"});
            'p.layout.annotations.push({xref:"x",yref:"y",axref:"x",ayref:"y",x:'ζBEAM_diagram_udl_arrow_3_x',y:0,ax:'ζBEAM_diagram_udl_arrow_3_x',ay:'ζBEAM_diagram_udl_tail_y',text:" ",showarrow:true,arrowhead:3,arrowsize:1.05,arrowwidth:2,arrowcolor:"#337ab7"});
            'p.layout.annotations.push({xref:"x",yref:"y",x:'ζBEAM_diagram_udl_label_x',y:'ζBEAM_diagram_udl_label_y',text:"w",showarrow:false,xanchor:"right",font:{color:"#337ab7",size:12}});
            '</script>
            #equ
        #end if
    #loop
    #for ζBEAM_diagram_moment_index = 1 : min(len(moment_positions$); len(moment_values$))
        #hide
        ζBEAM_diagram_moment_x = clrunits(BeamLengthElement(moment_positions$; ζBEAM_diagram_moment_index))
        ζBEAM_diagram_moment_scale = if(ζBEAM_diagram_moment_max > 0N*m; abs(BeamVectorElement(moment_values$; ζBEAM_diagram_moment_index))/ζBEAM_diagram_moment_max; 0)
        ζBEAM_diagram_moment_size = 28*ζBEAM_diagram_moment_scale
        #show
        #if BeamVectorElement(moment_values$; ζBEAM_diagram_moment_index) > 0N*m
            #val
            '<script>window.TSPlots["id$"].data.push({x:['ζBEAM_diagram_moment_x'],y:[0.40],mode:"text",text:["↺ M"],textfont:{size:'ζBEAM_diagram_moment_size',color:"#9467bd"},name:"Applied moments",hoverinfo:"skip"});</script>
            #equ
        #end if
        #if BeamVectorElement(moment_values$; ζBEAM_diagram_moment_index) < 0N*m
            #val
            '<script>window.TSPlots["id$"].data.push({x:['ζBEAM_diagram_moment_x'],y:[0.40],mode:"text",text:["↻ M"],textfont:{size:'ζBEAM_diagram_moment_size',color:"#9467bd"},name:"Applied moments",hoverinfo:"skip"});</script>
            #equ
        #end if
    #loop
    #for ζBEAM_diagram_axial_index = 1 : len(axial_positions$)
        #hide
        ζBEAM_diagram_axial_x = clrunits(BeamLengthElement(axial_positions$; ζBEAM_diagram_axial_index))
        ζBEAM_diagram_axial_scale = if(ζBEAM_diagram_axial_max > 0N; abs(BeamForceElement(axial_loads$; ζBEAM_diagram_axial_index))/ζBEAM_diagram_axial_max; 0)
        ζBEAM_diagram_axial_arrow_length = 0.12*ζBEAM_diagram_span_numeric*ζBEAM_diagram_axial_scale
        ζBEAM_diagram_axial_tail_x = if(BeamForceElement(axial_loads$; ζBEAM_diagram_axial_index) > 0N; ζBEAM_diagram_axial_x - ζBEAM_diagram_axial_arrow_length; ζBEAM_diagram_axial_x + ζBEAM_diagram_axial_arrow_length)
        #show
        #if BeamForceElement(axial_loads$; ζBEAM_diagram_axial_index) ≠ 0N
            #val
            '<script>window.TSPlots["id$"].layout.annotations.push({xref:"x",yref:"y",axref:"x",ayref:"y",x:'ζBEAM_diagram_axial_x',y:-0.21,ax:'ζBEAM_diagram_axial_tail_x',ay:-0.21,text:"N",showarrow:true,arrowhead:3,arrowsize:1.1,arrowwidth:2.5,arrowcolor:"#5cb85c",font:{color:"#5cb85c",size:12}});</script>
            #equ
        #end if
    #loop
    #for ζBEAM_diagram_axial_segment_index = 1 : len(axial_starts$)
        #hide
        ζBEAM_diagram_axial_segment_x = clrunits((BeamLengthElement(axial_starts$; ζBEAM_diagram_axial_segment_index) + BeamLengthElement(axial_ends$; ζBEAM_diagram_axial_segment_index))/2)
        ζBEAM_diagram_axial_segment_scale = if(ζBEAM_diagram_axial_segment_max > 0N/m; abs(BeamDistributedElement(axial_values$; ζBEAM_diagram_axial_segment_index))/ζBEAM_diagram_axial_segment_max; 0)
        ζBEAM_diagram_axial_segment_arrow_length = 0.10*ζBEAM_diagram_span_numeric*ζBEAM_diagram_axial_segment_scale
        ζBEAM_diagram_axial_segment_tail_x = if(BeamDistributedElement(axial_values$; ζBEAM_diagram_axial_segment_index) > 0N/m; ζBEAM_diagram_axial_segment_x - ζBEAM_diagram_axial_segment_arrow_length; ζBEAM_diagram_axial_segment_x + ζBEAM_diagram_axial_segment_arrow_length)
        #show
        #if BeamDistributedElement(axial_values$; ζBEAM_diagram_axial_segment_index) ≠ 0N/m
            #val
            '<script>window.TSPlots["id$"].layout.annotations.push({xref:"x",yref:"y",axref:"x",ayref:"y",x:'ζBEAM_diagram_axial_segment_x',y:-0.33,ax:'ζBEAM_diagram_axial_segment_tail_x',ay:-0.33,text:"n",showarrow:true,arrowhead:3,arrowsize:1.1,arrowwidth:2,arrowcolor:"#5cb85c",font:{color:"#5cb85c",size:12}});</script>
            #equ
        #end if
    #loop
    hideLegend$(id$)
    render$(id$; Beam loading diagram; Position along beam; Schematic ordinate)
#end def

#def ShowBeamShearDiagram$(id$; support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$; sample_positions$)
    #hide
    ζBEAM_plot_shear = BeamShearSampleSeries(support$; span$; point_loads$; point_positions$; udl_starts$; udl_ends$; udl_values$; modulus$; inertia$; sample_positions$)
    ζBEAM_plot_x = BeamNumericSeries(sample_positions$)
    ζBEAM_plot_y = BeamNumericSeries(ζBEAM_plot_shear)
    #show
    figure$(id$)
    plot$(id$; ζBEAM_plot_x; ζBEAM_plot_y; #d9534f; Shear)
    hline$(id$; 0; #777777; Zero)
    hoverUnified$(id$)
    render$(id$; Shear-force diagram; Position along beam; Shear)
#end def

