#if and(DRAT_CORE_API ≥ 10000; DRAT_CORE_API < 40000)
#if and(DRAT_DATA_WRAPPER_API ≥ 302; DRAT_DATA_WRAPPER_API < 1000)
#if and(DRAT_CHECKS_API ≥ 10200; DRAT_CHECKS_API < 30000)
#hide
'<!-- Static beam-response, diagram, and screening library. Version 0.6.0. -->
#def BeamAnalysisLibraryName$ = DRAT Static Beam Analysis Library
#def BeamAnalysisLibraryRevision$ = 0.6.0
#def BeamAnalysisLibraryDate$ = 2026-08-11
#def BeamAnalysisLibrarySource$ = Modular closed-form Euler-Bernoulli beam equations and Plotting-wrapper diagram helpers for prismatic members.
#def BeamAnalysisLibraryScope$ = Simply supported and cantilever beams with composable point, uniform, linearly varying, axial, and concentrated-moment load families, sampled shear, moment, rotation, axial-force, displacement, and loading-schematic diagrams. Linear elastic, small-deflection, static response only. This library does not provide code capacities, load combinations, lateral-torsional buckling, shear-deformation, plastic, dynamic, or stability analysis.
#show
'<style>table.data.beam-case-summary td:nth-child(2),table.data.beam-case-summary td:nth-child(2) p,table.data.beam-response td:nth-child(2),table.data.beam-response td:nth-child(2) p,table.data.beam-load-summary td:nth-child(2),table.data.beam-load-summary td:nth-child(2) p,table.data.beam-load-response td:nth-child(2),table.data.beam-load-response td:nth-child(2) p,table.data.beam-load-reactions td:nth-child(2),table.data.beam-load-reactions td:nth-child(2) p,table.data.beam-load-extrema td:nth-child(2),table.data.beam-load-extrema td:nth-child(2) p{text-align:right!important;overflow-wrap:anywhere;word-break:break-word;}</style>
#hide

BEAM_SIMPLE_SUPPORTED = 1
BEAM_CANTILEVER = 2

BEAM_POINT_LOAD = 1
BEAM_FULL_UDL = 2

BEAM_RESPONSE_SHEAR = 1
BEAM_RESPONSE_MOMENT = 2
BEAM_RESPONSE_DEFLECTION = 3
BEAM_RESPONSE_ROTATION = 4

BeamSupportKnown(support) = or(support ≡ BEAM_SIMPLE_SUPPORTED; support ≡ BEAM_CANTILEVER)
BeamLoadTypeKnown(load_type) = or(load_type ≡ BEAM_POINT_LOAD; load_type ≡ BEAM_FULL_UDL)
BeamFinite(value) = and(value ≡ value; abs(clrunits(value)) < 1*10^300)
BeamPositive(value) = and(BeamFinite(value); clrunits(value) > 0)
BeamPositionOK(x; span) = and(BeamFinite(x); BeamPositive(span); x ≥ 0*span; x ≤ span)

'Use this argument order for every response function:
'support; load type; span; point load; point-load position; full-span UDL; elastic modulus; second moment of area.
BeamCaseStatus(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia) = switch(
    not(BeamSupportKnown(support)); DB_ERR_BAD_METHOD;
    not(BeamLoadTypeKnown(load_type)); DB_ERR_BAD_METHOD;
    not(BeamPositive(span)); DB_ERR_BAD_RANGE;
    not(BeamPositive(modulus)); DB_ERR_BAD_RANGE;
    not(BeamPositive(inertia)); DB_ERR_BAD_RANGE;
    and(load_type ≡ BEAM_POINT_LOAD; not(BeamFinite(point_load))); DB_ERR_BAD_RANGE;
    and(load_type ≡ BEAM_POINT_LOAD; not(BeamPositionOK(point_position; span))); DB_ERR_BAD_RANGE;
    and(load_type ≡ BEAM_FULL_UDL; not(BeamFinite(distributed_load))); DB_ERR_BAD_RANGE;
    DB_OK)

BeamResponseStatus(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia; x) = switch(
    BeamCaseStatus(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia) ≠ DB_OK; BeamCaseStatus(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia);
    not(BeamFinite(x)); DB_ERR_BAD_RANGE;
    DBRangeStatus(x; 0m; span; DB_STRICT))

BeamSimplePointReactionLeft(point_load; span; point_position) = point_load*(span - point_position)/span

BeamResponse(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia; x; response_type) = _
$block{
    status = BeamResponseStatus(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia; x);
    reaction_left = BeamSimplePointReactionLeft(point_load; span; point_position);
    distance_after_point = if(x > point_position; x - point_position; 0*span);
    distance_to_free_end = span - x;
    simple_point_shear = if(x < point_position; reaction_left; reaction_left - point_load);
    simple_point_moment = reaction_left*x - point_load*distance_after_point;
    simple_point_deflection_left = point_load*(span - point_position)*x*(span^2 - (span - point_position)^2 - x^2)/(6*span*modulus*inertia);
    simple_point_deflection_right = point_load*point_position*distance_to_free_end*(2*span*x - x^2 - point_position^2)/(6*span*modulus*inertia);
    simple_point_deflection = if(x ≤ point_position; simple_point_deflection_left; simple_point_deflection_right);
    simple_point_rotation_left = point_load*(span - point_position)*(span^2 - (span - point_position)^2 - 3*x^2)/(6*span*modulus*inertia);
    simple_point_rotation_right = point_load*point_position*(2*span^2 - 6*span*x + 3*x^2 + point_position^2)/(6*span*modulus*inertia);
    simple_point_rotation = if(x ≤ point_position; simple_point_rotation_left; simple_point_rotation_right);
    simple_udl_shear = distributed_load*(span/2 - x);
    simple_udl_moment = distributed_load*x*(span - x)/2;
    simple_udl_deflection = distributed_load*x*(span^3 - 2*span*x^2 + x^3)/(24*modulus*inertia);
    simple_udl_rotation = distributed_load*(span^3 - 6*span*x^2 + 4*x^3)/(24*modulus*inertia);
    cantilever_point_shear = if(x ≤ point_position; point_load; 0N);
    cantilever_point_moment = if(x ≤ point_position; point_load*(point_position - x); 0N*m);
    cantilever_point_deflection_left = point_load*x^2*(3*point_position - x)/(6*modulus*inertia);
    cantilever_point_deflection_right = point_load*point_position^2*(3*x - point_position)/(6*modulus*inertia);
    cantilever_point_deflection = if(x ≤ point_position; cantilever_point_deflection_left; cantilever_point_deflection_right);
    cantilever_point_rotation_left = point_load*x*(2*point_position - x)/(2*modulus*inertia);
    cantilever_point_rotation_right = point_load*point_position^2/(2*modulus*inertia);
    cantilever_point_rotation = if(x ≤ point_position; cantilever_point_rotation_left; cantilever_point_rotation_right);
    cantilever_udl_shear = distributed_load*(span - x);
    cantilever_udl_moment = distributed_load*(span - x)^2/2;
    cantilever_udl_deflection = distributed_load*x^2*(6*span^2 - 4*span*x + x^2)/(24*modulus*inertia);
    cantilever_udl_rotation = distributed_load*x*(3*span^2 - 3*span*x + x^2)/(6*modulus*inertia);
    response = switch(
        and(support ≡ BEAM_SIMPLE_SUPPORTED; load_type ≡ BEAM_POINT_LOAD; response_type ≡ BEAM_RESPONSE_SHEAR); simple_point_shear;
        and(support ≡ BEAM_SIMPLE_SUPPORTED; load_type ≡ BEAM_POINT_LOAD; response_type ≡ BEAM_RESPONSE_MOMENT); simple_point_moment;
        and(support ≡ BEAM_SIMPLE_SUPPORTED; load_type ≡ BEAM_POINT_LOAD; response_type ≡ BEAM_RESPONSE_DEFLECTION); simple_point_deflection;
        and(support ≡ BEAM_SIMPLE_SUPPORTED; load_type ≡ BEAM_POINT_LOAD; response_type ≡ BEAM_RESPONSE_ROTATION); simple_point_rotation;
        and(support ≡ BEAM_SIMPLE_SUPPORTED; load_type ≡ BEAM_FULL_UDL; response_type ≡ BEAM_RESPONSE_SHEAR); simple_udl_shear;
        and(support ≡ BEAM_SIMPLE_SUPPORTED; load_type ≡ BEAM_FULL_UDL; response_type ≡ BEAM_RESPONSE_MOMENT); simple_udl_moment;
        and(support ≡ BEAM_SIMPLE_SUPPORTED; load_type ≡ BEAM_FULL_UDL; response_type ≡ BEAM_RESPONSE_DEFLECTION); simple_udl_deflection;
        and(support ≡ BEAM_SIMPLE_SUPPORTED; load_type ≡ BEAM_FULL_UDL; response_type ≡ BEAM_RESPONSE_ROTATION); simple_udl_rotation;
        and(support ≡ BEAM_CANTILEVER; load_type ≡ BEAM_POINT_LOAD; response_type ≡ BEAM_RESPONSE_SHEAR); cantilever_point_shear;
        and(support ≡ BEAM_CANTILEVER; load_type ≡ BEAM_POINT_LOAD; response_type ≡ BEAM_RESPONSE_MOMENT); cantilever_point_moment;
        and(support ≡ BEAM_CANTILEVER; load_type ≡ BEAM_POINT_LOAD; response_type ≡ BEAM_RESPONSE_DEFLECTION); cantilever_point_deflection;
        and(support ≡ BEAM_CANTILEVER; load_type ≡ BEAM_POINT_LOAD; response_type ≡ BEAM_RESPONSE_ROTATION); cantilever_point_rotation;
        and(support ≡ BEAM_CANTILEVER; load_type ≡ BEAM_FULL_UDL; response_type ≡ BEAM_RESPONSE_SHEAR); cantilever_udl_shear;
        and(support ≡ BEAM_CANTILEVER; load_type ≡ BEAM_FULL_UDL; response_type ≡ BEAM_RESPONSE_MOMENT); cantilever_udl_moment;
        and(support ≡ BEAM_CANTILEVER; load_type ≡ BEAM_FULL_UDL; response_type ≡ BEAM_RESPONSE_DEFLECTION); cantilever_udl_deflection;
        and(support ≡ BEAM_CANTILEVER; load_type ≡ BEAM_FULL_UDL; response_type ≡ BEAM_RESPONSE_ROTATION); cantilever_udl_rotation;
        0/0);
    result = if(status ≡ DB_OK; response; 0/0);
    result;
}

BeamShearAt(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia; x) = BeamResponse(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia; x; BEAM_RESPONSE_SHEAR)
BeamMomentAt(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia; x) = BeamResponse(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia; x; BEAM_RESPONSE_MOMENT)
BeamDeflectionAt(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia; x) = BeamResponse(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia; x; BEAM_RESPONSE_DEFLECTION)
BeamRotationAt(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia; x) = BeamResponse(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia; x; BEAM_RESPONSE_ROTATION)

BeamMaxShear(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia) = _
$block{
    status = BeamCaseStatus(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia);
    simple_point = abs(point_load)*max(point_position/span; (span - point_position)/span);
    simple_udl = abs(distributed_load)*span/2;
    cantilever_point = abs(point_load);
    cantilever_udl = abs(distributed_load)*span;
    response = switch(
        and(support ≡ BEAM_SIMPLE_SUPPORTED; load_type ≡ BEAM_POINT_LOAD); simple_point;
        and(support ≡ BEAM_SIMPLE_SUPPORTED; load_type ≡ BEAM_FULL_UDL); simple_udl;
        and(support ≡ BEAM_CANTILEVER; load_type ≡ BEAM_POINT_LOAD); cantilever_point;
        and(support ≡ BEAM_CANTILEVER; load_type ≡ BEAM_FULL_UDL); cantilever_udl;
        0/0);
    result = if(status ≡ DB_OK; response; 0/0);
    result;
}

BeamMaxMoment(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia) = _
$block{
    status = BeamCaseStatus(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia);
    simple_point = abs(point_load)*point_position*(span - point_position)/span;
    simple_udl = abs(distributed_load)*span^2/8;
    cantilever_point = abs(point_load)*point_position;
    cantilever_udl = abs(distributed_load)*span^2/2;
    response = switch(
        and(support ≡ BEAM_SIMPLE_SUPPORTED; load_type ≡ BEAM_POINT_LOAD); simple_point;
        and(support ≡ BEAM_SIMPLE_SUPPORTED; load_type ≡ BEAM_FULL_UDL); simple_udl;
        and(support ≡ BEAM_CANTILEVER; load_type ≡ BEAM_POINT_LOAD); cantilever_point;
        and(support ≡ BEAM_CANTILEVER; load_type ≡ BEAM_FULL_UDL); cantilever_udl;
        0/0);
    result = if(status ≡ DB_OK; response; 0/0);
    result;
}

BeamMaxDeflection(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia) = _
$block{
    status = BeamCaseStatus(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia);
    point_distance_left = span - point_position;
    point_x_left = sqrt((span^2 - point_distance_left^2)/3);
    point_x_right = span - sqrt((span^2 - point_position^2)/3);
    point_left = abs(BeamDeflectionAt(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia; point_x_left));
    point_right = abs(BeamDeflectionAt(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia; point_x_right));
    simple_point = max(point_left; point_right);
    simple_udl = abs(BeamDeflectionAt(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia; span/2));
    cantilever_point = abs(BeamDeflectionAt(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia; span));
    cantilever_udl = abs(BeamDeflectionAt(support; load_type; span; point_load; point_position; distributed_load; modulus; inertia; span));
    response = switch(
        and(support ≡ BEAM_SIMPLE_SUPPORTED; load_type ≡ BEAM_POINT_LOAD); simple_point;
        and(support ≡ BEAM_SIMPLE_SUPPORTED; load_type ≡ BEAM_FULL_UDL); simple_udl;
        and(support ≡ BEAM_CANTILEVER; load_type ≡ BEAM_POINT_LOAD); cantilever_point;
        and(support ≡ BEAM_CANTILEVER; load_type ≡ BEAM_FULL_UDL); cantilever_udl;
        0/0);
    result = if(status ≡ DB_OK; response; 0/0);
    result;
}

'Modular load-family API. Each vector contains one physical quantity only:
'point_loads and point_moments use force and moment units, point_positions and
'udl_starts/udl_ends use length units, and udl_values use force-per-length units.
'Use zero-valued one-element vectors when a load family is not present.
BeamVectorElement(v; i) = sum(last(first(v; i); 1))
BeamForceElement(v; i) = BeamVectorElement(v; i) + 0N
BeamLengthElement(v; i) = BeamVectorElement(v; i) + 0m
BeamDistributedElement(v; i) = BeamVectorElement(v; i) + 0N/m
BeamMomentElement(v; i) = BeamVectorElement(v; i) + 0N*m

BeamSegmentOK(start; finish; span) = and(
    BeamPositionOK(start; span);
    BeamPositionOK(finish; span);
    finish ≥ start)

BeamLoadSetStatus(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia) = _
$block{
    point_count = len(point_loads);
    point_position_count = len(point_positions);
    udl_start_count = len(udl_starts);
    udl_end_count = len(udl_ends);
    udl_value_count = len(udl_values);
    point_pair_count = min(point_count; point_position_count);
    udl_pair_count = min(udl_start_count; min(udl_end_count; udl_value_count));
    point_finite = fill(resize([0]; max(point_pair_count; 1)); 1);
    udl_finite = fill(resize([0]; max(udl_pair_count; 1)); 1);
    $Repeat{point_finite.i = and(BeamFinite(BeamForceElement(point_loads; i)); BeamFinite(BeamLengthElement(point_positions; i))) @ i = 1 : point_pair_count};
    $Repeat{udl_finite.i = and(BeamFinite(BeamLengthElement(udl_starts; i)); BeamFinite(BeamLengthElement(udl_ends; i)); BeamFinite(BeamDistributedElement(udl_values; i))) @ i = 1 : udl_pair_count};
    finite_status = and(min(point_finite) ≡ 1; min(udl_finite) ≡ 1);
    status = switch(
        not(BeamSupportKnown(support)); DB_ERR_BAD_METHOD;
        not(BeamPositive(span)); DB_ERR_BAD_RANGE;
        not(BeamPositive(modulus)); DB_ERR_BAD_RANGE;
        not(BeamPositive(inertia)); DB_ERR_BAD_RANGE;
        point_count ≠ point_position_count; DB_ERR_BAD_RANGE;
        and(udl_start_count ≠ udl_end_count; 1); DB_ERR_BAD_RANGE;
        and(udl_start_count ≠ udl_value_count; 1); DB_ERR_BAD_RANGE;
        finite_status ≠ 1; DB_ERR_BAD_RANGE;
        DB_OK);
    point_position_status = fill(resize([0]; max(point_pair_count; 1)); 1);
    udl_position_status = fill(resize([0]; max(udl_pair_count; 1)); 1);
    $Repeat{point_position_status.i = if(BeamPositionOK(BeamLengthElement(point_positions; i); span); 1; 0) @ i = 1 : point_pair_count};
    $Repeat{udl_position_status.i = if(BeamSegmentOK(BeamLengthElement(udl_starts; i); BeamLengthElement(udl_ends; i); span); 1; 0) @ i = 1 : udl_pair_count};
    status = if(and(status ≡ DB_OK; min(point_position_status) ≡ 1; min(udl_position_status) ≡ 1); DB_OK; DB_ERR_BAD_RANGE);
    status;
}

BeamAnalyzeStatus(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia) = BeamLoadSetStatus(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia)

BeamSimplePointShearTerm(point_load; point_position; span; x) = if(x < point_position; point_load*(span - point_position)/span; point_load*(span - point_position)/span - point_load)
BeamSimplePointMomentTerm(point_load; point_position; span; x) = point_load*(span - point_position)*x/span - point_load*max(x - point_position; 0*x)
BeamSimplePointDeflectionTerm(point_load; point_position; span; modulus; inertia; x) = if(
    x ≤ point_position;
    point_load*(span - point_position)*x*(span^2 - (span - point_position)^2 - x^2)/(6*span*modulus*inertia);
    point_load*point_position*(span - x)*(2*span*x - x^2 - point_position^2)/(6*span*modulus*inertia))
BeamSimplePointRotationTerm(point_load; point_position; span; modulus; inertia; x) = if(
    x ≤ point_position;
    point_load*(span - point_position)*(span^2 - (span - point_position)^2 - 3*x^2)/(6*span*modulus*inertia);
    point_load*point_position*(2*span^2 - 6*span*x + 3*x^2 + point_position^2)/(6*span*modulus*inertia))

BeamCantileverPointShearTerm(point_load; point_position; x) = if(x ≤ point_position; point_load; 0*point_load)
BeamCantileverPointMomentTerm(point_load; point_position; x) = if(x ≤ point_position; point_load*(point_position - x); 0*point_load*point_position)
BeamCantileverPointDeflectionTerm(point_load; point_position; modulus; inertia; x) = if(
    x ≤ point_position;
    point_load*x^2*(3*point_position - x)/(6*modulus*inertia);
    point_load*point_position^2*(3*x - point_position)/(6*modulus*inertia))
BeamCantileverPointRotationTerm(point_load; point_position; modulus; inertia; x) = if(
    x ≤ point_position;
    point_load*x*(2*point_position - x)/(2*modulus*inertia);
    point_load*point_position^2/(2*modulus*inertia))

BeamSimpleSegmentReactionTerm(udl; start; finish; span) = udl*(finish - start)*(span - (start + finish)/2)/span
BeamSimpleSegmentShearTerm(udl; start; finish; span; x) = BeamSimpleSegmentReactionTerm(udl; start; finish; span) - udl*(max(x - start; 0*x) - max(x - finish; 0*x))
BeamSimpleSegmentMomentTerm(udl; start; finish; span; x) = BeamSimpleSegmentReactionTerm(udl; start; finish; span)*x - udl*(max(x - start; 0*x)^2 - max(x - finish; 0*x)^2)/2
BeamSimpleSegmentDeflectionTerm(udl; start; finish; span; modulus; inertia; x) = _
$block{
    reaction = BeamSimpleSegmentReactionTerm(udl; start; finish; span);
    correction = (reaction*span^3/6 - udl*((span - start)^4 - (span - finish)^4)/24)/span;
    (-reaction*x^3/6 + udl*(max(x - start; 0*x)^4 - max(x - finish; 0*x)^4)/24 + correction*x)/(modulus*inertia);
}
BeamSimpleSegmentRotationTerm(udl; start; finish; span; modulus; inertia; x) = _
$block{
    reaction = BeamSimpleSegmentReactionTerm(udl; start; finish; span);
    correction = (reaction*span^3/6 - udl*((span - start)^4 - (span - finish)^4)/24)/span;
    (-reaction*x^2/2 + udl*(max(x - start; 0*x)^3 - max(x - finish; 0*x)^3)/6 + correction)/(modulus*inertia);
}

BeamCantileverSegmentShearTerm(udl; start; finish; x) = udl*(max(finish - x; 0*x) - max(start - x; 0*x))
BeamCantileverSegmentMomentTerm(udl; start; finish; x) = udl*(max(finish - x; 0*x)^2 - max(start - x; 0*x)^2)/2
BeamCantileverSegmentDeflectionTerm(udl; start; finish; modulus; inertia; x) = _
$block{
    finish_term = if(x ≤ finish; udl*x^2*(6*finish^2 - 4*finish*x + x^2)/(24*modulus*inertia); udl*finish^3*(4*x - finish)/(24*modulus*inertia));
    start_term = if(x ≤ start; udl*x^2*(6*start^2 - 4*start*x + x^2)/(24*modulus*inertia); udl*start^3*(4*x - start)/(24*modulus*inertia));
    finish_term - start_term;
}
BeamCantileverSegmentRotationTerm(udl; start; finish; modulus; inertia; x) = _
$block{
    finish_term = if(x ≤ finish; udl*x*(3*finish^2 - 3*finish*x + x^2)/(6*modulus*inertia); udl*finish^3/(6*modulus*inertia));
    start_term = if(x ≤ start; udl*x*(3*start^2 - 3*start*x + x^2)/(6*modulus*inertia); udl*start^3/(6*modulus*inertia));
    finish_term - start_term;
}

'Linearly varying transverse-load segment. Start and end intensities may be
'equal for a UDL, or one may be zero for a triangular load.
BeamVaryingLoadTotal(start; finish; start_value; end_value) = (start_value + end_value)*(finish - start)/2
BeamVaryingLoadFirstMoment(start; finish; start_value; end_value) = (finish - start)*(start_value*(2*start + finish) + end_value*(start + 2*finish))/6
BeamVaryingLoadSlope(start; finish; start_value; end_value) = (end_value - start_value)/(finish - start)

BeamVaryingLoadAccumulation(start; finish; start_value; end_value; x) = _
$block{
    distance = finish - start;
    slope = BeamVaryingLoadSlope(start; finish; start_value; end_value);
    start_term = max(x - start; 0*x);
    end_term = max(x - finish; 0*x);
    start_value*(start_term - end_term) + slope*(start_term^2 - end_term^2)/2 - slope*distance*end_term;
}

BeamVaryingMomentAccumulation(start; finish; start_value; end_value; x) = _
$block{
    distance = finish - start;
    slope = BeamVaryingLoadSlope(start; finish; start_value; end_value);
    start_term = max(x - start; 0*x);
    end_term = max(x - finish; 0*x);
    start_value*(start_term^2 - end_term^2)/2 + slope*(start_term^3 - end_term^3)/6 - slope*distance*end_term^2/2;
}

BeamVaryingRotationAccumulation(start; finish; start_value; end_value; x) = _
$block{
    distance = finish - start;
    slope = BeamVaryingLoadSlope(start; finish; start_value; end_value);
    start_term = max(x - start; 0*x);
    end_term = max(x - finish; 0*x);
    start_value*(start_term^3 - end_term^3)/6 + slope*(start_term^4 - end_term^4)/24 - slope*distance*end_term^3/6;
}

BeamVaryingDeflectionAccumulation(start; finish; start_value; end_value; x) = _
$block{
    distance = finish - start;
    slope = BeamVaryingLoadSlope(start; finish; start_value; end_value);
    start_term = max(x - start; 0*x);
    end_term = max(x - finish; 0*x);
    start_value*(start_term^4 - end_term^4)/24 + slope*(start_term^5 - end_term^5)/120 - slope*distance*end_term^4/24;
}

BeamSimpleVaryingReactionTerm(start; finish; start_value; end_value; span) = BeamVaryingLoadTotal(start; finish; start_value; end_value) - BeamVaryingLoadFirstMoment(start; finish; start_value; end_value)/span
BeamSimpleVaryingShearTerm(start; finish; start_value; end_value; span; x) = BeamSimpleVaryingReactionTerm(start; finish; start_value; end_value; span) - BeamVaryingLoadAccumulation(start; finish; start_value; end_value; x)
BeamSimpleVaryingMomentTerm(start; finish; start_value; end_value; span; x) = BeamSimpleVaryingReactionTerm(start; finish; start_value; end_value; span)*x - BeamVaryingMomentAccumulation(start; finish; start_value; end_value; x)
BeamSimpleVaryingRotationTerm(start; finish; start_value; end_value; span; modulus; inertia; x) = _
$block{
    reaction = BeamSimpleVaryingReactionTerm(start; finish; start_value; end_value; span);
    correction = (reaction*span^3/6 - BeamVaryingDeflectionAccumulation(start; finish; start_value; end_value; span))/span;
    (-reaction*x^2/2 + BeamVaryingRotationAccumulation(start; finish; start_value; end_value; x) + correction)/(modulus*inertia);
}
BeamSimpleVaryingDeflectionTerm(start; finish; start_value; end_value; span; modulus; inertia; x) = _
$block{
    reaction = BeamSimpleVaryingReactionTerm(start; finish; start_value; end_value; span);
    correction = (reaction*span^3/6 - BeamVaryingDeflectionAccumulation(start; finish; start_value; end_value; span))/span;
    (-reaction*x^3/6 + BeamVaryingDeflectionAccumulation(start; finish; start_value; end_value; x) + correction*x)/(modulus*inertia);
}

BeamCantileverVaryingShearTerm(start; finish; start_value; end_value; x) = BeamVaryingLoadTotal(start; finish; start_value; end_value) - BeamVaryingLoadAccumulation(start; finish; start_value; end_value; x)
BeamCantileverVaryingMomentTerm(start; finish; start_value; end_value; x) = BeamVaryingLoadFirstMoment(start; finish; start_value; end_value) - x*BeamVaryingLoadTotal(start; finish; start_value; end_value) + BeamVaryingMomentAccumulation(start; finish; start_value; end_value; x)
BeamCantileverVaryingRotationTerm(start; finish; start_value; end_value; modulus; inertia; x) = (BeamVaryingLoadFirstMoment(start; finish; start_value; end_value)*x - BeamVaryingLoadTotal(start; finish; start_value; end_value)*x^2/2 + BeamVaryingRotationAccumulation(start; finish; start_value; end_value; x))/(modulus*inertia)
BeamCantileverVaryingDeflectionTerm(start; finish; start_value; end_value; modulus; inertia; x) = (BeamVaryingLoadFirstMoment(start; finish; start_value; end_value)*x^2/2 - BeamVaryingLoadTotal(start; finish; start_value; end_value)*x^3/6 + BeamVaryingDeflectionAccumulation(start; finish; start_value; end_value; x))/(modulus*inertia)

BeamVaryingLoadSetStatus(span; starts; ends; start_values; end_values) = _
$block{
    pair_count = min(min(len(starts); len(ends)); min(len(start_values); len(end_values)));
    finite_terms = fill(resize([0]; max(pair_count; 1)); 1);
    position_terms = fill(resize([0]; max(pair_count; 1)); 1);
    $Repeat{finite_terms.i = and(BeamFinite(BeamLengthElement(starts; i)); BeamFinite(BeamLengthElement(ends; i)); BeamFinite(BeamDistributedElement(start_values; i)); BeamFinite(BeamDistributedElement(end_values; i))) @ i = 1 : pair_count};
    $Repeat{position_terms.i = if(and(BeamSegmentOK(BeamLengthElement(starts; i); BeamLengthElement(ends; i); span); BeamLengthElement(ends; i) > BeamLengthElement(starts; i)); 1; 0) @ i = 1 : pair_count};
    switch(
        not(BeamPositive(span)); DB_ERR_BAD_RANGE;
        len(starts) ≠ len(ends); DB_ERR_BAD_RANGE;
        len(starts) ≠ len(start_values); DB_ERR_BAD_RANGE;
        len(starts) ≠ len(end_values); DB_ERR_BAD_RANGE;
        min(finite_terms) < 1; DB_ERR_BAD_RANGE;
        min(position_terms) < 1; DB_ERR_BAD_RANGE;
        DB_OK);
}

BeamVaryingResponseStatus(support; span; starts; ends; start_values; end_values; modulus; inertia; x) = switch(
    not(BeamSupportKnown(support)); DB_ERR_BAD_METHOD;
    not(BeamPositive(modulus)); DB_ERR_BAD_RANGE;
    not(BeamPositive(inertia)); DB_ERR_BAD_RANGE;
    BeamVaryingLoadSetStatus(span; starts; ends; start_values; end_values) ≠ DB_OK; BeamVaryingLoadSetStatus(span; starts; ends; start_values; end_values);
    not(BeamPositionOK(x; span)); DB_ERR_BAD_RANGE;
    DB_OK)

BeamVaryingResponseUnchecked(support; span; starts; ends; start_values; end_values; modulus; inertia; x; response_type) = _
$block{
    response_terms = vector(len(start_values));
    $Repeat{
        response_terms.i = switch(
            response_type ≡ BEAM_RESPONSE_SHEAR; if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimpleVaryingShearTerm(BeamLengthElement(starts; i); BeamLengthElement(ends; i); BeamDistributedElement(start_values; i); BeamDistributedElement(end_values; i); span; x); BeamCantileverVaryingShearTerm(BeamLengthElement(starts; i); BeamLengthElement(ends; i); BeamDistributedElement(start_values; i); BeamDistributedElement(end_values; i); x));
            response_type ≡ BEAM_RESPONSE_MOMENT; if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimpleVaryingMomentTerm(BeamLengthElement(starts; i); BeamLengthElement(ends; i); BeamDistributedElement(start_values; i); BeamDistributedElement(end_values; i); span; x); BeamCantileverVaryingMomentTerm(BeamLengthElement(starts; i); BeamLengthElement(ends; i); BeamDistributedElement(start_values; i); BeamDistributedElement(end_values; i); x));
            response_type ≡ BEAM_RESPONSE_ROTATION; if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimpleVaryingRotationTerm(BeamLengthElement(starts; i); BeamLengthElement(ends; i); BeamDistributedElement(start_values; i); BeamDistributedElement(end_values; i); span; modulus; inertia; x); BeamCantileverVaryingRotationTerm(BeamLengthElement(starts; i); BeamLengthElement(ends; i); BeamDistributedElement(start_values; i); BeamDistributedElement(end_values; i); modulus; inertia; x));
            response_type ≡ BEAM_RESPONSE_DEFLECTION; if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimpleVaryingDeflectionTerm(BeamLengthElement(starts; i); BeamLengthElement(ends; i); BeamDistributedElement(start_values; i); BeamDistributedElement(end_values; i); span; modulus; inertia; x); BeamCantileverVaryingDeflectionTerm(BeamLengthElement(starts; i); BeamLengthElement(ends; i); BeamDistributedElement(start_values; i); BeamDistributedElement(end_values; i); modulus; inertia; x));
            0/0);
        @ i = 1 : len(start_values)};
    sum(response_terms);
}

BeamVaryingResponse(support; span; starts; ends; start_values; end_values; modulus; inertia; x; response_type) = if(BeamVaryingResponseStatus(support; span; starts; ends; start_values; end_values; modulus; inertia; x) ≡ DB_OK; BeamVaryingResponseUnchecked(support; span; starts; ends; start_values; end_values; modulus; inertia; x; response_type); 0/0)

BeamVaryingLeftReaction(support; span; starts; ends; start_values; end_values) = _
$block{
    status = BeamVaryingLoadSetStatus(span; starts; ends; start_values; end_values);
    reaction_terms = 1N*vector(len(start_values));
    $Repeat{reaction_terms.i = if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimpleVaryingReactionTerm(BeamLengthElement(starts; i); BeamLengthElement(ends; i); BeamDistributedElement(start_values; i); BeamDistributedElement(end_values; i); span); BeamVaryingLoadTotal(BeamLengthElement(starts; i); BeamLengthElement(ends; i); BeamDistributedElement(start_values; i); BeamDistributedElement(end_values; i))) @ i = 1 : len(start_values)};
    if(and(status ≡ DB_OK; BeamSupportKnown(support)); sum(reaction_terms); 0/0);
}

BeamVaryingRightReaction(support; span; starts; ends; start_values; end_values) = _
$block{
    status = BeamVaryingLoadSetStatus(span; starts; ends; start_values; end_values);
    total_terms = 1N*vector(len(start_values));
    $Repeat{total_terms.i = BeamVaryingLoadTotal(BeamLengthElement(starts; i); BeamLengthElement(ends; i); BeamDistributedElement(start_values; i); BeamDistributedElement(end_values; i)) @ i = 1 : len(start_values)};
    if(and(status ≡ DB_OK; support ≡ BEAM_SIMPLE_SUPPORTED); sum(total_terms) - BeamVaryingLeftReaction(support; span; starts; ends; start_values; end_values); 0/0);
}

BeamVaryingFixedReaction(support; span; starts; ends; start_values; end_values) = _
$block{
    status = BeamVaryingLoadSetStatus(span; starts; ends; start_values; end_values);
    moment_terms = 1N*m*vector(len(start_values));
    $Repeat{moment_terms.i = BeamVaryingLoadFirstMoment(BeamLengthElement(starts; i); BeamLengthElement(ends; i); BeamDistributedElement(start_values; i); BeamDistributedElement(end_values; i)) @ i = 1 : len(start_values)};
    if(and(status ≡ DB_OK; support ≡ BEAM_CANTILEVER); sum(moment_terms); 0N*m);
}

BeamResponseAtLoadsUnchecked(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; x; response_type) = _
$block{
    point_response_terms = vector(len(point_loads));
    $Repeat{
        point_response_terms.i = switch(
            response_type ≡ BEAM_RESPONSE_SHEAR; if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimplePointShearTerm(BeamForceElement(point_loads; i); BeamLengthElement(point_positions; i); span; x); BeamCantileverPointShearTerm(BeamForceElement(point_loads; i); BeamLengthElement(point_positions; i); x));
            response_type ≡ BEAM_RESPONSE_MOMENT; if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimplePointMomentTerm(BeamForceElement(point_loads; i); BeamLengthElement(point_positions; i); span; x); BeamCantileverPointMomentTerm(BeamForceElement(point_loads; i); BeamLengthElement(point_positions; i); x));
            response_type ≡ BEAM_RESPONSE_ROTATION; if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimplePointRotationTerm(BeamForceElement(point_loads; i); BeamLengthElement(point_positions; i); span; modulus; inertia; x); BeamCantileverPointRotationTerm(BeamForceElement(point_loads; i); BeamLengthElement(point_positions; i); modulus; inertia; x));
            response_type ≡ BEAM_RESPONSE_DEFLECTION; if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimplePointDeflectionTerm(BeamForceElement(point_loads; i); BeamLengthElement(point_positions; i); span; modulus; inertia; x); BeamCantileverPointDeflectionTerm(BeamForceElement(point_loads; i); BeamLengthElement(point_positions; i); modulus; inertia; x));
            0/0);
        @ i = 1 : len(point_loads)};
    udl_response_terms = vector(len(udl_values));
    $Repeat{
        udl_response_terms.i = switch(
            response_type ≡ BEAM_RESPONSE_SHEAR; if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimpleSegmentShearTerm(BeamDistributedElement(udl_values; i); BeamLengthElement(udl_starts; i); BeamLengthElement(udl_ends; i); span; x); BeamCantileverSegmentShearTerm(BeamDistributedElement(udl_values; i); BeamLengthElement(udl_starts; i); BeamLengthElement(udl_ends; i); x));
            response_type ≡ BEAM_RESPONSE_MOMENT; if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimpleSegmentMomentTerm(BeamDistributedElement(udl_values; i); BeamLengthElement(udl_starts; i); BeamLengthElement(udl_ends; i); span; x); BeamCantileverSegmentMomentTerm(BeamDistributedElement(udl_values; i); BeamLengthElement(udl_starts; i); BeamLengthElement(udl_ends; i); x));
            response_type ≡ BEAM_RESPONSE_ROTATION; if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimpleSegmentRotationTerm(BeamDistributedElement(udl_values; i); BeamLengthElement(udl_starts; i); BeamLengthElement(udl_ends; i); span; modulus; inertia; x); BeamCantileverSegmentRotationTerm(BeamDistributedElement(udl_values; i); BeamLengthElement(udl_starts; i); BeamLengthElement(udl_ends; i); modulus; inertia; x));
            response_type ≡ BEAM_RESPONSE_DEFLECTION; if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimpleSegmentDeflectionTerm(BeamDistributedElement(udl_values; i); BeamLengthElement(udl_starts; i); BeamLengthElement(udl_ends; i); span; modulus; inertia; x); BeamCantileverSegmentDeflectionTerm(BeamDistributedElement(udl_values; i); BeamLengthElement(udl_starts; i); BeamLengthElement(udl_ends; i); modulus; inertia; x));
            0/0);
        @ i = 1 : len(udl_values)};
    sum(point_response_terms) + sum(udl_response_terms);
}

BeamResponseAtLoads(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; x; response_type) = _
$block{
    status = BeamLoadSetStatus(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia);
    status = if(and(status ≡ DB_OK; BeamPositionOK(x; span)); status; if(status ≠ DB_OK; status; DB_ERR_BAD_RANGE));
    if(status ≡ DB_OK; BeamResponseAtLoadsUnchecked(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; x; response_type); 0/0);
}

BeamShearAtLoads(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; x) = BeamResponseAtLoads(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; x; BEAM_RESPONSE_SHEAR)
BeamMomentAtLoads(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; x) = BeamResponseAtLoads(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; x; BEAM_RESPONSE_MOMENT)
BeamDeflectionAtLoads(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; x) = BeamResponseAtLoads(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; x; BEAM_RESPONSE_DEFLECTION)
BeamRotationAtLoads(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; x) = BeamResponseAtLoads(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; x; BEAM_RESPONSE_ROTATION)

BeamReactionLeftLoads(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia) = _
$block{
    status = BeamLoadSetStatus(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia);
    point_reaction_terms = vector(len(point_loads));
    udl_reaction_terms = vector(len(udl_values));
    $Repeat{point_reaction_terms.i = if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamForceElement(point_loads; i)*(span - BeamLengthElement(point_positions; i))/span; BeamForceElement(point_loads; i)) @ i = 1 : len(point_loads)};
    $Repeat{udl_reaction_terms.i = if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimpleSegmentReactionTerm(BeamDistributedElement(udl_values; i); BeamLengthElement(udl_starts; i); BeamLengthElement(udl_ends; i); span); BeamDistributedElement(udl_values; i)*(BeamLengthElement(udl_ends; i) - BeamLengthElement(udl_starts; i))) @ i = 1 : len(udl_values)};
    reaction = sum(point_reaction_terms) + sum(udl_reaction_terms);
    if(status ≡ DB_OK; reaction; 0/0);
}

BeamReactionRightLoads(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia) = _
$block{
    status = BeamLoadSetStatus(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia);
    point_total_terms = vector(len(point_loads));
    udl_total_terms = vector(len(udl_values));
    $Repeat{point_total_terms.i = BeamForceElement(point_loads; i) @ i = 1 : len(point_loads)};
    $Repeat{udl_total_terms.i = BeamDistributedElement(udl_values; i)*(BeamLengthElement(udl_ends; i) - BeamLengthElement(udl_starts; i)) @ i = 1 : len(udl_values)};
    total = sum(point_total_terms) + sum(udl_total_terms);
    left = BeamReactionLeftLoads(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia);
    if(and(status ≡ DB_OK; support ≡ BEAM_SIMPLE_SUPPORTED); total - left; 0/0);
}

BeamReactionMomentLoads(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia) = _
$block{
    status = BeamLoadSetStatus(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia);
    point_moment_terms = vector(len(point_loads));
    udl_moment_terms = vector(len(udl_values));
    $Repeat{point_moment_terms.i = if(support ≡ BEAM_CANTILEVER; BeamForceElement(point_loads; i)*BeamLengthElement(point_positions; i); 0N*m) @ i = 1 : len(point_loads)};
    $Repeat{udl_moment_terms.i = if(support ≡ BEAM_CANTILEVER; BeamDistributedElement(udl_values; i)*(BeamLengthElement(udl_ends; i) - BeamLengthElement(udl_starts; i))*(BeamLengthElement(udl_starts; i) + BeamLengthElement(udl_ends; i))/2; 0N*m) @ i = 1 : len(udl_values)};
    moment = sum(point_moment_terms) + sum(udl_moment_terms);
    if(and(status ≡ DB_OK; support ≡ BEAM_CANTILEVER); moment; 0N*m);
}

BeamMaxResponseAtSamples(response_type; support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions) = _
$block{
    status = BeamLoadSetStatus(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia);
    sample_status_terms = vector(len(sample_positions));
    response_terms = vector(len(sample_positions));
    $Repeat{
        sample_status_terms.i = and(BeamFinite(BeamLengthElement(sample_positions; i)); BeamPositionOK(BeamLengthElement(sample_positions; i); span));
        response_terms.i = abs(BeamResponseAtLoadsUnchecked(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; BeamLengthElement(sample_positions; i); response_type));
        @ i = 1 : len(sample_positions)};
    sample_status = min(sample_status_terms);
    if(and(status ≡ DB_OK; sample_status); max(response_terms); 0/0);
}

BeamMaxShearAtSamples(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions) = BeamMaxResponseAtSamples(BEAM_RESPONSE_SHEAR; support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions)
BeamMaxMomentAtSamples(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions) = BeamMaxResponseAtSamples(BEAM_RESPONSE_MOMENT; support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions)
BeamMaxDeflectionAtSamples(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions) = BeamMaxResponseAtSamples(BEAM_RESPONSE_DEFLECTION; support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions)
BeamMaxRotationAtSamples(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions) = BeamMaxResponseAtSamples(BEAM_RESPONSE_ROTATION; support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions)

'Return a unit-consistent vector for charting or caller-owned tables.
BeamResponseSampleSeries(response_type; support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions) = _
$block{
    status = BeamLoadSetStatus(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia);
    response_series = vector(len(sample_positions));
    $Repeat{
        response_series.i = if(and(status ≡ DB_OK; BeamPositionOK(BeamLengthElement(sample_positions; i); span)); BeamResponseAtLoadsUnchecked(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; BeamLengthElement(sample_positions; i); response_type); 0/0);
        @ i = 1 : len(sample_positions)};
    response_series;
}

BeamShearSampleSeries(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions) = BeamResponseSampleSeries(BEAM_RESPONSE_SHEAR; support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions)
BeamMomentSampleSeries(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions) = BeamResponseSampleSeries(BEAM_RESPONSE_MOMENT; support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions)
BeamDeflectionSampleSeries(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions) = BeamResponseSampleSeries(BEAM_RESPONSE_DEFLECTION; support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions)
BeamRotationSampleSeries(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions) = BeamResponseSampleSeries(BEAM_RESPONSE_ROTATION; support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; sample_positions)

BeamStations(span; count) = _
$block{
    n = max(2; round(count));
    stations = span*vector(n);
    $Repeat{stations.i = (i - 1)*span/(n - 1) @ i = 1 : n};
    stations;
}

'Convert a unit-valued vector to numeric ordinates without passing the
'whole vector through clrunits (which can contaminate later unit inference).
BeamNumericSeries(values) = _
$block{
    numeric_values = vector(len(values));
    $Repeat{numeric_values.i = clrunits(BeamVectorElement(values; i)) @ i = 1 : len(values)};
    numeric_values;
}

'Axial load convention: positive loads act toward increasing x and the
'returned internal axial force is positive in tension. Point and distributed
'axial loads to the right of a station contribute to that station force.
BeamAxialSegmentTerm(axial_value; start; finish; x) = axial_value*(max(finish - x; 0*x) - max(start - x; 0*x))
BeamAxialStatus(span; axial_loads; axial_positions; axial_starts; axial_ends; axial_values) = BeamLoadSetStatus(BEAM_SIMPLE_SUPPORTED; span; axial_loads; axial_positions; axial_starts; axial_ends; axial_values; 1Pa; 1m^4)

BeamMomentSetStatus(span; moment_positions; moment_values) = _
$block{
    pair_count = min(len(moment_positions); len(moment_values));
    finite_terms = vector(pair_count);
    position_terms = vector(pair_count);
    $Repeat{finite_terms.i = and(BeamFinite(BeamLengthElement(moment_positions; i)); BeamFinite(BeamMomentElement(moment_values; i))) @ i = 1 : pair_count};
    $Repeat{position_terms.i = if(BeamPositionOK(BeamLengthElement(moment_positions; i); span); 1; 0) @ i = 1 : pair_count};
    status = switch(
        not(BeamPositive(span)); DB_ERR_BAD_RANGE;
        len(moment_positions) ≠ len(moment_values); DB_ERR_BAD_RANGE;
        min(finite_terms) < 1; DB_ERR_BAD_RANGE;
        min(position_terms) < 1; DB_ERR_BAD_RANGE;
        DB_OK);
    status;
}

'Applied-moment convention: positive moments are counterclockwise. Rotation is
'the derivative of positive-downward deflection with respect to x.
BeamSimpleAppliedMomentShearTerm(applied_moment; span) = applied_moment/span
BeamSimpleAppliedMomentMomentTerm(applied_moment; position; span; x) = applied_moment*x/span - if(x < position; 0*applied_moment; applied_moment)
BeamSimpleAppliedMomentRotationTerm(applied_moment; position; span; modulus; inertia; x) = applied_moment*(-x^2/(2*span) + max(x - position; 0*x) + span/6 - (span - position)^2/(2*span))/(modulus*inertia)
BeamSimpleAppliedMomentDeflectionTerm(applied_moment; position; span; modulus; inertia; x) = applied_moment*(-x^3/(6*span) + max(x - position; 0*x)^2/2 + x*(span/6 - (span - position)^2/(2*span)))/(modulus*inertia)

BeamCantileverAppliedMomentShearTerm(applied_moment; span) = 0*applied_moment/span
BeamCantileverAppliedMomentMomentTerm(applied_moment; position; x) = if(x < position; -applied_moment; 0*applied_moment)
BeamCantileverAppliedMomentRotationTerm(applied_moment; position; modulus; inertia; x) = -applied_moment*min(x; position)/(modulus*inertia)
BeamCantileverAppliedMomentDeflectionTerm(applied_moment; position; modulus; inertia; x) = if(x ≤ position; -applied_moment*x^2/(2*modulus*inertia); -applied_moment*position*(2*x - position)/(2*modulus*inertia))

BeamAppliedMomentStatus(support; span; moment_positions; moment_values; modulus; inertia) = switch(
    not(BeamSupportKnown(support)); DB_ERR_BAD_METHOD;
    not(BeamPositive(modulus)); DB_ERR_BAD_RANGE;
    not(BeamPositive(inertia)); DB_ERR_BAD_RANGE;
    BeamMomentSetStatus(span; moment_positions; moment_values))

BeamAppliedMomentResponseUnchecked(support; span; moment_positions; moment_values; modulus; inertia; x; response_type) = _
$block{
    response_terms = vector(len(moment_values));
    $Repeat{
        response_terms.i = switch(
            response_type ≡ BEAM_RESPONSE_SHEAR; if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimpleAppliedMomentShearTerm(BeamMomentElement(moment_values; i); span); BeamCantileverAppliedMomentShearTerm(BeamMomentElement(moment_values; i); span));
            response_type ≡ BEAM_RESPONSE_MOMENT; if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimpleAppliedMomentMomentTerm(BeamMomentElement(moment_values; i); BeamLengthElement(moment_positions; i); span; x); BeamCantileverAppliedMomentMomentTerm(BeamMomentElement(moment_values; i); BeamLengthElement(moment_positions; i); x));
            response_type ≡ BEAM_RESPONSE_ROTATION; if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimpleAppliedMomentRotationTerm(BeamMomentElement(moment_values; i); BeamLengthElement(moment_positions; i); span; modulus; inertia; x); BeamCantileverAppliedMomentRotationTerm(BeamMomentElement(moment_values; i); BeamLengthElement(moment_positions; i); modulus; inertia; x));
            response_type ≡ BEAM_RESPONSE_DEFLECTION; if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamSimpleAppliedMomentDeflectionTerm(BeamMomentElement(moment_values; i); BeamLengthElement(moment_positions; i); span; modulus; inertia; x); BeamCantileverAppliedMomentDeflectionTerm(BeamMomentElement(moment_values; i); BeamLengthElement(moment_positions; i); modulus; inertia; x));
            0/0);
        @ i = 1 : len(moment_values)};
    sum(response_terms);
}

BeamAppliedMomentResponse(support; span; moment_positions; moment_values; modulus; inertia; x; response_type) = _
$block{
    status = BeamAppliedMomentStatus(support; span; moment_positions; moment_values; modulus; inertia);
    status = if(and(status ≡ DB_OK; BeamPositionOK(x; span)); status; if(status ≠ DB_OK; status; DB_ERR_BAD_RANGE));
    if(status ≡ DB_OK; BeamAppliedMomentResponseUnchecked(support; span; moment_positions; moment_values; modulus; inertia; x; response_type); 0/0);
}

BeamAppliedMomentLeftReaction(support; span; moment_positions; moment_values) = _
$block{
    status = BeamAppliedMomentStatus(support; span; moment_positions; moment_values; 1Pa; 1m^4);
    reaction_terms = 1N*vector(len(moment_values));
    $Repeat{reaction_terms.i = if(support ≡ BEAM_SIMPLE_SUPPORTED; BeamMomentElement(moment_values; i)/span; 0N) @ i = 1 : len(moment_values)};
    if(status ≡ DB_OK; sum(reaction_terms); 0/0);
}

BeamAppliedMomentRightReaction(support; span; moment_positions; moment_values) = if(support ≡ BEAM_SIMPLE_SUPPORTED; -BeamAppliedMomentLeftReaction(support; span; moment_positions; moment_values); 0/0)

BeamAppliedMomentFixedReaction(support; span; moment_positions; moment_values) = _
$block{
    status = BeamAppliedMomentStatus(support; span; moment_positions; moment_values; 1Pa; 1m^4);
    moment_terms = 1N*m*vector(len(moment_values));
    $Repeat{moment_terms.i = if(support ≡ BEAM_CANTILEVER; -BeamMomentElement(moment_values; i); 0N*m) @ i = 1 : len(moment_values)};
    if(status ≡ DB_OK; sum(moment_terms); 0/0);
}

BeamModelInputStatus(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; varying_starts; varying_ends; varying_start_values; varying_end_values; axial_loads; axial_positions; axial_starts; axial_ends; axial_values; moment_positions; moment_values; modulus; inertia) = _
$block{
    transverse_status = BeamAnalyzeStatus(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia);
    varying_status = BeamVaryingLoadSetStatus(span; varying_starts; varying_ends; varying_start_values; varying_end_values);
    axial_status = BeamAxialStatus(span; axial_loads; axial_positions; axial_starts; axial_ends; axial_values);
    moment_status = BeamMomentSetStatus(span; moment_positions; moment_values);
    switch(transverse_status ≠ DB_OK; transverse_status; varying_status ≠ DB_OK; varying_status; axial_status ≠ DB_OK; axial_status; moment_status);
}

BeamAxialAtLoads(span; axial_loads; axial_positions; axial_starts; axial_ends; axial_values; x) = _
$block{
    status = BeamAxialStatus(span; axial_loads; axial_positions; axial_starts; axial_ends; axial_values);
    status = if(and(status ≡ DB_OK; BeamPositionOK(x; span)); status; if(status ≠ DB_OK; status; DB_ERR_BAD_RANGE));
    point_terms = vector(len(axial_loads));
    $Repeat{point_terms.i = if(x < BeamLengthElement(axial_positions; i); BeamForceElement(axial_loads; i); 0N) @ i = 1 : len(axial_loads)};
    segment_terms = vector(len(axial_values));
    $Repeat{segment_terms.i = BeamAxialSegmentTerm(BeamDistributedElement(axial_values; i); BeamLengthElement(axial_starts; i); BeamLengthElement(axial_ends; i); x) @ i = 1 : len(axial_values)};
    axial_force = sum(point_terms) + sum(segment_terms);
    if(status ≡ DB_OK; axial_force; 0/0);
}

BeamAxialSampleSeries(span; axial_loads; axial_positions; axial_starts; axial_ends; axial_values; sample_positions) = _
$block{
    axial_series = 1N*vector(len(sample_positions));
    $Repeat{axial_series.i = BeamAxialAtLoads(span; axial_loads; axial_positions; axial_starts; axial_ends; axial_values; BeamLengthElement(sample_positions; i)) @ i = 1 : len(sample_positions)};
    axial_series;
}

BeamBendingStress(moment; section_modulus) = if(BeamPositive(section_modulus); abs(moment)/section_modulus; 0/0)
BeamBendingUtilization(moment; section_modulus; allowable_stress) = if(and(BeamPositive(section_modulus); BeamPositive(allowable_stress)); BeamBendingStress(moment; section_modulus)/allowable_stress; 0/0)
BeamBendingStatus(moment; section_modulus; allowable_stress; warning_threshold) = if(and(BeamPositive(section_modulus); BeamPositive(allowable_stress)); CheckUpperStatus(abs(moment); section_modulus*allowable_stress; warning_threshold); CHK_ERROR)

BeamShearStress(shear; shear_area) = if(BeamPositive(shear_area); abs(shear)/shear_area; 0/0)
BeamShearUtilization(shear; shear_area; allowable_stress) = if(and(BeamPositive(shear_area); BeamPositive(allowable_stress)); BeamShearStress(shear; shear_area)/allowable_stress; 0/0)
BeamShearStatus(shear; shear_area; allowable_stress; warning_threshold) = if(and(BeamPositive(shear_area); BeamPositive(allowable_stress)); CheckUpperStatus(abs(shear); shear_area*allowable_stress; warning_threshold); CHK_ERROR)

BeamDeflectionUtilization(deflection; allowable_deflection) = if(BeamPositive(allowable_deflection); abs(deflection)/allowable_deflection; 0/0)
BeamDeflectionStatus(deflection; allowable_deflection; warning_threshold) = if(BeamPositive(allowable_deflection); CheckUpperStatus(abs(deflection); allowable_deflection; warning_threshold); CHK_ERROR)

'High-level mixed-unit vector record API.
BEAM_MODEL_VERSION = 2
BEAM_MODEL_HEADER_LENGTH = 6
BEAM_MODEL_DEFAULT_SAMPLES = 121

BeamRecordElement(model; index) = take(index; model)
BeamRecordSlice(model; start; count) = first(last(model; len(model) - start + 1); count)

BeamModelVersion(model) = round(BeamRecordElement(model; 1))
BeamModelSupport(model) = round(BeamRecordElement(model; 2))
BeamModelSpan(model) = BeamRecordElement(model; 3) + 0m
BeamModelModulus(model) = BeamRecordElement(model; 4) + 0Pa
BeamModelInertia(model) = BeamRecordElement(model; 5) + 0m^4
BeamModelSampleCount(model) = round(BeamRecordElement(model; 6))
BeamModelProperties(model) = [BeamModelSupport(model); BeamModelSpan(model); BeamModelModulus(model); BeamModelInertia(model); BeamModelSampleCount(model)]

BeamPointLoadData(loads; positions) = join(join([len(loads); len(positions)]; loads); positions)
BeamDistributedLoadData(starts; ends; loads) = join(join(join([len(starts); len(ends); len(loads)]; starts); ends); loads)
BeamMomentData(positions; moments) = join(join([len(positions); len(moments)]; positions); moments)
BeamVaryingLoadData(starts; ends; start_values; end_values) = join(join(join(join([len(starts); len(ends); len(start_values); len(end_values)]; starts); ends); start_values); end_values)

BeamModelPointDataStart(model) = BEAM_MODEL_HEADER_LENGTH + 1
BeamModelPointLoadCount(model) = round(BeamRecordElement(model; BeamModelPointDataStart(model)))
BeamModelPointPositionCount(model) = round(BeamRecordElement(model; BeamModelPointDataStart(model) + 1))
BeamModelPointLoadsStart(model) = BeamModelPointDataStart(model) + 2
BeamModelPointPositionsStart(model) = BeamModelPointLoadsStart(model) + BeamModelPointLoadCount(model)

BeamModelUDLDataStart(model) = BeamModelPointPositionsStart(model) + BeamModelPointPositionCount(model)
BeamModelUDLStartCount(model) = round(BeamRecordElement(model; BeamModelUDLDataStart(model)))
BeamModelUDLEndCount(model) = round(BeamRecordElement(model; BeamModelUDLDataStart(model) + 1))
BeamModelUDLValueCount(model) = round(BeamRecordElement(model; BeamModelUDLDataStart(model) + 2))
BeamModelUDLStartsStart(model) = BeamModelUDLDataStart(model) + 3
BeamModelUDLEndsStart(model) = BeamModelUDLStartsStart(model) + BeamModelUDLStartCount(model)
BeamModelUDLValuesStart(model) = BeamModelUDLEndsStart(model) + BeamModelUDLEndCount(model)

BeamModelAxialPointDataStart(model) = BeamModelUDLValuesStart(model) + BeamModelUDLValueCount(model)
BeamModelAxialLoadCount(model) = round(BeamRecordElement(model; BeamModelAxialPointDataStart(model)))
BeamModelAxialPositionCount(model) = round(BeamRecordElement(model; BeamModelAxialPointDataStart(model) + 1))
BeamModelAxialLoadsStart(model) = BeamModelAxialPointDataStart(model) + 2
BeamModelAxialPositionsStart(model) = BeamModelAxialLoadsStart(model) + BeamModelAxialLoadCount(model)

BeamModelAxialUDLDataStart(model) = BeamModelAxialPositionsStart(model) + BeamModelAxialPositionCount(model)
BeamModelAxialStartCount(model) = round(BeamRecordElement(model; BeamModelAxialUDLDataStart(model)))
BeamModelAxialEndCount(model) = round(BeamRecordElement(model; BeamModelAxialUDLDataStart(model) + 1))
BeamModelAxialValueCount(model) = round(BeamRecordElement(model; BeamModelAxialUDLDataStart(model) + 2))
BeamModelAxialStartsStart(model) = BeamModelAxialUDLDataStart(model) + 3
BeamModelAxialEndsStart(model) = BeamModelAxialStartsStart(model) + BeamModelAxialStartCount(model)
BeamModelAxialValuesStart(model) = BeamModelAxialEndsStart(model) + BeamModelAxialEndCount(model)

BeamModelMomentDataStart(model) = BeamModelAxialValuesStart(model) + BeamModelAxialValueCount(model)
BeamModelMomentPositionCount(model) = round(BeamRecordElement(model; BeamModelMomentDataStart(model)))
BeamModelMomentValueCount(model) = round(BeamRecordElement(model; BeamModelMomentDataStart(model) + 1))
BeamModelMomentPositionsStart(model) = BeamModelMomentDataStart(model) + 2
BeamModelMomentValuesStart(model) = BeamModelMomentPositionsStart(model) + BeamModelMomentPositionCount(model)

BeamModelVaryingDataStart(model) = BeamModelMomentValuesStart(model) + BeamModelMomentValueCount(model)
BeamModelVaryingStartCount(model) = round(BeamRecordElement(model; BeamModelVaryingDataStart(model)))
BeamModelVaryingEndCount(model) = round(BeamRecordElement(model; BeamModelVaryingDataStart(model) + 1))
BeamModelVaryingStartValueCount(model) = round(BeamRecordElement(model; BeamModelVaryingDataStart(model) + 2))
BeamModelVaryingEndValueCount(model) = round(BeamRecordElement(model; BeamModelVaryingDataStart(model) + 3))
BeamModelVaryingStartsStart(model) = BeamModelVaryingDataStart(model) + 4
BeamModelVaryingEndsStart(model) = BeamModelVaryingStartsStart(model) + BeamModelVaryingStartCount(model)
BeamModelVaryingStartValuesStart(model) = BeamModelVaryingEndsStart(model) + BeamModelVaryingEndCount(model)
BeamModelVaryingEndValuesStart(model) = BeamModelVaryingStartValuesStart(model) + BeamModelVaryingStartValueCount(model)

BeamModelPointLoads(model) = BeamRecordSlice(model; BeamModelPointLoadsStart(model); BeamModelPointLoadCount(model))
BeamModelPointPositions(model) = BeamRecordSlice(model; BeamModelPointPositionsStart(model); BeamModelPointPositionCount(model))
BeamModelUDLStarts(model) = BeamRecordSlice(model; BeamModelUDLStartsStart(model); BeamModelUDLStartCount(model))
BeamModelUDLEnds(model) = BeamRecordSlice(model; BeamModelUDLEndsStart(model); BeamModelUDLEndCount(model))
BeamModelUDLValues(model) = BeamRecordSlice(model; BeamModelUDLValuesStart(model); BeamModelUDLValueCount(model))
BeamModelAxialLoads(model) = BeamRecordSlice(model; BeamModelAxialLoadsStart(model); BeamModelAxialLoadCount(model))
BeamModelAxialPositions(model) = BeamRecordSlice(model; BeamModelAxialPositionsStart(model); BeamModelAxialPositionCount(model))
BeamModelAxialStarts(model) = BeamRecordSlice(model; BeamModelAxialStartsStart(model); BeamModelAxialStartCount(model))
BeamModelAxialEnds(model) = BeamRecordSlice(model; BeamModelAxialEndsStart(model); BeamModelAxialEndCount(model))
BeamModelAxialValues(model) = BeamRecordSlice(model; BeamModelAxialValuesStart(model); BeamModelAxialValueCount(model))
BeamModelMomentPositions(model) = BeamRecordSlice(model; BeamModelMomentPositionsStart(model); BeamModelMomentPositionCount(model))
BeamModelMomentValues(model) = BeamRecordSlice(model; BeamModelMomentValuesStart(model); BeamModelMomentValueCount(model))
BeamModelVaryingStarts(model) = BeamRecordSlice(model; BeamModelVaryingStartsStart(model); BeamModelVaryingStartCount(model))
BeamModelVaryingEnds(model) = BeamRecordSlice(model; BeamModelVaryingEndsStart(model); BeamModelVaryingEndCount(model))
BeamModelVaryingStartValues(model) = BeamRecordSlice(model; BeamModelVaryingStartValuesStart(model); BeamModelVaryingStartValueCount(model))
BeamModelVaryingEndValues(model) = BeamRecordSlice(model; BeamModelVaryingEndValuesStart(model); BeamModelVaryingEndValueCount(model))

BeamModelPointData(model) = BeamRecordSlice(model; BeamModelPointDataStart(model); BeamModelUDLDataStart(model) - BeamModelPointDataStart(model))
BeamModelUDLData(model) = BeamRecordSlice(model; BeamModelUDLDataStart(model); BeamModelAxialPointDataStart(model) - BeamModelUDLDataStart(model))
BeamModelAxialPointData(model) = BeamRecordSlice(model; BeamModelAxialPointDataStart(model); BeamModelAxialUDLDataStart(model) - BeamModelAxialPointDataStart(model))
BeamModelAxialUDLData(model) = BeamRecordSlice(model; BeamModelAxialUDLDataStart(model); BeamModelMomentDataStart(model) - BeamModelAxialUDLDataStart(model))
BeamModelMomentData(model) = BeamRecordSlice(model; BeamModelMomentDataStart(model); BeamModelVaryingDataStart(model) - BeamModelMomentDataStart(model))
BeamModelVaryingData(model) = BeamRecordSlice(model; BeamModelVaryingDataStart(model); len(model) - BeamModelVaryingDataStart(model) + 1)
BeamModelExpectedLength(model) = BeamModelVaryingEndValuesStart(model) + BeamModelVaryingEndValueCount(model) - 1

BeamModelBuild(properties; point_data; udl_data; axial_point_data; axial_udl_data; moment_data; varying_data) = join(join(join(join(join(join([BEAM_MODEL_VERSION; BeamRecordElement(properties; 1); BeamRecordElement(properties; 2); BeamRecordElement(properties; 3); BeamRecordElement(properties; 4); BeamRecordElement(properties; 5)]; point_data); udl_data); axial_point_data); axial_udl_data); moment_data); varying_data)

BeamModel(support; span; modulus; inertia) = _
$block{
    properties = [support; span; modulus; inertia; BEAM_MODEL_DEFAULT_SAMPLES];
    point_data = BeamPointLoadData([0N]; [0m]);
    udl_data = BeamDistributedLoadData([0m]; [span]; [0N/m]);
    axial_point_data = BeamPointLoadData([0N]; [0m]);
    axial_udl_data = BeamDistributedLoadData([0m]; [span]; [0N/m]);
    moment_data = BeamMomentData([0m]; [0N*m]);
    varying_data = BeamVaryingLoadData([0m]; [span]; [0N/m]; [0N/m]);
    BeamModelBuild(properties; point_data; udl_data; axial_point_data; axial_udl_data; moment_data; varying_data);
}

BeamWithPointLoads(model; loads; positions) = _
$block{
    properties = BeamModelProperties(model);
    point_data = BeamPointLoadData(loads; positions);
    BeamModelBuild(properties; point_data; BeamModelUDLData(model); BeamModelAxialPointData(model); BeamModelAxialUDLData(model); BeamModelMomentData(model); BeamModelVaryingData(model));
}

BeamWithPointLoad(model; load; position) = BeamWithPointLoads(model; [load]; [position])

BeamWithDistributedLoads(model; starts; ends; loads) = _
$block{
    properties = BeamModelProperties(model);
    udl_data = BeamDistributedLoadData(starts; ends; loads);
    BeamModelBuild(properties; BeamModelPointData(model); udl_data; BeamModelAxialPointData(model); BeamModelAxialUDLData(model); BeamModelMomentData(model); BeamModelVaryingData(model));
}

BeamWithUDL(model; load) = BeamWithDistributedLoads(model; [0m]; [BeamModelSpan(model)]; [load])

BeamWithVaryingDistributedLoads(model; starts; ends; start_values; end_values) = _
$block{
    properties = BeamModelProperties(model);
    varying_data = BeamVaryingLoadData(starts; ends; start_values; end_values);
    BeamModelBuild(properties; BeamModelPointData(model); BeamModelUDLData(model); BeamModelAxialPointData(model); BeamModelAxialUDLData(model); BeamModelMomentData(model); varying_data);
}

BeamWithVaryingDistributedLoad(model; start; finish; start_value; end_value) = BeamWithVaryingDistributedLoads(model; [start]; [finish]; [start_value]; [end_value])

BeamWithAxialPointLoads(model; loads; positions) = _
$block{
    properties = BeamModelProperties(model);
    axial_point_data = BeamPointLoadData(loads; positions);
    BeamModelBuild(properties; BeamModelPointData(model); BeamModelUDLData(model); axial_point_data; BeamModelAxialUDLData(model); BeamModelMomentData(model); BeamModelVaryingData(model));
}

BeamWithAxialDistributedLoads(model; starts; ends; loads) = _
$block{
    properties = BeamModelProperties(model);
    axial_udl_data = BeamDistributedLoadData(starts; ends; loads);
    BeamModelBuild(properties; BeamModelPointData(model); BeamModelUDLData(model); BeamModelAxialPointData(model); axial_udl_data; BeamModelMomentData(model); BeamModelVaryingData(model));
}

BeamWithMoments(model; positions; moments) = _
$block{
    properties = BeamModelProperties(model);
    moment_data = BeamMomentData(positions; moments);
    BeamModelBuild(properties; BeamModelPointData(model); BeamModelUDLData(model); BeamModelAxialPointData(model); BeamModelAxialUDLData(model); moment_data; BeamModelVaryingData(model));
}

BeamWithMoment(model; position; moment) = BeamWithMoments(model; [position]; [moment])
BeamWithDiagramMoments(model; positions; moments) = BeamWithMoments(model; positions; moments)

BeamWithSampleCount(model; count) = _
$block{
    properties = [BeamModelSupport(model); BeamModelSpan(model); BeamModelModulus(model); BeamModelInertia(model); count];
    BeamModelBuild(properties; BeamModelPointData(model); BeamModelUDLData(model); BeamModelAxialPointData(model); BeamModelAxialUDLData(model); BeamModelMomentData(model); BeamModelVaryingData(model));
}

BeamModelStatus(model) = switch(BeamModelVersion(model) ≠ BEAM_MODEL_VERSION; DB_ERR_BAD_METHOD; len(model) ≠ BeamModelExpectedLength(model); DB_ERR_BAD_RANGE; not(and(BeamFinite(BeamModelSampleCount(model)); BeamModelSampleCount(model) ≥ 2)); DB_ERR_BAD_RANGE; BeamModelInputStatus(BeamModelSupport(model); BeamModelSpan(model); BeamModelPointLoads(model); BeamModelPointPositions(model); BeamModelUDLStarts(model); BeamModelUDLEnds(model); BeamModelUDLValues(model); BeamModelVaryingStarts(model); BeamModelVaryingEnds(model); BeamModelVaryingStartValues(model); BeamModelVaryingEndValues(model); BeamModelAxialLoads(model); BeamModelAxialPositions(model); BeamModelAxialStarts(model); BeamModelAxialEnds(model); BeamModelAxialValues(model); BeamModelMomentPositions(model); BeamModelMomentValues(model); BeamModelModulus(model); BeamModelInertia(model)))
BeamModelResponseStatus(model; x) = switch(BeamModelStatus(model) ≠ DB_OK; BeamModelStatus(model); not(BeamFinite(x)); DB_ERR_BAD_RANGE; DBRangeStatus(x; 0m; BeamModelSpan(model); DB_STRICT))
BeamModelResponseUnchecked(model; x; response_type) = _
$block{
    transverse_response = BeamResponseAtLoadsUnchecked(BeamModelSupport(model); BeamModelSpan(model); BeamModelPointLoads(model); BeamModelPointPositions(model); BeamModelUDLStarts(model); BeamModelUDLEnds(model); BeamModelUDLValues(model); BeamModelModulus(model); BeamModelInertia(model); x; response_type);
    varying_response = BeamVaryingResponseUnchecked(BeamModelSupport(model); BeamModelSpan(model); BeamModelVaryingStarts(model); BeamModelVaryingEnds(model); BeamModelVaryingStartValues(model); BeamModelVaryingEndValues(model); BeamModelModulus(model); BeamModelInertia(model); x; response_type);
    applied_moment_response = BeamAppliedMomentResponseUnchecked(BeamModelSupport(model); BeamModelSpan(model); BeamModelMomentPositions(model); BeamModelMomentValues(model); BeamModelModulus(model); BeamModelInertia(model); x; response_type);
    transverse_response + varying_response + applied_moment_response;
}

BeamModelResponse(model; x; response_type) = if(BeamModelResponseStatus(model; x) ≡ DB_OK; BeamModelResponseUnchecked(model; x; response_type); 0/0)

BeamShear(model; x) = BeamModelResponse(model; x; BEAM_RESPONSE_SHEAR)
BeamMoment(model; x) = BeamModelResponse(model; x; BEAM_RESPONSE_MOMENT)
BeamRotation(model; x) = BeamModelResponse(model; x; BEAM_RESPONSE_ROTATION)
BeamDeflection(model; x) = BeamModelResponse(model; x; BEAM_RESPONSE_DEFLECTION)
BeamAxial(model; x) = BeamAxialAtLoads(BeamModelSpan(model); BeamModelAxialLoads(model); BeamModelAxialPositions(model); BeamModelAxialStarts(model); BeamModelAxialEnds(model); BeamModelAxialValues(model); x)
BeamLeftReaction(model) = BeamReactionLeftLoads(BeamModelSupport(model); BeamModelSpan(model); BeamModelPointLoads(model); BeamModelPointPositions(model); BeamModelUDLStarts(model); BeamModelUDLEnds(model); BeamModelUDLValues(model); BeamModelModulus(model); BeamModelInertia(model)) + BeamVaryingLeftReaction(BeamModelSupport(model); BeamModelSpan(model); BeamModelVaryingStarts(model); BeamModelVaryingEnds(model); BeamModelVaryingStartValues(model); BeamModelVaryingEndValues(model)) + BeamAppliedMomentLeftReaction(BeamModelSupport(model); BeamModelSpan(model); BeamModelMomentPositions(model); BeamModelMomentValues(model))
BeamRightReaction(model) = BeamReactionRightLoads(BeamModelSupport(model); BeamModelSpan(model); BeamModelPointLoads(model); BeamModelPointPositions(model); BeamModelUDLStarts(model); BeamModelUDLEnds(model); BeamModelUDLValues(model); BeamModelModulus(model); BeamModelInertia(model)) + BeamVaryingRightReaction(BeamModelSupport(model); BeamModelSpan(model); BeamModelVaryingStarts(model); BeamModelVaryingEnds(model); BeamModelVaryingStartValues(model); BeamModelVaryingEndValues(model)) + BeamAppliedMomentRightReaction(BeamModelSupport(model); BeamModelSpan(model); BeamModelMomentPositions(model); BeamModelMomentValues(model))
BeamFixedEndMoment(model) = BeamReactionMomentLoads(BeamModelSupport(model); BeamModelSpan(model); BeamModelPointLoads(model); BeamModelPointPositions(model); BeamModelUDLStarts(model); BeamModelUDLEnds(model); BeamModelUDLValues(model); BeamModelModulus(model); BeamModelInertia(model)) + BeamVaryingFixedReaction(BeamModelSupport(model); BeamModelSpan(model); BeamModelVaryingStarts(model); BeamModelVaryingEnds(model); BeamModelVaryingStartValues(model); BeamModelVaryingEndValues(model)) + BeamAppliedMomentFixedReaction(BeamModelSupport(model); BeamModelSpan(model); BeamModelMomentPositions(model); BeamModelMomentValues(model))
BeamSamplePositions(model) = BeamStations(BeamModelSpan(model); BeamModelSampleCount(model))
BeamModelResponseSeries(model; response_type) = _
$block{
    status = BeamModelStatus(model);
    samples = BeamSamplePositions(model);
    support = BeamModelSupport(model);
    span = BeamModelSpan(model);
    modulus = BeamModelModulus(model);
    inertia = BeamModelInertia(model);
    point_loads = BeamModelPointLoads(model);
    point_positions = BeamModelPointPositions(model);
    udl_starts = BeamModelUDLStarts(model);
    udl_ends = BeamModelUDLEnds(model);
    udl_values = BeamModelUDLValues(model);
    varying_starts = BeamModelVaryingStarts(model);
    varying_ends = BeamModelVaryingEnds(model);
    varying_start_values = BeamModelVaryingStartValues(model);
    varying_end_values = BeamModelVaryingEndValues(model);
    moment_positions = BeamModelMomentPositions(model);
    moment_values = BeamModelMomentValues(model);
    response_series = vector(len(samples));
    $Repeat{
        response_series.i = if(
            status ≡ DB_OK;
            BeamResponseAtLoadsUnchecked(support; span; point_loads; point_positions; udl_starts; udl_ends; udl_values; modulus; inertia; BeamLengthElement(samples; i); response_type) + BeamVaryingResponseUnchecked(support; span; varying_starts; varying_ends; varying_start_values; varying_end_values; modulus; inertia; BeamLengthElement(samples; i); response_type) + BeamAppliedMomentResponseUnchecked(support; span; moment_positions; moment_values; modulus; inertia; BeamLengthElement(samples; i); response_type);
            0/0);
        @ i = 1 : len(samples)};
    response_series;
}

BeamShearSeries(model) = BeamModelResponseSeries(model; BEAM_RESPONSE_SHEAR)
BeamMomentSeries(model) = BeamModelResponseSeries(model; BEAM_RESPONSE_MOMENT)
BeamRotationSeries(model) = BeamModelResponseSeries(model; BEAM_RESPONSE_ROTATION)
BeamDeflectionSeries(model) = BeamModelResponseSeries(model; BEAM_RESPONSE_DEFLECTION)
BeamAxialSeries(model) = BeamAxialSampleSeries(BeamModelSpan(model); BeamModelAxialLoads(model); BeamModelAxialPositions(model); BeamModelAxialStarts(model); BeamModelAxialEnds(model); BeamModelAxialValues(model); BeamSamplePositions(model))

BeamAppliedMomentsAtPosition(model; x) = _
$block{
    moment_terms = 1N*m*vector(len(BeamModelMomentValues(model)));
    $Repeat{moment_terms.i = if(BeamLengthElement(BeamModelMomentPositions(model); i) ≡ x; BeamMomentElement(BeamModelMomentValues(model); i); 0N*m) @ i = 1 : len(BeamModelMomentValues(model))};
    sum(moment_terms);
}

BeamMomentLeftLimit(model; x) = BeamMoment(model; x) + if(BeamModelSupport(model) ≡ BEAM_SIMPLE_SUPPORTED; BeamAppliedMomentsAtPosition(model; x); -BeamAppliedMomentsAtPosition(model; x))

BeamModelMaxResponse(model; response_type) = _
$block{
    response_terms = abs(BeamModelResponseSeries(model; response_type));
    left_limit_terms = vector(len(BeamModelMomentValues(model)));
    $Repeat{left_limit_terms.i = if(and(response_type ≡ BEAM_RESPONSE_MOMENT; BeamLengthElement(BeamModelMomentPositions(model); i) > 0m); abs(BeamMomentLeftLimit(model; BeamLengthElement(BeamModelMomentPositions(model); i))); 0*BeamVectorElement(response_terms; 1)) @ i = 1 : len(BeamModelMomentValues(model))};
    max(max(response_terms); max(left_limit_terms));
}

BeamPeakShear(model) = BeamModelMaxResponse(model; BEAM_RESPONSE_SHEAR)
BeamPeakMoment(model) = BeamModelMaxResponse(model; BEAM_RESPONSE_MOMENT)
BeamPeakRotation(model) = BeamModelMaxResponse(model; BEAM_RESPONSE_ROTATION)
BeamPeakDeflection(model) = BeamModelMaxResponse(model; BEAM_RESPONSE_DEFLECTION)

#def BeamSupport$(support$)
    #if support$ ≡ BEAM_SIMPLE_SUPPORTED
        'Simply supported
    #end if
    #if support$ ≡ BEAM_CANTILEVER
        'Cantilever
    #end if
    #if not(BeamSupportKnown(support$))
        '<span class="err">Unknown support type</span>
    #end if
#end def

#def BeamLoadType$(load_type$)
    #if load_type$ ≡ BEAM_POINT_LOAD
        'Point load
    #end if
    #if load_type$ ≡ BEAM_FULL_UDL
        'Full-span uniform distributed load
    #end if
    #if not(BeamLoadTypeKnown(load_type$))
        '<span class="err">Unknown load type</span>
    #end if
#end def

