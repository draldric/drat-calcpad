    #end if
    #if fluid$ ≡ 201
        'CoolProp incompressible-fluid key INCOMP::MEG-50%.
    #end if
    #if fluid$ ≡ 301
        'Pure nitrogen using the Span et al. reference Helmholtz equation of state.
    #end if
    #if fluid$ ≡ 302
        'Pure carbon dioxide using the Span-Wagner reference Helmholtz equation of state.
