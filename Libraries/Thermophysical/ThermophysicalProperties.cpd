#def ThermoFluidName$(fluid$)
    #if fluid$ ≡ 101
        'Water
    #end if
    #if fluid$ ≡ 201
        'Ethylene glycol solution, 50 percent by mass
    #end if
    #if not(ThermoHasFluid(fluid$))
        '<span class="err">Unknown thermophysical fluid ID</span>
    #end if
#end def

#def ThermoFluidDescription$(fluid$)
    #if fluid$ ≡ 101
        'Water property curves sampled from the source-model CoolProp engine.
    #end if
    #if fluid$ ≡ 201
        'CoolProp incompressible-fluid key INCOMP::MEG-50%.
    #end if
    #if not(ThermoHasFluid(fluid$))
        '<span class="err">Unknown thermophysical fluid ID</span>
    #end if
#end def

#def ThermoPropertyName$(property$)
    #if property$ ≡ 1
        'Density
    #end if
    #if property$ ≡ 2
        'Specific heat capacity
    #end if
    #if property$ ≡ 3
        'Dynamic viscosity
    #end if
    #if property$ ≡ 4
        'Thermal conductivity
    #end if
    #if property$ ≡ 5
        'Saturation pressure
    #end if
    #if property$ ≡ 6
        'Latent heat of vaporization
    #end if
    #if not(ThermoHasProperty(property$))
        '<span class="err">Unknown thermophysical property ID</span>
    #end if
#end def

#def ThermoPropertySymbol$(property$)
    #if property$ ≡ 1
        'rho
    #end if
    #if property$ ≡ 2
        'c_p
    #end if
    #if property$ ≡ 3
        'mu
    #end if
    #if property$ ≡ 4
        'k
    #end if
    #if property$ ≡ 5
        'P_sat
    #end if
    #if property$ ≡ 6
        'h_fg
    #end if
    #if not(ThermoHasProperty(property$))
        '<span class="err">Unknown thermophysical property ID</span>
    #end if
#end def

#def ThermoPropertyUnit$(property$)
    #if property$ ≡ 1
        'kg/m3
    #end if
    #if property$ ≡ 2
        'J/(kg K)
    #end if
    #if property$ ≡ 3
        'Pa s
    #end if
    #if property$ ≡ 4
        'W/(m K)
    #end if
    #if property$ ≡ 5
        'kPa
    #end if
    #if property$ ≡ 6
        'kJ/kg
    #end if
    #if not(ThermoHasProperty(property$))
        '<span class="err">Unknown thermophysical property ID</span>
    #end if
#end def

#def ThermoSourceName$(source$)
    #if source$ ≡ 1
        'CoolProp sampled through SMath
    #end if
    #if not(ThermoHasSource(source$))
        '<span class="err">Unknown thermophysical source ID</span>
    #end if
#end def

