    '<tr><td><strong>Qualification note</strong></td><td>
    ThermoSourceNotes$(source$)
    '</td></tr>
    '<tr><td><strong>Status</strong></td><td>
    DBStatus$(ζTHERMO_source_status)
    '</td></tr></tbody></table>
    #equ
