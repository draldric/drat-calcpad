#def ThermoSourceNotes$(source$)
    #if source$ ≡ 1
        'Fluid keys Water and INCOMP::MEG-50%. The saved worksheet did not retain the complete input-pair calls, so this dataset must be treated as a traceable migration baseline rather than independent validation of the property basis.
    #end if
    #if source$ ≡ 2
        'Region 1 and Region 2 fundamental equations with the Region 4 saturation equations and the B23 boundary equation. Coefficients and verification points are transcribed from the official release.
    #end if
    #if source$ ≡ 3
        'Primary EOS DOI 10.1063/1.1349047. Imported from the pinned CoolProp pure-fluid JSON record.
    #end if
    #if source$ ≡ 4
        'Primary EOS DOI 10.1063/1.555991. Imported from the pinned CoolProp pure-fluid JSON record.
    #end if
    #if source$ ≡ 5
        'Primary EOS DOI 10.1016/0378-3812(92)87054-Q. Imported from the pinned CoolProp pure-fluid JSON record.
    #end if
    #if source$ ≡ 6
        'Primary EOS reference is VDI Fortschritt-Berichte series 19 number 57. Imported from the pinned CoolProp pure-fluid JSON record.
    #end if
    #if source$ ≡ 7
        'Primary reference DOI 10.1007/978-3-662-02608-3. Imported from the pinned CoolProp pure-fluid JSON record.
    #end if
    #if source$ ≡ 8
        'Primary EOS DOI 10.1063/1.555958. Imported from the pinned CoolProp pure-fluid JSON record.
    #end if
    #if source$ ≡ 9
        'Primary EOS DOI 10.1063/1.556002. Imported from the pinned CoolProp pure-fluid JSON record.
    #end if
    #if source$ ≡ 10
